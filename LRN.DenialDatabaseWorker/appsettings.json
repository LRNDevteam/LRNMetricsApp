{
	// Azure Key Vault holds every secret this service needs: ConnectionStrings:DenialDatabase, each
	// lab's database (see Labs[] below) and the SharePoint app registration under
	// DenialDatabaseProcessor:SharePoint. Vault secret names use "--" in place of ":", e.g. the secret
	// "ConnectionStrings--DenialDatabase" supplies ConnectionStrings:DenialDatabase. Nothing below
	// this line is a secret.
	//
	// Access is via DefaultAzureCredential (managed identity on the server, az-cli / Visual Studio
	// sign-in locally); that identity needs the "Key Vault Secrets User" role on the vault.
	// Set VaultUri to "" to run without the vault - see README.md.
	"KeyVault": {
		"VaultUri": "https://kv-lrnmetrics-prod.vault.azure.net/"
	},
	"DenialDatabaseProcessor": {
		"RunOnceOnStartup": true,
		// Loop interval when RunOnceOnStartup is false. Must never be 0 — that turns continuous
		// mode into an uninterrupted loop over every lab.
		"IntervalMinutes": 60,
		// Orphan disposition (spec §6). An orphan is an existing, non-closed task whose denial did
		// not recur in this run. Before it goes to a reviewer, the worker asks the upstream data
		// whether something already explains the disappearance.
		//   EnableUpstreamResolutionCheck - was the line written off or adjusted? (§6.1)
		//   EnableResubmissionCheck       - was the claim rebilled? (§6.2). OFF until the
		//                                   line-level table name and grain are confirmed.
		"EnableUpstreamResolutionCheck": true,
		"EnableResubmissionCheck": false,
		"LineLevelTable": "dbo.LineLevelData",
		// Matched case-insensitively, ignoring spaces and hyphens, so one entry covers several
		// spellings. The vocabulary comes from the labs' billing systems, not from us.
		"WriteOffStatusValues": [ "Write Off", "Fully WriteOff", "Write-Off" ],
		"AdjustedStatusValues": [ "Adjusted", "Fully Adjusted" ],
		"OutputRoot": "C:\\LRN-Files\\Automation\\LRN-Output\\DenialDatabase",
		"LogCsvPath": "C:\\LRN-Files\\Automation\\LRN-Logs\\DenialDatabaseProcessor_Log.csv",
		"TaskBoardMapperPath": "C:\\Services\\LRN.DenialAnalysisProcessor\\MapperJon\\DenialTaskBoardMapper.json",
		"DenialInshightMapperPath": "C:\\Services\\LRN.DenialAnalysisProcessor\\MapperJon\\DenialInsightMapper.json",
		"DenialLineItemMapperPath": "C:\\Services\\LRN.DenialAnalysisProcessor\\MapperJon\\DenialLineItemMapper.json",
		"PayerValidationReportTable": "dbo.PayerValidationReport",
		"DeniedPayStatus": "Denied",
		"ProcessLatestRunOnly": true,
		"GenerateOutputFiles": false,
		"UploadOutputsToSharePoint": false,
		"SqlCommandTimeoutSeconds": 600,
		"ReportName": "Denial Report",
		"ReportLogCreatedBy": "Denial Database Processor",
		"RecentSuccessRunProcedure": "dbo.sp_GetRecentSuccessRunByLab",
		"SharePoint": {
			// TenantId, ClientId and ClientSecret come from Key Vault, under
			// DenialDatabaseProcessor--SharePoint--*. Never add them here.
			"Enabled": true,
			"Hostname": "3eclaimsprocessingllc.sharepoint.com",
			"SitePath": "/sites/3EClaimsProcessingLLC",
			"SiteUrl": "https://3eclaimsprocessingllc.sharepoint.com/sites/3EClaimsProcessingLLC"
		}
	},
