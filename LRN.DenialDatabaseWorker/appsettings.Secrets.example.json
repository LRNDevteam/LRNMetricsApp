// Copy this file to appsettings.Secrets.json (gitignored) and fill in the real values.
//
// Loaded AFTER Azure Key Vault, so anything here overrides the vault.
//
// Two kinds of entry belong in this file:
//
//   1. Secrets the vault cannot hold. Today that is only the Teams incoming-webhook URL: at 265
//      characters it is longer than the 256-character limit on the Azure resource tags these
//      settings are managed through. This one is permanent.
//
//   2. Temporary local overrides, while a vault secret does not exist yet or you are working
//      offline. Delete these as soon as the vault has the value - leaving one here means the vault
//      is silently ignored for that key, including after a credential rotation.
//
// Everything else - the SharePoint app registration, LRNMaster, every lab database - comes from
// the vault. Do not duplicate them here.
{
  "TeamsNotification": {
    "WebhookUrl": "https://<tenant>.webhook.office.com/webhookb2/..."
  },

  // Category 2 examples. Remove each once the matching vault secret exists.
  "DenialDatabaseProcessor": {
    "SharePoint": {
      "TenantId": "<tenant-guid>",
      "ClientId": "<app-registration-guid>",
      "ClientSecret": "<client-secret>"
    }
  },
  "ConnectionStrings": {
    // LRNMaster - the run log, task board and workflow tracker.
    "DenialDatabase": "Server=<host>;Initial Catalog=LRNMaster;...",
    // A single lab, named by its LabDbConnectionKey in appsettings.json.
    "CoveConnection": "Server=<host>;Initial Catalog=CoveLRN;..."
  }
}
