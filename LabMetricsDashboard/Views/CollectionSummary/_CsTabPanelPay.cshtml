@model LabMetricsDashboard.Models.CollectionSummaryViewModel
@{
    var rowsData = Model.PanelPayments;
    // Pivot mode when any row carries a real BillYear/Month (e.g. Elixir).
    var hasMonthlyGrain = rowsData.Any(r => r.BillYear > 0 && r.BillMonth > 0);
}
<style>
/* Footer year / Grand Total cells stay navy (not cream/peach body fills). */
#panelpay-pane .cs-rpt-table tbody td.cs-pr-year { background-color: #fefce8 !important; }
#panelpay-pane .cs-rpt-table tbody td.cs-pr-grand { background-color: #fef3c7 !important; font-weight: 800; }
#panelpay-pane .cs-rpt-table tfoot td,
#panelpay-pane .cs-rpt-table tfoot td.cs-pr-year,
#panelpay-pane .cs-rpt-table tfoot td.cs-pr-grand {
    background: #0e3460 !important;
    color: #fff !important;
    font-weight: 800;
}
</style>
@if (rowsData.Count == 0)
{
    <div class="text-center py-5 text-muted">
        <div style="font-size:2rem;opacity:.4">&#128202;</div>
        <div class="fw-semibold mt-2">No panel payment data available</div>
        <div class="small mt-1">No matching claim records found. Try adjusting your filters.</div>
    </div>
}
else if (!hasMonthlyGrain)
{
    var grandClaims = rowsData.Sum(r => r.NoOfClaims);
    var grandPayments = rowsData.Sum(r => r.InsurancePayments);
    <div class="cs-rpt-wrap">
        <div class="cs-rpt-scroll">
            <table class="cs-rpt-table">
                <thead>
                    <tr>
                        <th style="min-width:280px">Panel</th>
                        <th style="min-width:140px">No. of Claims</th>
                        <th style="min-width:180px">Insurance Payments</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in rowsData)
                    {
                        <tr>
                            <td style="text-align:left;font-weight:600">@row.PanelName</td>
                            <td style="text-align:right">@row.NoOfClaims.N0OrDash()</td>
                            <td style="text-align:right">@Acct2(row.InsurancePayments)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="background:linear-gradient(135deg,#0a1628 0%,#0e3460 50%,#0d5c74 100%);color:#fff;font-weight:700">
                        <td style="text-align:left;color:#fff">Grand Total</td>
                        <td style="text-align:right;color:#fff">@grandClaims.N0OrDash()</td>
                        <td style="text-align:right;color:#fff">@Acct2(grandPayments)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="mt-2" style="font-size:.68rem; color:#94a3b8">
        <strong>Source:</strong> @(Model.IsAugustusLab ? "Collection Claim Level Data" : "Claim Level Data") &bull;
        <strong>Filter:</strong> InsurancePayment &gt; 0@(Model.IsAugustusLab ? " · Posted Date" : "") &bull;
        <strong>Sorted by:</strong> @(Model.IsAugustusLab ? "Count of PanelNew DESC" : "SUM(InsurancePayment) DESC") &bull;
        <strong>Metric:</strong> @(Model.IsAugustusLab ? "COUNT(*) (Count of PanelNew), SUM(InsurancePayment)" : "COUNT(DISTINCT ClaimID), SUM(InsurancePayment)")
    </div>
}
else
{
    var periods = rowsData
        .Where(r => r.BillYear > 0 && r.BillMonth > 0)
        .Select(r => (Year: r.BillYear, Month: r.BillMonth))
        .Distinct()
        .OrderBy(p => p.Year).ThenBy(p => p.Month)
        .ToList();
    var years = periods.Select(p => p.Year).Distinct().OrderBy(y => y).ToList();

    var pivotRows = rowsData
        .Where(r => r.BillYear > 0 && r.BillMonth > 0)
        .GroupBy(r => r.PanelName, StringComparer.OrdinalIgnoreCase)
        .Select(g => new
        {
            PanelName = g.Key,
            Cells = g.GroupBy(r => (Year: r.BillYear, Month: r.BillMonth))
                .ToDictionary(
                    cg => cg.Key,
                    cg => new
                    {
                        Count   = cg.Sum(x => x.NoOfClaims),
                        Payment = cg.Sum(x => x.InsurancePayments)
                    }),
            TotalCount   = g.Sum(x => x.NoOfClaims),
            TotalPayment = g.Sum(x => x.InsurancePayments)
        })
        .OrderByDescending(r => Model.IsAugustusLab ? r.TotalCount : r.TotalPayment)
        .ToList();

    <div class="cs-rpt-wrap">
        <div class="cs-rpt-scroll">
            <table class="cs-rpt-table">
                <thead>
                    <tr>
                        <th rowspan="3">Panel</th>
                        @foreach (var year in years)
                        {
                            var yearMonthCount = periods.Count(p => p.Year == year);
                            <th colspan="@(yearMonthCount * 2 + 2)">@year</th>
                        }
                        <th colspan="2" rowspan="2" class="cs-pr-grand">Grand Total</th>
                    </tr>
                    <tr>
                        @foreach (var year in years)
                        {
                            foreach (var p in periods.Where(p => p.Year == year))
                            {
                                var monthLabel = new DateTime(p.Year, p.Month, 1).ToString("MMM");
                                <th colspan="2">@monthLabel</th>
                            }
                            <th colspan="2" class="cs-pr-year">@year Total</th>
                        }
                    </tr>
                    <tr>
                        @foreach (var year in years)
                        {
                            foreach (var _ in periods.Where(p => p.Year == year))
                            {
                                <th>Count of Panel Name</th>
                                <th>Sum of CarrierPayment</th>
                            }
                            <th class="cs-pr-year">Count of Panel Name</th>
                            <th class="cs-pr-year">Sum of CarrierPayment</th>
                        }
                        <th class="cs-pr-grand">Count of Panel Name</th>
                        <th class="cs-pr-grand">Sum of CarrierPayment</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in pivotRows)
                    {
                        <tr>
                            <td style="text-align:left;font-weight:600">@row.PanelName</td>
                            @foreach (var year in years)
                            {
                                var yearCount = 0;
                                var yearPayment = 0m;
                                foreach (var p in periods.Where(p => p.Year == year))
                                {
                                    row.Cells.TryGetValue((p.Year, p.Month), out var cell);
                                    var count = cell?.Count ?? 0;
                                    var payment = cell?.Payment ?? 0m;
                                    yearCount += count;
                                    yearPayment += payment;
                                    <td style="text-align:right">@count.N0OrDash()</td>
                                    <td style="text-align:right">@Acct2(payment)</td>
                                }
                                <td style="text-align:right;font-weight:700" class="cs-pr-year">@yearCount.N0OrDash()</td>
                                <td style="text-align:right;font-weight:700" class="cs-pr-year">@Acct2(yearPayment)</td>
                            }
                            <td style="text-align:right;font-weight:700" class="cs-pr-grand">@row.TotalCount.N0OrDash()</td>
                            <td style="text-align:right;font-weight:700" class="cs-pr-grand">@Acct2(row.TotalPayment)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="background:linear-gradient(135deg,#0a1628 0%,#0e3460 50%,#0d5c74 100%);color:#fff;font-weight:700">
                        <td style="text-align:left;color:#fff">Grand Total</td>
                        @foreach (var year in years)
                        {
                            var yearCount = 0;
                            var yearPayment = 0m;
                            foreach (var p in periods.Where(p => p.Year == year))
                            {
                                var monthRows = rowsData.Where(r => r.BillYear == p.Year && r.BillMonth == p.Month);
                                var count = monthRows.Sum(r => r.NoOfClaims);
                                var payment = monthRows.Sum(r => r.InsurancePayments);
                                yearCount += count;
                                yearPayment += payment;
                                <td style="text-align:right;color:#fff">@count.N0OrDash()</td>
                                <td style="text-align:right;color:#fff">@Acct2(payment)</td>
                            }
                            <td style="text-align:right;color:#fff" class="cs-pr-year">@yearCount.N0OrDash()</td>
                            <td style="text-align:right;color:#fff" class="cs-pr-year">@Acct2(yearPayment)</td>
                        }
                        <td style="text-align:right;color:#fff" class="cs-pr-grand">@pivotRows.Sum(r => r.TotalCount).N0OrDash()</td>
                        <td style="text-align:right;color:#fff" class="cs-pr-grand">@Acct2(pivotRows.Sum(r => r.TotalPayment))</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="mt-2" style="font-size:.68rem; color:#94a3b8">
        <strong>Source:</strong> @(Model.IsAugustusLab ? "Collection Claim Level Data" : "Aggregate snapshot table") <code>@(Model.IsAugustusLab ? "usp_GetAug_CS_PanelVsPayment_v2" : "{prefix}_CS_PanelVsPayment")</code> &bull;
        <strong>Grain:</strong> PanelNew &times; @(Model.IsAugustusLab ? "Posted Date" : "CheckDate") Year/Month
        @(Model.IsAugustusLab ? " · Count of PanelNew, SUM(Ins. Pay)" : "")
    </div>
}
