@model LabMetricsDashboard.Models.CollectionSummaryViewModel
            @if (Model.CptPaymentPct.Any(r => r.IsPanelRow))
            {
                // Panel -> CPT hierarchy from the SP (rows already sorted by claim count).
                var hierRows = Model.CptPaymentPct;
                var hierGrandClaims = hierRows.Where(r => r.IsPanelRow).Sum(r => r.SumServiceUnits);
                var hierGrandPct = hierRows[0].TotalPaymentPctFromSp ?? 0m;
                var hierMaxPct = hierRows.Max(r => r.PaymentPct);
                <div class="cs-rpt-wrap">
                    <div class="cs-rpt-scroll">
                        <table class="cs-rpt-table">
                            <thead>
                                <tr>
                                    <th>Panel name / CPT Code</th>
                                    <th>Claim Count</th>
                                    <th>Average Payment %</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in hierRows)
                                {
                                    var pct = row.PaymentPct;
                                    var barWidth = hierMaxPct == 0 ? 0m : Math.Round(pct / hierMaxPct * 100m, 1);
                                    <tr style="@(row.IsPanelRow ? "background:#eef4fb" : "")">
                                        <td style="text-align:left;@(row.IsPanelRow ? "font-weight:700" : "padding-left:2rem")">@row.CptCode</td>
                                        <td style="text-align:right;@(row.IsPanelRow ? "font-weight:700" : "")">@row.SumServiceUnits.N0OrDash()</td>
                                        <td>
                                            <div class="reimb-bar-bg">
                                                <div class="reimb-bar-fill" style="width:@(barWidth.ToString("F1"))%"></div>
                                                <div class="reimb-bar-label">@pct.ToString("F2") %</div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr style="background:linear-gradient(135deg,#0a1628 0%,#0e3460 50%,#0d5c74 100%);color:#fff;font-weight:700">
                                    <td style="text-align:left;color:#fff">Grand Total</td>
                                    <td style="text-align:right;color:#fff">@hierGrandClaims.N0OrDash()</td>
                                    <td style="text-align:right;color:#fff">@hierGrandPct.ToString("F2") %</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="mt-2" style="font-size:.68rem; color:#94a3b8">
                    <strong>Source:</strong> Claim Level Data &bull;
                    <strong>Filter (applied):</strong> Payers: @(Model.FilterPayerNames != null && Model.FilterPayerNames.Count > 0 ? string.Join(", ", Model.FilterPayerNames) : "All") &nbsp;|&nbsp; Panels: @(Model.FilterPanelNames != null && Model.FilterPanelNames.Count > 0 ? string.Join(", ", Model.FilterPanelNames) : "All") &bull;
                    <strong>Rows:</strong> Panel name &rarr; CPT Code &bull; <strong>Sorted by:</strong> Claim Count DESC &bull;
                    <strong>Values:</strong> Count of unique ClaimID, Average of PaymentPercent
                </div>
            }
            else if (Model.CptPaymentPct.Count > 0)
            {
                var cptGrandUnits   = Model.CptPaymentPct.Sum(r => r.SumServiceUnits);
                var cptGrandPaidIns = Model.CptPaymentPct.Sum(r => r.PaidInsurancePayment);
                var cptGrandPaidChg = Model.CptPaymentPct.Sum(r => r.PaidChargeAmount);

                // When the aggregate snapshot stores 0/0 for PaidInsurancePayment/PaidChargeAmount
                // fall back to a units-weighted average of each row's PaymentPct.
                decimal cptGrandPct;
                if (cptGrandPaidChg != 0)
                {
                    cptGrandPct = Math.Round(cptGrandPaidIns / cptGrandPaidChg * 100m, 2);
                }
                else
                {
                    var weightedSum = Model.CptPaymentPct.Sum(r => r.PaymentPct * r.SumServiceUnits);
                    cptGrandPct = cptGrandUnits == 0 ? 0m : Math.Round(weightedSum / cptGrandUnits, 2);
                }
                var cptMaxPct = Model.CptPaymentPct.Max(r => r.PaymentPct);
                var isInHealthCpt = Model.IsInHealthDtrLab;
                <div class="cs-rpt-wrap">
                    <div class="cs-rpt-scroll">
                        <table class="cs-rpt-table">
                            <thead>
                                <tr>
                                    <th>CPT Code</th>
                                    <th>@(isInHealthCpt ? "Count of ClaimID" : "Sum of Service Units")</th>
                                    <th>@(isInHealthCpt ? "Average of PaymentPercent" : "Payment %")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.CptPaymentPct)
                                {
                                    var pct = row.PaymentPct;
                                    var barWidth = cptMaxPct == 0 ? 0m : Math.Round(pct / cptMaxPct * 100m, 1);
                                    <tr>
                                        <td style="text-align:left;font-weight:600">@row.CptCode</td>
                                        <td style="text-align:right">@row.SumServiceUnits.N0OrDash()</td>
                                        <td>
                                            <div class="reimb-bar-bg">
                                                <div class="reimb-bar-fill" style="width:@(barWidth.ToString("F1"))%"></div>
                                                <div class="reimb-bar-label">@pct.ToString("F2") %</div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr style="background:linear-gradient(135deg,#0a1628 0%,#0e3460 50%,#0d5c74 100%);color:#fff;font-weight:700">
                                    <td style="text-align:left;color:#fff">Grand Total</td>
                                    <td style="text-align:right;color:#fff">@cptGrandUnits.N0OrDash()</td>
                                    <td style="text-align:right;color:#fff">@cptGrandPct.ToString("F2") %</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="mt-2" style="font-size:.68rem; color:#94a3b8">
                    <strong>Source:</strong> Line Level Data &bull;
                    <strong>Filter (applied):</strong> Payers: @(Model.FilterPayerNames != null && Model.FilterPayerNames.Count > 0 ? string.Join(", ", Model.FilterPayerNames) : "All") &nbsp;|&nbsp; Panels: @(Model.FilterPanelNames != null && Model.FilterPanelNames.Count > 0 ? string.Join(", ", Model.FilterPanelNames) : "All") &nbsp;|&nbsp; FirstBilledDate: @(string.IsNullOrWhiteSpace(Model.FilterFirstBillFrom) ? "-" : Model.FilterFirstBillFrom) — @(string.IsNullOrWhiteSpace(Model.FilterFirstBillTo) ? "-" : Model.FilterFirstBillTo) &bull;
                    @if (isInHealthCpt)
                    {
                        <span><strong>Rows:</strong> CPTCode &bull; <strong>Sorted by:</strong> Count of ClaimID DESC &bull; <strong>Payment %:</strong> Average of PaymentPercent</span>
                    }
                    else
                    {
                        <span><strong>Sorted by:</strong> SUM(Units) DESC &bull;
                        <strong>Payment %:</strong> SUM(InsurancePayment) / SUM(ChargeAmount) × 100 where ClaimStatus IN (Fully Paid, Partially Paid)</span>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <div style="font-size:2rem;opacity:.4">&#128202;</div>
                    <div class="fw-semibold mt-2">No CPT payment data available</div>
                    <div class="small mt-1"><strong>Reason:</strong> No rows match: CPTCode not blank (line-level). Try adjusting your filters.</div>
                </div>
            }
