@model LabMetricsDashboard.Models.CollectionSummaryViewModel
@if (Model.WeeklyClaimVolume.HasData)
{
    var wcvPivot = Model.WeeklyClaimVolume;
    var wcvWeeks = wcvPivot.Weeks;
    var wcvMinWidth = 200 + (wcvWeeks.Count * 120) + 158;

    int WcvCellEnc(Dictionary<string, CollectionMonthlyCell>? d, string wk)
        => d is not null && d.TryGetValue(wk, out var c) ? c.EncounterCount : 0;
    decimal WcvCellPaid(Dictionary<string, CollectionMonthlyCell>? d, string wk)
        => d is not null && d.TryGetValue(wk, out var c) ? c.InsurancePaidAmount : 0m;

    <div class="cs-rpt-wrap">
        <div class="cs-rpt-scroll">
            <table class="cs-pr-table" style="min-width:@(wcvMinWidth)px;">
                <colgroup>
                    <col style="width:200px" />
                    @foreach (var _ in wcvWeeks)
                    {
                        <col style="width:52px" />
                        <col style="width:68px" />
                    }
                    <col style="width:72px" />
                    <col style="width:86px" />
                </colgroup>
                <thead>
                    <tr>
                        <th rowspan="3">Panel &amp; Insurance</th>
                        <th colspan="@(wcvWeeks.Count * 2)">Data based on Last 4 Week &mdash; Posting Date</th>
                        <th colspan="2" class="cs-pr-grand">Grand Total</th>
                    </tr>
                    <tr>
                        @foreach (var w in wcvWeeks)
                        {
                            <th colspan="2">@w.Label</th>
                        }
                        <th colspan="2" class="cs-pr-grand"></th>
                    </tr>
                    <tr>
                        @foreach (var w in wcvWeeks)
                        {
                            <th class="cs-pr-metric">No. of Claims</th>
                            <th class="cs-pr-metric">Insurance Paid Amount</th>
                        }
                        <th class="cs-pr-grand">No. of Claims</th>
                        <th class="cs-pr-grand">Insurance Paid Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var wcvIdx = 0; }
                    @foreach (var panel in wcvPivot.PanelRows)
                    {
                        wcvIdx++;
                        var letter = wcvIdx <= 26 ? ((char)('A' + wcvIdx - 1)).ToString() : wcvIdx.ToString();
                        var wcvGroupId = $"cs-wcv-{wcvIdx}";
                        <tr class="cs-pr-panel cs-ag-group" data-ag-group="@wcvGroupId" role="button"
                            aria-expanded="false" title="Open / close payers">
                            <td>
                                <i class="bi bi-chevron-right cs-ag-chevron" aria-hidden="true"></i>@letter &nbsp; @panel.PanelName
                            </td>
                            @foreach (var w in wcvWeeks)
                            {
                                <td class="cs-pr-metric">@WcvCellEnc(panel.ByWeek, w.Key).ToString("N0")</td>
                                <td class="cs-pr-metric">@Acct(WcvCellPaid(panel.ByWeek, w.Key))</td>
                            }
                            <td class="cs-pr-grand">@panel.TotalEncounters.ToString("N0")</td>
                            <td class="cs-pr-grand">@Acct(panel.TotalInsurancePaid)</td>
                        </tr>
                        @foreach (var payer in panel.TopPayers)
                        {
                            <tr class="cs-pr-payer cs-ag-child" data-ag-parent="@wcvGroupId">
                                <td>
                                    @if (payer.PayerRank > 0)
                                    {
                                        <span class="mcv-payer-rank">@payer.PayerRank</span>
                                    }
                                    @payer.PayerName
                                </td>
                                @foreach (var w in wcvWeeks)
                                {
                                    <td class="cs-pr-metric">@WcvCellEnc(payer.ByWeek, w.Key).ToString("N0")</td>
                                    <td class="cs-pr-metric">@Acct(WcvCellPaid(payer.ByWeek, w.Key))</td>
                                }
                                <td class="cs-pr-grand">@payer.TotalEncounters.ToString("N0")</td>
                                <td class="cs-pr-grand">@Acct(payer.TotalInsurancePaid)</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td>Grand Total</td>
                        @foreach (var w in wcvWeeks)
                        {
                            <td class="cs-pr-metric">@WcvCellEnc(wcvPivot.GrandTotalByWeek, w.Key).ToString("N0")</td>
                            <td class="cs-pr-metric">@Acct(WcvCellPaid(wcvPivot.GrandTotalByWeek, w.Key))</td>
                        }
                        <td>@wcvPivot.GrandTotalEncounters.ToString("N0")</td>
                        <td>@Acct(wcvPivot.GrandTotalInsurancePaid)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="mt-2" style="font-size:.68rem; color:#94a3b8">
        <strong>Source:</strong> @(Model.UsesLineEncounters ? "Line Level Data (encounters) + Claim Level Data (payments)" : "Claim Level Data") &bull;
        <strong>Filter:</strong> InsurancePayment &gt; 0, ClaimStatus IN (Fully Paid, Partially Paid, Paid-Client) &bull;
        <strong>Rows:</strong> PanelName &bull;
        <strong>Drill-down:</strong> @(Model.UsesLineEncounters ? "All Payers" : "Top 3 PayerName") by @(Model.UsesLineEncounters ? "Encounter Count" : "Paid Claims Count") &bull;
        <strong>Columns:</strong> Last 4 Weeks (PostingDate) — No. of Claims + Insurance Paid Amount &bull;
        <strong>Sorted by:</strong> Grand Total @(Model.UsesLineEncounters ? "Encounters" : "Paid Claims") DESC
    </div>
}
else
{
    <div class="text-center py-5 text-muted">
        <div style="font-size:2rem;opacity:.4">&#128202;</div>
        <div class="fw-semibold mt-2">No weekly claim volume data available</div>
        <div class="small mt-1">No matching claim records found for the last 4 weeks. Try adjusting your filters.</div>
    </div>
}
