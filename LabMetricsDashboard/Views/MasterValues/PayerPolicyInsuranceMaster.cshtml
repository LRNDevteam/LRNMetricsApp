@model LabMetricsDashboard.Models.MasterValuesPageViewModel
@{
    ViewData["Title"] = "Payer Policy Insurance Master";
}

<style>
    .mv-shell { display: flex; flex-direction: column; gap: 1rem; }
    .mv-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .mv-title h2 { margin: 0; font-size: 1.45rem; font-weight: 800; color: #162033; }
    .mv-title small { color: #64748b; font-weight: 600; }
    .mv-actions { display: flex; gap: .5rem; flex-wrap: wrap; }
    .mv-card { background: #fff; border: 1px solid #d9e2ef; border-radius: 8px; box-shadow: 0 6px 18px rgba(15, 23, 42, .06); }
    .mv-filter { padding: 1rem; }
    .mv-filter .form-label { margin-bottom: .25rem; font-size: .74rem; color: #475569; font-weight: 800; text-transform: uppercase; }
    .mv-filter .form-control, .mv-filter .form-select { min-height: 38px; font-size: .9rem; }
    .mv-filter .btn { white-space: nowrap; min-height: 38px; }
    .mv-perm-strip { font-size: .8rem; color: #64748b; background: #fff; border: 1px dashed #d9e2ef; border-radius: 8px; padding: .5rem .85rem; }
    .mv-perm-strip b { color: #1F3B57; }
    .mv-grid-wrap { position: relative; }
    .mv-grid-scroll { overflow: auto; overflow-x: auto; max-height: calc(100vh - 315px); min-height: 315px; }
    .mv-table { min-width: 1900px; font-size: .8rem; }
    .mv-table th, .mv-table td { border: 1px solid #d8e1ee; }
    .mv-table thead th { position: sticky; top: 0; z-index: 2; background: #f8fafc; color: #0f172a; border-bottom: 1px solid #b8c5d6; white-space: nowrap; font-size: .74rem; text-transform: uppercase; letter-spacing: .02em; }
    .mv-table thead th.sortable { cursor: pointer; user-select: none; }
    .mv-table thead th.sortable:hover { background: #eef6ff; color: #0b5ed7; }
    .mv-sort { color: #64748b; font-size: .72rem; margin-left: .25rem; }
    .mv-table thead th.sorted .mv-sort { color: #0b5ed7; }
    .mv-table tbody td { white-space: normal; word-break: break-word; vertical-align: top; min-width: 90px; }
    .mv-table tbody tr:hover td { background: #f8fbff; }
    /* Actions column: only as wide as its buttons, pinned right while scrolling horizontally */
    .mv-table th:last-child, .mv-table td:last-child { position: sticky; right: 0; width: 1%; min-width: 0; white-space: nowrap; box-shadow: -6px 0 8px -6px rgba(15, 23, 42, .18); }
    .mv-table td:last-child { background: #fff; z-index: 1; vertical-align: middle; }
    .mv-table thead th:last-child { z-index: 3; }
    .mv-table tbody tr:hover td:last-child { background: #f8fbff; }
    .mv-primary { font-weight: 800; color: #0f172a; }
    .mv-badge { display: inline-flex; align-items: center; border-radius: 999px; padding: .15rem .5rem; font-size: .72rem; font-weight: 800; background: #eef2f7; color: #334155; }
    .mv-badge.on { background: #dcfce7; color: #166534; }
    .mv-badge.off { background: #fee2e2; color: #991b1b; }
    .mv-loader { display: none; position: absolute; inset: 0; z-index: 5; align-items: center; justify-content: center; background: rgba(248, 250, 252, .74); backdrop-filter: blur(1px); }
    .mv-loader.active { display: flex; }
    .mv-loader-box { background: #0f172a; color: white; border-radius: 8px; padding: .75rem 1rem; display: inline-flex; gap: .7rem; align-items: center; box-shadow: 0 18px 40px rgba(15, 23, 42, .22); }
    .mv-empty { padding: 4rem 1rem; text-align: center; color: #64748b; }
    .mv-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .75rem 1rem; border-top: 1px solid #e2e8f0; flex-wrap: wrap; }
    .mv-readonly-tag { background: #eef2f7; color: #64748b; font-size: .66rem; padding: 1px 6px; border-radius: 4px; margin-left: 6px; font-weight: 600; }
    .mv-warning-banner { background: #FDF3E3; border: 1px solid #F0D9A8; color: #8A5A0B; padding: .55rem .75rem; border-radius: 6px; font-size: .8rem; margin-bottom: .85rem; }
    .mv-info-banner { background: #E8F1F9; border: 1px solid #C6DCEE; color: #1F3B57; padding: .55rem .75rem; border-radius: 6px; font-size: .8rem; margin-bottom: .85rem; }
    .mv-deactivated-note { color: #9AA5B1; font-size: .76rem; }
</style>

<div class="mv-shell">
    <div class="mv-header">
        <div class="mv-title">
            <h2>Payer Policy Insurance Master</h2>
            <small>Source: Payer Policy database &mdash; unique list of payers used in payer policy validation.</small>
        </div>
        <div class="mv-actions">
            @if (Model.CanWrite)
            {
                <button type="button" class="btn btn-primary" id="addBtn"><i class="bi bi-plus-lg"></i> Add Payer</button>
            }
            @if (Model.CanWrite && !Model.RequiresApproval)
            {
                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#importModal"><i class="bi bi-upload"></i> Bulk Upload</button>
            }
            <button type="button" class="btn btn-outline-success" id="exportBtn"><i class="bi bi-file-earmark-excel"></i> Export Excel</button>
        </div>
    </div>

    <div class="mv-perm-strip">
        @if (Model.RequiresApproval)
        {
            <b>@Model.RoleLabel:</b> <text>add, edit, and deactivate actions are routed to LRN Admin / Payer Policy Admin for approval before they take effect.</text>
        }
        else if (Model.IsViewOnly)
        {
            <b>@Model.RoleLabel:</b> <text>view-only access. Add, edit, and deactivate controls are hidden.</text>
        }
        else
        {
            <b>@Model.RoleLabel:</b> <text>add, edit, and deactivate are applied immediately, no approval required.</text>
        }
    </div>

    <div class="mv-card mv-filter">
        <form id="filterForm" class="row g-3 align-items-end">
            <div class="col-lg-3 col-md-6"><label class="form-label">Search</label><input class="form-control" name="search" placeholder="Payer name, code, normalized name..." /></div>
            <div class="col-lg-2 col-md-6"><label class="form-label">Plan Type</label><select class="form-select" name="planType"><option value="">All Plan Types</option><option>Medicare</option><option>Medicaid</option><option>Commercial</option><option>Managed Care</option><option>Other</option></select></div>
            <div class="col-lg-2 col-md-6"><label class="form-label">Status</label><select class="form-select" name="isActive"><option value="">All Status</option><option>Active</option><option>Inactive</option></select></div>
            <div class="col-lg-2 col-md-6"><label class="form-label">Global Payer ID</label><input class="form-control" name="globalPayerId" type="number" /></div>
            <div class="col-lg-3 col-md-6 d-flex gap-2 justify-content-end align-items-end flex-nowrap">
                <button class="btn btn-primary" type="submit" id="searchBtn"><i class="bi bi-search"></i> Search</button>
                <button class="btn btn-outline-secondary" type="button" id="resetBtn"><i class="bi bi-arrow-counterclockwise"></i> Reset</button>
            </div>
        </form>
    </div>

    <div class="mv-card mv-grid-wrap">
        <div class="mv-loader" id="gridLoader"><div class="mv-loader-box"><span class="spinner-border spinner-border-sm"></span><span id="busyText">Loading records...</span></div></div>
        <div class="mv-grid-scroll">
            <table class="table table-sm table-hover table-bordered align-middle mv-table mb-0">
                <thead><tr><th class="sortable" data-sort="globalPayerId">Global Payer ID <span class="mv-sort"></span></th><th class="sortable" data-sort="globalPayerCode">Global Payer Code <span class="mv-sort"></span></th><th class="sortable" data-sort="payerName">Payer Name <span class="mv-sort"></span></th><th class="sortable" data-sort="payerNameNormalized">Normalized <span class="mv-sort"></span></th><th class="sortable" data-sort="payerFamily">Payer Family <span class="mv-sort"></span></th><th class="sortable" data-sort="payerFamilySource">Family Source <span class="mv-sort"></span></th><th class="sortable" data-sort="payerShortCode">Short Code <span class="mv-sort"></span></th><th class="sortable" data-sort="payerGroupCode">Group Code <span class="mv-sort"></span></th><th class="sortable" data-sort="planType">Plan Type <span class="mv-sort"></span></th><th class="sortable" data-sort="payerState">Payer State <span class="mv-sort"></span></th><th class="sortable" data-sort="isActive">Status <span class="mv-sort"></span></th><th class="sortable" data-sort="benefitAdminCode">Benefit Code <span class="mv-sort"></span></th><th class="sortable" data-sort="benefitAdministrator">Benefit Manager <span class="mv-sort"></span></th><th class="sortable" data-sort="remarks">Remarks <span class="mv-sort"></span></th><th class="text-end">Actions</th></tr></thead>
                <tbody id="rows"></tbody>
            </table>
        </div>
        <div class="mv-footer">
            <small id="pageInfo" class="text-muted"></small>
            <div class="d-flex align-items-center gap-2">
                <label class="text-muted" style="font-size:.78rem;font-weight:700;">Page size</label>
                <select id="pageSizeSel" class="form-select form-select-sm" style="width:auto;"><option>10</option><option selected>20</option><option>50</option><option>100</option><option>500</option><option>1000</option></select>
                <div class="btn-group"><button class="btn btn-outline-secondary btn-sm" id="prevBtn">Previous</button><button class="btn btn-outline-secondary btn-sm" id="nextBtn">Next</button></div>
            </div>
        </div>
    </div>
    <p class="mv-deactivated-note mb-0">Global Payer ID is system auto-generated and assigned only once a new payer record is approved; it is never reused, including after deactivation. Deactivated payers cannot be reactivated &mdash; re-add as a new record.</p>
</div>

@if (Model.CanWrite)
{
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="editTitle">Add Payer &mdash; Payer Policy Insurance Master</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mv-warning-banner d-none" id="dupWarning"></div>
                <form id="editForm" class="row g-3">
                    <input type="hidden" id="id" />
                    <div class="col-md-6"><label class="form-label">Payer Name *</label><input class="form-control" name="payerNameRaw" required placeholder="e.g., AETNA" /></div>
                    <div class="col-md-6"><label class="form-label">Payer Name Normalized <span class="mv-readonly-tag">Read-only, system-generated</span></label><input class="form-control" name="payerNameNormalized" readonly tabindex="-1" /></div>
                    <div class="col-md-4"><label class="form-label">Global Payer Code *</label><input class="form-control" name="globalPayerCode" required placeholder="e.g., GPC-AETNA" /></div>
                    <div class="col-md-4"><label class="form-label">Global Payer ID <span class="mv-readonly-tag">Auto-assigned on approval</span></label><input class="form-control" name="globalPayerId" readonly tabindex="-1" placeholder="Assigned after approval" /></div>
                    <div class="col-md-4"><label class="form-label">Payer Short Code</label><input class="form-control" name="payerShortCode" placeholder="Optional" /></div>
                    <div class="col-md-4"><label class="form-label">Payer Group Code</label><input class="form-control" name="payerGroupCode" type="number" placeholder="Optional (numeric)" /></div>
                    <div class="col-md-4"><label class="form-label">Plan Type *</label><select class="form-select" name="planType" required><option value="">Select...</option><option>Medicare</option><option>Medicaid</option><option>Commercial</option><option>Managed Care</option><option>Other</option></select></div>
                    <div class="col-md-4"><label class="form-label">Payer State *</label><select class="form-select" name="payerState" required><option value="">Select...</option></select></div>
                    <div class="col-md-4"><label class="form-label">Benefit Manager</label><select class="form-select" name="benefitAdministrator"><option value=""></option><option>Optum</option><option>Evernorth</option><option>CVS Caremark</option></select></div>
                    <div class="col-md-4"><label class="form-label">Benefit Manager Code</label><input class="form-control" name="benefitAdminCode" placeholder="Optional" /></div>
                    <div class="col-md-4"><label class="form-label">Is Active <span class="mv-readonly-tag">System-managed</span></label><input class="form-control" name="isActive" readonly tabindex="-1" /></div>
                    <div class="col-md-12"><label class="form-label">Remarks</label><textarea class="form-control" name="remarks" rows="2" placeholder="Optional notes"></textarea></div>
                </form>
                @if (Model.RequiresApproval)
                {
                    <div class="mv-info-banner mt-3 mb-0">You are submitting as <b>Reports Analyst</b>. This action will be routed to LRN Admin / Payer Policy Admin for approval before it is saved.</div>
                }
                <div id="saveError" class="alert alert-danger mt-3 d-none"></div>
            </div>
            <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="saveBtn">Submit</button></div>
        </div>
    </div>
</div>

@if (!Model.RequiresApproval)
{
<div class="modal fade" id="importModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Bulk Upload &mdash; Policy Payers</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="alert alert-info py-2">Upload PayerPolicy Insurance Master Excel with sheet <strong>PP_Ins.Master</strong>.</div>
                <input class="form-control" type="file" id="importFile" accept=".xlsx" />
                <div id="importResult" class="mt-3 small"></div>
            </div>
            <div class="modal-footer"><button class="btn btn-primary" id="importBtn"><i class="bi bi-upload"></i> Import</button></div>
        </div>
    </div>
</div>
}
}

@section Scripts {
<script nonce='@Context.Items["CspNonce"]'>
(function(){
const canWrite=@(Model.CanWrite ? "true" : "false"),requiresApproval=@(Model.RequiresApproval ? "true" : "false");
let page=1,pageSize=20,totalPages=1,sortColumn='',sortDirection='asc',currentItems=[];
const urls={data:'@Url.Action("PolicyPayersData","MasterValues")',get:'@Url.Action("PolicyPayer","MasterValues")',save:'@Url.Action("SavePolicyPayer","MasterValues")',status:'@Url.Action("PolicyStatus","MasterValues")',import:'@Url.Action("ImportPolicy","MasterValues")',export:'@Url.Action("ExportPolicy","MasterValues")'};
const US_STATES=['AL','AK','AZ','AR','CA','CO','CT','DE','DC','FL','GA','HI','ID','IL','IN','IA','KS','KY','LA','ME','MD','MA','MI','MN','MS','MO','MT','NE','NV','NH','NJ','NM','NY','NC','ND','OH','OK','OR','PA','RI','SC','SD','TN','TX','UT','VT','VA','WA','WV','WI','WY'];
const COLS=15;
const editModal=canWrite?new bootstrap.Modal(document.getElementById('editModal')):null;
const loader=document.getElementById('gridLoader'),busyText=document.getElementById('busyText');
function esc(v){return (v??'').toString().replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}
function normalize(v){return (v||'').toString().toUpperCase().replace(/[^A-Z0-9]+/g,' ').replace(/\s+/g,' ').trim();}
function isInactiveVal(v){return /inactive|^no$|^false$|^0$|^n$/i.test((v||'').toString().trim());}
function isActiveVal(v){return !isInactiveVal(v);} // blank/unknown counts as active so rows are never left without actions
function qs(){const fd=new FormData(document.getElementById('filterForm'));fd.set('page',page);fd.set('pageSize',pageSize);if(sortColumn){fd.set('sortColumn',sortColumn);fd.set('sortDirection',sortDirection);}return new URLSearchParams(fd).toString();}
function updateSortHeaders(){document.querySelectorAll('th.sortable').forEach(th=>{const active=th.dataset.sort===sortColumn;th.classList.toggle('sorted',active);th.querySelector('.mv-sort').textContent=active?(sortDirection==='asc'?'▲':'▼'):'↕';});}
function setBusy(on,text){busyText.textContent=text||'Working...';loader.classList.toggle('active',on);document.querySelectorAll('button,input,select,textarea').forEach(x=>{if(!x.closest('.modal.show')&&!x.closest('tr.mv-editing'))x.disabled=on;});}
function setBtn(btn,on,text){btn.disabled=on;if(on){btn.dataset.old=btn.innerHTML;btn.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>'+text;}else if(btn.dataset.old){btn.innerHTML=btn.dataset.old;delete btn.dataset.old;}}
async function errorText(r){try{const j=await r.json();return j.message||j.title||JSON.stringify(j);}catch{return await r.text();}}
function badge(v){if(v===null||v===undefined||v==='')return '—';const off=isInactiveVal(v);return `<span class="mv-badge ${off?'off':'on'}">${esc(v)}</span>`;}
function rowActions(x){
  if(!canWrite)return '';
  // Edit is always available; Deactivate only while the record is still active.
  const deact=isActiveVal(x.isActive)?` <button class="btn btn-sm btn-outline-danger stat" data-id="${x.ppInsuranceMasterId}" data-name="${esc(x.payerNameRaw)}" title="Deactivate"><i class="bi bi-slash-circle"></i></button>`:'';
  return `<button class="btn btn-sm btn-outline-primary edit" data-id="${x.ppInsuranceMasterId}" title="Edit"><i class="bi bi-pencil"></i> Edit</button>${deact}`;
}
function rowHtml(x){
  return `<tr data-id="${x.ppInsuranceMasterId}"><td>${esc(x.globalPayerId??'—')}</td><td class="mv-primary">${esc(x.globalPayerCode)}</td><td class="mv-primary">${esc(x.payerNameRaw)}</td><td>${esc(x.payerNameNormalized)}</td><td>${esc(x.payerFamily)}</td><td>${esc(x.payerFamilySource)}</td><td>${esc(x.payerShortCode)}</td><td>${esc(x.payerGroupCode)}</td><td>${esc(x.planType)}</td><td>${esc(x.payerState)}</td><td>${badge(x.isActive)}</td><td>${esc(x.benefitAdminCode)}</td><td>${esc(x.benefitAdministrator)}</td><td>${esc(x.remarks)}</td><td class="text-end text-nowrap">${rowActions(x)}</td></tr>`;
}
function renderRows(items){currentItems=items||[];document.getElementById('rows').innerHTML=currentItems.map(rowHtml).join('')||`<tr><td colspan="${COLS}"><div class="mv-empty"><div class="fw-bold">No records found</div><div>Adjust filters or import the master file.</div></div></td></tr>`;}
async function load(){updateSortHeaders();const query=qs();setBusy(true,'Loading records...');try{const r=await fetch(urls.data+'?'+query);const d=await r.json();totalPages=d.totalPages||1;document.getElementById('pageInfo').textContent=`Page ${d.page||1} of ${totalPages} - ${d.totalCount||0} records`;renderRows(d.items);}catch(e){document.getElementById('rows').innerHTML=`<tr><td colspan="${COLS}"><div class="mv-empty text-danger">Unable to load records.</div></td></tr>`;}finally{setBusy(false);}}
document.getElementById('filterForm').onsubmit=e=>{e.preventDefault();page=1;load();};
document.querySelectorAll('th.sortable').forEach(th=>th.addEventListener('click',()=>{const col=th.dataset.sort;if(sortColumn===col){sortDirection=sortDirection==='asc'?'desc':'asc';}else{sortColumn=col;sortDirection='asc';}page=1;load();}));
document.getElementById('resetBtn').onclick=()=>{document.getElementById('filterForm').reset();page=1;load();};
document.getElementById('prevBtn').onclick=()=>{if(page>1){page--;load();}};
document.getElementById('nextBtn').onclick=()=>{if(page<totalPages){page++;load();}};
document.getElementById('pageSizeSel').onchange=e=>{pageSize=Number(e.target.value);page=1;load();};
document.getElementById('exportBtn').onclick=()=>{const btn=document.getElementById('exportBtn');setBtn(btn,true,'Exporting...');window.lmdExcelDownload(urls.export+'?'+qs());setTimeout(()=>setBtn(btn,false),1800);};

if(canWrite){
  const stateSelect=document.querySelector('#editForm [name=payerState]');
  US_STATES.forEach(s=>stateSelect.insertAdjacentHTML('beforeend',`<option>${s}</option>`));
  function setSelect(sel,value){if(value&&![...sel.options].some(o=>o.value===value))sel.insertAdjacentHTML('beforeend',`<option>${esc(value)}</option>`);sel.value=value||'';}
  function hideDup(){document.getElementById('dupWarning').classList.add('d-none');}
  function fill(x){
    const f=document.getElementById('editForm');f.reset();
    document.getElementById('id').value=x?.ppInsuranceMasterId||'';
    for(const e of f.elements){if(e.name&&x&&x[e.name]!==undefined&&e.tagName!=='SELECT')e.value=x[e.name]??'';}
    setSelect(f.elements.planType,x?.planType||'');
    setSelect(f.elements.payerState,x?.payerState||'');
    setSelect(f.elements.benefitAdministrator,x?.benefitAdministrator||'');
    f.elements.payerNameNormalized.value=x?normalize(x.payerNameRaw):'';
    f.elements.isActive.value=x?(x.isActive||'Active'):'Active';
    if(!x)f.elements.globalPayerId.value='';
    hideDup();document.getElementById('saveError').classList.add('d-none');
  }
  document.querySelector('#editForm [name=payerNameRaw]').addEventListener('input',e=>{document.querySelector('#editForm [name=payerNameNormalized]').value=normalize(e.target.value);hideDup();});
  async function findDuplicate(name,currentId){
    try{
      const r=await fetch(urls.data+'?'+new URLSearchParams({search:name,page:1,pageSize:100}));
      const d=await r.json();const norm=normalize(name);
      return (d.items||[]).find(x=>normalize(x.payerNameRaw)===norm&&isActiveVal(x.isActive)&&String(x.ppInsuranceMasterId)!==String(currentId||''));
    }catch{return null;}
  }
  document.getElementById('addBtn').onclick=()=>{fill(null);document.getElementById('editTitle').textContent='Add Payer — Payer Policy Insurance Master';editModal.show();};
  document.getElementById('rows').onclick=async e=>{
    const edit=e.target.closest('.edit'),stat=e.target.closest('.stat');
    if(edit){setBusy(true,'Opening record...');try{const r=await fetch(urls.get+'?id='+edit.dataset.id);fill(await r.json());document.getElementById('editTitle').textContent='Edit Payer — Payer Policy Insurance Master';editModal.show();}finally{setBusy(false);}}
    if(stat){
      const msg=requiresApproval
        ?`Deactivate "${stat.dataset.name}"?\n\nThis request will be routed to LRN Admin / Payer Policy Admin for approval. Deactivated payers cannot be reactivated.`
        :`Deactivate "${stat.dataset.name}"?\n\nDeactivated payers cannot be reactivated — re-adding requires a new record with a new Global Payer ID. A notification will be sent to review linked Lab Insurance Master record(s).`;
      if(!confirm(msg))return;
      setBusy(true,'Deactivating...');
      try{const r=await fetch(urls.status+`?id=${stat.dataset.id}&isActive=Inactive`,{method:'POST'});if(!r.ok){alert(await errorText(r));}else{const resp=await r.json().catch(()=>({}));if(resp.pendingApproval)alert('Deactivation request submitted. It will take effect once approved by LRN Admin / Payer Policy Admin.');}await load();}finally{setBusy(false);}
    }
  };
  document.getElementById('saveBtn').onclick=async()=>{
    const btn=document.getElementById('saveBtn'),f=document.getElementById('editForm');
    if(!f.reportValidity())return;
    const data=Object.fromEntries(new FormData(f));
    data.payerNameNormalized=normalize(data.payerNameRaw);
    data.globalPayerId=data.globalPayerId?Number(data.globalPayerId):null;
    data.payerGroupCode=data.payerGroupCode?Number(data.payerGroupCode):null;
    const id=document.getElementById('id').value;
    setBtn(btn,true,'Checking...');
    const dup=await findDuplicate(data.payerNameRaw,id);
    setBtn(btn,false);
    if(dup){
      const w=document.getElementById('dupWarning');
      w.innerHTML=`⚠ A payer with the same normalized name already exists ("${esc(dup.payerNameRaw)}"${dup.globalPayerId?', Global Payer ID '+esc(dup.globalPayerId):''}). Review before continuing.`;
      w.classList.remove('d-none');return;
    }
    setBtn(btn,true,'Saving...');
    try{
      const r=await fetch(urls.save+(id?'?id='+id:''),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
      if(!r.ok){document.getElementById('saveError').textContent=await errorText(r);document.getElementById('saveError').classList.remove('d-none');return;}
      const resp=await r.json().catch(()=>({}));
      editModal.hide();
      if(resp.pendingApproval)alert('Your request was submitted and routed to LRN Admin / Payer Policy Admin for approval. It will appear in the master once approved.');
      await load();
    }finally{setBtn(btn,false);}
  };
  const importBtn=document.getElementById('importBtn');
  if(importBtn)importBtn.onclick=async()=>{const btn=importBtn,file=document.getElementById('importFile').files[0];if(!file)return;const fd=new FormData();fd.append('file',file);setBtn(btn,true,'Importing...');document.getElementById('importResult').innerHTML='<span class="text-muted">Import running. Please keep this window open.</span>';try{const r=await fetch(urls.import,{method:'POST',body:fd});const d=await r.json();document.getElementById('importResult').innerHTML=`<div class="alert alert-light border mb-0"><strong>Total:</strong> ${d.totalRows||0} &nbsp; <strong>Inserted:</strong> ${d.insertedRows||0} &nbsp; <strong>Updated:</strong> ${d.updatedRows||0} &nbsp; <strong>Skipped:</strong> ${d.skippedRows||0} &nbsp; <strong>Errors:</strong> ${d.errorRows||0}<div class="mt-2 text-warning">${(d.warnings||[]).map(esc).slice(0,8).join('<br>')}</div><div class="mt-2 text-danger">${(d.errors||[]).map(esc).slice(0,8).join('<br>')}</div></div>`;await load();}finally{setBtn(btn,false);}};
}
load();
})();
</script>
}
