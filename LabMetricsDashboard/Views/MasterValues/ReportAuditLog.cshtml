@model LabMetricsDashboard.Models.MasterValuesPageViewModel
@{
    ViewData["Title"] = "Report Audit Log";
}

<style>
    .mv-shell { display: flex; flex-direction: column; gap: 1rem; }
    .mv-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .mv-title h2 { margin: 0; font-size: 1.45rem; font-weight: 800; color: #162033; }
    .mv-title small { color: #64748b; font-weight: 600; }
    .mv-card { background: #fff; border: 1px solid #d9e2ef; border-radius: 8px; box-shadow: 0 6px 18px rgba(15, 23, 42, .06); }
    .mv-filters { display: flex; gap: .6rem; align-items: flex-end; flex-wrap: wrap; padding: .75rem 1rem; border-bottom: 1px solid #e2e8f0; }
    .mv-filters label { display: block; font-size: .7rem; font-weight: 800; text-transform: uppercase; letter-spacing: .02em; color: #64748b; margin-bottom: .15rem; }
    .mv-filters .form-control, .mv-filters .form-select { font-size: .8rem; }
    .mv-grid-wrap { position: relative; }
    .mv-grid-scroll { overflow: auto; max-height: calc(100vh - 330px); min-height: 300px; }
    .mv-table { font-size: .8rem; margin-bottom: 0; }
    .mv-table th, .mv-table td { border: 1px solid #d8e1ee; white-space: nowrap; }
    .mv-table thead th { position: sticky; top: 0; z-index: 2; background: #f8fafc; color: #0f172a; font-size: .7rem; text-transform: uppercase; letter-spacing: .02em; vertical-align: bottom; }
    /* Report-type headers are numerous, so they stay narrow and wrap onto two lines. */
    .mv-table thead th.report-col { white-space: normal; min-width: 84px; max-width: 96px; text-align: center; line-height: 1.15; }
    .mv-table td.report-col { text-align: center; }
    .mv-table tbody tr:hover td { background: #f8fbff; }
    .mv-table thead th.sortable { cursor: pointer; user-select: none; }
    .mv-table thead th.sortable:hover { background: #eef6ff; color: #0b5ed7; }
    .mv-sort { color: #94a3b8; font-size: .7rem; margin-left: .2rem; }
    .mv-table thead th.sorted .mv-sort { color: #0b5ed7; }
    .st { display: inline-flex; align-items: center; justify-content: center; min-width: 1.35rem; height: 1.35rem; border-radius: 999px; font-size: .72rem; font-weight: 800; }
    .st.ok { background: #dcfce7; color: #166534; }
    .st.bad { background: #fee2e2; color: #991b1b; }
    .st.skip { background: #eef2f7; color: #64748b; }
    .st.none { color: #cbd5e1; }
    .mv-runid { font-family: Consolas, monospace; font-size: .74rem; color: #2E5C8A; cursor: pointer; text-decoration: underline dotted; }
    .mv-runid:hover { color: #0b5ed7; }
    .mv-errlink { font-weight: 700; font-size: .74rem; color: #B3261E; text-decoration: underline; cursor: pointer; white-space: nowrap; }
    .mv-errlink:hover { color: #7f1d1d; }
    .mv-errlink.empty { color: #94a3b8; text-decoration: none; cursor: default; font-weight: 600; }
    .mv-alllink { font-size: .72rem; color: #2E5C8A; text-decoration: underline; cursor: pointer; white-space: nowrap; }
    .mv-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .75rem 1rem; border-top: 1px solid #e2e8f0; flex-wrap: wrap; }
    .mv-loader { display: none; position: absolute; inset: 0; z-index: 5; align-items: center; justify-content: center; background: rgba(248, 250, 252, .74); }
    .mv-loader.active { display: flex; }
    .mv-loader-box { background: #0f172a; color: #fff; border-radius: 8px; padding: .75rem 1rem; display: inline-flex; gap: .7rem; align-items: center; }
    .mv-info-banner { background: #E8F1F9; border: 1px solid #C6DCEE; color: #1F3B57; padding: .55rem .75rem; border-radius: 6px; font-size: .8rem; }
    .mv-legend { display: flex; gap: .9rem; align-items: center; flex-wrap: wrap; font-size: .74rem; color: #475569; }
    .mv-log-scroll { overflow: auto; max-height: 55vh; border: 1px solid #d8e1ee; border-radius: 6px; }
    .mv-log-scroll .mv-table thead th { z-index: 3; }
    /* Qualified with td: the grid-wide ".mv-table td { white-space: nowrap }" is more specific than
       a bare class, so an unqualified rule here leaves long messages unwrapped and overlapping the
       Source File / By columns. */
    .mv-log-scroll .mv-table td.mv-log-msg { white-space: pre-wrap; word-break: break-word; min-width: 320px; max-width: 560px; font-size: .76rem; line-height: 1.35; }
    .mv-log-scroll .mv-table td, .mv-log-scroll .mv-table th { vertical-align: top; }
    .mv-log-scroll .mv-table td.mv-log-file { white-space: normal; word-break: break-all; max-width: 220px; font-size: .74rem; }
    .mv-badge { display: inline-flex; align-items: center; border-radius: 999px; padding: .15rem .5rem; font-size: .7rem; font-weight: 800; background: #eef2f7; color: #334155; }
    .mv-badge.Error { background: #FBEAE9; color: #B3261E; }
    .mv-badge.Warning { background: #FDF3E3; color: #B7791F; }
    .mv-badge.Info { background: #E5EEF7; color: #2E5C8A; }
    .mv-badge.Start, .mv-badge.End { background: #dcfce7; color: #166534; }
</style>

<div class="mv-shell">
    <div class="mv-header">
        <div class="mv-title">
            <h2>Report Audit Log</h2>
            <small>Every report run by Run ID, newest synchronized first. Click a Run ID to read its log, or use the Error Log link to download that run's errors as CSV.</small>
        </div>
        <div class="mv-actions d-flex gap-2">
            <button type="button" class="btn btn-outline-danger" id="downloadAllErrorsBtn" title="Download the error log for every run matching the current filters">
                <i class="bi bi-filetype-csv"></i> All Errors (CSV)
            </button>
            <button type="button" class="btn btn-outline-primary" id="downloadAllLogsBtn" title="Download every log entry (all types) for the runs matching the current filters">
                <i class="bi bi-download"></i> All Logs (CSV)
            </button>
            <button type="button" class="btn btn-outline-secondary" id="refreshBtn"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
        </div>
    </div>

    <div class="mv-info-banner" id="errorBanner" style="display:none;"></div>

    <div class="mv-card">
        <div class="mv-filters">
            <div style="width:190px;">
                <label for="fRunId">Run ID</label>
                <input type="text" class="form-control form-control-sm" id="fRunId" placeholder="e.g. R20260804NWL0039" />
            </div>
            <div style="width:160px;">
                <label for="fLab">Lab</label>
                <select class="form-select form-select-sm" id="fLab"><option value="">All labs</option></select>
            </div>
            <div style="width:150px;">
                <label for="fFrom">From</label>
                <input type="date" class="form-control form-control-sm" id="fFrom" />
            </div>
            <div style="width:150px;">
                <label for="fTo">To</label>
                <input type="date" class="form-control form-control-sm" id="fTo" />
            </div>
            <div style="width:165px;">
                <label for="fMode">Runs</label>
                <select class="form-select form-select-sm" id="fMode">
                    <option value="All">All runs</option>
                    <option value="Latest">Latest run per lab</option>
                    <option value="LatestSuccess">Latest clean run per lab</option>
                </select>
            </div>
            <div style="width:150px;">
                <label for="fStatus">Show</label>
                <select class="form-select form-select-sm" id="fStatus">
                    <option value="">Every run</option>
                    <option value="failed">With failures</option>
                    <option value="errors">With error logs</option>
                    <option value="clean">Fully successful</option>
                </select>
            </div>
            <div class="form-check ms-1 mb-1">
                <input class="form-check-input" type="checkbox" id="fInactive" />
                <label class="form-check-label" for="fInactive" style="text-transform:none;font-size:.75rem;letter-spacing:0;">Retired report types</label>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary btn-sm" id="applyBtn"><i class="bi bi-funnel"></i> Apply</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="clearBtn">Clear</button>
            </div>
        </div>

        <div class="mv-grid-wrap">
            <div class="mv-loader" id="gridLoader"><div class="mv-loader-box"><span class="spinner-border spinner-border-sm"></span><span>Loading report runs...</span></div></div>
            <div class="mv-grid-scroll">
                <table class="table table-sm table-hover table-bordered align-middle mv-table">
                    <thead><tr id="gridHead"></tr></thead>
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>

        <div class="mv-footer">
            <small id="pageInfo" class="text-muted"></small>
            <div class="mv-legend">
                <span><span class="st ok">&#10003;</span> Success</span>
                <span><span class="st bad">&#10007;</span> Failed</span>
                <span><span class="st skip">&ndash;</span> Skipped</span>
                <span><span class="st none">&#8226;</span> Not run</span>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="logModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="logTitle">Run Log</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <select class="form-select form-select-sm" id="logTypeFilter" style="max-width:170px;">
                        <option value="">All log types</option>
                        <option value="Error">Error</option>
                        <option value="Warning">Warning</option>
                        <option value="Info">Info</option>
                        <option value="Start">Start</option>
                        <option value="End">End</option>
                    </select>
                    <input type="text" class="form-control form-control-sm" id="logSearch" placeholder="Search message / report type…" style="max-width:300px;" />
                    <small class="text-muted" id="logCount"></small>
                    <div class="ms-auto d-flex gap-2">
                        <button type="button" class="btn btn-outline-danger btn-sm" id="logErrorCsvBtn"><i class="bi bi-filetype-csv"></i> Error Log</button>
                        <button type="button" class="btn btn-outline-primary btn-sm" id="logAllCsvBtn"><i class="bi bi-download"></i> All Logs</button>
                    </div>
                </div>
                <div class="mv-log-scroll">
                    <table class="table table-sm table-bordered align-middle mv-table">
                        <thead><tr>
                            <th>Logged On</th>
                            <th>Type</th>
                            <th>Report Type</th>
                            <th>Source System</th>
                            <th>Message</th>
                            <th>Source File</th>
                            <th>By</th>
                        </tr></thead>
                        <tbody id="logRows"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div>
        </div>
    </div>
</div>

@section Scripts {
<script nonce='@Context.Items["CspNonce"]'>
(function(){
const urls={
  runs:'@Url.Action("ReportAuditRuns","MasterValues")',
  logs:'@Url.Action("ReportAuditLogs","MasterValues")',
  export:'@Url.Action("ReportAuditLogsExport","MasterValues")'
};
const PAGE_SIZE=50;
let reportColumns=[],allRows=[],viewRows=[],page=1;
let sortCol='',sortDir='desc';           // blank = keep the proc's own order (synchronized on, newest first)
let logEntries=[],logRunId='',logFilterTimer=null;
const logModal=new bootstrap.Modal(document.getElementById('logModal'));
const el=id=>document.getElementById(id);
function esc(v){return (v??'').toString().replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}
function qs(obj){
  return Object.entries(obj)
    .filter(([,v])=>v!==''&&v!==null&&v!==undefined&&v!==false)
    .map(([k,v])=>encodeURIComponent(k)+'='+encodeURIComponent(v)).join('&');
}
function banner(message){
  const b=el('errorBanner');
  if(!message){b.style.display='none';b.textContent='';return;}
  b.textContent=message;b.style.display='';
}

// ── filters ────────────────────────────────────────────────────────────────
// Run ID / dates / mode are proc parameters and re-query; lab and status filter the loaded rows.
function serverFilters(){
  return {runId:el('fRunId').value.trim(),fromDate:el('fFrom').value,toDate:el('fTo').value,
          mode:el('fMode').value,includeInactiveReports:el('fInactive').checked};
}
function fmtDate(row){
  return row.syncedOn||(row.syncedOnDate?new Date(row.syncedOnDate).toLocaleDateString():'—');
}
function statusCell(status){
  if(!status)return '<span class="st none" title="Not run">&#8226;</span>';
  const s=status.toLowerCase();
  if(s==='success')return '<span class="st ok" title="Success">&#10003;</span>';
  if(s==='failed')return '<span class="st bad" title="Failed">&#10007;</span>';
  if(s==='skipped')return '<span class="st skip" title="Skipped">&ndash;</span>';
  return `<span class="st skip" title="${esc(status)}">?</span>`;
}
function renderHead(){
  const fixed=[['lab','Lab'],['syncedOnDate','Synced On'],['runId','Run ID'],['week','Week']];
  el('gridHead').innerHTML=
    fixed.map(([key,label])=>`<th class="sortable" data-sort="${key}">${label} <span class="mv-sort"></span></th>`).join('')+
    reportColumns.map(c=>`<th class="report-col" title="${esc(c)}">${esc(c)}</th>`).join('')+
    // Named "(CSV)" because ReportTypeMaster itself has a report type called "Error Log" -
    // that one is a status column above; this one is the download.
    '<th>Error Log (CSV)</th>';
  el('gridHead').querySelectorAll('th.sortable').forEach(th=>th.addEventListener('click',()=>{
    const col=th.dataset.sort;
    if(sortCol===col)sortDir=sortDir==='asc'?'desc':'asc';
    else{sortCol=col;sortDir='asc';}
    page=1;render();
  }));
}
function paintSort(){
  el('gridHead').querySelectorAll('th.sortable').forEach(th=>{
    const active=th.dataset.sort===sortCol;
    th.classList.toggle('sorted',active);
    th.querySelector('.mv-sort').textContent=active?(sortDir==='asc'?'▲':'▼'):'↕';
  });
}
function applyClientFilters(){
  const lab=el('fLab').value,status=el('fStatus').value;
  return allRows.filter(r=>{
    if(lab&&(r.lab||'')!==lab)return false;
    if(status==='failed'&&!(r.failedCount>0))return false;
    if(status==='errors'&&!(r.errorLogCount>0))return false;
    if(status==='clean'&&!(r.failedCount===0&&r.successCount>0))return false;
    return true;
  });
}
function sortRows(list){
  if(!sortCol)return list;                       // proc order: synchronized on, newest first
  const mul=sortDir==='desc'?-1:1;
  return [...list].sort((a,b)=>{
    let x=a[sortCol],y=b[sortCol];
    if(x==null&&y==null)return 0; if(x==null)return 1; if(y==null)return -1;
    if(typeof x==='string'&&typeof y==='string'){x=x.toLowerCase();y=y.toLowerCase();}
    return x<y?-mul:x>y?mul:0;
  });
}
function rowHtml(r){
  const errCell=r.errorLogCount>0
    ? `<span class="mv-errlink" data-err="${esc(r.runId)}" title="Download this run's error log as CSV"><i class="bi bi-filetype-csv"></i> Errors (${r.errorLogCount})</span>`
      +` <span class="mv-alllink" data-all="${esc(r.runId)}" title="Download every log entry for this run">all ${r.totalLogCount}</span>`
    : (r.totalLogCount>0
        ? `<span class="mv-errlink empty">No errors</span> <span class="mv-alllink" data-all="${esc(r.runId)}" title="Download every log entry for this run">all ${r.totalLogCount}</span>`
        : '<span class="mv-errlink empty">No log</span>');
  return `<tr><td>${esc(r.lab||'—')}</td><td>${esc(fmtDate(r))}</td>`+
    `<td><span class="mv-runid" data-run="${esc(r.runId)}" title="View this run's log">${esc(r.runId)}</span></td>`+
    `<td>${esc(r.week||'—')}</td>`+
    reportColumns.map(c=>`<td class="report-col">${statusCell((r.statuses||{})[c])}</td>`).join('')+
    `<td>${errCell}</td></tr>`;
}
function render(){
  viewRows=sortRows(applyClientFilters());
  paintSort();
  const totalPages=Math.max(1,Math.ceil(viewRows.length/PAGE_SIZE));
  if(page>totalPages)page=totalPages;
  const slice=viewRows.slice((page-1)*PAGE_SIZE,page*PAGE_SIZE);
  const span=reportColumns.length+5;
  el('rows').innerHTML=slice.map(rowHtml).join('')
    ||`<tr><td colspan="${span}" class="text-center text-muted py-4">No report runs match these filters.</td></tr>`;
  el('pageInfo').innerHTML=viewRows.length
    ? `Showing <b>${(page-1)*PAGE_SIZE+1}&ndash;${Math.min(page*PAGE_SIZE,viewRows.length)}</b> of <b>${viewRows.length}</b> run(s)`
      +(viewRows.length!==allRows.length?` (filtered from ${allRows.length})`:'')
      +(totalPages>1?` &nbsp; <button class="btn btn-outline-secondary btn-sm" id="prevBtn"${page===1?' disabled':''}>Previous</button>`
        +` <button class="btn btn-outline-secondary btn-sm" id="nextBtn"${page===totalPages?' disabled':''}>Next</button>`:'')
    : 'No runs';
  const prev=el('prevBtn'),next=el('nextBtn');
  if(prev)prev.onclick=()=>{if(page>1){page--;render();}};
  if(next)next.onclick=()=>{if(page<totalPages){page++;render();}};
}
function fillLabs(){
  const current=el('fLab').value;
  const labs=[...new Set(allRows.map(r=>r.lab).filter(Boolean))].sort((a,b)=>a.localeCompare(b));
  el('fLab').innerHTML='<option value="">All labs</option>'+labs.map(l=>`<option value="${esc(l)}">${esc(l)}</option>`).join('');
  if(labs.includes(current))el('fLab').value=current;
}
async function load(){
  el('gridLoader').classList.add('active');
  banner('');
  try{
    const r=await fetch(urls.runs+'?'+qs(serverFilters()));
    const d=await r.json().catch(()=>({}));
    if(!r.ok)throw new Error(d.message||'Unable to load the report audit log.');
    reportColumns=d.reportColumns||[];
    allRows=d.rows||[];
    page=1;
    renderHead();
    fillLabs();
    render();
  }catch(e){
    reportColumns=[];allRows=[];
    renderHead();
    el('rows').innerHTML='<tr><td colspan="5" class="text-center text-danger py-4">Unable to load the report audit log.</td></tr>';
    el('pageInfo').textContent='';
    banner(e.message||'Unable to load the report audit log.');
  }finally{el('gridLoader').classList.remove('active');}
}

// ── downloads ──────────────────────────────────────────────────────────────
// Plain navigation so the browser handles the file; the MVC action streams the API's CSV.
function download(params){window.location.href=urls.export+'?'+qs(params);}
function downloadRunErrors(runId){download({runId:runId,logType:'Error'});}
function downloadRunAll(runId){download({runId:runId});}

el('rows').addEventListener('click',e=>{
  const err=e.target.closest('.mv-errlink[data-err]');
  if(err){downloadRunErrors(err.dataset.err);return;}
  const all=e.target.closest('.mv-alllink[data-all]');
  if(all){downloadRunAll(all.dataset.all);return;}
  const run=e.target.closest('.mv-runid');
  if(run)openLog(run.dataset.run);
});
el('downloadAllErrorsBtn').onclick=()=>{
  const f=serverFilters();
  download({runId:f.runId,logType:'Error',fromDate:f.fromDate,toDate:f.toDate});
};
el('downloadAllLogsBtn').onclick=()=>{
  const f=serverFilters();
  download({runId:f.runId,fromDate:f.fromDate,toDate:f.toDate});
};

// ── run log viewer ─────────────────────────────────────────────────────────
function renderLog(){
  const type=el('logTypeFilter').value.toLowerCase();
  const term=el('logSearch').value.trim().toLowerCase();
  const list=logEntries.filter(x=>
    (!type||(x.logType||'').toLowerCase()===type)&&
    (!term||((x.logMessage||'')+' '+(x.reportType||'')+' '+(x.sourceFileName||'')).toLowerCase().includes(term)));
  el('logCount').textContent=list.length===logEntries.length
    ?`${logEntries.length} entr${logEntries.length===1?'y':'ies'}`
    :`${list.length} of ${logEntries.length} entries`;
  el('logRows').innerHTML=list.map(x=>{
    const when=x.createdOn?new Date(x.createdOn):null;
    const badge=(x.logType||'').replace(/[^A-Za-z]/g,'');
    return `<tr><td>${when?esc(when.toLocaleDateString()+' '+when.toLocaleTimeString()):'—'}</td>`+
      `<td><span class="mv-badge ${badge}">${esc(x.logType||'—')}</span></td>`+
      `<td>${esc(x.reportType||'—')}</td><td>${esc(x.sourceSystem||'—')}</td>`+
      `<td class="mv-log-msg">${esc(x.logMessage||'')}</td>`+
      `<td class="mv-log-file">${esc(x.sourceFileName||'—')}</td><td>${esc(x.createdBy||'—')}</td></tr>`;
  }).join('')||'<tr><td colspan="7" class="text-center text-muted py-3">No log entries match this filter.</td></tr>';
}
async function openLog(runId){
  logRunId=runId;logEntries=[];
  el('logTitle').textContent='Run Log — '+runId;
  el('logSearch').value='';el('logTypeFilter').value='';el('logCount').textContent='';
  el('logRows').innerHTML='<tr><td colspan="7" class="text-center text-muted py-3">Loading…</td></tr>';
  logModal.show();
  try{
    const r=await fetch(urls.logs+'?'+qs({runId:runId}));
    const d=await r.json().catch(()=>([]));
    if(!r.ok)throw new Error(d.message||'Unable to load the run log.');
    logEntries=Array.isArray(d)?d:[];
    renderLog();
  }catch(e){
    el('logRows').innerHTML=`<tr><td colspan="7" class="text-center text-danger py-3">${esc(e.message||'Unable to load the run log.')}</td></tr>`;
  }
}
el('logTypeFilter').addEventListener('change',renderLog);
el('logSearch').addEventListener('input',()=>{clearTimeout(logFilterTimer);logFilterTimer=setTimeout(renderLog,200);});
el('logErrorCsvBtn').onclick=()=>{if(logRunId)downloadRunErrors(logRunId);};
el('logAllCsvBtn').onclick=()=>{if(logRunId)downloadRunAll(logRunId);};

// ── wiring ─────────────────────────────────────────────────────────────────
el('applyBtn').onclick=()=>load();
el('refreshBtn').onclick=()=>load();
el('clearBtn').onclick=()=>{
  el('fRunId').value='';el('fFrom').value='';el('fTo').value='';
  el('fMode').value='All';el('fStatus').value='';el('fLab').value='';el('fInactive').checked=false;
  load();
};
el('fRunId').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();load();}});
el('fLab').addEventListener('change',()=>{page=1;render();});
el('fStatus').addEventListener('change',()=>{page=1;render();});
load();
})();
</script>
}
