@model LabMetricsDashboard.Models.MasterValuesPageViewModel
@{
    ViewData["Title"] = "Payer Master Approval Queue";
}

<style>
    .mv-shell { display: flex; flex-direction: column; gap: 1rem; }
    .mv-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .mv-title h2 { margin: 0; font-size: 1.45rem; font-weight: 800; color: #162033; }
    .mv-title small { color: #64748b; font-weight: 600; }
    .mv-card { background: #fff; border: 1px solid #d9e2ef; border-radius: 8px; box-shadow: 0 6px 18px rgba(15, 23, 42, .06); }
    .mv-filter { padding: 1rem; }
    .mv-filter .form-label { margin-bottom: .25rem; font-size: .74rem; color: #475569; font-weight: 800; text-transform: uppercase; }
    .mv-info-banner { background: #E8F1F9; border: 1px solid #C6DCEE; color: #1F3B57; padding: .55rem .75rem; border-radius: 8px; font-size: .8rem; }
    .mv-grid-wrap { position: relative; }
    .mv-grid-scroll { overflow: auto; max-height: calc(100vh - 330px); min-height: 280px; }
    .mv-table { min-width: 1100px; font-size: .82rem; }
    .mv-table th, .mv-table td { border: 1px solid #d8e1ee; }
    .mv-table thead th { position: sticky; top: 0; z-index: 2; background: #f8fafc; color: #0f172a; white-space: nowrap; font-size: .75rem; text-transform: uppercase; letter-spacing: .02em; }
    .mv-table tbody td { vertical-align: middle; }
    .mv-primary { font-weight: 800; color: #0f172a; }
    .mv-badge { display: inline-flex; align-items: center; border-radius: 999px; padding: .15rem .5rem; font-size: .72rem; font-weight: 800; background: #eef2f7; color: #334155; white-space: nowrap; }
    .mv-badge.pending { background: #FDF3E3; color: #B7791F; }
    .mv-badge.sla { background: #FBEAE9; color: #B3261E; }
    .mv-badge.on { background: #dcfce7; color: #166534; }
    .mv-badge.off { background: #fee2e2; color: #991b1b; }
    .mv-diff { font-size: .76rem; color: #475569; max-width: 340px; white-space: normal; }
    .mv-loader { display: none; position: absolute; inset: 0; z-index: 5; align-items: center; justify-content: center; background: rgba(248, 250, 252, .74); }
    .mv-loader.active { display: flex; }
    .mv-loader-box { background: #0f172a; color: white; border-radius: 8px; padding: .75rem 1rem; display: inline-flex; gap: .7rem; align-items: center; }
    .mv-empty { padding: 3.5rem 1rem; text-align: center; color: #64748b; }
    .mv-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .75rem 1rem; border-top: 1px solid #e2e8f0; }
</style>

<div class="mv-shell">
    <div class="mv-header">
        <div class="mv-title">
            <h2>Approval Queue</h2>
            <small>Pending Reports Analyst actions awaiting review across both Payer Master screens.</small>
        </div>
        @if (Model.CanWrite)
        {
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-success" id="bulkApproveBtn"><i class="bi bi-check2-all"></i> Approve Selected</button>
                <button type="button" class="btn btn-outline-danger" id="bulkRejectBtn"><i class="bi bi-x-circle"></i> Reject Selected</button>
            </div>
        }
    </div>

    <div class="mv-info-banner">
        @if (Model.CanWrite)
        {
            <text>Approval by any one eligible approver is sufficient. Rejection requires a reason, which is shared with the submitter. Items unactioned beyond the SLA window are flagged and escalated automatically.</text>
        }
        else
        {
            <text><b>@Model.RoleLabel:</b> showing your own submissions and their outcomes. Approvals are actioned by LRN Admin / Payer Policy Admin (Payer Policy) and LRN Admin / Reports Manager (Lab Insurance).</text>
        }
    </div>

    <div class="mv-card mv-filter">
        <form id="filterForm" class="row g-3 align-items-end">
            <div class="col-lg-3 col-md-6"><label class="form-label">Master</label><select class="form-select" name="master"><option value="">All Masters</option><option value="Policy">Payer Policy Insurance Master</option><option value="Lab">Lab Insurance Master</option></select></div>
            <div class="col-lg-3 col-md-6"><label class="form-label">Status</label><select class="form-select" name="status"><option>Pending</option><option>Approved</option><option>Rejected</option></select></div>
            <div class="col-lg-3 col-md-6 d-flex gap-2">
                <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Refresh</button>
            </div>
        </form>
    </div>

    <div class="mv-card mv-grid-wrap">
        <div class="mv-loader" id="gridLoader"><div class="mv-loader-box"><span class="spinner-border spinner-border-sm"></span><span>Loading...</span></div></div>
        <div class="mv-grid-scroll">
            <table class="table table-sm table-hover table-bordered align-middle mv-table mb-0">
                <thead><tr>
                    @if (Model.CanWrite) { <th style="width:34px;text-align:center;"><input type="checkbox" id="selectAll" /></th> }
                    <th>Master</th><th>Action</th><th>Payer</th><th>Submitted By</th><th>Field Changes</th><th>SLA</th><th>Status</th>
                    @if (Model.CanWrite) { <th class="text-end">Decision</th> }
                </tr></thead>
                <tbody id="rows"></tbody>
            </table>
        </div>
        <div class="mv-footer"><small id="pageInfo" class="text-muted"></small><div class="btn-group"><button class="btn btn-outline-secondary btn-sm" id="prevBtn">Previous</button><button class="btn btn-outline-secondary btn-sm" id="nextBtn">Next</button></div></div>
    </div>
</div>

@if (Model.CanWrite)
{
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="rejectTitle">Reject Request</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <label class="form-label fw-bold">Rejection Reason *</label>
                <textarea class="form-control" id="rejectReason" rows="3" placeholder="Required — this will be shared with the Reports Analyst"></textarea>
                <div id="rejectError" class="alert alert-danger mt-3 d-none"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-danger" id="confirmRejectBtn">Confirm Rejection</button>
            </div>
        </div>
    </div>
</div>
}

@section Scripts {
<script nonce='@Context.Items["CspNonce"]'>
(function(){
const canAct=@(Model.CanWrite ? "true" : "false");
let page=1,pageSize=50,totalPages=1,rejectIds=[];
const urls={data:'@Url.Action("ApprovalsData","MasterValues")',approve:'@Url.Action("ApproveRequests","MasterValues")',reject:'@Url.Action("RejectRequests","MasterValues")'};
const loader=document.getElementById('gridLoader');
const rejectModal=canAct?new bootstrap.Modal(document.getElementById('rejectModal')):null;
function esc(v){return (v??'').toString().replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}
function setBusy(on){loader.classList.toggle('active',on);}
async function errorText(r){try{const j=await r.json();return j.message||j.title||JSON.stringify(j);}catch{return await r.text();}}
function masterLabel(m){return m==='Policy'?'Payer Policy':'Lab Insurance';}
function slaBadge(x){
  if(x.status!=='Pending')return '—';
  if(x.isOverdue)return '<span class="mv-badge sla">SLA breached — escalated</span>';
  const hrs=Math.max(0,Math.round((new Date(x.slaDeadline)-new Date())/36e5));
  return `<span class="mv-badge pending">Due in ${hrs}h</span>`;
}
function statusBadge(x){
  if(x.status==='Pending')return '<span class="mv-badge pending">Pending</span>';
  if(x.status==='Approved')return `<span class="mv-badge on">Approved by ${esc(x.decidedBy||'')}</span>`;
  return `<span class="mv-badge off" title="${esc(x.rejectionReason||'')}">Rejected by ${esc(x.decidedBy||'')}</span>`;
}
function renderRows(items){
  const cols=canAct?9:7;
  document.getElementById('rows').innerHTML=(items||[]).map(x=>{
    const cb=canAct?`<td style="text-align:center;">${x.status==='Pending'?`<input type="checkbox" class="rowCheck" value="${x.approvalRequestId}">`:''}</td>`:'';
    const act=canAct?`<td class="text-end text-nowrap">${x.status==='Pending'?`<button class="btn btn-sm btn-success approve" data-id="${x.approvalRequestId}">Approve</button> <button class="btn btn-sm btn-outline-danger reject" data-id="${x.approvalRequestId}" data-name="${esc(x.payerName)}">Reject</button>`:''}</td>`:'';
    return `<tr>${cb}<td>${masterLabel(x.master)}</td><td>${esc(x.actionType)}</td><td class="mv-primary">${esc(x.payerName)}</td><td>${esc(x.submittedBy)}<div class="text-muted" style="font-size:.72rem;">${new Date(x.submittedOn).toLocaleString()}</div></td><td class="mv-diff">${esc(x.changeSummary||'—')}</td><td>${slaBadge(x)}</td><td>${statusBadge(x)}</td>${act}</tr>`;
  }).join('')||`<tr><td colspan="${cols}"><div class="mv-empty"><div class="fw-bold">No requests found</div><div>There are no ${document.querySelector('[name=status]').value.toLowerCase()} requests for the selected filter.</div></div></td></tr>`;
  const selectAll=document.getElementById('selectAll');if(selectAll)selectAll.checked=false;
}
async function load(){
  setBusy(true);
  try{
    const fd=new FormData(document.getElementById('filterForm'));fd.set('page',page);fd.set('pageSize',pageSize);
    const r=await fetch(urls.data+'?'+new URLSearchParams(fd));
    if(!r.ok){document.getElementById('rows').innerHTML=`<tr><td colspan="9"><div class="mv-empty text-danger">${esc(await errorText(r))}</div></td></tr>`;return;}
    const d=await r.json();
    totalPages=d.totalPages||1;
    document.getElementById('pageInfo').textContent=`Page ${d.page||1} of ${totalPages} - ${d.totalCount||0} request(s)`;
    renderRows(d.items);
  }catch(e){document.getElementById('rows').innerHTML='<tr><td colspan="9"><div class="mv-empty text-danger">Unable to load the approval queue.</div></td></tr>';}
  finally{setBusy(false);}
}
document.getElementById('filterForm').onsubmit=e=>{e.preventDefault();page=1;load();};
document.querySelector('[name=status]').onchange=()=>{page=1;load();};
document.querySelector('[name=master]').onchange=()=>{page=1;load();};
document.getElementById('prevBtn').onclick=()=>{if(page>1){page--;load();}};
document.getElementById('nextBtn').onclick=()=>{if(page<totalPages){page++;load();}};

if(canAct){
  function selected(){return [...document.querySelectorAll('.rowCheck:checked')].map(x=>Number(x.value));}
  document.getElementById('selectAll').onchange=e=>{document.querySelectorAll('.rowCheck').forEach(c=>c.checked=e.target.checked);};
  async function decide(url,ids,reason){
    setBusy(true);
    try{
      const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids,reason})});
      if(!r.ok){alert(await errorText(r));return null;}
      const d=await r.json();
      if((d.errors||[]).length)alert('Some requests could not be processed:\n'+d.errors.join('\n'));
      await load();
      return d;
    }finally{setBusy(false);}
  }
  document.getElementById('bulkApproveBtn').onclick=async()=>{
    const ids=selected();if(!ids.length){alert('Select at least one pending request.');return;}
    if(!confirm(`Approve ${ids.length} selected request(s)? New payers will receive a system-assigned Global Payer ID.`))return;
    await decide(urls.approve,ids);
  };
  function openReject(ids,title){
    rejectIds=ids;
    document.getElementById('rejectTitle').textContent=title;
    document.getElementById('rejectReason').value='';
    document.getElementById('rejectError').classList.add('d-none');
    rejectModal.show();
  }
  document.getElementById('bulkRejectBtn').onclick=()=>{
    const ids=selected();if(!ids.length){alert('Select at least one pending request.');return;}
    openReject(ids,`Reject ${ids.length} Selected Request(s)`);
  };
  document.getElementById('rows').onclick=async e=>{
    const approve=e.target.closest('.approve'),reject=e.target.closest('.reject');
    if(approve){
      if(!confirm('Approve this request? New payers will receive a system-assigned Global Payer ID.'))return;
      await decide(urls.approve,[Number(approve.dataset.id)]);
    }
    if(reject)openReject([Number(reject.dataset.id)],'Reject Request — '+reject.dataset.name);
  };
  document.getElementById('confirmRejectBtn').onclick=async()=>{
    const reason=document.getElementById('rejectReason').value.trim();
    if(!reason){const el=document.getElementById('rejectError');el.textContent='A rejection reason is required.';el.classList.remove('d-none');return;}
    rejectModal.hide();
    await decide(urls.reject,rejectIds,reason);
  };
}
load();
})();
</script>
}
