@using LabMetricsDashboard.Models
@model LabMetricsDashboard.Models.PayerPolicyValidationViewModel
@{
    ViewData["Title"]       = $"Payer Policy Validation - {Model.SelectedLab}";
    ViewData["SelectedLab"] = Model.SelectedLab;
    ViewData["PageLabel"]   = "Payer Policy Validation";

    bool hasFilters = Model.HasActiveFilters;

    var f = new Dictionary<string, string?>
    {
        ["lab"] = Model.SelectedLab,
        ["filterPayerName"] = Model.FilterPayerName,
        ["filterPanelName"] = Model.FilterPanelName,
        ["filterFinalCoverageStatus"] = Model.FilterFinalCoverageStatus,
        ["filterCPTCode"] = Model.FilterCPTCode,
        ["filterForecastingPayabilitySubstatus"] = Model.FilterForecastingPayabilitySubstatus,
        ["filterPredictionStatus"] = Model.FilterPredictionStatus,
        ["filterPayStatus"] = Model.FilterPayStatus,
        ["pageSize"] = Model.PageSize.ToString(),
        ["search"] = "true",
    };

    var columns = PayerPolicyValidationColumns.All;
    int[] presetSizes = [10, 25, 50, 100];
    bool isCustomSize = !presetSizes.Contains(Model.PageSize);

    static string CellText(PayerPolicyValidationColumns.Column col, PredictionRecord r)
    {
        var v = col.Value(r);
        if (v is null) return string.Empty;
        return col.IsMoney && v is decimal d ? Text(d, 2) : v.ToString() ?? string.Empty;
    }
}

<style>
/* Filter panel — same style as Prediction page */
.filter-panel { background:#fff; border-radius:12px; box-shadow:0 2px 10px rgba(0,0,0,.07); }

/* Results grid — Prediction-style scroll container, ~600px with frozen header + first 2 columns */
.ppv-grid-scroll {
    overflow: auto;
    max-height: 600px;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    -webkit-overflow-scrolling: touch;
    position: relative;
    isolation: isolate;
    background: #fff;
}
.ppv-grid-scroll::-webkit-scrollbar { width: 8px; height: 8px; }
.ppv-grid-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 8px; }
.ppv-table {
    width: max-content;
    min-width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: .74rem;
    white-space: nowrap;
}
.ppv-table thead th {
    position: sticky; top: 0; z-index: 5;
    background: #0f172a;
    color: #fff;
    font-weight: 700;
    font-size: .68rem;
    text-transform: uppercase;
    padding: .55rem .65rem;
    border: none;
    border-right: 1px solid rgba(255,255,255,.08);
    vertical-align: middle;
}
.ppv-table td {
    padding: .4rem .65rem;
    border-top: 1px solid #eef2f7;
    border-right: 1px solid #eef2f7;
    vertical-align: middle;
    color: #1e293b;
    background: #fff;
}
.ppv-table tbody tr:hover td { background: #f8fafc; }
.ppv-money { text-align: right; font-variant-numeric: tabular-nums; }
/* Frozen first two columns — fixed widths so the second column's left offset stays aligned */
.ppv-table th.ppv-fz1, .ppv-table td.ppv-fz1,
.ppv-table th.ppv-fz2, .ppv-table td.ppv-fz2 {
    width: 150px; min-width: 150px; max-width: 150px;
    overflow: hidden; text-overflow: ellipsis;
}
.ppv-table th.ppv-fz1, .ppv-table td.ppv-fz1 { position: sticky; left: 0; }
.ppv-table th.ppv-fz2, .ppv-table td.ppv-fz2 { position: sticky; left: 150px; }
.ppv-table thead th.ppv-fz1, .ppv-table thead th.ppv-fz2 { z-index: 7; background: #0f172a; }
.ppv-table tbody td.ppv-fz1, .ppv-table tbody td.ppv-fz2 { z-index: 3; background: #fff; }
.ppv-table tbody tr:hover td.ppv-fz1, .ppv-table tbody tr:hover td.ppv-fz2 { background: #f8fafc; }
.ppv-table td.ppv-fz2, .ppv-table th.ppv-fz2 { box-shadow: 2px 0 4px rgba(15,23,42,.06); }
</style>

<div class="container-fluid px-4 py-3">
    <div class="d-flex align-items-center gap-2 mb-3">
        <i class="bi bi-shield-check fs-4 text-success"></i>
        <h4 class="mb-0 fw-semibold">Payer Policy Validation</h4>
        @if (!string.IsNullOrWhiteSpace(Model.SelectedLab))
        {
            <span class="badge bg-primary ms-1">@Model.SelectedLab</span>
        }
    </div>

    @await Html.PartialAsync("_AnalysisRangeBanner", Model.AnalysisRange)

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-1"></i>@Model.ErrorMessage</div>
    }

    <!-- ── Filter panel — same style as Prediction page ─────────────────── -->
    <div class="filter-panel p-3 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="fw-semibold" style="font-size:.9rem">
                &#128269; Filters
                @if (hasFilters)
                {
                    <span class="badge bg-primary ms-1" style="font-size:.7rem">Active</span>
                }
            </span>
            <button class="btn btn-sm btn-link text-muted p-0" type="button"
                    data-bs-toggle="collapse" data-bs-target="#ppvFilterBody"
                    aria-expanded="true">
                <i class="bi bi-chevron-up me-1"></i><span>Hide</span>
            </button>
        </div>
        <div id="ppvFilterBody" class="collapse show">
            <form method="get" asp-controller="PayerPolicyValidation" asp-action="Index" id="ppvFilterForm">
                <input type="hidden" name="lab" value="@Model.SelectedLab" />
                <input type="hidden" name="search" value="true" />
                <div class="row g-2 align-items-end">
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label fw-semibold mb-1" style="font-size:.75rem">PAYER NAME</label>
                        <select name="filterPayerName" class="form-select form-select-sm">
                            <option value="">All</option>
                            @foreach (var v in Model.PayerNames)
                            {
                                if (v == Model.FilterPayerName) { <option value="@v" selected="selected">@v</option> }
                                else { <option value="@v">@v</option> }
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label fw-semibold mb-1" style="font-size:.75rem">PANEL NAME</label>
                        <select name="filterPanelName" class="form-select form-select-sm">
                            <option value="">All</option>
                            @foreach (var v in Model.PanelNames)
                            {
                                if (v == Model.FilterPanelName) { <option value="@v" selected="selected">@v</option> }
                                else { <option value="@v">@v</option> }
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label fw-semibold mb-1" style="font-size:.75rem">CPT CODE</label>
                        <select name="filterCPTCode" class="form-select form-select-sm">
                            <option value="">All</option>
                            @foreach (var v in Model.CPTCodes)
                            {
                                if (v == Model.FilterCPTCode) { <option value="@v" selected="selected">@v</option> }
                                else { <option value="@v">@v</option> }
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label fw-semibold mb-1" style="font-size:.75rem">FINAL COVERAGE</label>
                        <select name="filterFinalCoverageStatus" class="form-select form-select-sm">
                            <option value="">All</option>
                            @foreach (var v in Model.FinalCoverageStatuses)
                            {
                                if (v == Model.FilterFinalCoverageStatus) { <option value="@v" selected="selected">@v</option> }
                                else { <option value="@v">@v</option> }
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label fw-semibold mb-1" style="font-size:.75rem">PAY STATUS</label>
                        <select name="filterPayStatus" class="form-select form-select-sm">
                            <option value="">All</option>
                            @foreach (var v in Model.PayStatuses)
                            {
                                if (v == Model.FilterPayStatus) { <option value="@v" selected="selected">@v</option> }
                                else { <option value="@v">@v</option> }
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label fw-semibold mb-1" style="font-size:.75rem">FORECAST SUBSTATUS</label>
                        <select name="filterForecastingPayabilitySubstatus" class="form-select form-select-sm">
                            <option value="">All</option>
                            @foreach (var v in Model.ForecastingPayabilitySubstatuses)
                            {
                                if (v == Model.FilterForecastingPayabilitySubstatus) { <option value="@v" selected="selected">@v</option> }
                                else { <option value="@v">@v</option> }
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label fw-semibold mb-1" style="font-size:.75rem">PREDICTION STATUS</label>
                        <select name="filterPredictionStatus" class="form-select form-select-sm">
                            <option value="">All</option>
                            @foreach (var v in Model.PredictionStatuses)
                            {
                                if (v == Model.FilterPredictionStatus) { <option value="@v" selected="selected">@v</option> }
                                else { <option value="@v">@v</option> }
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label fw-semibold mb-1" style="font-size:.75rem">DISPLAY RECORDS</label>
                        <div class="d-flex gap-1">
                            <select id="ppvPageSizeSelect" class="form-select form-select-sm">
                                @foreach (var s in presetSizes)
                                {
                                    if (!isCustomSize && s == Model.PageSize) { <option value="@s" selected="selected">@s</option> }
                                    else { <option value="@s">@s</option> }
                                }
                                @if (isCustomSize) { <option value="custom" selected="selected">Custom</option> }
                                else { <option value="custom">Custom</option> }
                            </select>
                            <input type="number" id="ppvPageSizeCustom" class="form-control form-control-sm"
                                   min="1" max="100000" value="@Model.PageSize"
                                   style="width:90px; @(isCustomSize ? "" : "display:none;")" />
                            <input type="hidden" name="pageSize" id="ppvPageSizeValue" value="@Model.PageSize" />
                        </div>
                    </div>
                </div>
                <div class="mt-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm">Apply Filters</button>
                    <a asp-controller="PayerPolicyValidation" asp-action="Index" asp-route-lab="@Model.SelectedLab"
                       class="btn btn-outline-secondary btn-sm">Clear</a>
                    @if (Model.DataLoaded)
                    {
                        <button type="button" id="ppvExportBtn" class="btn btn-sm btn-outline-success ms-auto"
                                data-db-enabled="@(Model.DbEnabled ? "1" : "0")">
                            <i class="bi bi-file-earmark-excel me-1"></i>Download Excel
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (!Model.DataLoaded)
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-table fs-1 opacity-50"></i>
            <div class="mt-2 fw-semibold">Select filters and click <em>Apply Filters</em></div>
            <div class="small">Data loads from <strong>@Model.SelectedLab</strong> — dbo.PayerValidationReport</div>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-2 small text-muted">
            <span>
                Showing @Model.Paging.FirstItem–@Model.Paging.LastItem of @Model.Paging.TotalFiltered.ToString("N0") filtered rows
                (@Model.Paging.TotalAll.ToString("N0") total in table)
            </span>
        </div>

        <div class="ppv-grid-scroll mb-3">
            <table class="ppv-table">
                <thead>
                    <tr>
                        @for (var c = 0; c < columns.Count; c++)
                        {
                            var fz = c == 0 ? "ppv-fz1" : c == 1 ? "ppv-fz2" : "";
                            <th class="@fz">@columns[c].Header</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Records)
                    {
                        <tr>
                            @for (var c = 0; c < columns.Count; c++)
                            {
                                var col = columns[c];
                                var cls = (c == 0 ? "ppv-fz1" : c == 1 ? "ppv-fz2" : "")
                                          + (col.IsMoney ? " ppv-money" : "");
                                var text = CellText(col, r);
                                if (c < 2)
                                {
                                    <td class="@cls" title="@text">@text</td>
                                }
                                else
                                {
                                    <td class="@cls">@text</td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Paging.TotalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm justify-content-center">
                    @if (Model.Paging.HasPrev)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-all-route-data="f" asp-route-page="@(Model.Paging.CurrentPage - 1)">Previous</a>
                        </li>
                    }
                    <li class="page-item disabled">
                        <span class="page-link">Page @Model.Paging.CurrentPage of @Model.Paging.TotalPages</span>
                    </li>
                    @if (Model.Paging.HasNext)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-all-route-data="f" asp-route-page="@(Model.Paging.CurrentPage + 1)">Next</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>

@section Scripts {
<script nonce='@Context.Items["CspNonce"]'>
(function () {
    // ── Display Records: preset sizes + custom value ─────────────────────
    var sizeSelect = document.getElementById('ppvPageSizeSelect');
    var sizeCustom = document.getElementById('ppvPageSizeCustom');
    var sizeValue  = document.getElementById('ppvPageSizeValue');

    function syncPageSize() {
        if (!sizeSelect || !sizeValue) return;
        if (sizeSelect.value === 'custom') {
            if (sizeCustom) {
                sizeCustom.style.display = '';
                var v = parseInt(sizeCustom.value, 10);
                sizeValue.value = (v && v > 0) ? v : '50';
            }
        } else {
            if (sizeCustom) sizeCustom.style.display = 'none';
            sizeValue.value = sizeSelect.value;
        }
    }
    if (sizeSelect) sizeSelect.addEventListener('change', syncPageSize);
    if (sizeCustom) sizeCustom.addEventListener('input', syncPageSize);

    var form = document.getElementById('ppvFilterForm');
    if (form) form.addEventListener('submit', syncPageSize);

    // ── Excel export ──────────────────────────────────────────────────────
    // DB-enabled labs: ASYNC — queue the request, LRN.ReportWorker generates it,
    // the 📄 Reports badge notifies when it's ready. No more long waits/timeouts.
    // File-based labs: legacy synchronous download (no queue table available).
    var btn = document.getElementById('ppvExportBtn');

    function queueAsyncExport() {
        var fd = new FormData(form);
        var val = function (n) { return (fd.get(n) || '').toString().trim() || null; };
        var filters = {
            PayerName:                      val('filterPayerName'),
            PanelName:                      val('filterPanelName'),
            FinalCoverageStatus:            val('filterFinalCoverageStatus'),
            CPTCode:                        val('filterCPTCode'),
            ForecastingPayabilitySubstatus: val('filterForecastingPayabilitySubstatus'),
            PredictionStatus:               val('filterPredictionStatus'),
            PayStatus:                      val('filterPayStatus')
        };

        var body = new FormData();
        body.append('lab', '@Model.SelectedLab');
        body.append('reportType', 'PayerPolicyValidation');
        body.append('filterDetails', JSON.stringify(filters));
        var af = document.querySelector('#lrnReportsAf input[name="__RequestVerificationToken"]');
        if (af) body.append('__RequestVerificationToken', af.value);

        var original = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Queuing…';

        fetch('@Url.Action("Queue", "UserReports")', { method: 'POST', body: body })
            .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, status: r.status, j: j }; }); })
            .then(function (res) {
                if (res.ok) {
                    btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Generating — watch <strong>Reports</strong> 📄';
                    if (window.lrnShowReportAlert) window.lrnShowReportAlert('success');
                    if (window.lrnReportsBadgeRefresh) window.lrnReportsBadgeRefresh();
                } else {
                    btn.innerHTML = original;
                    var qMsg = res.j && res.j.message ? res.j.message : '';
                    if (window.lrnShowReportAlert) {
                        if (res.status === 409 || /already/i.test(qMsg)) {
                            window.lrnShowReportAlert('info');
                        } else {
                            window.lrnShowReportAlert('error', { message: qMsg || 'Could not queue the report.' });
                        }
                    }
                }
            })
            .catch(function () {
                btn.innerHTML = original;
                if (window.lrnShowReportAlert) {
                    window.lrnShowReportAlert('error', { message: 'Could not queue the report. Please try again.' });
                }
            })
            .finally(function () {
                setTimeout(function () { btn.disabled = false; btn.innerHTML = original; }, 8000);
            });
    }

    function legacySyncExport() {
        var params = new URLSearchParams(new FormData(form));
        params.delete('pageSize');
        var url = '@Url.Action("ExportExcel", "PayerPolicyValidation")' + '?' + params.toString();
        if (window.lmdExcelDownload) {
            window.lmdExcelDownload(url);
        } else {
            window.location.href = url;
        }
    }

    if (btn) {
        btn.addEventListener('click', function () {
            if (btn.getAttribute('data-db-enabled') === '1') queueAsyncExport();
            else legacySyncExport();
        });
    }
})();
</script>
}
