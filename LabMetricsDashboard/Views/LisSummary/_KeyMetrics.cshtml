@using System.Globalization
@model LabMetricsDashboard.Models.LisKeyMetricsBlock

@{
    string FormatMetric(double? value) =>
        value.HasValue ? value.Value.ToString("0.##", CultureInfo.InvariantCulture) : "—";

    string DeltaClass(double? current, double? previous)
    {
        if (!current.HasValue || !previous.HasValue) return "is-flat";
        var delta = current.Value - previous.Value;
        if (Math.Abs(delta) < 0.005) return "is-flat";
        // Lower turnaround / bill time is better.
        return delta < 0 ? "is-better" : "is-worse";
    }

    string FormatDelta(double? current, double? previous)
    {
        if (!current.HasValue || !previous.HasValue) return string.Empty;
        var delta = current.Value - previous.Value;
        if (Math.Abs(delta) < 0.005) return "·";
        var arrow = delta < 0 ? "↓" : "↑";
        return $"{arrow} {Math.Abs(delta).ToString("0.##", CultureInfo.InvariantCulture)}";
    }

    var months = Model.Months;
}

<div class="lis-km card border-0 table-card mb-3">
    <div class="card-body lis-km-body">
        <div class="lis-km-header">
            <div>
                <div class="section-title mb-0">Key Metrics</div>
                <div class="section-subtitle">
                    Recent 4 Months by @Model.CollectionDateLabel
                </div>
            </div>
            <div class="lis-km-filter" title="Filter applied to Key Metrics averages">
                <span class="lis-km-filter-label">Filter</span>
                <span>@Model.CollectionDateLabel · exclude blanks · monthly average</span>
            </div>
        </div>

        <div class="lis-km-panel">
            <table class="lis-km-table">
                <thead>
                    <tr>
                        <th scope="col" class="lis-km-metric-head">Metrics</th>
                        @for (var i = 0; i < months.Count; i++)
                        {
                            var isLatest = i == months.Count - 1;
                            <th scope="col" class="@(isLatest ? "lis-km-latest" : null)">@months[i].Label</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th scope="row" class="lis-km-metric-name">
                            <span class="lis-km-metric-title">Time to Result</span>
                            <span class="lis-km-metric-unit">days avg</span>
                        </th>
                        @for (var i = 0; i < months.Count; i++)
                        {
                            var month = months[i];
                            var prev = i > 0 ? months[i - 1].AvgTimeToResult : null;
                            var isLatest = i == months.Count - 1;
                            <td class="@(isLatest ? "lis-km-latest" : null)">
                                <span class="lis-km-value">@FormatMetric(month.AvgTimeToResult)</span>
                                @if (i > 0)
                                {
                                    <span class="lis-km-delta @DeltaClass(month.AvgTimeToResult, prev)">@FormatDelta(month.AvgTimeToResult, prev)</span>
                                }
                            </td>
                        }
                    </tr>
                    <tr>
                        <th scope="row" class="lis-km-metric-name">
                            <span class="lis-km-metric-title">Time to Bill</span>
                            <span class="lis-km-metric-unit">days avg</span>
                        </th>
                        @for (var i = 0; i < months.Count; i++)
                        {
                            var month = months[i];
                            var prev = i > 0 ? months[i - 1].AvgTimeToBill : null;
                            var isLatest = i == months.Count - 1;
                            <td class="@(isLatest ? "lis-km-latest" : null)">
                                <span class="lis-km-value">@FormatMetric(month.AvgTimeToBill)</span>
                                @if (i > 0)
                                {
                                    <span class="lis-km-delta @DeltaClass(month.AvgTimeToBill, prev)">@FormatDelta(month.AvgTimeToBill, prev)</span>
                                }
                            </td>
                        }
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
