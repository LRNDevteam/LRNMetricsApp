@using System.Globalization
@model LabMetricsDashboard.ViewModels.LisSummaryPageViewModel
@{
    ViewData["Title"] = $"LIS Summary – {Model.CurrentLabName}";
    ViewData["SelectedLab"] = Model.CurrentLabName;
    ViewData["PageLabel"] = "LIS Summary";
    var result = Model.Result;
    var monthColumns = new List<(string Key, int Year, string Label, bool IsYearTotal)>();
    if (result is not null)
    {
        foreach (var year in result.Years.OrderBy(x => x))
        {
            var yearMonths = result.Months.Where(x => x.StartsWith($"{year:D4}-", StringComparison.OrdinalIgnoreCase)).OrderBy(x => x).ToList();
            foreach (var monthKey in yearMonths)
            {
                var month = int.Parse(monthKey[^2..]);
                monthColumns.Add((monthKey, year, new DateTime(year, month, 1).ToString("MMM-yyyy"), false));
            }
            if (yearMonths.Count > 0)
            {
                monthColumns.Add(($"{year:D4}-TOTAL", year, $"{year} Total", true));
            }
        }
    }

    var useUploadedLogicTemplate = false;
    var logicTemplateCss = string.Empty;
    string DateValue(DateOnly? value) => value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty;
    string RowCss(int level) => level <= 0 ? "lis-summary-section-row" : level == 1 ? "lis-summary-level-one" : level == 2 ? "lis-summary-level-two" : "lis-summary-level-three";
    var filters = Model.Filters;
    var activeTab = filters.EffectiveActiveTab;
    var lineData = Model.LineData;
    var totalPages = lineData is null ? 1 : Math.Max(1, (int)Math.Ceiling(lineData.TotalCount / (double)lineData.PageSize));
    bool IsSelected(string? current, string value) => string.Equals(current, value, StringComparison.OrdinalIgnoreCase);
    string TabUrl(string tab, int? pageNumber = null) => Url.Action("Index", "LisSummary", new
    {
        lab = Model.CurrentLabName,
        LabId = filters.LabId,
        DateType = filters.EffectiveDateType,
        DateFrom = DateValue(filters.EffectiveDateFrom),
        DateTo = DateValue(filters.EffectiveDateTo),
        Panel = filters.Panel,
        Clinic = filters.Clinic,
        RefPhy = filters.RefPhy,
        SalesRep = filters.SalesRep,
        ActiveTab = tab,
        PageNumber = pageNumber ?? filters.PageNumber,
        PageSize = filters.PageSize
    }) ?? "#";
    string ExportUrl() => Url.Action("ExportToExcel", "LisSummary", new
    {
        lab = Model.CurrentLabName,
        LabId = filters.LabId,
        DateType = filters.EffectiveDateType,
        DateFrom = DateValue(filters.EffectiveDateFrom),
        DateTo = DateValue(filters.EffectiveDateTo),
        Panel = filters.Panel,
        Clinic = filters.Clinic,
        RefPhy = filters.RefPhy,
        SalesRep = filters.SalesRep,
        ActiveTab = filters.EffectiveActiveTab
    }) ?? "#";
    string FormatDateTime(DateTime? value) => value?.ToString("MM/dd/yyyy", CultureInfo.InvariantCulture) ?? string.Empty;
}

