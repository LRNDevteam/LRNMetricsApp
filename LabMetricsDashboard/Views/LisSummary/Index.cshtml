    }

    .lis-summary-level-two td:nth-child(2) {
        padding-left: 1.5rem !important;
    }

    .year-total-cell {
        background: #fff8df !important;
        font-weight: 800;
        color: #001b44;
    }

    .grand-total-cell,
    .grand-total-row td {
        background: #fff2cc !important;
        font-weight: 900;
        color: #001b44;
    }

    .grand-total-row .sticky-col-1,
    .grand-total-row .sticky-col-2 {
        background: #fff2cc !important;
    }

    .lis-summary-table.lis-freeze-table tbody tr:last-child td,
    .lis-summary-table.lis-freeze-table tbody tr.lis-summary-section-row:last-child td {
        background: #e5f4ee !important;
        color: #007044;
        font-weight: 900;
    }

    .lis-filter-row {
        display: flex;
        align-items: end;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .lis-filter-item {
        width: 285px;
    }

    .lis-filter-item-sm {
        width: 190px;
    }

    .lis-filter-actions {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding-bottom: 1px;
    }

        .lis-filter-actions .btn {
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

    @@media (max-width: 768px) {
        .lis-filter-item {
            width: 100%;
        }

        .lis-filter-actions {
            width: 100%;
            flex-wrap: wrap;
        }
    }

    .lis-tabs {
        display: inline-flex;
        gap: .35rem;
        padding: .3rem;
        border: 1px solid #d8e2ee;
        border-radius: .85rem;
        background: #f6f9fc;
    }

    .lis-tab {
        min-height: 36px;
        padding: .45rem .9rem;
        border-radius: .6rem;
        color: #294766;
        font-weight: 700;
        text-decoration: none;
    }

    .lis-tab.active {
        background: #123b63;
        color: #fff;
    }

    .lis-line-table {
        width: max-content;
        min-width: 100%;
        font-size: .78rem;
        color: #00214d;
    }

    .lis-line-table th {
        background: #123b63;
        color: #fff;
        white-space: nowrap;
        position: sticky;
        top: 0;
        z-index: 4;
    }

    .lis-line-table td {
        white-space: nowrap;
        vertical-align: middle;
    }
</style>

@if (TempData["LisSummaryError"] is string error && !string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-warning border-0 shadow-sm">@error</div>
}

<div class="lis-filter-shell card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
            <div>
                <div class="section-title">LIS Summary</div>
                @* <div class="section-subtitle">Grouped by collected date and calculated using the lab-specific Excel logic.</div> *@
            </div>
            <div class="d-flex flex-wrap gap-2">
                <span class="chip">Lab: @(string.IsNullOrWhiteSpace(Model.CurrentLabName) ? "-" : Model.CurrentLabName)</span>
                @if (result is not null)
                {
                    <span class="chip">Source File Name: @(string.IsNullOrWhiteSpace(result.SourceFileName) ? "-" : result.SourceFileName)</span>
                    <span class="chip">Total: @result.GrandTotal.ToString("N0")</span>
                }
            </div>
        </div>

        <form method="get" asp-action="Index" asp-controller="LisSummary" class="lis-filter-row">
            <input type="hidden" name="lab" value="@Model.CurrentLabName" />
            <input type="hidden" name="LabId" value="@filters.LabId" />
            <input type="hidden" name="ActiveTab" value="@activeTab" />
            <input type="hidden" name="PageNumber" value="1" />
            <input type="hidden" name="PageSize" value="@filters.PageSize" />

            <div class="lis-filter-item-sm">
                <label class="form-label">Date Type</label>
                <select class="form-select filter-select" name="DateType">
                    <option value="Collected" selected="@IsSelected(filters.EffectiveDateType, "Collected")">Collected</option>
                    <option value="Received" selected="@IsSelected(filters.EffectiveDateType, "Received")">Received</option>
                    <option value="Resulted" selected="@IsSelected(filters.EffectiveDateType, "Resulted")">Resulted</option>
                </select>
            </div>

            <div class="lis-filter-item-sm">
                <label class="form-label">Date From</label>
                <input class="form-control filter-select" type="date" name="DateFrom"
                       value="@DateValue(filters.EffectiveDateFrom)" />
            </div>

            <div class="lis-filter-item-sm">
                <label class="form-label">Date To</label>
                <input class="form-control filter-select" type="date" name="DateTo"
                       value="@DateValue(filters.EffectiveDateTo)" />
            </div>

            <div class="lis-filter-item">
                <label class="form-label">Panel</label>
                <select class="form-select filter-select" name="Panel">
                    <option value="">All</option>
                    @foreach (var option in Model.FilterOptions.Panels)
                    {
                        <option value="@option" selected="@IsSelected(filters.Panel, option)">@option</option>
                    }
                </select>
            </div>

            <div class="lis-filter-item">
                <label class="form-label">Clinic</label>
                <select class="form-select filter-select" name="Clinic">
                    <option value="">All</option>
                    @foreach (var option in Model.FilterOptions.Clinics)
                    {
                        <option value="@option" selected="@IsSelected(filters.Clinic, option)">@option</option>
                    }
                </select>
            </div>

            <div class="lis-filter-item">
                <label class="form-label">Ref Phy</label>
                <select class="form-select filter-select" name="RefPhy">
                    <option value="">All</option>
                    @foreach (var option in Model.FilterOptions.RefPhysicians)
                    {
                        <option value="@option" selected="@IsSelected(filters.RefPhy, option)">@option</option>
                    }
                </select>
            </div>

            <div class="lis-filter-item">
                <label class="form-label">Sales Rep</label>
                <select class="form-select filter-select" name="SalesRep">
                    <option value="">All</option>
                    @foreach (var option in Model.FilterOptions.SalesReps)
                    {
                        <option value="@option" selected="@IsSelected(filters.SalesRep, option)">@option</option>
                    }
                </select>
            </div>

            <div class="lis-filter-actions">
                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-funnel me-1"></i>Apply Filters
                </button>

                <a class="btn btn-outline-success rounded-pill px-4"
                   href="@ExportUrl()">
                    <i class="bi bi-file-earmark-excel me-1"></i>Export Excel
                </a>
            </div>
        </form>

        <div class="mt-3">
            <div class="lis-tabs" role="tablist" aria-label="LIS Summary tabs">
                <a class="lis-tab @(activeTab == "summary" ? "active" : "")" href="@TabUrl("summary", 1)">LIMS Summary</a>
                <a class="lis-tab @(activeTab == "line" ? "active" : "")" href="@TabUrl("line", 1)">LIMS Line Data</a>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning border-0 shadow-sm">@Model.ErrorMessage</div>
}
else if (result is null)
{
    <div class="alert alert-info border-0 shadow-sm">No LIS Summary data found.</div>
}
else if (activeTab == "summary")
{
    <div class="lis-kpi-grid">
        <div class="lis-kpi-card">
            <div class="lis-kpi-label">Total Samples</div>
            <div class="lis-kpi-value">@result.KpiCards.TotalSamples.ToString("N0")</div>
        </div>
        <div class="lis-kpi-card">
            <div class="lis-kpi-label">Billed Count</div>
            <div class="lis-kpi-value">@result.KpiCards.BilledCount.ToString("N0")</div>
        </div>
        <div class="lis-kpi-card">
            <div class="lis-kpi-label">Unbilled Count</div>
            <div class="lis-kpi-value">@result.KpiCards.UnbilledCount.ToString("N0")</div>
        </div>
        <div class="lis-kpi-card">
            <div class="lis-kpi-label">Self Pay Count</div>
            <div class="lis-kpi-value">@result.KpiCards.SelfPayCount.ToString("N0")</div>
        </div>
    </div>

    <div class="card border-0 shadow-sm table-card">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <div class="section-title">@result.LogicSheetName Summary</div>
                    @* <div class="section-subtitle">Format follows the attached Excel logic workbook.</div> *@
                </div>
            </div>

            <div class="lis-freeze-scroll" id="lisSummaryFreeze">
                <table class="table table-sm lis-summary-table lis-freeze-table align-middle mb-0">
                    <thead>
                        <tr class="year-header">
                            <th rowspan="3" class="lis-code-col sticky-col-1">#</th>
                            <th rowspan="3" class="desc-col sticky-col-2 text-start">LIS STATUS SUMMARY</th>
                            @foreach (var year in result.Years.OrderBy(x => x))
                            {
                                var yearMonthCount = monthColumns.Count(x => x.Year == year);
                                if (yearMonthCount > 0)
                                {
                                    <th colspan="@yearMonthCount">@year</th>
                                }
                            }
                            <th rowspan="3" class="grand-total-cell">TOTAL</th>
                        </tr>
                        <tr class="month-header">
                            @foreach (var column in monthColumns)
                            {
                                var label = column.IsYearTotal ? $"{column.Year} TOTAL" : new DateTime(column.Year, int.Parse(column.Key[^2..]), 1).ToString("MMM", CultureInfo.InvariantCulture).ToUpperInvariant();
                                <th class="@(column.IsYearTotal ? "year-total-head" : "")">@label</th>
                            }
                        </tr>
                        <tr class="sample-header">
                            @foreach (var column in monthColumns)
                            {
                                <th class="@(column.IsYearTotal ? "year-total-head" : "")">SAMPLES</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var rowIndex = 0; rowIndex < result.Rows.Count; rowIndex++)
                        {
                            var row = result.Rows[rowIndex];
                            var hasChildren = rowIndex + 1 < result.Rows.Count && result.Rows[rowIndex + 1].Level > row.Level;
                            <tr class="@RowCss(row.Level) @(hasChildren ? "lis-summary-has-children" : "")" data-lis-row="true" data-level="@row.Level" data-expanded="true">
                                <td class="lis-code-col sticky-col-1">@row.Code</td>
                                <td class="desc-col sticky-col-2">
                                    <span class="lis-summary-desc-content" style="--lis-row-level:@row.Level">
                                        @if (hasChildren)
                                        {
                                            <button type="button" class="lis-toggle-btn" aria-label="Collapse @row.Description" aria-expanded="true">▾</button>
                                        }
                                        else
                                        {
                                            <span class="lis-toggle-placeholder"></span>
                                        }
                                        <span>@row.Description</span>
                                    </span>
                                </td>
                                @foreach (var column in monthColumns)
                                {
                                    if (column.IsYearTotal)
                                    {
                                        <td class="count-cell year-total-cell">@(row.ByYear.TryGetValue(column.Year, out var yearTotal) ? yearTotal.ToString("N0") : "0")</td>
                                    }
                                    else
                                    {
                                        <td class="count-cell">@(row.ByMonth.TryGetValue(column.Key, out var monthTotal) ? monthTotal.ToString("N0") : "0")</td>
                                    }
                                }
                                <td class="count-cell grand-total-cell">@row.Total.ToString("N0")</td>
                            </tr>
                        }
                        <tr class="grand-total-row">
                            <td class="lis-code-col sticky-col-1"></td>
                            <td class="desc-col sticky-col-2">Grand Total</td>
                            @foreach (var column in monthColumns)
                            {
                                if (column.IsYearTotal)
                                {
                                    <td class="count-cell">@(result.GrandTotalByYear.TryGetValue(column.Year, out var yearTotal) ? yearTotal.ToString("N0") : "0")</td>
                                }
                                else
                                {
                                    <td class="count-cell">@(result.GrandTotalByMonth.TryGetValue(column.Key, out var monthTotal) ? monthTotal.ToString("N0") : "0")</td>
                                }
                            }
                            <td class="count-cell">@result.GrandTotal.ToString("N0")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm table-card">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                <div>
                    <div class="section-title">LIMS Line Data</div>
                    <div class="section-subtitle">@((lineData?.TotalCount ?? 0).ToString("N0")) rows</div>
                </div>
                @if (lineData is not null && totalPages > 1)
                {
                    <div class="d-flex align-items-center gap-2">
                        <a class="btn btn-sm btn-outline-primary @(lineData.PageNumber <= 1 ? "disabled" : "")"
                           href="@TabUrl("line", Math.Max(1, lineData.PageNumber - 1))">Previous</a>
                        <span class="chip">Page @lineData.PageNumber of @totalPages</span>
                        <a class="btn btn-sm btn-outline-primary @(lineData.PageNumber >= totalPages ? "disabled" : "")"
                           href="@TabUrl("line", Math.Min(totalPages, lineData.PageNumber + 1))">Next</a>
                    </div>
                }
            </div>

            @if (lineData is null || lineData.Rows.Count == 0)
            {
                <div class="alert alert-info border-0 shadow-sm mb-0">No LIMS line data found for the selected filters.</div>
            }
            else
            {
                <div class="lis-freeze-scroll">
                    <table class="table table-sm table-bordered lis-line-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Order Id</th>
                                <th>Sample Id</th>
                                <th>Payment Method</th>
                                <th>Barcode</th>
                                <th>Specimen</th>
                                <th>Collector</th>
                                <th>Order Status</th>
                                <th>Billing Status</th>
                                <th>Sample Status</th>
                                <th>Request Submitted Date</th>
                                <th>Request Collect Date</th>
                                <th>Req Received Date</th>
                                <th>Req Reported Date</th>
                                <th>Resulted Status</th>
                                <th>Client Status</th>
                                <th>Time to Result</th>
                                <th>Turnaround Time</th>
                                <th>Performing Laboratory</th>
                                <th>Results</th>
                                <th>Patient First Name</th>
                                <th>Patient Last Name</th>
                                <th>Patient DOB</th>
                                <th>Visit Number</th>
                                <th>AMD DOE</th>
                                <th>AMD LBD</th>
                                <th>Time to Bill</th>
                                <th>Claim Status</th>
                                <th>Billed or Not</th>
                                <th>Provider</th>
                                <th>Primary Insurance</th>
                                <th>Primary Insurance ID</th>
                                <th>ICD10 Codes</th>
                                <th>Tests</th>
                                <th>Panel Category</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in lineData.Rows)
                            {
                                <tr>
                                    <td>@row.OrderId</td>
                                    <td>@row.SampleId</td>
                                    <td>@row.PaymentMethod</td>
                                    <td>@row.Barcode</td>
                                    <td>@row.Specimen</td>
                                    <td>@row.Collector</td>
                                    <td>@row.OrderStatus</td>
                                    <td>@row.BillingStatus</td>
                                    <td>@row.SampleStatus</td>
                                    <td>@FormatDateTime(row.RequestSubmittedDate)</td>
                                    <td>@FormatDateTime(row.RequestCollectDate)</td>
                                    <td>@FormatDateTime(row.ReqReceivedDate)</td>
                                    <td>@FormatDateTime(row.ReqReportedDate)</td>
                                    <td>@row.ResultedStatus</td>
                                    <td>@row.ClientStatus</td>
                                    <td>@row.TimetoResult</td>
                                    <td>@row.TurnaroundTime</td>
                                    <td>@row.PerformingLaboratory</td>
                                    <td>@row.Results</td>
                                    <td>@row.PatientFirstName</td>
                                    <td>@row.PatientLastName</td>
                                    <td>@FormatDateTime(row.PatientDateofBirth)</td>
                                    <td>@row.VisitNumber</td>
                                    <td>@row.AMDDOE</td>
                                    <td>@row.AMDLBD</td>
                                    <td>@row.TimetoBill</td>
                                    <td>@row.ClaimStatus</td>
                                    <td>@row.BilledorNot</td>
                                    <td>@row.Provider</td>
                                    <td>@row.PrimaryInsurance</td>
                                    <td>@row.PrimaryInsuranceID</td>
                                    <td>@row.ICD10Codes</td>
                                    <td>@row.Tests</td>
                                    <td>@row.PanelCategory</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}


<script>
    (function () {
        const root = document.getElementById('lisSummaryFreeze');
        if (!root) return;

        const updateLisHeaderOffsets = () => {
            let top = 0;
            root.querySelectorAll('thead tr').forEach(row => {
                row.querySelectorAll('th').forEach(cell => cell.style.setProperty('--lis-sticky-top', `${top}px`));
                top += row.getBoundingClientRect().height;
            });
        };

        const updateHierarchy = () => {
            const rows = Array.from(root.querySelectorAll('tbody tr[data-lis-row="true"]'));
            const expandedByLevel = [];

            rows.forEach(row => {
                const level = Number(row.dataset.level || 0);
                expandedByLevel.length = level;
                const isVisible = expandedByLevel.every(Boolean);
                row.hidden = !isVisible;

                const isExpanded = row.dataset.expanded !== 'false';
                expandedByLevel[level] = isVisible && isExpanded;

                const button = row.querySelector('.lis-toggle-btn');
                if (button) {
                    button.textContent = isExpanded ? '▾' : '▸';
                    button.setAttribute('aria-expanded', String(isExpanded));
                    button.setAttribute('aria-label', `${isExpanded ? 'Collapse' : 'Expand'} ${row.querySelector('.lis-summary-desc-content span:last-child')?.textContent?.trim() || 'row'}`);
                }
            });
        };

        root.addEventListener('click', event => {
            const button = event.target.closest('.lis-toggle-btn');
            const row = event.target.closest('tr[data-lis-row="true"]');
            if (!row || !root.contains(row) || !row.classList.contains('lis-summary-has-children')) return;
            if (!button && event.target.closest('a, input, select, textarea')) return;

            row.dataset.expanded = row.dataset.expanded === 'false' ? 'true' : 'false';
            updateHierarchy();
            requestAnimationFrame(updateLisHeaderOffsets);
        });

        updateHierarchy();
        requestAnimationFrame(updateLisHeaderOffsets);
        window.addEventListener('resize', updateLisHeaderOffsets, { passive: true });
    })();
</script>
