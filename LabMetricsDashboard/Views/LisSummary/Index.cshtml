<script nonce='@Context.Items["CspNonce"]'>
    (function () {
        const form = document.getElementById('lisFilterForm');
        if (!form) return;

        const dateRange = document.getElementById('lisDateRange');
        const fromInput = document.getElementById('lisDateFrom');
        const toInput = document.getElementById('lisDateTo');
        const customDateBlocks = Array.from(document.querySelectorAll('.lis-custom-date'));

        function formatDate(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function startOfWeek(date) {
            const result = new Date(date);
            const offset = (result.getDay() + 6) % 7;
            result.setDate(result.getDate() - offset);
            return result;
        }

        function applyDatePreset() {
            if (!dateRange || !fromInput || !toInput) return;

            const today = new Date();
            const current = dateRange.value;
            const isCustom = current === 'custom';

            customDateBlocks.forEach(block => block.classList.toggle('is-hidden', !isCustom));

            if (isCustom) {
                if (fromInput.value && !toInput.value) {
                    toInput.value = formatDate(today);
                }
                return;
            }

            let from = new Date(today);
            let to = new Date(today);

            if (current === 'this-week') {
                from = startOfWeek(today);
            } else if (current === 'last-week') {
                to = startOfWeek(today);
                to.setDate(to.getDate() - 1);
                from = new Date(to);
                from.setDate(from.getDate() - 6);
            } else if (current === 'this-month') {
                from = new Date(today.getFullYear(), today.getMonth(), 1);
            } else if (current === 'last-month') {
                from = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                to = new Date(today.getFullYear(), today.getMonth(), 0);
            }

            fromInput.value = formatDate(from);
            toInput.value = formatDate(to);
        }

        dateRange?.addEventListener('change', applyDatePreset);
        form.addEventListener('submit', applyDatePreset);
        applyDatePreset();

        function selectedCheckboxes(widget) {
            return Array.from(widget.querySelectorAll('.lis-ms-option input[type="checkbox"]:checked'));
        }

        function updateMultiSelect(widget) {
            const hidden = widget.querySelector('input[type="hidden"]');
            const label = widget.querySelector('.lis-ms-label');
            const clear = widget.querySelector('.lis-ms-clear');
            const selected = selectedCheckboxes(widget);
            const values = selected.map(input => input.value);

            if (hidden) hidden.value = values.join('|');
            clear?.classList.toggle('is-visible', values.length > 0);

            if (!label) return;
            if (values.length === 0) {
                label.textContent = 'All';
            } else if (values.length === 1) {
                label.textContent = values[0];
            } else {
                label.textContent = `${values[0]} +${values.length - 1}`;
            }
        }

        function closeMultiSelects(exceptPanel) {
            document.querySelectorAll('.lis-ms-panel.open').forEach(panel => {
                if (panel !== exceptPanel) {
                    panel.classList.remove('open');
                    panel.closest('[data-lis-ms]')?.querySelector('.lis-ms-btn')?.setAttribute('aria-expanded', 'false');
                }
            });
        }

        document.querySelectorAll('[data-lis-ms]').forEach(widget => {
            const button = widget.querySelector('.lis-ms-btn');
            const panel = widget.querySelector('.lis-ms-panel');
            const search = widget.querySelector('.lis-ms-search');
            const clear = widget.querySelector('.lis-ms-clear');

            updateMultiSelect(widget);

            button?.addEventListener('click', event => {
                event.stopPropagation();
                const isOpen = panel?.classList.contains('open');
                closeMultiSelects(panel);
                if (panel && !isOpen) {
                    panel.classList.add('open');
                    button.setAttribute('aria-expanded', 'true');
                    if (search) {
                        search.value = '';
                        search.dispatchEvent(new Event('input'));
                        search.focus();
                    }
                }
            });

            panel?.addEventListener('click', event => event.stopPropagation());

            const clearSelection = event => {
                event.preventDefault();
                event.stopPropagation();
                widget.querySelectorAll('.lis-ms-option input[type="checkbox"]:checked')
                    .forEach(input => input.checked = false);
                updateMultiSelect(widget);
            };

            clear?.addEventListener('click', clearSelection);
            clear?.addEventListener('keydown', event => {
                if (event.key === 'Enter' || event.key === ' ') clearSelection(event);
            });

            widget.addEventListener('change', () => updateMultiSelect(widget));

            search?.addEventListener('input', () => {
                const term = search.value.trim().toLowerCase();
                widget.querySelectorAll('.lis-ms-option').forEach(option => {
                    option.classList.toggle('lis-ms-hidden', term !== '' && !option.textContent.toLowerCase().includes(term));
                });
            });
        });

        document.addEventListener('click', () => closeMultiSelects(null));
    })();

    window.lmdInitLisFreeze = function () {
        const root = document.getElementById('lisSummaryFreeze');
        if (!root || root.getAttribute('data-lis-freeze') === '1') return;
        root.setAttribute('data-lis-freeze', '1');

        const updateLisHeaderOffsets = () => {
            let top = 0;
            root.querySelectorAll('thead tr').forEach(row => {
                row.querySelectorAll('th').forEach(cell => cell.style.setProperty('--lis-sticky-top', `${top}px`));
                top += row.getBoundingClientRect().height;
            });
        };

        const updateHierarchy = () => {
            const rows = Array.from(root.querySelectorAll('tbody tr[data-lis-row="true"]'));
            const expandedByLevel = [];

            rows.forEach(row => {
                const level = Number(row.dataset.level || 0);
                expandedByLevel.length = level;
                const isVisible = expandedByLevel.every(Boolean);
                row.hidden = !isVisible;

                const isExpanded = row.dataset.expanded !== 'false';
                expandedByLevel[level] = isVisible && isExpanded;

                const button = row.querySelector('.lis-toggle-btn');
                if (button) {
                    button.textContent = isExpanded ? '▾' : '▸';
                    button.setAttribute('aria-expanded', String(isExpanded));
                    button.setAttribute('aria-label', `${isExpanded ? 'Collapse' : 'Expand'} ${row.querySelector('.lis-summary-desc-content span:last-child')?.textContent?.trim() || 'row'}`);
                }
            });
        };

        root.addEventListener('click', event => {
            const button = event.target.closest('.lis-toggle-btn');
            const row = event.target.closest('tr[data-lis-row="true"]');
            if (!row || !root.contains(row) || !row.classList.contains('lis-summary-has-children')) return;
            if (!button && event.target.closest('a, input, select, textarea')) return;

            row.dataset.expanded = row.dataset.expanded === 'false' ? 'true' : 'false';
            updateHierarchy();
            requestAnimationFrame(updateLisHeaderOffsets);
        });

        updateHierarchy();
        requestAnimationFrame(updateLisHeaderOffsets);
        window.addEventListener('resize', updateLisHeaderOffsets, { passive: true });
    };
    window.lmdInitLisFreeze();

    (function () {
        var host = document.getElementById('lisResultHost');
        if (!host || !document.getElementById('lisResultSpinner')) return;
        if (window.lmdFpLog) window.lmdFpLog('spinner-on', 'page landed — in-page spinner on');
        var qs = window.location.search || '';
        fetch('@Url.Action("GetSummary", "LisSummary")' + qs, { credentials: 'same-origin' })
            .then(function (r) { return r.text(); })
            .then(function (html) {
                host.innerHTML = html;
                if (window.lmdInitLisFreeze) window.lmdInitLisFreeze();
                if (window.lmdFpLog) window.lmdFpLog('monthly-html', 'LIS summary HTML on screen');
            })
            .catch(function () {
                host.innerHTML = '<div class="alert alert-warning border-0 shadow-sm">Failed to load LIS Summary. Please refresh the page.</div>';
            });
        fetch('@Url.Action("GetMeta", "LisSummary")' + qs, { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (d) {
                if (!d) return;
                var labId = document.getElementById('lisLabId');
                if (labId && d.labId) labId.value = d.labId;
                function fill(listId, names, selectedPipe) {
                    var list = document.getElementById(listId);
                    if (!list || !names) return;
                    var selected = (selectedPipe || '').split('|').filter(Boolean);
                    list.innerHTML = '';
                    names.forEach(function (name) {
                        var label = document.createElement('label');
                        label.className = 'lis-ms-option';
                        var input = document.createElement('input');
                        input.type = 'checkbox';
                        input.value = name;
                        if (selected.indexOf(name) !== -1) input.checked = true;
                        var span = document.createElement('span');
                        span.textContent = name;
                        label.appendChild(input);
                        label.appendChild(span);
                        list.appendChild(label);
                    });
                    var widget = list.closest('[data-lis-ms]');
                    if (widget) widget.dispatchEvent(new Event('change', { bubbles: true }));
                }
                var form = document.getElementById('lisFilterForm');
                fill('lisPanelList', d.panels, form && form.Panel ? form.Panel.value : '');
                fill('lisClinicList', d.clinics, form && form.Clinic ? form.Clinic.value : '');
                fill('lisRefPhyList', d.refPhys, form && form.RefPhy ? form.RefPhy.value : '');
                fill('lisSalesRepList', d.salesReps, form && form.SalesRep ? form.SalesRep.value : '');
                fill('lisCollectorList', d.collectors, form && form.Collector ? form.Collector.value : '');
            })
            .catch(function () { });
    })();
</script>

@* ── Excel export ──────────────────────────────────────────────────────────────
   Queues a LisSummary report; LRN.ReportWorker builds the two-sheet workbook
   ("LIS Summary" + the FULL "LIMS Master" line-level sheet, with the
   AdditionalFields JSON expanded into real columns) and the 📄 Reports badge
   notifies when it is ready. Falls back to the synchronous download when the
   lab has no UserReqReports queue deployed. *@
<script nonce='@Context.Items["CspNonce"]'>
(function () {
    var btn  = document.getElementById('lisExportExcelBtn');
    var form = document.getElementById('lisFilterForm');
    if (!btn || !form) return;

    function legacyDownload() {
        var params = new URLSearchParams(new FormData(form));
        window.location.href = '@Url.Action("ExportToExcel", "LisSummary")' + '?' + params.toString();
    }

    btn.addEventListener('click', function () {
        var lab = '@Model.ConfiguredLabKey';
        if (!lab) { legacyDownload(); return; }

        var fd  = new FormData(form);
        var val = function (n) { return (fd.get(n) || '').toString().trim() || null; };
        var num = function (n) { var v = parseInt(val(n), 10); return isNaN(v) ? null : v; };

        var filters = {
            LabId:     num('LabId'),
            DateType:  val('DateType'),
            DateFrom:  val('DateFrom'),
            DateTo:    val('DateTo'),
            Panel:     val('Panel'),
            Clinic:    val('Clinic'),
            RefPhy:    val('RefPhy'),
            SalesRep:  val('SalesRep'),
            Collector: val('Collector'),
            // Not filters — these name the downloaded file after the run it came from.
            RunId:      '@Model.RunId' || null,
            WeekFolder: '@Model.WeekLabel' || null
        };

        var body = new FormData();
        body.append('lab', lab);
        body.append('reportType', 'LisSummary');
        body.append('filterDetails', JSON.stringify(filters));
        var af = document.querySelector('#lrnReportsAf input[name="__RequestVerificationToken"]');
        if (af) body.append('__RequestVerificationToken', af.value);

        var original = btn.innerHTML;
        btn.disabled = true;
        window.rptExportBusy(btn, '<span class="spinner-border spinner-border-sm"></span> Queuing\u2026');

        fetch('@Url.Action("Queue", "UserReports")', { method: 'POST', body: body })
            .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, status: r.status, j: j }; }); })
            .then(function (res) {
                if (res.ok) {
                    window.rptExportBusy(btn, '<i class="bi bi-check-circle"></i> Generating — watch Reports');
                    if (window.lrnShowReportAlert) window.lrnShowReportAlert('success');
                    if (window.lrnReportsBadgeRefresh) window.lrnReportsBadgeRefresh();
                    setTimeout(function () { window.rptExportIdle(btn, original); }, 8000);
                } else if (res.status === 400) {
                    window.rptExportIdle(btn, original);
                    legacyDownload();
                } else {
                    window.rptExportIdle(btn, original);
                    var qMsg = res.j && res.j.message ? res.j.message : '';
                    if (window.lrnShowReportAlert) {
                        if (res.status === 409 || /already/i.test(qMsg)) {
                            window.lrnShowReportAlert('info');
                        } else {
                            window.lrnShowReportAlert('error', { message: qMsg || 'Could not queue the report.' });
                        }
                    }
                }
            })
            .catch(function () {
                window.rptExportIdle(btn, original);
                legacyDownload();
            });
    });
})();
</script>
}
