@inherits Microsoft.AspNetCore.Mvc.Razor.RazorPage<LabMetricsDashboard.Models.AdminViewModel>
@model LabMetricsDashboard.Models.AdminViewModel
@{
    ViewData["Title"] = "Admin - User List";
    var roleOptions = Model.Roles
        .Where(role => !string.IsNullOrWhiteSpace(role.RoleName))
        .GroupBy(role => role.RoleName.Trim(), StringComparer.OrdinalIgnoreCase)
        .Select(group => group.First())
        .OrderBy(role => role.RoleName)
        .ToList();
    var labOptions = Model.Labs
        .Where(lab => lab.IsActive && !string.IsNullOrWhiteSpace(lab.LabName))
        .GroupBy(lab => lab.LabName.Trim(), StringComparer.OrdinalIgnoreCase)
        .Select(group => group.First())
        .OrderBy(lab => lab.LabName)
        .ToList();
    // Linking a Microsoft sign-in to an existing account is for full admins only.
    var canLinkAccounts = LabMetricsDashboard.Filters.MenuAccessFilter.IsFullAdmin(User);
}

<style>
    .users-page-shell {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 18px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
    }
    .users-header {
        gap: 12px;
    }
    .users-title {
        font-weight: 700;
        letter-spacing: 0;
    }
    .users-filter-panel {
        background: #fff;
        border: 1px solid #dbe4ef;
        border-radius: 12px;
        padding: 14px;
    }
    .users-filter-panel .form-label {
        color: #475569;
        font-size: .85rem;
        font-weight: 600;
        margin-bottom: .35rem;
    }
    .users-filter-panel .form-control,
    .users-filter-panel .form-select {
        border-color: #cbd5e1;
        border-radius: 10px;
        min-height: 42px;
    }
    .users-table-wrap {
        background: #fff;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        overflow: hidden;
    }
    .users-table {
        margin-bottom: 0;
        border-collapse: collapse;
    }
    .users-table thead th {
        background: #0f2942;
        color: #fff;
        border: 1px solid #27445f;
        font-size: .82rem;
        letter-spacing: .02em;
        text-transform: uppercase;
        white-space: nowrap;
        padding: .55rem .65rem;
    }
    .users-table thead th button {
        width: 100%;
        border: 0;
        background: transparent;
        color: inherit;
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 0;
        font: inherit;
        text-transform: inherit;
        letter-spacing: inherit;
    }
    .users-table tbody td {
        vertical-align: middle;
        border: 1px solid #d7dee8;
        padding: .45rem .65rem;
    }
    .users-table tbody tr:hover {
        background: #eef6ff;
    }
    .user-badge {
        border-radius: 999px;
        font-weight: 700;
        padding: .35rem .55rem;
    }
    .user-badge-role {
        background: #0dbbd7;
        color: #06202a;
    }
    .user-badge-lab {
        background: #64748b;
        color: #fff;
    }
    .user-badge-ms {
        background: #e8f1fb;
        color: #0b4f9c;
        border: 1px solid #b6d3f2;
        font-size: .7rem;
    }
    .user-badge-pending {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fcd34d;
        font-size: .7rem;
    }
    .user-action-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        box-shadow: 0 3px 10px rgba(15, 23, 42, .08);
    }
    .sort-icon {
        opacity: .7;
        font-size: .8rem;
    }
    .users-tabs .nav-link { font-weight: 600; color: #475569; }
    .users-tabs .nav-link.active { color: #0f2942; }
    .user-kind-tabs { gap: 6px; }
    .user-kind-tabs .btn { border-radius: 999px; font-weight: 600; }
    .user-lab-count { text-decoration: none; }
    .user-lab-count:hover { text-decoration: underline; }
    .email-status { border-radius: 999px; font-weight: 700; padding: .3rem .55rem; }
    .email-error { color: #b91c1c; font-size: .78rem; max-width: 280px; }
    #emailPreview { width: 100%; height: 70vh; border: 1px solid #d7dee8; border-radius: 8px; background: #fff; }
</style>

<div class="users-page-shell">
<div class="d-flex flex-wrap align-items-center justify-content-between mb-3 users-header">
    <h2 class="m-0 users-title">Manage Users</h2>
    <button class="btn btn-primary px-4" data-bs-toggle="modal" data-bs-target="#createUserModal">
        <i class="bi bi-person-plus-fill me-2"></i>Create User
    </button>
</div>

@{
    var adminNotice = TempData["AdminNotice"] as string;
    var adminNoticeKind = TempData["AdminNoticeKind"] as string ?? "success";
}
<div id="adminNotice" class="@(string.IsNullOrEmpty(adminNotice) ? "d-none" : $"alert alert-{adminNoticeKind} alert-dismissible fade show")" role="status">
    @if (!string.IsNullOrEmpty(adminNotice))
    {
        <span>@adminNotice</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    }
</div>

<ul class="nav nav-tabs users-tabs mb-3" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-users" data-bs-toggle="tab" data-bs-target="#pane-users" type="button" role="tab" aria-controls="pane-users" aria-selected="true">
            <i class="bi bi-people me-1"></i>Users
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-emails" data-bs-toggle="tab" data-bs-target="#pane-emails" type="button" role="tab" aria-controls="pane-emails" aria-selected="false">
            <i class="bi bi-envelope me-1"></i>Sent Emails
        </button>
    </li>
</ul>

<div class="tab-content">
<div class="tab-pane fade show active" id="pane-users" role="tabpanel" aria-labelledby="tab-users">

@if (ViewData["OpenCreateUserModal"] as bool? == true)
{
    <script nonce='@Context.Items["CspNonce"]'>
        document.addEventListener('DOMContentLoaded', function(){
            try {
                var modalEl = document.getElementById('createUserModal');
                if (modalEl) {
                    var m = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    m.show();
                }
            } catch (e) { }
        });
    </script>
}

<!-- Create User modal -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Create User</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        @await Html.PartialAsync("_CreateUserForm", Model)
      </div>
    </div>
  </div>
</div>

<div class="row g-3 align-items-end mb-3 users-filter-panel" id="userFilters">
    <div class="col-md-5 col-lg-4">
        <label class="form-label" for="userFreeTextFilter">Search</label>
        <input class="form-control" id="userFreeTextFilter" type="search" placeholder="User name, email, mobile, or name" autocomplete="off" />
    </div>
    <div class="col-md-3 col-lg-3">
        <label class="form-label" for="userRoleFilter">Role</label>
        <select class="form-select" id="userRoleFilter">
            <option value="">All roles</option>
            @foreach (var role in roleOptions)
            {
                <option value="@role.RoleName">@role.RoleName</option>
            }
        </select>
    </div>
    <div class="col-md-3 col-lg-3">
        <label class="form-label" for="userLabFilter">Lab</label>
        <select class="form-select" id="userLabFilter">
            <option value="">All labs</option>
            @foreach (var lab in labOptions)
            {
                <option value="@lab.LabName">@lab.LabName</option>
            }
        </select>
    </div>
    <div class="col-md-1 col-lg-2">
        <button class="btn btn-outline-secondary w-100" type="button" id="clearUserFilters">Clear</button>
    </div>
</div>

@{
    var azureUserCount = Model.Users.Count(u => u.IsEntra);
    var systemUserCount = Model.Users.Count() - azureUserCount;
}
<div class="d-flex flex-wrap align-items-center mb-2 user-kind-tabs" role="tablist" aria-label="User type">
    <button type="button" class="btn btn-sm btn-primary" role="tab" aria-selected="true" data-user-kind="local">
        <i class="bi bi-person-badge me-1"></i>System Users <span class="badge bg-light text-dark ms-1" id="countLocal">@systemUserCount</span>
    </button>
    <button type="button" class="btn btn-sm btn-outline-primary" role="tab" aria-selected="false" data-user-kind="entra">
        <i class="bi bi-microsoft me-1"></i>Azure AD Users <span class="badge bg-light text-dark ms-1" id="countEntra">@azureUserCount</span>
    </button>
    <small class="text-muted ms-2" id="userKindHint">Username and password sign-in.</small>
</div>

<div class="users-table-wrap table-responsive">
    <table class="table table-sm table-striped users-table" id="usersTable" data-layout="kinds">
        <thead>
            <tr>
                <th><button type="button" data-sort-column="0">UserName <i class="bi bi-arrow-down-up sort-icon"></i></button></th>
                <th><button type="button" data-sort-column="1">Name <i class="bi bi-arrow-down-up sort-icon"></i></button></th>
                <th><button type="button" data-sort-column="2">Email <i class="bi bi-arrow-down-up sort-icon"></i></button></th>
                <th><button type="button" data-sort-column="3">Mobile <i class="bi bi-arrow-down-up sort-icon"></i></button></th>
                <th><button type="button" data-sort-column="4">Role <i class="bi bi-arrow-down-up sort-icon"></i></button></th>
                <th><button type="button" data-sort-column="5">Labs <i class="bi bi-arrow-down-up sort-icon"></i></button></th>
                <th><button type="button" data-sort-column="6">Active <i class="bi bi-arrow-down-up sort-icon"></i></button></th>
                <th><button type="button" data-sort-column="7">Last Login <i class="bi bi-arrow-down-up sort-icon"></i></button></th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="tblUsersBody">
            @foreach(var u in Model.Users)
            {
                var roleText = Model.UserRolesMap != null && Model.UserRolesMap.TryGetValue(u.LabUserID, out var roles)
                    ? string.Join(" ", roles.GroupBy(r => r.RoleName, StringComparer.OrdinalIgnoreCase).Select(g => g.First().RoleName))
                    : string.Empty;
                var userLabs = Model.UserLabsMap != null && Model.UserLabsMap.TryGetValue(u.LabUserID, out var assignedLabs)
                    ? assignedLabs.GroupBy(l => l.LabId).Select(g => g.First().LabName).ToList()
                    : new List<string>();
                var labText = string.Join(" ", userLabs);
                var isPending = string.IsNullOrWhiteSpace(roleText);
                var searchText = string.Join(" ", new[] { u.UserName, u.FirstName, u.LastName, u.Email, u.Mobile, roleText, labText, u.IsEntra ? "Microsoft" : "Local", isPending ? "Pending" : "" });
                var lastLoginIso = u.LastLoginUtc.HasValue
                    ? DateTime.SpecifyKind(u.LastLoginUtc.Value, DateTimeKind.Utc).ToString("o", System.Globalization.CultureInfo.InvariantCulture)
                    : string.Empty;
                <tr data-search="@searchText" data-roles="@roleText" data-labs="@labText"
                    data-kind="@(u.IsEntra ? "entra" : "local")" data-active="@(u.IsActive ? "1" : "0")">
                    <td class="text-nowrap">
                        @u.UserName
                        @if (isPending && u.IsActive)
                        {
                            <span class="badge user-badge user-badge-pending ms-1" title="No role yet: sees Access pending">Pending</span>
                        }
                    </td>
                    <td>@u.FirstName @u.LastName</td>
                    <td class="text-truncate" style="max-width:180px">@u.Email</td>
                    <td>@u.Mobile</td>
                    <td>
                        @if (Model.UserRolesMap != null && Model.UserRolesMap.TryGetValue(u.LabUserID, out var displayRoles))
                        {
                            foreach (var role in displayRoles.GroupBy(r => r.RoleName, StringComparer.OrdinalIgnoreCase).Select(g => g.First()))
                            {
                                <span class="badge user-badge user-badge-role me-1">@role.RoleName</span>
                            }
                        }
                    </td>
                    <td data-sort-value="@userLabs.Count.ToString("D4")">
                        @if (userLabs.Count > 0)
                        {
                            <a class="user-lab-count" asp-action="Edit" asp-route-id="@u.LabUserID"
                               title="@string.Join(", ", userLabs.OrderBy(n => n))" aria-label="@userLabs.Count mapped labs - open @u.UserName to see and edit them">
                                <span class="badge user-badge user-badge-lab">@userLabs.Count @(userLabs.Count == 1 ? "lab" : "labs")</span>
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>@(u.IsActive?"Yes":"No")</td>
                    <td class="text-nowrap" data-sort-value="@lastLoginIso">
                        @if (u.LastLoginUtc.HasValue)
                        {
                            <time class="user-last-login" datetime="@lastLoginIso">@u.LastLoginUtc.Value.ToString("MM/dd/yyyy HH:mm") UTC</time>
                        }
                        else
                        {
                            <span class="text-muted">Never</span>
                        }
                    </td>
                    <td>
                        <div class="btn-group" role="group">
                            <a class="btn btn-sm btn-primary user-action-btn" asp-action="Edit" asp-route-id="@u.LabUserID" title="Edit user" aria-label="Edit @u.UserName"><i class="bi bi-pencil-square"></i></a>
                            @if (u.IsActive && !u.IsEntra && !string.IsNullOrWhiteSpace(u.Email))
                            {
                                <button class="btn btn-sm btn-outline-primary user-action-btn" data-invite-userid="@u.LabUserID" title="Send invitation email" aria-label="Send invitation to @u.UserName"><i class="bi bi-envelope"></i></button>
                            }
                            @if (u.IsEntra && isPending && canLinkAccounts)
                            {
                                <button class="btn btn-sm btn-outline-success user-action-btn" data-link-userid="@u.LabUserID" data-link-username="@u.UserName" title="Link to an existing account" aria-label="Link @u.UserName to an existing account"><i class="bi bi-link-45deg"></i></button>
                            }
                            <button class="btn btn-sm btn-outline-danger user-action-btn" data-remove-userid="@u.LabUserID" title="Remove user" aria-label="Remove @u.UserName"><i class="bi bi-trash3"></i></button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>

@* Sent Emails: invitation emails from LRN Metrics and the AR Workbench (one shared log). *@
<div class="tab-pane fade" id="pane-emails" role="tabpanel" aria-labelledby="tab-emails">
    <div class="row g-3 align-items-end mb-3 users-filter-panel" id="emailFilters">
        <div class="col-md-4 col-lg-3">
            <label class="form-label" for="emailSearch">Search</label>
            <input class="form-control" id="emailSearch" type="search" placeholder="Username, email, subject, sent by" autocomplete="off" />
        </div>
        <div class="col-md-3 col-lg-2">
            <label class="form-label" for="emailRole">Role</label>
            <select class="form-select" id="emailRole">
                <option value="">All roles</option>
                @foreach (var role in roleOptions)
                {
                    <option value="@role.RoleID">@role.RoleName</option>
                }
            </select>
        </div>
        <div class="col-md-2 col-lg-2">
            <label class="form-label" for="emailStatus">Status</label>
            <select class="form-select" id="emailStatus">
                <option value="">All</option>
                <option value="Sent">Sent</option>
                <option value="Failed">Failed</option>
            </select>
        </div>
        <div class="col-md-3 col-lg-2">
            <label class="form-label" for="emailApp">Application</label>
            <select class="form-select" id="emailApp">
                <option value="">Both</option>
                <option value="LRN Metrics">LRN Metrics</option>
                <option value="AR Workbench">AR Workbench</option>
            </select>
        </div>
        <div class="col-md-3 col-lg-2">
            <label class="form-label" for="emailOrder">Order</label>
            <select class="form-select" id="emailOrder">
                <option value="recent">Most recent first</option>
                <option value="oldest">Oldest first</option>
            </select>
        </div>
        <div class="col-md-2 col-lg-1">
            <button class="btn btn-outline-secondary w-100" type="button" id="emailRefresh" title="Refresh"><i class="bi bi-arrow-clockwise"></i></button>
        </div>
    </div>

    <div id="emailError" class="alert alert-danger d-none"></div>
    <div class="users-table-wrap table-responsive">
        <table class="table table-sm table-striped users-table">
            <thead>
                <tr>
                    <th>Sent</th><th>User</th><th>Roles</th><th>To</th><th>Application</th><th>Type</th><th>Status</th><th>Sent By</th><th></th>
                </tr>
            </thead>
            <tbody id="emailRows">
                <tr><td colspan="9" class="text-muted text-center py-4">Open this tab to load sent emails.</td></tr>
            </tbody>
        </table>
    </div>
    <div class="d-flex align-items-center gap-2 mt-2">
        <small class="text-muted" id="emailSummary"></small>
        <a class="small ms-2" asp-action="EmailLog"><i class="bi bi-box-arrow-up-right me-1"></i>Open the full Email Log (all mail types)</a>
        <div class="ms-auto btn-group">
            <button class="btn btn-sm btn-outline-secondary" type="button" id="emailPrev"><i class="bi bi-chevron-left"></i> Newer</button>
            <button class="btn btn-sm btn-outline-secondary" type="button" id="emailNext">Older <i class="bi bi-chevron-right"></i></button>
        </div>
    </div>
</div>
</div>
</div>

<!-- Email preview (the message as sent; one-time password and link removed) -->
<div class="modal fade" id="emailModal" tabindex="-1" aria-hidden="true" aria-labelledby="emailModalTitle">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h5 class="modal-title" id="emailModalTitle">Email</h5>
          <small class="text-muted" id="emailModalMeta"></small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="emailModalError" class="alert alert-danger d-none"></div>
        <iframe id="emailPreview" sandbox="" title="Email preview" referrerpolicy="no-referrer"></iframe>
        <small class="text-muted d-block mt-2">The one-time password and the first-login link are removed from stored copies.</small>
      </div>
    </div>
  </div>
</div>

<script nonce='@Context.Items["CspNonce"]'>
document.addEventListener('DOMContentLoaded', function () {
    const freeText = document.getElementById('userFreeTextFilter');
    const role = document.getElementById('userRoleFilter');
    const lab = document.getElementById('userLabFilter');
    const clear = document.getElementById('clearUserFilters');

    function normalize(value) {
        return (value || '').toString().trim().toLowerCase();
    }

    const tbody = document.getElementById('tblUsersBody');

    // Run on load and after refreshUsers() rebuilds the rows (create / remove / link).
    function prepareRows() {
        let local = 0, entra = 0;
        Array.from(tbody.querySelectorAll('tr')).forEach(function (row, i) {
            // Server order (by username), restored when a tab is opened without a column sort.
            row.setAttribute('data-order', i);
            if (row.getAttribute('data-kind') === 'entra') entra++; else local++;
        });
        const cl = document.getElementById('countLocal'), ce = document.getElementById('countEntra');
        if (cl) cl.textContent = local;
        if (ce) ce.textContent = entra;

        // Last login in the viewer's own time zone.
        tbody.querySelectorAll('time.user-last-login').forEach(function (t) {
            const d = new Date(t.getAttribute('datetime'));
            if (!isNaN(d.getTime())) {
                t.textContent = d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' })
                    + ' ' + d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
            }
        });
    }
    prepareRows();

    window.afterUsersRefreshed = function () {
        prepareRows();
        currentSort = { column: -1, direction: 1 };
        defaultOrder();
        window.applyUserFilters();
    };

    // System Users (username + password) / Azure AD Users (Sign in with Microsoft).
    let userKind = 'local';
    const kindHints = {
        local: 'Username and password sign-in.',
        entra: 'Sign in with Microsoft (Azure AD). Inactive users first, then the most recent sign-in.'
    };

    function lastLoginOf(row) {
        const v = row.children[7] && row.children[7].getAttribute('data-sort-value');
        const t = v ? Date.parse(v) : NaN;
        return isNaN(t) ? -Infinity : t;
    }

    function defaultOrder() {
        const rows = Array.from(tbody.querySelectorAll('tr'));
        rows.sort(function (a, b) {
            if (userKind === 'entra') {
                const ia = a.getAttribute('data-active') === '1', ib = b.getAttribute('data-active') === '1';
                if (ia !== ib) return ia ? 1 : -1;
                const la = lastLoginOf(a), lb = lastLoginOf(b);
                if (la !== lb) return lb > la ? 1 : -1;
            }
            return Number(a.getAttribute('data-order')) - Number(b.getAttribute('data-order'));
        });
        rows.forEach(function (row) { tbody.appendChild(row); });
    }

    document.querySelectorAll('[data-user-kind]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            userKind = btn.getAttribute('data-user-kind');
            document.querySelectorAll('[data-user-kind]').forEach(function (b) {
                const on = b === btn;
                b.classList.toggle('btn-primary', on);
                b.classList.toggle('btn-outline-primary', !on);
                b.setAttribute('aria-selected', on ? 'true' : 'false');
            });
            const hint = document.getElementById('userKindHint');
            if (hint) hint.textContent = kindHints[userKind];
            currentSort = { column: -1, direction: 1 };
            defaultOrder();
            window.applyUserFilters();
        });
    });

    window.applyUserFilters = function () {
        const q = normalize(freeText && freeText.value);
        const selectedRole = normalize(role && role.value);
        const selectedLab = normalize(lab && lab.value);

        document.querySelectorAll('#tblUsersBody tr').forEach(function (row) {
            const text = normalize(row.getAttribute('data-search'));
            const roles = normalize(row.getAttribute('data-roles'));
            const labs = normalize(row.getAttribute('data-labs'));
            const matchesKind = row.getAttribute('data-kind') === userKind;
            const matchesText = !q || text.indexOf(q) >= 0;
            const matchesRole = !selectedRole || roles.indexOf(selectedRole) >= 0;
            const matchesLab = !selectedLab || labs.indexOf(selectedLab) >= 0;
            row.classList.toggle('d-none', !(matchesKind && matchesText && matchesRole && matchesLab));
        });
    };

    [freeText, role, lab].forEach(function (el) {
        if (el) el.addEventListener('input', window.applyUserFilters);
        if (el) el.addEventListener('change', window.applyUserFilters);
    });
    if (clear) {
        clear.addEventListener('click', function () {
            if (freeText) freeText.value = '';
            if (role) role.value = '';
            if (lab) lab.value = '';
            window.applyUserFilters();
        });
    }

    var currentSort = { column: -1, direction: 1 };
    // A cell's data-sort-value (lab count, ISO last login) sorts in place of its text.
    function sortValue(row, column) {
        const cell = row.children[column];
        if (!cell) return '';
        return normalize(cell.hasAttribute('data-sort-value') ? cell.getAttribute('data-sort-value') : cell.textContent);
    }
    document.querySelectorAll('[data-sort-column]').forEach(function (button) {
        button.addEventListener('click', function () {
            const column = Number(button.getAttribute('data-sort-column'));
            currentSort.direction = currentSort.column === column ? currentSort.direction * -1 : 1;
            currentSort.column = column;

            const rows = Array.from(tbody.querySelectorAll('tr'));
            rows.sort(function (a, b) {
                const av = sortValue(a, column), bv = sortValue(b, column);
                if (!av || !bv) return av === bv ? 0 : (av ? -1 : 1);   // blanks (never signed in) last
                return av.localeCompare(bv, undefined, { numeric: true }) * currentSort.direction;
            });
            rows.forEach(function (row) { tbody.appendChild(row); });
        });
    });

    window.applyUserFilters();
});
</script>

<script nonce='@Context.Items["CspNonce"]'>
// Sent Emails tab: the shared invitation log (LRN Metrics + AR Workbench) through Admin/GetUserEmailsJson.
document.addEventListener('DOMContentLoaded', function () {
    // Modals declared inside a tab pane cannot open while that pane is hidden.
    ['createUserModal', 'emailModal'].forEach(function (id) {
        const el = document.getElementById(id);
        if (el && el.parentElement !== document.body) document.body.appendChild(el);
    });

    const BASE = '@Url.Content("~/Admin")';
    const PAGE_SIZE = 50;
    const state = { page: 1, total: 0, loaded: false, timer: null };
    const el = (id) => document.getElementById(id);
    const rows = el('emailRows');

    function esc(v) {
        return (v == null ? '' : String(v)).replace(/[&<>"']/g, function (ch) {
            return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch];
        });
    }
    function when(utc) {
        if (!utc) return '';
        const d = new Date(/Z$|[+-]\d\d:\d\d$/.test(utc) ? utc : utc + 'Z');
        return isNaN(d) ? utc : d.toLocaleString(undefined, { year: 'numeric', month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit' });
    }
    function showError(msg) {
        const box = el('emailError');
        box.textContent = msg || '';
        box.classList.toggle('d-none', !msg);
    }

    async function load() {
        showError('');
        rows.innerHTML = '<tr><td colspan="9" class="text-muted text-center py-4"><span class="spinner-border spinner-border-sm me-2"></span>Loading…</td></tr>';
        const qs = new URLSearchParams({ page: state.page, pageSize: PAGE_SIZE });
        // User emails only here; Admin > Email Log shows every mail type.
        qs.append('emailType', 'UserInvitation');
        qs.append('emailType', 'UserInvitationResend');
        const add = (k, v) => { if (v) qs.set(k, v); };
        add('search', el('emailSearch').value.trim());
        add('roleId', el('emailRole').value);
        add('status', el('emailStatus').value);
        add('application', el('emailApp').value);
        if (el('emailOrder').value === 'oldest') qs.set('oldestFirst', 'true');
        try {
            const r = await fetch(BASE + '/GetUserEmailsJson?' + qs.toString(), { credentials: 'same-origin', headers: { Accept: 'application/json' } });
            const data = await r.json().catch(() => null);
            if (!r.ok) throw new Error((data && data.message) || 'Could not load sent emails.');
            state.loaded = true;
            state.total = data.total || 0;
            if (data.installed === false) {
                rows.innerHTML = '<tr><td colspan="9" class="text-muted text-center py-4">The email log is not set up yet. Run Database/LRN.ReportsApi/UserMail_Setup.sql on LRNMaster.</td></tr>';
                el('emailSummary').textContent = '';
                return;
            }
            render(data.rows || []);
        } catch (e) {
            rows.innerHTML = '';
            showError(e.message);
        }
    }

    function render(list) {
        if (list.length === 0) {
            rows.innerHTML = '<tr><td colspan="9" class="text-muted text-center py-4">No emails match.</td></tr>';
        } else {
            rows.innerHTML = list.map(function (m) {
                const status = m.status === 'Sent'
                    ? '<span class="badge email-status bg-success">Sent</span>'
                    : '<span class="badge email-status bg-danger">Failed</span>' + (m.errorMessage ? '<div class="email-error">' + esc(m.errorMessage) + '</div>' : '');
                const user = esc(m.userName || '—') + (m.fullName ? '<div class="small text-muted">' + esc(m.fullName) + '</div>' : '')
                    + (m.userExists === false ? '<div class="small text-muted fst-italic">user deleted</div>' : '');
                const TYPES = { UserInvitation: 'Invitation', UserInvitationResend: 'Invitation (resent)', DenialWorkflowSupport: 'Denial Workflow support', DenialWorkflowNotification: 'Denial Workflow notification', PayerMasterNotification: 'Payer Master notification' };
                const type = TYPES[m.emailType] || esc(m.emailType);
                return '<tr>'
                    + '<td class="text-nowrap">' + esc(when(m.createdUtc)) + '</td>'
                    + '<td>' + user + '</td>'
                    + '<td>' + (m.roles ? m.roles.split(', ').map(function (r) { return '<span class="badge user-badge user-badge-role me-1">' + esc(r) + '</span>'; }).join('') : '—') + '</td>'
                    + '<td class="text-truncate" style="max-width:200px" title="' + esc(m.toAddress) + '">' + esc(m.toAddress) + '</td>'
                    + '<td class="text-nowrap">' + esc(m.application) + '</td>'
                    + '<td class="text-nowrap">' + type + '</td>'
                    + '<td>' + status + '</td>'
                    + '<td class="small">' + esc(m.sentBy || '') + '</td>'
                    + '<td><button type="button" class="btn btn-sm btn-outline-secondary user-action-btn" data-email-id="' + m.emailLogId + '" title="View email" aria-label="View email"><i class="bi bi-eye"></i></button></td>'
                    + '</tr>';
            }).join('');
        }
        const from = state.total === 0 ? 0 : (state.page - 1) * PAGE_SIZE + 1;
        const to = Math.min(state.page * PAGE_SIZE, state.total);
        el('emailSummary').textContent = state.total === 0 ? '' : from + '–' + to + ' of ' + state.total.toLocaleString() + ' emails';
        el('emailPrev').disabled = state.page <= 1;
        el('emailNext').disabled = to >= state.total;
        const oldest = el('emailOrder').value === 'oldest';
        el('emailPrev').innerHTML = '<i class="bi bi-chevron-left"></i> ' + (oldest ? 'Older' : 'Newer');
        el('emailNext').innerHTML = (oldest ? 'Newer' : 'Older') + ' <i class="bi bi-chevron-right"></i>';
    }

    function reload() { state.page = 1; load(); }
    window.reloadUserEmails = function () { if (state.loaded) reload(); };

    el('tab-emails').addEventListener('shown.bs.tab', function () { if (!state.loaded) load(); });
    ['emailRole', 'emailStatus', 'emailApp', 'emailOrder'].forEach(function (id) { el(id).addEventListener('change', reload); });
    el('emailSearch').addEventListener('input', function () { clearTimeout(state.timer); state.timer = setTimeout(reload, 350); });
    el('emailRefresh').addEventListener('click', load);
    el('emailPrev').addEventListener('click', function () { if (state.page > 1) { state.page--; load(); } });
    el('emailNext').addEventListener('click', function () { state.page++; load(); });

    rows.addEventListener('click', async function (e) {
        const btn = e.target.closest('[data-email-id]');
        if (!btn) return;
        const modalEl = el('emailModal');
        const frame = el('emailPreview');
        const err = el('emailModalError');
        err.classList.add('d-none');
        frame.srcdoc = '<p style="font-family:Segoe UI,Arial;padding:16px;color:#64748b">Loading…</p>';
        el('emailModalTitle').textContent = 'Email';
        el('emailModalMeta').textContent = '';
        (bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl)).show();
        try {
            const r = await fetch(BASE + '/GetUserEmailJson?id=' + encodeURIComponent(btn.getAttribute('data-email-id')), { credentials: 'same-origin', headers: { Accept: 'application/json' } });
            const d = await r.json().catch(() => null);
            if (!r.ok || !d) throw new Error((d && d.message) || 'Could not load the email.');
            const m = d.email || {};
            el('emailModalTitle').textContent = m.subject || 'Email';
            el('emailModalMeta').textContent = [when(m.createdUtc), 'To ' + (m.toAddress || ''), m.application, m.status].filter(Boolean).join(' · ');
            // sandbox="" : the stored HTML is shown with scripts, forms and navigation disabled.
            frame.srcdoc = d.bodyHtml || '<p style="font-family:Segoe UI,Arial;padding:16px;color:#64748b">No message body was stored (the email was not built).' + (m.errorMessage ? '<br><br>' + esc(m.errorMessage) : '') + '</p>';
        } catch (ex) {
            err.textContent = ex.message;
            err.classList.remove('d-none');
            frame.srcdoc = '';
        }
    });
});
</script>

