@* Shared admin JS for AJAX forms and mapping refresh *@
<script nonce='@Context.Items["CspNonce"]'>
(function(){
    function jsonFormData(form) { return new FormData(form); }
    // Resolve the Admin controller path through the app root so these AJAX calls keep working
    // when the app is hosted under a virtual path / sub-application (not just the site root).
    // Absolute paths from the domain root 404 under a path base; Url.Content resolves it correctly.
    const ADMIN_BASE = '@Url.Content("~/Admin")';

    function wireLabChipPickers(root){
        (root || document).querySelectorAll('.lab-chip-picker').forEach(function(picker){
            if (picker.dataset.wired === 'true') return;
            picker.dataset.wired = 'true';

            const inputName = picker.getAttribute('data-input-name');
            const select = picker.querySelector('select');
            const selectedBox = picker.querySelector('[data-selected-labs]');
            const hiddenBox = picker.querySelector('[data-hidden-labs]');
            if (!inputName || !select || !selectedBox || !hiddenBox) return;

            const selected = new Map();

            function render(){
                selectedBox.innerHTML = '';
                hiddenBox.innerHTML = '';

                if (selected.size === 0) {
                    const empty = document.createElement('span');
                    empty.className = 'lab-chip-empty';
                    empty.textContent = 'No labs selected';
                    selectedBox.appendChild(empty);
                }

                selected.forEach(function(name, id){
                    const hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = inputName;
                    hidden.value = id;
                    hiddenBox.appendChild(hidden);

                    const chip = document.createElement('span');
                    chip.className = 'lab-chip';
                    chip.textContent = name;

                    const remove = document.createElement('button');
                    remove.type = 'button';
                    remove.setAttribute('aria-label', 'Remove ' + name);
                    remove.innerHTML = '&times;';
                    remove.addEventListener('click', function(){
                        selected.delete(id);
                        const option = Array.from(select.options).find(function(item){ return item.value === id; });
                        if (option) option.disabled = false;
                        render();
                    });

                    chip.appendChild(remove);
                    selectedBox.appendChild(chip);
                });

                select.setCustomValidity(selected.size === 0 && select.required ? 'Select at least one lab' : '');
            }

            function addSelectedOption(option){
                if (!option || !option.value || selected.has(option.value)) return;
                selected.set(option.value, option.textContent.trim());
                option.disabled = true;
                select.value = '';
                render();
            }

            Array.from(select.options).forEach(function(option){
                if (option.dataset.selected === 'true') addSelectedOption(option);
            });
            select.addEventListener('change', function(){
                addSelectedOption(select.selectedOptions[0]);
            });

            const form = picker.closest('form');
            if (form) {
                form.addEventListener('reset', function(){
                    setTimeout(function(){
                        selected.clear();
                        Array.from(select.options).forEach(function(option){ option.disabled = false; });
                        Array.from(select.options).forEach(function(option){
                            if (option.dataset.selected === 'true') addSelectedOption(option);
                        });
                        render();
                    }, 0);
                });
            }

            render();
        });
    }

    wireLabChipPickers(document);
    window.wireLabChipPickers = wireLabChipPickers;

    // Generic helper to POST FormData and handle JSON errors
    async function postForm(url, fd){
        const resp = await fetch(url, { method: 'POST', body: fd, credentials: 'same-origin' });
        if (!resp.ok) {
            let data = null; try { data = await resp.json(); } catch(e) {}
            if (data && data.errors) throw new Error(data.errors.join('; '));
            throw new Error('Request failed');
        }
        return resp.json().catch(()=>null);
    }

    // Wire page-level create user if present
    // Support both modal and page forms, and scope validation to the correct form
    function wireCreateUserValidation(formId, pwdId, confId, feedbackId) {
        const form = document.getElementById(formId);
        if (!form) return;
        const pwd = form.querySelector('#' + pwdId) || form.querySelector('[name="NewUserPassword"]');
        const conf = form.querySelector('#' + confId) || form.querySelector('[name="NewUserConfirmPassword"]');
        const fb = form.querySelector('#' + feedbackId) || form.querySelector('.create-confirm-feedback');
        if (!pwd || !conf) return;
        function checkMatch() {
            if (!conf.value) {
                conf.classList.remove('is-invalid');
                if (fb) fb.textContent = '';
                try { conf.setCustomValidity(''); } catch(e){}
                return;
            }
            if (pwd.value !== conf.value) {
                conf.classList.add('is-invalid');
                if (fb) fb.textContent = 'Passwords do not match';
                try { conf.setCustomValidity('Passwords do not match'); } catch(e){}
            } else {
                conf.classList.remove('is-invalid');
                if (fb) fb.textContent = '';
                try { conf.setCustomValidity(''); } catch(e){}
            }
        }
        pwd.addEventListener('input', checkMatch);
        conf.addEventListener('input', checkMatch);
        conf.addEventListener('blur', function(){ checkMatch(); if (conf.classList.contains('is-invalid')) try{ conf.reportValidity(); }catch(e){} });
    }

    wireCreateUserValidation('frmCreateUserModal', 'createUserPassword', 'createUserConfirm', 'createUserConfirmFeedback');
    wireCreateUserValidation('frmCreateUserPage', 'NewUserPassword', 'NewUserConfirmPassword', '');

    // Password show/hide toggle for the modal create-user form. The input-group button flips the
    // field between type=password and type=text and swaps the eye icon.
    function wirePasswordToggle(toggleId, inputId){
        const btn = document.getElementById(toggleId);
        const input = document.getElementById(inputId);
        if (!btn || !input) return;
        btn.addEventListener('click', function(){
            const reveal = input.type === 'password';
            input.type = reveal ? 'text' : 'password';
            btn.innerHTML = reveal ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
            btn.setAttribute('aria-pressed', reveal ? 'true' : 'false');
        });
    }
    wirePasswordToggle('createUserPwdToggle', 'createUserPassword');
    wirePasswordToggle('createUserConfirmToggle', 'createUserConfirm');

    const frmCreateUser = document.getElementById('frmCreateUserModal') || document.getElementById('frmCreateUser') || document.getElementById('frmCreateUserPage') || document.getElementById('frmCreateUserPageOnly') || document.getElementById('frmCreateUser');
    if (frmCreateUser){
        function clearCreateUserValidation(){
            ['createUserUserName','createUserPassword','createUserConfirm','createUserEmail','createUserMobile','createUserRole','createUserLab'].forEach(id=>{
                const el = document.getElementById(id);
                if (!el) return;
                el.classList.remove('is-invalid');
                const fb = document.getElementById(id + 'Feedback');
                if (fb) {
                    fb.textContent = '';
                    try { fb.style.display = ''; } catch(e) {}
                }
            });
            const errEl = document.getElementById('createUserErrors'); if (errEl) { errEl.classList.add('d-none'); errEl.textContent = ''; }
        }

        function validateCreateUserForm(){
            clearCreateUserValidation();
            let ok = true;
            const user = document.getElementById('createUserUserName');
            const pwd = document.getElementById('createUserPassword');
            const conf = document.getElementById('createUserConfirm');
            const role = document.getElementById('createUserRole');
            const lab = document.getElementById('createUserLab');

            if (!user || !user.value.trim()) { if(user){ user.classList.add('is-invalid'); } const fb = document.getElementById('createUserUserNameFeedback'); if(fb) fb.textContent = 'UserName is required'; ok = false; }
            if (!pwd || pwd.value.length < 8) { if(pwd){ pwd.classList.add('is-invalid'); } const fb = document.getElementById('createUserPasswordFeedback'); if(fb) fb.textContent = 'Password must be at least 8 characters'; ok = false; }
            if (!conf || conf.value !== (pwd ? pwd.value : '')) {
                if(conf){
                    conf.classList.add('is-invalid');
                    try { conf.setCustomValidity('Passwords do not match'); } catch(e){}
                }
                const fb = document.getElementById('createUserConfirmFeedback');
                if(fb) {
                    fb.textContent = 'Passwords do not match';
                    try { fb.style.display = 'block'; } catch(e) {}
                }
                ok = false;
            } else {
                try { conf.setCustomValidity(''); } catch(e){}
            }
            if (role && (!role.value || role.value === '')) { role.classList.add('is-invalid'); const fb = document.getElementById('createUserRoleFeedback'); if(fb) fb.textContent = 'Role is required'; ok = false; }
            const selectedLabs = frmCreateUser.querySelectorAll('[data-hidden-labs] input[name="NewUserLabIds"]');
            if (lab && selectedLabs.length === 0) { lab.classList.add('is-invalid'); const fb = document.getElementById('createUserLabFeedback'); if(fb) fb.textContent = 'Lab is required'; ok = false; }

            // Trigger native validation bubble when something is invalid
            if (!ok) {
                try { frmCreateUser.reportValidity(); } catch (e) {}
            }
            return ok;
        }

        // Password strength scoring and live feedback
        function scorePassword(p) {
            let score = 0;
            if (!p) return 0;
            if (p.length >= 8) score += 30;
            if (/[a-z]/.test(p)) score += 15;
            if (/[A-Z]/.test(p)) score += 20;
            if (/[0-9]/.test(p)) score += 20;
            if (/[^A-Za-z0-9]/.test(p)) score += 15;
            return Math.min(100, score);
        }

        function updatePasswordStrength() {
            const pwd = document.getElementById('createUserPassword');
            const bar = document.getElementById('createUserPwdStrength');
            const txt = document.getElementById('createUserPwdStrengthText');
            if (!pwd || !bar) return;
            const s = scorePassword(pwd.value);
            bar.style.width = s + '%';
            bar.className = 'progress-bar';
            if (s < 40) bar.classList.add('bg-danger');
            else if (s < 70) bar.classList.add('bg-warning');
            else bar.classList.add('bg-success');
            if (txt) txt.textContent = s < 40 ? 'Weak' : (s < 70 ? 'Medium' : 'Strong');
        }

        // live confirm match
        function updateConfirmMatch(){
            const pwd = document.getElementById('createUserPassword');
            const conf = document.getElementById('createUserConfirm');
            const fb = document.getElementById('createUserConfirmFeedback');
            if (!pwd || !conf) return;
            if (conf.value && pwd.value !== conf.value) {
                conf.classList.add('is-invalid');
                if (fb) { fb.textContent = 'Passwords do not match'; fb.style.display = 'block'; }
                // set native validation message for non-AJAX submit
                try { conf.setCustomValidity('Passwords do not match'); } catch(e){}
            } else {
                conf.classList.remove('is-invalid');
                if (fb) { fb.textContent = ''; fb.style.display = 'none'; }
                try { conf.setCustomValidity(''); } catch(e){}
            }
        }

        // live email validation
        function validateEmailLive(){
            const email = document.getElementById('createUserEmail');
            const fb = document.getElementById('createUserEmailFeedback');
            if (!email) return true;
            if (!email.value) { email.classList.remove('is-invalid'); if (fb) fb.textContent = ''; return true; }
            // build regex pattern without at-sign literal so Razor will not parse it
            const at = String.fromCharCode(64);
            const pattern = '^[^' + at + '\\s]+' + at + '[^' + at + '\\s]+\\.[^' + at + '\\s]+$';
            const re = new RegExp(pattern);
            if (!re.test(email.value)) { email.classList.add('is-invalid'); if (fb) fb.textContent = 'Enter a valid email address'; return false; }
            email.classList.remove('is-invalid'); if (fb) fb.textContent = ''; return true;
        }

        // set native email validity using setCustomValidity for non-AJAX fallback
        function updateEmailValidity(){
            const email = document.getElementById('createUserEmail');
            const fb = document.getElementById('createUserEmailFeedback');
            if (!email) return;
            if (!validateEmailLive()) {
                try { email.setCustomValidity('Enter a valid email address'); } catch(e){}
            } else {
                try { email.setCustomValidity(''); } catch(e){}
            }
        }

        // Attach live listeners if modal fields exist
        const pwdEl = document.getElementById('createUserPassword');
        if (pwdEl) {
            pwdEl.addEventListener('input', function(){ updatePasswordStrength(); updateConfirmMatch(); validateEmailLive(); updateEmailValidity(); });
            pwdEl.addEventListener('blur', function(){ updateConfirmMatch(); try{ if(document.getElementById('createUserConfirm')?.classList.contains('is-invalid')) document.getElementById('createUserConfirm').reportValidity(); }catch(e){} });
        }
        const confEl = document.getElementById('createUserConfirm');
        if (confEl) {
            confEl.addEventListener('input', function(){ updateConfirmMatch(); updateEmailValidity(); });
            confEl.addEventListener('blur', function(){ updateConfirmMatch(); try{ if(confEl.classList.contains('is-invalid')) confEl.reportValidity(); }catch(e){} });
        }
        const emailEl = document.getElementById('createUserEmail');
        if (emailEl) emailEl.addEventListener('input', function(){ validateEmailLive(); updateEmailValidity(); });

        // Delegate input events in case elements are added dynamically
        document.addEventListener('input', function(e){
            try {
                const id = e.target && e.target.id;
                if (id === 'createUserPassword') { updatePasswordStrength(); updateConfirmMatch(); }
                if (id === 'createUserConfirm') { updateConfirmMatch(); }
                if (id === 'createUserEmail') { validateEmailLive(); updateEmailValidity(); }
            } catch (ex) { /* ignore */ }
        });

        // When modal shown, refresh validation UI
        const modalEl = document.getElementById('createUserModal');
        if (modalEl) {
            modalEl.addEventListener('shown.bs.modal', function(){
                try { updatePasswordStrength(); updateConfirmMatch(); validateEmailLive(); updateEmailValidity(); } catch(e){}
            });
        }

        frmCreateUser.addEventListener('submit', function(e){
            e.preventDefault();
            if (frmCreateUser.dataset.submitting === 'true') return;
            clearCreateUserValidation();
            if (!validateCreateUserForm()) return;
            frmCreateUser.dataset.submitting = 'true';
            const submitButton = frmCreateUser.querySelector('[data-create-user-submit], button[type="submit"]');
            const submitLabel = submitButton ? submitButton.querySelector('span') : null;
            if (submitButton) {
                submitButton.disabled = true;
                submitButton.setAttribute('aria-busy', 'true');
                if (submitLabel) submitLabel.textContent = 'Creating User...';
                else submitButton.textContent = 'Creating User...';
                submitButton.insertAdjacentHTML('afterbegin', '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>');
            }
            function releaseCreateUserSubmit() {
                frmCreateUser.dataset.submitting = 'false';
                if (!submitButton) return;
                submitButton.disabled = false;
                submitButton.removeAttribute('aria-busy');
                const spinner = submitButton.querySelector('.spinner-border');
                if (spinner) spinner.remove();
                if (submitLabel) submitLabel.textContent = submitButton.dataset.defaultText || 'Create User';
            }
            const fd = jsonFormData(frmCreateUser);
            fetch(ADMIN_BASE + '/CreateUserAjax', { method: 'POST', body: fd, credentials: 'same-origin' })
            .then(async r=>{
                if (!r.ok) { const d = await r.json().catch(()=>null); const msg = d && d.errors ? d.errors.join('; ') : 'Create user failed';
                    const errEl = document.getElementById('createUserErrors'); if (errEl) { errEl.classList.remove('d-none'); errEl.textContent = msg; }
                    else alert(msg);
                    releaseCreateUserSubmit();
                    return; }
                await refreshUsers();
                frmCreateUser.reset();
                releaseCreateUserSubmit();
                const modalEl = document.getElementById('createUserModal');
                if (modalEl) { const m = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl); m.hide(); }
            }).catch(err=>{ releaseCreateUserSubmit(); console.error(err); alert(err.message||'Error'); });
        });
    }

    const frmCreateRole = document.getElementById('frmCreateRole') || document.getElementById('frmCreateRolePage');
    if (frmCreateRole){
        frmCreateRole.addEventListener('submit', function(e){
            e.preventDefault();
            const fd = jsonFormData(frmCreateRole);
            fetch(ADMIN_BASE + '/CreateRoleAjax', { method: 'POST', body: fd, credentials: 'same-origin' })
            .then(async r=>{ if (!r.ok){ const d = await r.json().catch(()=>null); alert(d && d.errors? d.errors.join('; '): 'Create role failed'); return;} await refreshRoles(); frmCreateRole.reset(); }).catch(err=>{ console.error(err); alert(err.message||'Error'); });
        });
    }

    // Assign role forms
    const frmAssignRole = document.getElementById('frmAssignRole') || document.getElementById('frmAssignRolePage');
    if (frmAssignRole){
        frmAssignRole.addEventListener('submit', function(e){ e.preventDefault(); const fd = jsonFormData(frmAssignRole); fetch(ADMIN_BASE + '/AssignRoleAjax',{method:'POST',body:fd,credentials:'same-origin'}).then(r=>{ if (!r.ok) { alert('Assign failed'); return;} const uid = (document.getElementById('mapUserSelect')||document.getElementById('mapUserSelectPage')).value; if (uid) loadMappingsForUser(uid); }).catch(err=>{console.error(err); alert('Network error');}); });
    }

    // Assign lab forms
    const frmAssignLab = document.getElementById('frmAssignLab') || document.getElementById('frmAssignLabPage');
    if (frmAssignLab){
        frmAssignLab.addEventListener('submit', function(e){ e.preventDefault(); const fd = jsonFormData(frmAssignLab); fetch(ADMIN_BASE + '/AssignUserLabAjax',{method:'POST',body:fd,credentials:'same-origin'}).then(r=>{ if (!r.ok){ alert('Assign lab failed'); return;} const uid = (document.getElementById('mapUserSelect2')||document.getElementById('mapUserSelectPage2')).value; if (uid) loadMappingsForUser(uid); }).catch(err=>{console.error(err); alert('Network error');}); });
    }

    // Remove delegated
    document.addEventListener('click', function(e){ const tr = e.target.closest('[data-remove-role]'); if (tr){ const id = tr.getAttribute('data-remove-role'); fetch(ADMIN_BASE + '/RemoveUserRole',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'userRoleId='+encodeURIComponent(id),credentials:'same-origin'}).then(r=>{ if(r.ok){ const uid = (document.getElementById('mapUserSelect')||document.getElementById('mapUserSelectPage')).value; if(uid) loadMappingsForUser(uid);} else alert('Remove failed');}); } });
    document.addEventListener('click', function(e){ const tr = e.target.closest('[data-remove-ul]'); if (tr){ const id = tr.getAttribute('data-remove-ul'); fetch(ADMIN_BASE + '/RemoveUserLab',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'ulid='+encodeURIComponent(id),credentials:'same-origin'}).then(r=>{ if(r.ok){ const uid = (document.getElementById('mapUserSelect2')||document.getElementById('mapUserSelectPage2')).value; if(uid) loadMappingsForUser(uid);} else alert('Remove failed');}); } });
    document.addEventListener('click', function(e){
        const btn = e.target.closest('[data-remove-userid]');
        if (!btn) return;
        const id = btn.getAttribute('data-remove-userid');
        const row = btn.closest('tr');
        const name = row ? (row.children[0]?.textContent || 'this user').trim() : 'this user';
        if (!confirm('Deactivate ' + name + '?')) return;
        btn.disabled = true;
        fetch(ADMIN_BASE + '/RemoveUser', {
            method: 'POST',
            headers: { 'Content-Type':'application/x-www-form-urlencoded' },
            body: 'userId=' + encodeURIComponent(id),
            credentials: 'same-origin'
        }).then(async r=>{
            if (!r.ok) {
                const d = await r.json().catch(()=>null);
                alert(d && d.errors ? d.errors.join('; ') : 'Remove user failed');
                btn.disabled = false;
                return;
            }
            await refreshUsers();
        }).catch(err=>{
            console.error(err);
            alert('Remove user failed');
            btn.disabled = false;
        });
    });

    // Refresh helpers
    function escapeHtml(value){
        return (value || '').toString().replace(/[&<>"']/g, function(ch){
            return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[ch];
        });
    }

    window.refreshUsers = async function(){ try{ const r = await fetch(ADMIN_BASE + '/GetUsersJson', {credentials:'same-origin'}); const data = await r.json(); const tbody = document.getElementById('tblUsersBody'); if(tbody){ tbody.innerHTML=''; data.forEach(u=>{ const tr = document.createElement('tr'); tr.setAttribute('data-userid', u.labUserID); const labs = [...new Set((u.labs||[]).map(x=>x.labName||x.labId).filter(Boolean))]; const roles = [...new Set((u.roles||[]).map(x=>x.roleName||x.RoleName||x.roleID||x.roleId).filter(Boolean))]; const name = `${u.firstName||''} ${u.lastName||''}`.trim(); const searchText = [u.userName, name, u.email, u.mobile, roles.join(' '), labs.join(' ')].filter(Boolean).join(' '); tr.setAttribute('data-search', searchText); tr.setAttribute('data-roles', roles.join(' ')); tr.setAttribute('data-labs', labs.join(' ')); const roleBadges = roles.map(x=>`<span class="badge user-badge user-badge-role me-1">${escapeHtml(x)}</span>`).join(''); const labBadges = labs.map(x=>`<span class="badge user-badge user-badge-lab me-1">${escapeHtml(x)}</span>`).join(''); tr.innerHTML = `<td>${escapeHtml(u.userName)}</td><td>${escapeHtml(name)}</td><td>${escapeHtml(u.email)}</td><td>${escapeHtml(u.mobile)}</td><td>${roleBadges}</td><td>${labBadges}</td><td>${u.isActive? 'Yes':'No'}</td><td><div class="btn-group" role="group"><a class="btn btn-sm btn-primary user-action-btn" href="${ADMIN_BASE}/Edit/${u.labUserID}" title="Edit user" aria-label="Edit ${escapeHtml(u.userName)}"><i class="bi bi-pencil-square"></i></a><button class="btn btn-sm btn-outline-danger user-action-btn" data-remove-userid="${u.labUserID}" title="Remove user" aria-label="Remove ${escapeHtml(u.userName)}"><i class="bi bi-trash3"></i></button></div></td>`; tbody.appendChild(tr); }); populateUserSelects(data); if (window.applyUserFilters) window.applyUserFilters(); }}catch(e){console.error(e);} };
    window.refreshRoles = async function(){ try{ const r = await fetch(ADMIN_BASE + '/GetRolesJson', {credentials:'same-origin'}); const data = await r.json(); document.querySelectorAll('#mapRoleSelect, #mapRoleSelectPage').forEach(sel=>{ if(!sel) return; sel.innerHTML = '<option value="">-- select role --</option>'; data.forEach(r=>{ const id = r.roleID||r.RoleID||r.roleId||r.RoleId; const name = r.roleName||r.RoleName||r.name||r.role; const opt = document.createElement('option'); opt.value = id; opt.textContent = name; sel.appendChild(opt); }); }); // labs
        const lr = await fetch(ADMIN_BASE + '/GetLabsJson', {credentials:'same-origin'}); const labs = await lr.json(); const labSel = document.getElementById('mapLabSelect')||document.getElementById('mapLabSelectPage'); if(labSel){ labSel.innerHTML = '<option value="">-- select lab --</option>'; labs.forEach(l=>{ const id = l.labId||l.LabId||l.labID||l.LabID; const name = l.labName||l.LabName||l.name; const o = document.createElement('option'); o.value = id; o.textContent = name; labSel.appendChild(o); }); }
    }catch(e){console.error(e);} };

    function populateUserSelects(data){ ['mapUserSelect','mapUserSelect2','mapUserSelectPage','mapUserSelectPage2','mapUserSelect'].forEach(id=>{ const sel = document.getElementById(id); if(!sel) return; sel.innerHTML = '<option value="">-- select user --</option>'; data.forEach(u=>{ const opt = document.createElement('option'); opt.value = u.labUserID; opt.textContent = u.userName; sel.appendChild(opt); }); }); }

    window.loadMappingsForUser = async function(userId){ try{ const r = await fetch(ADMIN_BASE + '/GetUserRolesJson?userId='+encodeURIComponent(userId), {credentials:'same-origin'}); const roles = await r.json(); const tbody = document.querySelector('#tblUserRoles tbody')||document.querySelector('#tblUserRolesPage tbody'); if(tbody){ tbody.innerHTML=''; roles.forEach(ur=>{ const tr = document.createElement('tr'); tr.innerHTML = `<td>${ur.roleName||ur.roleID||ur.roleId}</td><td><button class="btn btn-sm btn-outline-danger" data-remove-role="${ur.userRoleId}">Remove</button></td>`; tbody.appendChild(tr); }); }
        const r2 = await fetch(ADMIN_BASE + '/GetUserLabsJson?userId='+encodeURIComponent(userId), {credentials:'same-origin'}); const labs = await r2.json(); const tbody2 = document.querySelector('#tblUserLabs tbody')||document.querySelector('#tblUserLabsPage tbody'); if(tbody2){ tbody2.innerHTML=''; labs.forEach(ul=>{ const tr = document.createElement('tr'); tr.innerHTML = `<td>${ul.labName||ul.labId}</td><td><button class="btn btn-sm btn-outline-danger" data-remove-ul="${ul.ulid}">Remove</button></td>`; tbody2.appendChild(tr); }); }
    }catch(e){console.error(e);} };

    // wire change events
    ['mapUserSelect','mapUserSelect2','mapUserSelectPage','mapUserSelectPage2'].forEach(id=>{ const s = document.getElementById(id); if(s) s.addEventListener('change', function(){ if(this.value) loadMappingsForUser(this.value); }); });

    // initial load intentionally omitted (avoid AJAX-driven overwrites of server-rendered UI)
})();
</script>

<script nonce='@Context.Items["CspNonce"]'>
// jQuery-only validation for Create User (modal + page forms)
$(function(){
    function isValidEmail(value){
        if (!value) return true;
        var at = String.fromCharCode(64);
        var pattern = new RegExp('^[^' + at + '\\s]+' + at + '[^' + at + '\\s]+\\.[^' + at + '\\s]+$');
        return pattern.test(value);
    }

    function ensureFeedback($afterEl, selectorClass){
        var $fb = $afterEl.parent().find(selectorClass);
        if ($fb.length) return $fb;
        $fb = $('<div/>', { 'class': 'text-danger small mt-1 ' + selectorClass.replace('.', ''), 'style': 'display:none' });
        $afterEl.after($fb);
        return $fb;
    }

    function setFieldError($field, $fb, message){
        $field.addClass('is-invalid');
        if ($fb && $fb.length) $fb.text(message).show();
        try { if ($field[0]) $field[0].setCustomValidity(message); } catch(e){}
    }

    function clearFieldError($field, $fb){
        $field.removeClass('is-invalid');
        if ($fb && $fb.length) $fb.text('').hide();
        try { if ($field[0]) $field[0].setCustomValidity(''); } catch(e){}
    }

    function wireCreateUserForm($form){
        if (!$form || !$form.length) return;
        if ($form.data('createUserWired')) return;
        $form.data('createUserWired', true);

        var $user = $form.find('#createUserUserName, [name="NewUser.UserName"]');
        var $pwd = $form.find('#createUserPassword, [name="NewUserPassword"]');
        var $conf = $form.find('#createUserConfirm, [name="NewUserConfirmPassword"]');
        var $email = $form.find('#createUserEmail, [name="NewUser.Email"]');
        var $role = $form.find('#createUserRole, [name="NewUserRoleId"]');
        var $lab  = $form.find('#createUserLab, [name="NewUserLabId"], [name="NewUserLabIds"]');

        var $confFb = $form.find('#createUserConfirmFeedback');
        if (!$confFb.length && $conf.length) $confFb = ensureFeedback($conf, '.create-confirm-feedback');
        var $emailFb = $form.find('#createUserEmailFeedback');
        if (!$emailFb.length && $email.length) $emailFb = ensureFeedback($email.closest('.input-group').length ? $email.closest('.input-group') : $email, '.create-email-feedback');

        function validateConfirm(){
            if (!$pwd.length || !$conf.length) return true;
            var pv = ($pwd.val() || '').toString();
            var cv = ($conf.val() || '').toString();
            if (!cv) { clearFieldError($conf, $confFb); return true; }
            if (pv !== cv) { setFieldError($conf, $confFb, 'Passwords do not match'); return false; }
            clearFieldError($conf, $confFb);
            return true;
        }

        function validateEmail(){
            if (!$email.length) return true;
            var ev = ($email.val() || '').toString();
            if (!ev) { clearFieldError($email, $emailFb); return true; }
            if (!isValidEmail(ev)) { setFieldError($email, $emailFb, 'Enter a valid email address'); return false; }
            clearFieldError($email, $emailFb);
            return true;
        }

        $pwd.on('input', validateConfirm);
        $conf.on('input blur', function(){ validateConfirm(); if ($conf.hasClass('is-invalid')) try { $conf[0].reportValidity(); } catch(e){} });
        $email.on('input blur', validateEmail);

        $form.on('submit', function(e){
            var ok = true;
            if ($user.length && !($.trim($user.val()||''))) ok = false;
            if ($pwd.length && (($pwd.val()||'').toString().length < 8)) ok = false;
            if (!validateConfirm()) ok = false;
            if (!validateEmail()) ok = false;
            if ($role.length && !$role.val()) ok = false;
            if ($lab.length && !$form.find('[data-hidden-labs] input[name="NewUserLabIds"]').length) ok = false;
            if (!ok) {
                e.preventDefault();
                e.stopImmediatePropagation();
            }
        });
    }

    $('form').each(function(){
        var $f = $(this);
        if ($f.find('[name="NewUserPassword"]').length && $f.find('[name="NewUserConfirmPassword"]').length) wireCreateUserForm($f);
    });

    $(document).on('shown.bs.modal', '#createUserModal', function(){
        var $f = $(this).find('form').first();
        wireCreateUserForm($f);
        // validate immediately if values are already there (browser autofill)
        $f.find('#createUserConfirm, [name="NewUserConfirmPassword"]').trigger('blur');
    });
});
</script>
