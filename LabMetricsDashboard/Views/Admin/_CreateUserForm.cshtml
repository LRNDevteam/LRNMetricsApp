@model LabMetricsDashboard.Models.AdminViewModel

<style>
  .create-card {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 6px 18px rgba(20,45,80,0.06);
  }
  .create-card .card-header {
    background: linear-gradient(90deg,#0d6efd,#1177ff);
    color: #fff;
    border-bottom: none;
  }
  .form-control.smooth {
    border-radius: 10px;
    padding: 18px 14px;
    background-color: #f6f9ff;
    border: 1px solid rgba(25, 86, 255, 0.06);
  }
  .select-smooth {
    border-radius: 10px;
    padding: .5rem 1rem;
    background-color: #f6f9ff;
  }
  .access-panel {
    border: 1px solid #d8e1ef;
    border-radius: 12px;
    background: #f8fbff;
    padding: 14px;
  }
  .lab-chip-picker .selected-labs {
    min-height: 42px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    padding: 8px;
    border: 1px solid #d8e1ef;
    border-radius: 10px;
    background: #fff;
    margin-bottom: 10px;
  }
  .lab-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-radius: 999px;
    background: #0f2942;
    color: #fff;
    font-weight: 700;
    padding: .35rem .5rem .35rem .7rem;
  }
  .lab-chip button {
    border: 0;
    background: rgba(255,255,255,.18);
    color: #fff;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    line-height: 1;
  }
  .lab-chip-empty {
    color: #64748b;
    font-size: .9rem;
  }
  .action-row .btn { min-width: 120px; }
</style>

<div class="card create-card">
  <div class="card-header d-flex align-items-center justify-content-between">
    <div>
      <h5 class="mb-0"><i class="bi bi-person-plus-fill me-2"></i> Create User</h5>
      <small class="text-white-50">Add a new user and assign role & lab access</small>
    </div>
    <div class="text-end text-white-50">Required fields <span class="text-danger">*</span></div>
  </div>
  <div class="card-body">
    <form id="frmCreateUserModal" method="post" asp-action="CreateUser" autocomplete="off">
      @Html.AntiForgeryToken()
      <div id="createUserErrors" class="alert alert-danger d-none"></div>
      @* Server-side fallback validation (in case JS is blocked/disabled) *@
      @Html.ValidationSummary(excludePropertyErrors: false, message: "", htmlAttributes: new { @class = "text-danger mb-2" })

      <h6 class="text-muted mb-3">Account</h6>
      <div class="row g-3 mb-3">
        <div class="col-12">
          <label class="form-label">UserName <span class="text-danger">*</span></label>
          <div class="input-group">
            <input id="createUserUserName" class="form-control smooth" name="NewUser.UserName" placeholder="e.g. john.doe" required autocomplete="off" autocapitalize="none" spellcheck="false" />
            <span class="input-group-text bg-transparent"><i class="bi bi-at"></i></span>
            <div class="invalid-feedback" id="createUserUserNameFeedback"></div>
          </div>
        </div>
      </div>

      <div class="alert alert-info py-2 small mb-3">
        <i class="bi bi-envelope-check me-1"></i>
        No password is set here. The user is emailed a one-time password and a link to create their own password.
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-3">
          <label class="form-label">First Name</label>
          <input class="form-control smooth" name="NewUser.FirstName" placeholder="First name" />
        </div>
        <div class="col-md-3">
          <label class="form-label">Last Name</label>
          <input class="form-control smooth" name="NewUser.LastName" placeholder="Last name" />
        </div>
        <div class="col-md-3">
          <label class="form-label">Email Address <span class="text-danger">*</span></label>
          <div class="input-group">
            <input id="createUserEmail" class="form-control smooth" name="NewUser.Email" placeholder="user@example.com" type="email" required maxlength="256" />
            <span class="input-group-text bg-transparent"><i class="bi bi-envelope"></i></span>
            <div class="invalid-feedback" id="createUserEmailFeedback"></div>
          </div>
          @Html.ValidationMessageFor(m => m.NewUser.Email, "", new { @class = "text-danger small" })
          <small class="text-muted">The invitation with the first-login link is sent here</small>
        </div>
        <div class="col-md-3">
          <label class="form-label">Mobile Number</label>
          <div class="input-group">
            <input id="createUserMobile" class="form-control smooth" name="NewUser.Mobile" placeholder="+1 (000) 000-0000" />
            <span class="input-group-text bg-transparent"><i class="bi bi-telephone"></i></span>
            <div class="invalid-feedback" id="createUserMobileFeedback"></div>
          </div>
        </div>
      </div>

      <div class="row g-3 mb-4">
        <div class="col-md-6">
          <label class="form-label">Role <span class="text-danger">*</span></label>
          <select id="createUserRole" class="form-select select-smooth" name="NewUserRoleId" required>
            <option value="">-- select role --</option>
            @foreach(var r in Model.Roles) { <option value="@r.RoleID">@r.RoleName</option> }
          </select>
          <div class="invalid-feedback" id="createUserRoleFeedback"></div>
        </div>
        <div class="col-md-6">
          <label class="form-label">Labs <span class="text-danger">*</span></label>
          <div class="access-panel lab-chip-picker" data-input-name="NewUserLabIds">
            <div class="selected-labs" data-selected-labs>
              <span class="lab-chip-empty">No labs selected</span>
            </div>
            <div data-hidden-labs></div>
            <select id="createUserLab" class="form-select select-smooth">
              <option value="">Select lab to add</option>
              @foreach(var l in Model.Labs.Where(l => l.IsActive)) { <option value="@l.LabId">@l.LabName</option> }
            </select>
          </div>
          <div class="invalid-feedback" id="createUserLabFeedback"></div>
        </div>
      </div>

      <div class="d-flex gap-2 action-row">
        <button type="reset" class="btn btn-outline-secondary">Reset</button>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <div class="ms-auto">
          <button type="submit" class="btn btn-primary" data-create-user-submit data-default-text="Create User &amp; Send Invitation"><i class="bi bi-envelope-paper me-2"></i> <span>Create User &amp; Send Invitation</span></button>
        </div>
      </div>

    </form>
  </div>
</div>
