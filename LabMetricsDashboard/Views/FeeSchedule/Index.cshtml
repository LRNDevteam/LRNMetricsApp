@model LabMetricsDashboard.Models.FeeScheduleViewModel
@{
    ViewData["Title"] = "Fees Schedule Import";
    var last = Model.Rows.OrderByDescending(r => r.ImportedOn).FirstOrDefault();
    var priced = Model.Rows.Count(r => r.Rate > 0);
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h4 class="mb-0"><i class="bi bi-currency-dollar"></i> Fees Schedule Import</h4>
        <small class="text-muted">
            Rate per HCPCS / CPT code. The AR Workbench prices each claim's denied CPT lines with it (rate &times; units) to get the claim's
            Revenue Expectation; a claim is <strong>Fully Recovered</strong> once its total paid reaches that amount.
            @if (last is not null)
            {
                <span>Last imported @last.ImportedOn.ToLocalTime().ToString("MM/dd/yyyy hh:mm tt")@(string.IsNullOrWhiteSpace(last.ImportedBy) ? "" : $" by {last.ImportedBy}")@(string.IsNullOrWhiteSpace(last.SourceFile) ? "" : $" from {last.SourceFile}").</span>
            }
        </small>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (Model.SetupError is null && Model.Rows.Count > 0)
        {
            <a asp-action="Export" class="btn btn-outline-success btn-sm"><i class="bi bi-download"></i> Download</a>
        }
    </div>
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMsg <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Warning"] is string warningMsg)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @warningMsg <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string errorMsg)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMsg <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (Model.SetupError is not null)
{
    <div class="alert alert-warning">@Model.SetupError</div>
}

@if (Model.CanImport && Model.SetupError is null)
{
    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <form asp-action="Import" method="post" enctype="multipart/form-data" class="row g-2 align-items-center" id="fs-import-form">
                @Html.AntiForgeryToken()
                <div class="col-auto fw-bold small"><i class="bi bi-upload"></i> Import fee schedule</div>
                <div class="col">
                    <input type="file" name="file" class="form-control form-control-sm" accept=".xls,.xlsx,.csv" required />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary btn-sm">Import</button>
                </div>
                <div class="col-12">
                    <small class="text-muted">
                        Mandatory columns <strong>HCPCS</strong> and <strong>Rate</strong>; MOD, YEAR, EFF_DATE, INDICATOR and SHORTDESC are kept when present.
                        The Medicare Clinical Laboratory Fee Schedule .xls can be imported as published. The file <strong>replaces</strong> the whole schedule;
                        a code listed again with a modifier (e.g. QW) is kept once.
                    </small>
                </div>
            </form>
        </div>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex gap-2 mb-2 flex-wrap align-items-center">
            <input type="search" class="form-control form-control-sm" id="fs-search" placeholder="Search HCPCS or description" style="max-width:320px" />
            <small class="text-muted">@Model.Rows.Count.ToString("N0") code(s), @priced.ToString("N0") with a rate</small>
        </div>
        <div class="table-responsive" style="max-height:65vh">
            <table class="table table-sm table-hover table-bordered align-middle mb-0" id="fs-table">
                <thead class="table-light sticky-top">
                    <tr>
                        <th style="width:110px">HCPCS</th>
                        <th style="width:110px" class="text-end">Rate</th>
                        <th style="width:70px">MOD</th>
                        <th style="width:70px">Year</th>
                        <th style="width:110px">Effective</th>
                        <th style="width:90px">Indicator</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rows.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No fee schedule imported yet. Revenue Expectation stays $0 until one is.</td></tr>
                    }
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td class="fw-semibold">@r.Hcpcs</td>
                            <td class="text-end">@r.Rate.ToString("N2")</td>
                            <td>@r.Modifier</td>
                            <td>@r.FeeYear</td>
                            <td>@r.EffectiveDate?.ToString("MM/dd/yyyy")</td>
                            <td>@r.Indicator</td>
                            <td class="small">@r.ShortDescription</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script nonce='@Context.Items["CspNonce"]'>
    var fsImport = document.getElementById('fs-import-form');
    if (fsImport) {
        fsImport.addEventListener('submit', function (e) {
            if (!confirm('Replace the whole fee schedule with this file?')) e.preventDefault();
        });
    }

    var fsSearch = document.getElementById('fs-search');
    if (fsSearch) {
        fsSearch.addEventListener('input', function () {
            var term = fsSearch.value.trim().toLowerCase();
            document.querySelectorAll('#fs-table tbody tr').forEach(function (row) {
                if (row.cells.length < 2) return; // the "no rows" message
                row.style.display = !term || row.textContent.toLowerCase().indexOf(term) >= 0 ? '' : 'none';
            });
        });
    }
</script>
