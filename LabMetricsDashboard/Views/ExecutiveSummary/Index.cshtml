@* Notes & Insights callout (generic, report-agnostic component) *@
<link rel="stylesheet" href="~/css/notes-insights.css" asp-append-version="true" />
@await Html.PartialAsync("_NotesInsights", Model)
<script src="~/js/notes-insights.js" asp-append-version="true" nonce="@Context.Items["CspNonce"]"></script>

<script nonce='@Context.Items["CspNonce"]'>
// ── Async Excel export (preferred): queue via UserReqReports; LRN.ReportWorker
// generates the workbook in the background and the 📄 Reports badge notifies when
// ready. Falls back to the legacy synchronous ?export=excel download when the lab
// has no queue table (400) or the queue call fails.
(function () {
    var btn = document.getElementById('esExportExcelBtn');
    var form = document.getElementById('esFilterForm');
    if (!btn || !form) return;

    function legacyDownload() {
        var hidden = form.querySelector('input[name="export"]');
        if (!hidden) {
            hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = 'export';
            form.appendChild(hidden);
        }
        hidden.value = 'excel';
        form.submit();
        setTimeout(function () { hidden.value = ''; }, 1000);
    }

    btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var fd = new FormData(form);
        var val = function (n) { return (fd.get(n) || '').toString().trim() || null; };
        var num = function (n) { var v = val(n); return v != null && !isNaN(v) ? parseInt(v, 10) : null; };
        var all = function (n) {
            var v = fd.getAll(n).map(function (x) { return x.toString().trim(); })
                     .filter(function (x) { return x.length > 0; });
            return v.length > 0 ? v : null;
        };
        var filters = {
            YearFrom:   num('yearFrom'),
            YearTo:     num('yearTo'),
            MonthFrom:  num('monthFrom'),
            MonthTo:    num('monthTo'),
            DosFrom:    val('dosFrom'),
            DosTo:      val('dosTo'),
            BilledFrom: val('billedFrom'),
            BilledTo:   val('billedTo'),
            Panels:     all('panels'),
            Clinics:    all('clinics'),
            Providers:  all('providers'),
            Reps:       all('reps')
        };

        var body = new FormData();
        body.append('lab', '@Model.SelectedLab');
        body.append('reportType', 'ExecutiveSummary');
        body.append('filterDetails', JSON.stringify(filters));
        var af = document.querySelector('#lrnReportsAf input[name="__RequestVerificationToken"]');
        if (af) body.append('__RequestVerificationToken', af.value);

        var original = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Queuing…';

        fetch('@Url.Action("Queue", "UserReports")', { method: 'POST', body: body })
            .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, status: r.status, j: j }; }); })
            .then(function (res) {
                if (res.ok) {
                    btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Generating - watch Reports';
                    if (window.lrnShowReportAlert) window.lrnShowReportAlert('success');
                    if (window.lrnReportsBadgeRefresh) window.lrnReportsBadgeRefresh();
                    setTimeout(function () { btn.disabled = false; btn.innerHTML = original; }, 8000);
                } else if (res.status === 400) {
                    btn.disabled = false; btn.innerHTML = original;
                    legacyDownload();
                } else {
                    btn.disabled = false; btn.innerHTML = original;
                    var qMsg = res.j && res.j.message ? res.j.message : '';
                    if (window.lrnShowReportAlert) {
                        if (res.status === 409 || /already/i.test(qMsg)) {
                            window.lrnShowReportAlert('info');
                        } else {
                            window.lrnShowReportAlert('error', { message: qMsg || 'Could not queue the report.' });
                        }
                    }
                }
            })
            .catch(function () {
                btn.disabled = false; btn.innerHTML = original;
                legacyDownload();
            });
    });
})();
</script>

<div class="card">
    <div class="card-body p-0">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger m-3">
                <i class="bi bi-exclamation-circle-fill"></i>
                @Model.ErrorMessage
            </div>
        }
        else if (!Model.HasData)
        {
            <div class="text-center p-5">
                <i class="bi bi-inbox" style="font-size: 3rem; color: #6c757d;"></i>
                <p class="mt-2">No data found for the selected filters.</p>
            </div>
        }
        else
        {
            int totalDataCols = esYears.Sum(year => (esMonthsByYear.ContainsKey(year) ? esMonthsByYear[year].Count : 0) + 1);
            int totalCols = 1 + totalDataCols + 1; // description + (months + year-total) per year + grand total
            // Header date basis: matches the SP's @UseBilledDate rule —
            // FirstBilledDate when a Billed range is set and no DOS range is set; otherwise DOS.
            bool esUseBilled = (Model.BilledFrom.HasValue || Model.BilledTo.HasValue)
                               && !Model.DosFrom.HasValue && !Model.DosTo.HasValue;
            string esDateBasis = esUseBilled ? "Billed Date" : "DOS";
            <div class="es-wrap m-2">
                <div class="es-scroll">
                    <table class="es-table">
                        <colgroup>
                            <col style="width:240px" />
                            @foreach (var year in esYears)
                            {
                                var mons = esMonthsByYear.ContainsKey(year) ? esMonthsByYear[year] : new List<int>();
                                foreach (var _ in mons)
                                {
                                    <col style="width:78px" />
                                }
                                <col style="width:100px" />
                            }
                            <col style="width:108px" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th rowspan="2" class="col-desc">Description</th>
                                @foreach (var year in esYears)
                                {
                                    var mons = esMonthsByYear.ContainsKey(year) ? esMonthsByYear[year] : new List<int>();
                                    <th colspan="@(mons.Count + 1)">Data Based on @esDateBasis &mdash; @year</th>
                                }
                                <th rowspan="2" class="es-grand">Grand Total</th>
                            </tr>
                            <tr>
                                @foreach (var year in esYears)
                                {
                                    var mons = esMonthsByYear.ContainsKey(year) ? esMonthsByYear[year] : new List<int>();
                                    foreach (var m in mons)
                                    {
                                        <th>@MonthName(m).ToUpper()</th>
                                    }
                                    <th class="es-year-total">@year Total</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{ int sectionNum = 0; }
                            @foreach (var tab in tabs)
                            {
                                var rows = Model.Rows.Where(r => r.Category == tab).ToList();
                                if (rows.Count == 0) continue;
                                sectionNum++;
                                <tr class="es-section-row">
                                    <td class="es-section-cell" colspan="@totalCols">@sectionNum. @TabLabel(tab)</td>
                                </tr>
                                string? drillParentTitle = null;
                                string? drillSubParentTitle = null;
                                foreach (var row in rows)
                                {
                                    bool isSub = row.IsSubRow;
                                    string rClass = row.IsSubSubRow ? "es-sub-sub-row"
                                                  : isSub           ? "es-sub-row"
                                                  :                   "es-cat-row";
                                    bool dollarRow = IsDollar(row.Category);

                                    var leafTitle = (row.Description ?? "").Trim();
                                    if (!isSub)
                                    {
                                        drillParentTitle = leafTitle;
                                        drillSubParentTitle = null;
                                    }
                                    // Insight heading: parent - child (and grandparent - parent - child for sub-sub).
                                    string insightRowTitle;
                                    if (row.IsSubSubRow)
                                    {
                                        if (!string.IsNullOrEmpty(drillParentTitle) && !string.IsNullOrEmpty(drillSubParentTitle))
                                            insightRowTitle = $"{drillParentTitle} - {drillSubParentTitle} - {leafTitle}";
                                        else if (!string.IsNullOrEmpty(drillSubParentTitle))
                                            insightRowTitle = $"{drillSubParentTitle} - {leafTitle}";
                                        else if (!string.IsNullOrEmpty(drillParentTitle))
                                            insightRowTitle = $"{drillParentTitle} - {leafTitle}";
                                        else
                                            insightRowTitle = leafTitle;
                                    }
                                    else if (isSub && !string.IsNullOrEmpty(drillParentTitle))
                                    {
                                        insightRowTitle = $"{drillParentTitle} - {leafTitle}";
                                    }
                                    else
                                    {
                                        insightRowTitle = leafTitle;
                                    }
                                    if (isSub && !row.IsSubSubRow)
                                        drillSubParentTitle = leafTitle;

                                    // LIS Breakdown analytical drill-through: the Total No. of Samples
                                    // (RowCode L_0) and Billable Samples - Resulted (RowCode L_A) rows
                                    // send their Grand Total / Year Total cells to the LisDrill action
                                    // (Excel logic: MoM, 6-mo avg, 9-day comparison, top panels).
                                    string? lisDrillMetric = null;
                                    if (row.Category == "LIS")
                                    {
                                        var descNorm = leafTitle;
                                        if (row.RowCode == "L_0"
                                            || descNorm.Equals("Total No. of Samples", StringComparison.OrdinalIgnoreCase)
                                            || descNorm.Equals("Total Samples", StringComparison.OrdinalIgnoreCase))
                                        {
                                            lisDrillMetric = "Samples";
                                        }
                                        else if (row.RowCode == "L_A"
                                            || descNorm.StartsWith("Billable Samples", StringComparison.OrdinalIgnoreCase))
                                        {
                                            lisDrillMetric = "Billable";
                                        }
                                        else if (row.RowCode == "L_B"
                                            || descNorm.Equals("Not Resulted", StringComparison.OrdinalIgnoreCase))
                                        {
                                            lisDrillMetric = "NotResulted";
                                        }
                                    }

                                    // Panel-specific sub-rows (dynamic per-panel breakdown under Billable /
                                    // Coding Exception): no Insight drill links — display values only.
                                    // Patterns: B1.{Panel}, L_A.{Panel}, L_B.{Panel}, or 4-space sub-sub-rows.
                                    var rc = row.RowCode ?? "";
                                    bool isPanelSpecificRow =
                                        row.IsSubSubRow
                                        || rc.StartsWith("B1.", StringComparison.OrdinalIgnoreCase)
                                        || rc.StartsWith("L_A.", StringComparison.OrdinalIgnoreCase)
                                        || rc.StartsWith("L_B.", StringComparison.OrdinalIgnoreCase);
                                    var gTot = RowGrandTotal(row);

                                    <tr class="@rClass" data-row-code="@row.RowCode">
                                        <td class="col-desc">
                                            @if (dollarRow)
                                            {
                                                <span class="dollar-badge">$</span>
                                            }
                                            @leafTitle
                                        </td>
                                        @foreach (var year in esYears)
                                        {
                                            var mons = esMonthsByYear.ContainsKey(year) ? esMonthsByYear[year] : new List<int>();
                                            foreach (var m in mons)
                                            {
                                                row.ValuesByYearMonth.TryGetValue((year, m), out var v);
                                                string cellVal = FmtCount(v, row.Category, row.RowCode);
                                                // Monthly cells are display-only — drill links live on the
                                                // Year Total / Grand Total cells of the two LIS rows only.
                                                <td><span class="es-pill@(dollarRow ? " es-pill-dollar" : "")">@cellVal</span></td>
                                            }
                                            var yrTot = RowYearTotal(row, year);
                                            @* Prefer rowCode (lab-specific LisDrillRowDef) over generic
                                               metric=Billable — Inhealth Billable is RowCode B, not L_A. *@
                                            @if (!isPanelSpecificRow && (row.Category == "LIS" || row.Category == "PMS" || row.Category == "Cash") && !string.IsNullOrEmpty(row.RowCode) && yrTot != 0)
                                            {
                                                string yrRowUrl = Url.Action("LisDrill", "ExecutiveSummary", new {
                                                    lab      = Model.SelectedLab,
                                                    rowCode  = row.RowCode,
                                                    rowTitle = insightRowTitle,
                                                    category = row.Category,
                                                    year,
                                                    value    = yrTot,
                                                })!;
                                                <td class="es-year-total">
                                                    <a href="@yrRowUrl" class="es-drill-link@(dollarRow ? " es-link-dollar" : "")">@FmtCount(yrTot, row.Category, row.RowCode)</a>
                                                </td>
                                            }
                                            else if (!isPanelSpecificRow && lisDrillMetric != null && yrTot != 0)
                                            {
                                                string yrDrillUrl = Url.Action("LisDrill", "ExecutiveSummary", new {
                                                    lab    = Model.SelectedLab,
                                                    metric = lisDrillMetric,
                                                    year,
                                                    value  = yrTot,
                                                })!;
                                                <td class="es-year-total">
                                                    <a href="@yrDrillUrl" class="es-drill-link@(dollarRow ? " es-link-dollar" : "")">@FmtCount(yrTot, row.Category, row.RowCode)</a>
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="es-year-total"><span class="es-pill@(dollarRow ? " es-pill-dollar" : "")">@FmtCount(yrTot, row.Category, row.RowCode)</span></td>
                                            }
                                        }
                                        @if (!isPanelSpecificRow && (row.Category == "LIS" || row.Category == "PMS" || row.Category == "Cash") && !string.IsNullOrEmpty(row.RowCode) && gTot != 0)
                                        {
                                            string gtRowUrl = Url.Action("LisDrill", "ExecutiveSummary", new {
                                                lab      = Model.SelectedLab,
                                                rowCode  = row.RowCode,
                                                rowTitle = insightRowTitle,
                                                category = row.Category,
                                                year     = 0,
                                                value    = gTot,
                                            })!;
                                            <td class="es-grand">
                                                <a href="@gtRowUrl" class="es-drill-link@(dollarRow ? " es-link-dollar" : "")">@FmtCount(gTot, row.Category, row.RowCode)</a>
                                            </td>
                                        }
                                        else if (!isPanelSpecificRow && lisDrillMetric != null && gTot != 0)
                                        {
                                            string gtDrillUrl = Url.Action("LisDrill", "ExecutiveSummary", new {
                                                lab    = Model.SelectedLab,
                                                metric = lisDrillMetric,
                                                year   = 0,
                                                value  = gTot,
                                            })!;
                                            <td class="es-grand">
                                                <a href="@gtDrillUrl" class="es-drill-link@(dollarRow ? " es-link-dollar" : "")">@FmtCount(gTot, row.Category, row.RowCode)</a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="es-grand"><span class="es-pill@(dollarRow ? " es-pill-dollar" : "")">@FmtCount(gTot, row.Category, row.RowCode)</span></td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

<script nonce='@Context.Items["CspNonce"]'>
    // ── Collapsible rows (3-level hierarchy) ───────────────────────────
    // Level 1: es-cat-row  → collapses es-sub-row children
    //          (stops at next es-cat-row; skips es-sub-sub-row)
    // Level 2: es-sub-row  → collapses es-sub-sub-row children
    //          (stops at next es-sub-row OR es-cat-row)
    // State persists per RowCode via localStorage.
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.es-table tbody').forEach(function (tbody) {
            var rows = Array.prototype.slice.call(tbody.children).filter(function (r) {
                return r.tagName === 'TR';
            });

            function wireCollapse(parentClass, childClass, stopClass, grandchildClass) {
                rows.forEach(function (row, i) {
                    if (!row.classList.contains(parentClass)) return;

                    var children = [];
                    var grandchildren = [];
                    for (var j = i + 1; j < rows.length; j++) {
                        // stop at next sibling of same or higher level
                        if (rows[j].classList.contains(stopClass)) break;
                        if (rows[j].classList.contains(parentClass)) break;
                        if (rows[j].classList.contains(childClass)) children.push(rows[j]);
                        if (grandchildClass && rows[j].classList.contains(grandchildClass)) grandchildren.push(rows[j]);
                    }
                    if (children.length === 0) return;

                    row.classList.add('has-children');
                    var desc = row.querySelector('td.col-desc');
                    var storeKey = 'es-collapse-' + (row.getAttribute('data-row-code') || row.rowIndex);

                    function applyState(collapsed) {
                        row.classList.toggle('es-collapsed', collapsed);
                        children.forEach(function (r) { r.classList.toggle('es-hidden', collapsed); });
                        if (collapsed) {
                            // Also hide grandchildren when parent collapses
                            grandchildren.forEach(function (r) { r.classList.add('es-hidden'); });
                        } else {
                            // When expanding, only show grandchildren whose direct child-row parent is not itself collapsed
                            grandchildren.forEach(function (r) {
                                var rIdx = rows.indexOf(r);
                                var parentCollapsed = false;
                                for (var k = rIdx - 1; k > i; k--) {
                                    if (rows[k].classList.contains(childClass)) {
                                        parentCollapsed = rows[k].classList.contains('es-collapsed');
                                        break;
                                    }
                                }
                                if (!parentCollapsed) {
                                    r.classList.remove('es-hidden');
                                }
                            });
                        }
                    }

                    applyState(localStorage.getItem(storeKey) === '1');

                    desc.addEventListener('click', function (e) {
                        // Prevent the click from bubbling to a parent collapsible row
                        e.stopPropagation();
                        var collapsed = !row.classList.contains('es-collapsed');
                        applyState(collapsed);
                        localStorage.setItem(storeKey, collapsed ? '1' : '0');
                    });
                });
            }

            // Wire level-2 first (sub-sub inside sub) then level-1 (sub inside cat)
            // Pass 'es-sub-sub-row' as grandchildClass so cat-row collapse also hides grandchildren
            wireCollapse('es-sub-row',  'es-sub-sub-row', 'es-cat-row');
            wireCollapse('es-cat-row',  'es-sub-row',     'es-cat-row', 'es-sub-sub-row');
        });
    });

    // ── Description filter (client-side only) ─────────────────────────
    document.addEventListener('DOMContentLoaded', function () {
        var input = document.getElementById('esDescFilter');
        var clearBtn = document.getElementById('esDescFilterClear');
        if (!input) return;

        function applyDescFilter() {
            var q = input.value.trim().toLowerCase();
            document.querySelectorAll('.es-table tbody').forEach(function (tbody) {
                var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
                if (!q) {
                    tbody.classList.remove('es-filtering');
                    rows.forEach(function (r) { r.classList.remove('es-filter-hidden'); });
                    return;
                }
                tbody.classList.add('es-filtering');
                rows.forEach(function (r) {
                    if (r.classList.contains('es-section-row')) { r.classList.remove('es-filter-hidden'); return; }
                    var desc = r.querySelector('td.col-desc');
                    var label = desc ? desc.textContent.trim().toLowerCase() : '';
                    r.classList.toggle('es-filter-hidden', label.indexOf(q) === -1);
                });
            });
        }

        input.addEventListener('input', applyDescFilter);
        input.addEventListener('keydown', function (e) { if (e.key === 'Enter') e.preventDefault(); });
        if (clearBtn) { clearBtn.addEventListener('click', function () { input.value = ''; applyDescFilter(); input.focus(); }); }
    });

    // ── Filter panel collapse/expand ───────────────────────────────────
    document.addEventListener('DOMContentLoaded', function () {
        var toggle = document.getElementById('esFilterToggle');
        var body   = document.getElementById('esFilterBody');
        var card   = document.getElementById('esFilterCard');
        if (!toggle || !body) return;

        toggle.addEventListener('click', function () {
            var open = body.style.display !== 'none' && body.style.display !== '';
            if (open || body.offsetParent !== null) {
                body.style.display = 'none';
                card.classList.add('collapsed');
                toggle.setAttribute('aria-expanded', 'false');
            } else {
                body.style.display = '';
                card.classList.remove('collapsed');
                toggle.setAttribute('aria-expanded', 'true');
            }
        });
    });

    // ── Custom checkbox-dropdown widget ────────────────────────────────
    document.addEventListener('DOMContentLoaded', function () {
        var openMenu = null;

        // Build a dropdown from a .es-dropdown-wrap that contains
        // .es-dd-btn, .es-dd-menu, and .es-hidden-select
        document.querySelectorAll('.es-dropdown-wrap').forEach(function (wrap) {
            var btn       = wrap.querySelector('.es-dd-btn');
            var menu      = wrap.querySelector('.es-dd-menu');
            var select    = wrap.querySelector('.es-hidden-select');
            var searchInp = menu && menu.querySelector('.es-dd-search input');
            var list      = menu && menu.querySelector('.es-dd-list');
            var clearBtn  = menu && menu.querySelector('.es-dd-clear');
            var doneBtn   = menu && menu.querySelector('.es-dd-done');
            if (!btn || !menu || !select) return;
            // Skip disabled buttons — they have no items to interact with.
            if (btn.disabled) return;

            var placeholder = btn.getAttribute('data-placeholder') || 'Select…';

            function updateBtnLabel() {
                var selected = Array.prototype.filter.call(select.options, function (o) { return o.selected; });
                var labelEl  = btn.querySelector('.es-dd-label');
                var countEl  = btn.querySelector('.es-dd-count');
                if (selected.length === 0) {
                    if (labelEl) { labelEl.textContent = placeholder; labelEl.className = 'es-dd-label es-dd-placeholder'; }
                    if (countEl) countEl.remove();
                    btn.classList.remove('active');
                } else {
                    var txt = selected.length === 1 ? selected[0].value : selected.length + ' selected';
                    if (labelEl) { labelEl.textContent = txt; labelEl.className = 'es-dd-label'; }
                    if (!countEl) {
                        countEl = document.createElement('span');
                        countEl.className = 'es-dd-count';
                        var caret = btn.querySelector('.es-dd-caret');
                        btn.insertBefore(countEl, caret);
                    }
                    countEl.textContent = selected.length;
                    btn.classList.add('active');
                }
                // Only call refreshActiveChips once the date-exclusivity vars are set up.
                if (typeof refreshActiveChips === 'function') refreshActiveChips();
            }

            // Sync hidden <select> from checkboxes
            function syncSelectFromCheckboxes() {
                if (!list) return;
                var checks = list.querySelectorAll('input[type=checkbox]');
                Array.prototype.forEach.call(checks, function (cb) {
                    Array.prototype.forEach.call(select.options, function (opt) {
                        if (opt.value === cb.value) opt.selected = cb.checked;
                    });
                });
                updateBtnLabel();
            }

            // Sync checkboxes from hidden <select>
            function syncCheckboxesFromSelect() {
                if (!list) return;
                var checks = list.querySelectorAll('input[type=checkbox]');
                Array.prototype.forEach.call(checks, function (cb) {
                    Array.prototype.forEach.call(select.options, function (opt) {
                        if (opt.value === cb.value) cb.checked = opt.selected;
                    });
                });
            }

            if (list) {
                list.addEventListener('change', function (e) {
                    if (e.target.type === 'checkbox') syncSelectFromCheckboxes();
                });
            }

            if (searchInp && list) {
                searchInp.addEventListener('input', function () {
                    var q = searchInp.value.trim().toLowerCase();
                    Array.prototype.forEach.call(list.querySelectorAll('.es-dd-item'), function (item) {
                        item.style.display = (!q || item.textContent.toLowerCase().indexOf(q) > -1) ? '' : 'none';
                    });
                });
                // Prevent Enter inside the search box from submitting the outer form.
                searchInp.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') { e.preventDefault(); e.stopPropagation(); }
                });
            }

            if (clearBtn) {
                clearBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    Array.prototype.forEach.call(select.options, function (o) { o.selected = false; });
                    syncCheckboxesFromSelect();
                    updateBtnLabel();
                });
            }

            if (doneBtn) {
                doneBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    closeMenu();
                });
            }

            function openMenuFn() {
                if (openMenu && openMenu !== menu) { openMenu.classList.remove('open'); }
                menu.classList.add('open');
                openMenu = menu;
                // Position menu so it doesn't overflow viewport bottom
                var rect = btn.getBoundingClientRect();
                var spaceBelow = window.innerHeight - rect.bottom;
                menu.style.top    = spaceBelow > 240 ? '100%' : '';
                menu.style.bottom = spaceBelow > 240 ? ''      : '100%';
                if (searchInp) { searchInp.value = ''; searchInp.dispatchEvent(new Event('input')); searchInp.focus(); }
                syncCheckboxesFromSelect();
            }

            function closeMenu() { menu.classList.remove('open'); if (openMenu === menu) openMenu = null; }

            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                menu.classList.contains('open') ? closeMenu() : openMenuFn();
            });

            menu.addEventListener('click', function (e) { e.stopPropagation(); });

            // initialise label
            updateBtnLabel();
        });

        // Close any open menu on outside click
        document.addEventListener('click', function () {
            if (openMenu) { openMenu.classList.remove('open'); openMenu = null; }
        });

        // ── Active filter chips ─────────────────────────────────────────
        var chipsWrap = document.getElementById('esActiveChips');
        var chipsContainer = document.getElementById('esChipsContainer');
        var countBadge = document.getElementById('esActiveCountBadge');

        function makeChip(label, clearFn) {
            var chip = document.createElement('span');
            chip.className = 'es-chip';
            chip.innerHTML = label + ' <span class="es-chip-x" title="Remove">&times;</span>';
            chip.querySelector('.es-chip-x').addEventListener('click', function () { clearFn(); refreshActiveChips(); });
            return chip;
        }

        function refreshActiveChips() {
            // Keep DOS/Billed enable-state in sync (covers chip "×" clears, presets, etc.)
            if (typeof syncDateExclusivity === 'function') syncDateExclusivity();
            if (!chipsContainer) return;
            chipsContainer.innerHTML = '';
            var count = 0;

            // Date inputs
            document.querySelectorAll('.es-date-input').forEach(function (inp) {
                if (inp.value) {
                    count++;
                    var lbl = (inp.dataset.label || inp.name) + ': ' + inp.value;
                    chipsContainer.appendChild(makeChip(lbl, function () { inp.value = ''; }));
                }
            });


            // Dimension selects
            ['selPanels','selClinics','selProviders','selReps'].forEach(function (id) {
                var sel = document.getElementById(id);
                if (!sel) return;
                var selected = Array.prototype.filter.call(sel.options, function (o) { return o.selected; });
                selected.forEach(function (opt) {
                    count++;
                    var val = opt.value;
                    chipsContainer.appendChild(makeChip(val, function () {
                        opt.selected = false;
                        // Uncheck matching checkbox in the menu
                        document.querySelectorAll('#' + id.replace('sel', 'list') + ' input[type=checkbox]').forEach(function (cb) {
                            if (cb.value === val) cb.checked = false;
                        });
                        // Re-sync the button label
                        var wrap = sel.closest('.es-dropdown-wrap');
                        if (wrap) {
                            var btn = wrap.querySelector('.es-dd-btn');
                            if (btn) btn.dispatchEvent(new CustomEvent('_labelUpdate'));
                        }
                    }));
                });
            });

            if (chipsWrap) chipsWrap.style.display = count ? '' : 'none';
            if (countBadge) { countBadge.textContent = count; countBadge.style.display = count ? '' : 'none'; }
        }

        // Trigger chip refresh when date inputs change
        document.querySelectorAll('.es-date-input').forEach(function (inp) { inp.addEventListener('change', refreshActiveChips); });

        // ── DOS ⇄ First Billed Date mutual exclusivity ──────────────────
        // NOTE: syncDateExclusivity() queries the DOM fresh on every call so
        // refreshActiveChips() (called during dropdown init above) can safely
        // invoke it before the variables below are assigned.
        //
        // Overlay strategy: an absolutely-positioned div is dynamically created
        // on top of each date-input row.  When a group is locked the overlay is
        // shown — it sits above the inputs (z-index:10) and intercepts every
        // pointer event, preventing the browser-native calendar picker from
        // opening even though the native picker button lives in the browser's
        // shadow DOM and is not reachable via CSS pointer-events on the input.
        function esAnyVal(nodeList) {
            return Array.prototype.some.call(nodeList, function (i) { return !!i.value; });
        }

        // Create (once) a transparent blocking overlay inside a date-input row.
        function esEnsureOverlay(groupId) {
            var wrap = document.querySelector('#' + groupId + ' .d-flex');
            if (!wrap) return null;
            var ov = wrap.querySelector('.es-date-overlay');
            if (ov) return ov;
            ov = document.createElement('div');
            ov.className = 'es-date-overlay';
            ov.style.cssText =
                'display:none;position:absolute;top:0;left:0;right:0;bottom:0;' +
                'z-index:10;cursor:not-allowed;border-radius:.375rem;' +
                'background:rgba(248,250,252,0.60);';
            // Absorb clicks so they never reach the inputs below.
            ov.addEventListener('click',      function(e){ e.preventDefault(); e.stopPropagation(); });
            ov.addEventListener('mousedown',  function(e){ e.preventDefault(); e.stopPropagation(); });
            ov.addEventListener('touchstart', function(e){ e.preventDefault(); e.stopPropagation(); }, { passive: false });
            wrap.style.position = 'relative';
            wrap.appendChild(ov);
            return ov;
        }
        var dosOverlay    = esEnsureOverlay('esDosGroup');
        var billedOverlay = esEnsureOverlay('esBilledGroup');

        function esSetDisabled(nodeList, groupEl, overlay, disabled, customTitle) {
            Array.prototype.forEach.call(nodeList, function (i) {
                // disabled attribute: prevents form submission AND blocks the
                // native browser date picker reliably.
                if (disabled) { i.setAttribute('disabled', ''); }
                else          { i.removeAttribute('disabled'); }
            });
            if (groupEl) {
                groupEl.style.opacity = disabled ? '0.42' : '';
                groupEl.title = disabled
                    ? (customTitle || 'Clear the other date range (Reset Date Range) to use this one') : '';
            }
            // Show/hide the overlay on top of the inputs.
            if (overlay) overlay.style.display = disabled ? 'block' : 'none';
        }
        function esClearVals(nodeList) {
            Array.prototype.forEach.call(nodeList, function (i) { i.value = ''; });
        }
        function syncDateExclusivity(showAlert) {
            var dosI    = document.querySelectorAll('.es-dos-input');
            var billedI = document.querySelectorAll('.es-billed-input');
            var dosG    = document.getElementById('esDosGroup');
            var billedG = document.getElementById('esBilledGroup');
            var alertEl = document.getElementById('esDateConflictAlert');
            // NorthWest: First Billed Date is permanently disabled (LIMSMaster has
            // no FirstBilledDate column) — never re-enabled by the DOS/Billed
            // mutual-exclusivity logic below, regardless of DOS state.
            var billedPermanentlyDisabled = !!billedG && billedG.getAttribute('data-permanently-disabled') === 'true';
            var dosActive    = esAnyVal(dosI);
            var billedActive = billedPermanentlyDisabled ? false : esAnyVal(billedI);
            var conflict = dosActive && billedActive;
            // DOS takes precedence — clear Billed when both are active.
            if (conflict) { esClearVals(billedI); billedActive = false; }
            if (alertEl) alertEl.style.display = (conflict && showAlert) ? '' : 'none';
            esSetDisabled(billedI, billedG, billedOverlay, dosActive || billedPermanentlyDisabled,
                billedPermanentlyDisabled ? 'First Billed Date is not available for NorthWest' : undefined);
            esSetDisabled(dosI,    dosG,    dosOverlay,    billedActive);
        }

        // Listen on both 'change' and 'input' — browsers differ on which fires for date pickers.
        Array.prototype.forEach.call(
            document.querySelectorAll('.es-dos-input, .es-billed-input'),
            function (i) {
                i.addEventListener('change', function () { syncDateExclusivity(false); refreshActiveChips(); });
                i.addEventListener('input',  function () { syncDateExclusivity(false); refreshActiveChips(); });
            });
        syncDateExclusivity(true); // initial pass — show alert if server returned both

        // ── Reset Date Range button: clears both ranges and re-enables both ──
        var resetDatesBtn = document.getElementById('esResetDates');
        if (resetDatesBtn) {
            resetDatesBtn.addEventListener('click', function () {
                var alertEl = document.getElementById('esDateConflictAlert');
                if (alertEl) alertEl.style.display = 'none';
                // Clear values only — syncDateExclusivity() below re-derives the
                // disabled state for both groups, respecting any permanently
                // disabled group (e.g. NorthWest's First Billed Date), so it is
                // never accidentally re-enabled here.
                Array.prototype.forEach.call(
                    document.querySelectorAll('.es-dos-input, .es-billed-input'),
                    function (i) { i.value = ''; });
                syncDateExclusivity(false);
                refreshActiveChips();
            });
        }
    });
</script>
