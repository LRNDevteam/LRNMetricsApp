@model LabMetricsDashboard.Models.PhiExecutiveSummaryViewModel
@*
    Generic Notes & Insights callout for a report page.
    Context (lab, report name, RunID, week range) is passed to the
    client via data-* attributes on #niRoot; the JS controller
    (notes-insights.js) drives all interactions through the
    NotesController JSON API.
*@
@{
    // Admin > Report Visibility: hidden Key Insights drop the panel; Add / Edit / Delete / Import /
    // Template are allowed or denied one by one (NotesController refuses denied writes as well).
    var niAccess = await Context.GetReportAccessAsync(LabMetricsDashboard.Models.ReportVisibility.ReportVisibilityCatalog.ExecutiveSummary);
    if (!niAccess.KeyInsightsVisible) { return; }
    string NiFlag(LabMetricsDashboard.Models.ReportVisibility.KeyInsightAction a) => niAccess.CanKeyInsights(a, fallback: true) ? "1" : "0";
}
<div id="niRoot"
     data-can-add="@NiFlag(LabMetricsDashboard.Models.ReportVisibility.KeyInsightAction.Add)"
     data-can-edit="@NiFlag(LabMetricsDashboard.Models.ReportVisibility.KeyInsightAction.Edit)"
     data-can-delete="@NiFlag(LabMetricsDashboard.Models.ReportVisibility.KeyInsightAction.Delete)"
     data-can-import="@NiFlag(LabMetricsDashboard.Models.ReportVisibility.KeyInsightAction.Import)"
     data-can-template="@NiFlag(LabMetricsDashboard.Models.ReportVisibility.KeyInsightAction.Template)"
     data-base="@Url.Content("~/")"
     data-lab="@Model.SelectedLab"
     data-report-name="Executive Summary"
     data-run-id="@(Model.ReportRunId ?? "")"
     data-week-text="@(Model.ReportWeekFolder ?? "")"
     data-week-start=""
     data-week-end="">

    @Html.AntiForgeryToken()

    <div class="ni-callout" role="dialog" aria-label="Notes and Insights">
        <div class="ni-header">
            <span class="ni-title">✎ Notes &amp; Insights</span>
            <span class="ni-sub">Rolling current report log · most recent 4 weeks + carry-forward</span>
            <span class="ni-win-actions">
                <button type="button" data-ni-min title="Collapse">–</button>
                <button type="button" data-ni-close title="Close">✕</button>
            </span>
        </div>
        <div class="ni-context"></div>
        <div class="ni-toolbar"></div>
        <div class="ni-body"></div>
        <div class="ni-footer" data-ni-footer></div>
    </div>
</div>
