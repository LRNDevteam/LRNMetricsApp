@model LabMetricsDashboard.Models.PhiExecutiveSummaryViewModel
@{
    var insight = Model.AiThreePillarInsight;
}

@if (insight is null)
{
    return;
}

<div class="card mb-4" style="border:none;border-radius:12px;box-shadow:0 2px 14px rgba(0,0,0,.08)">
    <div class="card-header text-white d-flex align-items-center justify-content-between"
         style="background:linear-gradient(135deg,#0d1b2a,#0f766e);border-radius:12px 12px 0 0">
        <div>
            <div class="fw-bold">AI Three-Pillar Insights</div>
            <div style="font-size:.72rem;opacity:.85;font-weight:400">
                From LIS / PMS / Cash JSON · not the Notes journal
            </div>
        </div>
        <span class="badge bg-light text-dark" style="font-size:.68rem">@insight.ReportPeriod</span>
    </div>
    @if (!string.IsNullOrWhiteSpace(insight.Headline))
    {
        <div class="px-3 py-2" style="background:#ecfdf5;border-bottom:1px solid #a7f3d0;font-size:.85rem;color:#115e59">
            <strong>Headline.</strong> @insight.Headline
        </div>
    }
    <div class="p-3" style="background:#f8fafc">
        <div class="row g-3">
            @foreach (var sec in insight.Sections)
            {
                <div class="col-12 col-xl-6">
                    <div class="h-100 rounded-3 overflow-hidden"
                         style="background:#fff;border:1px solid #e2e8f0">
                        <div class="px-3 py-2 fw-bold" style="font-size:.78rem;letter-spacing:.04em;text-transform:uppercase;background:#f1f5f9;border-bottom:1px solid #e2e8f0">
                            @sec.SectionNumber. @sec.Title
                        </div>
                        <div class="px-3 py-2">
                            @foreach (var sub in sec.Subsections)
                            {
                                if (!string.IsNullOrWhiteSpace(sub.Title))
                                {
                                    <div class="mb-1 mt-2" style="font-size:.68rem;font-weight:700;color:#0f766e;text-transform:uppercase;letter-spacing:.04em">
                                        @sub.Title
                                    </div>
                                }
                                <ul class="mb-2 ps-3" style="font-size:.8rem;color:#374151;line-height:1.5">
                                    @foreach (var bullet in sub.Bullets)
                                    {
                                        <li class="mb-1">@bullet</li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="d-flex align-items-center justify-content-between px-3 py-2"
         style="background:#f8fafc;border-top:1px solid #e2e8f0;font-size:.68rem;color:#94a3b8">
        <span>Source: @insight.SourceFileName</span>
        <span>@insight.ModelUsed</span>
    </div>
</div>
