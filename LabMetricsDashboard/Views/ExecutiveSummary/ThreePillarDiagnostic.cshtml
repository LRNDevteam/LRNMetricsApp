        margin: 0 0 .35rem; min-height: 1.1rem;
    }
    .tpd-stack-legend span {
        display: inline-flex; align-items: center; gap: .22rem;
        font-size: .62rem; font-weight: 600; color: #475569; line-height: 1.2;
        white-space: nowrap;
    }
    .tpd-stack-legend i {
        width: 7px; height: 7px; border-radius: 1px; flex: 0 0 7px; display: inline-block;
    }
    .tpd-vol-hint { font-size: .78rem; color: #64748b; margin: .4rem 0 0; }
    .tpd-stack-col { cursor: pointer; }
    .tpd-stack-svg .tpd-stack-col.is-on rect { stroke: #0f172a; stroke-width: 1.4; }
    .tpd-stack-svg .tpd-stack-col.is-dim { opacity: .38; }
    .tpd-vol-svg .tpd-vol-hit, .tpd-vol-svg .tpd-vol-pt, .tpd-vol-svg .tpd-vol-lbl { cursor: pointer; }
    .tpd-vol-svg .tpd-vol-pt.is-on { stroke: #0f172a; stroke-width: 2.2; }
    .tpd-chart-lg { max-width: none; width: 100%; margin: 0; }
    .tpd-chart-vol { width: 100%; max-width: none; }
    .tpd-backlog-row {
        display: grid;
        grid-template-columns: 65% 35%;
        gap: 1rem;
        align-items: start;
    }
    .tpd-backlog-meta { max-width: none; margin: 0; padding-top: .35rem; }
    @@media (max-width: 900px) {
        .tpd-grid2, .tpd-cash-grid { grid-template-columns: 1fr; }
        .tpd-backlog-row { grid-template-columns: 1fr; }
    }
    .tpd-svg { width: 100%; height: auto; display: block; }
    .tpd-grid { stroke: #eef1f5; stroke-width: 1; }
    .tpd-axis-line { stroke: #94a3b8; stroke-width: 1.2; }
    .tpd-axis { font-size: 10px; fill: #64748b; font-family: system-ui, sans-serif; }
    .tpd-axis-red { fill: #B91C1C !important; }
    .tpd-axis-title { font-size: 11px; fill: #64748b; font-family: system-ui, sans-serif; }
    .tpd-val { font-size: 9px; fill: #9CA3AF; font-family: system-ui, sans-serif; font-weight: 600; }
    .tpd-val-dark { font-size: 11px; fill: #374151; font-family: system-ui, sans-serif; font-weight: 700; }
    .tpd-legend { font-size: 11px; font-family: system-ui, sans-serif; font-weight: 600; }
    .tpd-funnel-label { font-size: 12px; fill: #1f2733; font-weight: 700; font-family: system-ui, sans-serif; }
    .tpd-funnel-val { font-size: 12px; fill: #4b5563; font-family: system-ui, sans-serif; }
</style>

<div class="tpd-wrap">
    <a class="tpd-back tpd-no-print" href="@Model.BackUrl">&larr; Back to Executive Summary</a>

    <div class="tpd-print-head tpd-print-only">
        <div class="tpd-print-brand">
            <img src="@Url.Content("~/images/LRN-White-Logo-footer-1-1.png")" alt="LRN" />
            <div>
                <div class="tpd-print-title">Three-Pillar Diagnostic</div>
                <div class="tpd-print-lab">@Model.LabName</div>
            </div>
        </div>
        <div class="tpd-print-meta">
            <div id="tpd-print-pillar">Pillar 1 — LIS</div>
            <div>Period: Last @Model.TrailingMonths months</div>
            <div>Comparable window: days 1–@dayWin each month</div>
            <div>WeekRange end: @(Model.AsOfDate?.ToString("MM/dd/yyyy") ?? "—")@(string.IsNullOrWhiteSpace(Model.WeekFolder) ? "" : " · " + Model.WeekFolder)</div>
        </div>
    </div>

    <div class="tpd-head">
        <h1>Three-Pillar Diagnostic — @Model.LabName</h1>
        <div class="tpd-sub">LIS / Pipeline Health · scope: @Model.ScopeLabel</div>
    </div>

    <div class="tpd-toolbar tpd-no-print">
        <label>Period</label>
        <div class="tpd-month-btns">
            @foreach (var m in monthOpts)
            {
                var active = Model.TrailingMonths == m ? "active" : null;
                <a class="@active"
                   asp-controller="ExecutiveSummary"
                   asp-action="ThreePillarDiagnostic"
                   asp-route-lab="@Model.LabName"
                   asp-route-months="@m">@m Months</a>
            }
        </div>
        @if (Model.DayWindow > 0)
        {
            <span class="tpd-window-note">
                Comparable window: days 1–@Model.DayWindow each month
                @if (Model.AsOfDate is { } asOf)
                {
                    <text>· WeekRange end @asOf.ToString("MM/dd/yyyy")</text>
                }
            </span>
        }
        <div class="tpd-pdf-btns">
            <button type="button" class="tpd-pdf-btn" data-tpd-pdf="lis" title="Save LIS as PDF"><i class="bi bi-file-earmark-pdf"></i> PDF LIS</button>
            <button type="button" class="tpd-pdf-btn" data-tpd-pdf="pms" title="Save PMS as PDF"><i class="bi bi-file-earmark-pdf"></i> PDF PMS</button>
            <button type="button" class="tpd-pdf-btn" data-tpd-pdf="cash" title="Save Cash as PDF"><i class="bi bi-file-earmark-pdf"></i> PDF Cash</button>
            <button type="button" class="tpd-pdf-btn tpd-pdf-btn-all" data-tpd-pdf="all" title="Save all three pillars as PDF"><i class="bi bi-file-earmark-pdf"></i> PDF all 3</button>
        </div>
    </div>

    <div class="tpd-banner">
        <strong>How months are built (Insights parity):</strong>
        Source <code>dbo.LIMSMaster</code>, bucket date <code>RequestCollectDate</code>.
        AsOf = Billed WeekRange <strong>end</strong> (@asOfTxt). DayWindow = day-of-month of AsOf (<strong>@dayWin</strong>).
        Each month counts only <code>DAY(RequestCollectDate) BETWEEN 1 AND @dayWin</code>
        (e.g. if end is the 23rd → Jan 1–23, Feb 1–23, …). Trailing <strong>@scopeMonths</strong> months inclusive.
    </div>

    <p class="tpd-checks"><strong>LIS checks:</strong> #1 Partial-period · #2 Aging/backlog · #3 Ratio-driver · #4 Maturity · #6 Status-transition</p>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="tpd-error">@Model.ErrorMessage</div>
    }
    else if (!Model.HasData)
    {
        <div class="tpd-error">No LIS data returned for this scope.</div>
    }
    else
    {
        var pmsUrl = Url.Action("ThreePillarPmsPartial", "ExecutiveSummary", new { lab = Model.LabName, months = Model.TrailingMonths });
        var cashUrl = Url.Action("ThreePillarCashPartial", "ExecutiveSummary", new { lab = Model.LabName, months = Model.TrailingMonths });
        var insightUrl = Url.Action("ThreePillarInsightPartial", "ExecutiveSummary", new { lab = Model.LabName, months = Model.TrailingMonths });

        <div class="tpd-tabs" role="tablist" aria-label="Three pillars">
            <button type="button" class="tpd-tab active" role="tab" aria-selected="true" data-tpd-tab="lis">Pillar 1 — LIS</button>
            <button type="button" class="tpd-tab" role="tab" aria-selected="false" data-tpd-tab="pms" data-tpd-load="@pmsUrl">Pillar 2 — PMS</button>
            <button type="button" class="tpd-tab" role="tab" aria-selected="false" data-tpd-tab="cash" data-tpd-load="@cashUrl">Pillar 3 — Cash</button>
            <button type="button" class="tpd-tab" role="tab" aria-selected="false" data-tpd-tab="insight" data-tpd-load="@insightUrl">Insight</button>
        </div>

        <div class="tpd-tab-panel active" id="tpd-panel-lis" role="tabpanel">
        <h2 class="tpd-print-only tpd-print-pillar-h">Pillar 1 — LIS / Pipeline Health</h2>
        @if (!string.IsNullOrWhiteSpace(Model.AiThreePillarInsight?.Headline))
        {
            <div class="tpd-ai-panel" style="margin-bottom:1rem">
                <div class="tpd-ai-panel-head">
                    <span class="tpd-ai-panel-badge">AI Headline</span>
                    <span class="tpd-ai-panel-sub">Week @Model.AiThreePillarInsight!.ReportPeriod</span>
                </div>
                <div class="tpd-ai-panel-list" style="list-style:none;padding-left:1rem">
                    @Model.AiThreePillarInsight.Headline
                </div>
            </div>
        }

        <details class="tpd-card tpd-acc" open>
            <summary class="tpd-acc-head">
                <div class="tpd-acc-head-text">
                    <div class="tpd-card-title">Monthly Collected Sample Volume</div>
                    <p class="tpd-card-sub">Total Samples trend · Check #1</p>
                </div>
                <span class="tpd-acc-chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="tpd-acc-body">
                @{ ViewData["GraphTitle"] = "Monthly Collected Sample Volume"; }
                @await Html.PartialAsync("_ThreePillarGraphInsight", Model)
                <div class="tpd-logic">
                    <strong>Fetch logic</strong>
                    <ul>
                        <li>Table: <code>LIMSMaster</code> · Count: <code>COUNT(DISTINCT Accession)</code></li>
                        <li>Date: <code>RequestCollectDate</code> in month · Day filter: <code>DAY(RequestCollectDate) BETWEEN 1 AND @dayWin</code></li>
                        <li>No status filter — all accessions in the comparable day window</li>
                        <li><strong>Monthly collected sample</strong> = volume line (this chart)</li>
                        <li><strong>Payers / Panels</strong> = Top 5 + Other across all volume months</li>
                        <li>Click a month value on the line to open <strong>Payers</strong> with every payer for that month (same chart area). <strong>Clear</strong> returns to the volume line.</li>
                    </ul>
                </div>
                <div class="tpd-vol-block">
                <div class="tpd-subtabs" role="tablist" aria-label="Collected sample volume views">
                    <button type="button" class="tpd-subtab active" role="tab" aria-selected="true" data-tpd-sub="chart">Monthly collected sample</button>
                    <button type="button" class="tpd-subtab" role="tab" aria-selected="false" data-tpd-sub="payer">Payers</button>
                    <button type="button" class="tpd-subtab" role="tab" aria-selected="false" data-tpd-sub="panel">Panels</button>
                    <button type="button" class="tpd-sub-clear" id="tpd-vol-clear" disabled>Clear</button>
                </div>
                <div class="tpd-subpanel active" data-tpd-subpanel="chart" role="tabpanel">
                    <div class="tpd-chart tpd-chart-vol">@Html.Raw(SvgLine(labels, totals, "#1D4ED8", "Samples collected", dashLast: labels.Count > 1 ? labels.Count - 1 : null, clickable: true))</div>
                    <p class="tpd-vol-hint">Click a month value to open Payers for that month<span id="tpd-vol-month-wrap"> (<strong id="tpd-vol-month"></strong>)</span>.</p>
                </div>
                <div class="tpd-subpanel" data-tpd-subpanel="payer" role="tabpanel" hidden>
                    <div class="tpd-split-card tpd-top5">
                        <div class="tpd-split-title">Top 5 payers + Other</div>
                        <p class="tpd-split-sub">All volume months</p>
                        <div id="tpd-payer-chart">@Html.Raw(SvgStackedMonths(labels, payerSeries, payerColors))</div>
                    </div>
                    <div class="tpd-all-month" hidden>
                        <div class="tpd-all-head">
                            <div>
                                <div class="tpd-split-title" data-tpd-all-title>All payers</div>
                                <p class="tpd-split-sub" data-tpd-all-sub></p>
                            </div>
                            <button type="button" class="tpd-all-back" data-tpd-all-back>Clear</button>
                        </div>
                        <div data-tpd-all-body></div>
                    </div>
                </div>
                <div class="tpd-subpanel" data-tpd-subpanel="panel" role="tabpanel" hidden>
                    <div class="tpd-split-card tpd-top5">
                        <div class="tpd-split-title">Top 5 panels + Other</div>
                        <p class="tpd-split-sub">All volume months</p>
                        <div id="tpd-panel-chart">@Html.Raw(SvgStackedMonths(labels, panelSeries, panelColors))</div>
                    </div>
                    <div class="tpd-all-month" hidden>
                        <div class="tpd-all-head">
                            <div>
                                <div class="tpd-split-title" data-tpd-all-title>All panels</div>
                                <p class="tpd-split-sub" data-tpd-all-sub></p>
                            </div>
                            <button type="button" class="tpd-all-back" data-tpd-all-back>Clear</button>
                        </div>
                        <div data-tpd-all-body></div>
                    </div>
                </div>
                <script type="application/json" id="tpd-vol-data">@Html.Raw(volJson)</script>
                </div>
            </div>
        </details>

        <details class="tpd-card tpd-acc" open>
            <summary class="tpd-acc-head">
                <div class="tpd-acc-head-text">
                    <div class="tpd-card-title">Total Samples &amp; % Resulted — Last @scopeMonths Months</div>
                    <p class="tpd-card-sub">Bars = volume · Red line = % Resulted (right axis)</p>
                </div>
                <span class="tpd-acc-chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="tpd-acc-body">
                @{ ViewData["GraphTitle"] = $"Total Samples & % Resulted — Last {scopeMonths} Months"; }
                @await Html.PartialAsync("_ThreePillarGraphInsight", Model)
                <div class="tpd-insight tpd-insight-ok">
                    Focus on the <strong>% Resulted</strong> line. A sharp dip in the latest month is often Check #1 (partial-period), not a true quality drop.
                </div>
                <div class="tpd-logic">
                    <strong>Fetch logic</strong>
                    <ul>
                        <li><strong>Total Samples</strong> = <code>COUNT(DISTINCT Accession)</code> where day ≤ @dayWin</li>
                        <li><strong>Resulted</strong> = same window + <code>RessultedStatus = 'Resulted'</code></li>
                        <li><strong>% Resulted</strong> = Resulted ÷ Total Samples × 100</li>
                    </ul>
                </div>
                <div class="tpd-chart">@Html.Raw(SvgDualBarsLine(labels, totals, resultedPct))</div>
            </div>
        </details>

        <details class="tpd-card tpd-acc" open>
            <summary class="tpd-acc-head">
                <div class="tpd-acc-head-text">
                    <div class="tpd-card-title">Sample-to-Claim Funnel (Full Period)</div>
                    <p class="tpd-card-sub">Collected → Resulted – Insurance → Self Pay / Client Bill / Billed to Insurance</p>
                </div>
                <span class="tpd-acc-chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="tpd-acc-body">
                @{
                    ViewData["GraphTitle"] = "Sample-to-Claim Funnel (Full Period)";
                    var funnelSvg = SvgHFunnel(
                        ("Collected", Model.FunnelPeriod.Collected, 100m, "#1E3A8A"),
                        ("Resulted – Insurance", Model.FunnelPeriod.Resulted, Model.FunnelPeriod.PctResulted, "#2563EB"),
                        ("Resulted – Self Pay", Model.FunnelPeriod.ResultedSelfPay, Model.FunnelPeriod.PctSelfPayOfCollected, "#7C3AED"),
                        ("Resulted – Client Bill", Model.FunnelPeriod.ResultedClientBill, Model.FunnelPeriod.PctClientBillOfCollected, "#D97706"),
                        ("Billed to Insurance", Model.FunnelPeriod.BilledToInsurance, Model.FunnelPeriod.PctBilledOfResulted, "#93C5FD"));
                }
                @await Html.PartialAsync("_ThreePillarGraphInsight", Model)
                <div class="tpd-logic">
                    <strong>Fetch logic</strong>
                    <ul>
                        <li><strong>Collected</strong> = all accessions in DayWindow (same as Total Samples sum)</li>
                        <li><strong>Resulted – Insurance</strong> = <code>RessultedStatus = 'Resulted'</code> + <code>BillTo LIKE '%Insurance%'</code></li>
                        <li><strong>Resulted – Self Pay</strong> = Resulted + <code>ClientStatus = 'Self Pay'</code></li>
                        <li><strong>Resulted – Client Bill</strong> = Resulted + <code>ClientStatus = 'Client Bill'</code></li>
                        <li><strong>Billed to Insurance</strong> = Resulted + <code>ClaimStatus='Billed'</code> + <code>BilledOrNot='Billed'</code> + <code>ClientStatus=''</code></li>
                        <li>% next to Collected / Resulted–Insurance / Self Pay / Client Bill = stage ÷ Collected × 100</li>
                        <li><strong>Bill to Insurance %</strong> (on the billed bar) = Billed to Insurance ÷ Resulted – Insurance × 100</li>
                    </ul>
                </div>
                <div class="tpd-chart">@Html.Raw(funnelSvg)</div>
                <p class="tpd-funnel-note">
                    Collected <strong>@Num(Model.FunnelPeriod.Collected)</strong>
                    → Resulted – Insurance <strong>@Num(Model.FunnelPeriod.Resulted)</strong> (@Pct(Model.FunnelPeriod.PctResulted))
                    · Self Pay <strong>@Num(Model.FunnelPeriod.ResultedSelfPay)</strong>
                    · Client Bill <strong>@Num(Model.FunnelPeriod.ResultedClientBill)</strong>
                    · Billed to Insurance <strong>@Num(Model.FunnelPeriod.BilledToInsurance)</strong>
                    · Bill to Insurance % <strong>@Pct(Model.FunnelPeriod.PctBilledOfResulted)</strong>
                    (Billed to Insurance ÷ Resulted – Insurance).
                </p>
            </div>
        </details>

        <details class="tpd-card tpd-acc" open>
            <summary class="tpd-acc-head">
                <div class="tpd-acc-head-text">
                    <div class="tpd-card-title">Backlog – Resulted Insurance not billed (n=@Num(Model.BacklogSummary.TotalBacklog))</div>
                    <p class="tpd-card-sub">Resulted – Insurance − Billed to Insurance · aging as of WeekRange end</p>
                </div>
                <span class="tpd-acc-chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="tpd-acc-body">
                @{ ViewData["GraphTitle"] = "Backlog – Resulted Insurance not billed"; }
                @await Html.PartialAsync("_ThreePillarGraphInsight", Model)
                @{ ViewData["GraphTitle"] = "Backlog Age Buckets"; }
                @await Html.PartialAsync("_ThreePillarGraphInsight", Model)
                <div class="tpd-logic">
                    <strong>Fetch logic</strong>
                    <ul>
                        <li><strong>Backlog</strong> = Resulted – Insurance − Billed to Insurance (DayWindow, <code>COUNT(DISTINCT Accession)</code>)</li>
                        <li>i.e. <code>RessultedStatus='Resulted'</code> + <code>BillTo LIKE '%Insurance%'</code> and not billed-to-insurance (<code>ClaimStatus='Billed'</code> + <code>BilledOrNot='Billed'</code> + <code>ClientStatus=''</code>)</li>
                        <li><strong>AgeDays</strong> = <code>DATEDIFF(DAY, RequestCollectDate, @@AsOfDate)</code> (@asOfTxt)</li>
                        <li>Buckets: 0–7 / 8–14 / 15–30 / 31–60 / 60+</li>
                    </ul>
                </div>
                <div class="tpd-backlog-row">
                    <div class="tpd-chart tpd-chart-lg">@Html.Raw(SvgAgeBars(ageRows))</div>
                    <div class="tpd-backlog-meta">
                        @if (buckets.Count == 0) { <div class="tpd-empty">No backlog.</div> }
                        else
                        {
                            <table class="tpd-tbl">
                                <thead><tr><th>Age Bucket</th><th class="num">Samples</th></tr></thead>
                                <tbody>
                                @foreach (var b in buckets)
                                {
                                    <tr><td>@b.AgeBucket</td><td class="num">@Num(b.SampleCount)</td></tr>
                                }
                                </tbody>
                            </table>
                            <p class="tpd-funnel-note">Median <strong>@Dec(Model.BacklogSummary.MedianAgeDays) d</strong>; <strong>@Pct(Model.BacklogSummary.PctOver60Days)</strong> over 60 days.</p>
                        }
                    </div>
                </div>
            </div>
        </details>

        <details class="tpd-card tpd-acc" open>
            <summary class="tpd-acc-head">
                <div class="tpd-acc-head-text">
                    <div class="tpd-card-title">% of Resulted Samples Billed to Insurance</div>
                    <p class="tpd-card-sub">Bill to Insurance % = Billed to Insurance ÷ Resulted – Insurance</p>
                </div>
                <span class="tpd-acc-chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="tpd-acc-body">
                @{ ViewData["GraphTitle"] = "% of Resulted Samples Billed to Insurance"; }
                @await Html.PartialAsync("_ThreePillarGraphInsight", Model)
                <div class="tpd-insight">A multi-month decline before the partial latest month is a real resulted→billed pipeline leak (Check #3).</div>
                <div class="tpd-logic">
                    <strong>Fetch logic</strong>
                    <ul>
                        <li><strong>Resulted – Insurance</strong> = <code>RessultedStatus='Resulted'</code> + <code>BillTo LIKE '%Insurance%'</code></li>
                        <li><strong>Billed to Insurance</strong> = Resulted + <code>ClaimStatus='Billed'</code> + <code>BilledOrNot='Billed'</code> + <code>ClientStatus=''</code></li>
                        <li><strong>Bill to Insurance %</strong> = Billed to Insurance ÷ Resulted – Insurance × 100</li>
                    </ul>
                </div>
                <div class="tpd-chart">@Html.Raw(SvgLine(labels, billedPct.Select(v => double.IsNaN(v) ? 0 : v).ToList(), "#B91C1C", "% billed to insurance of resulted", fill: true, fillColor: "rgba(185,28,28,.14)", dashLast: labels.Count > 1 ? labels.Count - 1 : null, asPct: true))</div>
            </div>
        </details>

        <details class="tpd-card tpd-acc" open>
            <summary class="tpd-acc-head">
                <div class="tpd-acc-head-text">
                    <div class="tpd-card-title">Not Resulted Samples — Monthly Trend</div>
                    <p class="tpd-card-sub">Latest month in red (often Check #1 partial-period spike)</p>
                </div>
                <span class="tpd-acc-chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="tpd-acc-body">
                @{ ViewData["GraphTitle"] = "Not Resulted Samples — Monthly Trend"; }
                @await Html.PartialAsync("_ThreePillarGraphInsight", Model)
                <div class="tpd-logic">
                    <strong>Fetch logic</strong>
                    <ul>
                        <li><code>COUNT(DISTINCT Accession)</code> where <code>RessultedStatus = 'Not Resulted'</code></li>
                        <li>Same DayWindow comparable filter: days 1–@dayWin of each month</li>
                    </ul>
                </div>
                <div class="tpd-chart">@Html.Raw(SvgBars(labels, notRes, i => i == labels.Count - 1 ? "#B91C1C" : "#1E3A8A", "Not Resulted (count)"))</div>
            </div>
        </details>

        <details class="tpd-card tpd-acc" open>
            <summary class="tpd-acc-head">
                <div class="tpd-acc-head-text">
                    <div class="tpd-card-title">Self Pay % vs Client Bill % of Total Samples</div>
                    <p class="tpd-card-sub">Check #6 status-transition</p>
                </div>
                <span class="tpd-acc-chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="tpd-acc-body">
                @{ ViewData["GraphTitle"] = "Self Pay % vs Client Bill % of Total Samples"; }
                @await Html.PartialAsync("_ThreePillarGraphInsight", Model)
                <div class="tpd-insight tpd-insight-ok">When Self Pay falls and Client Bill rises together, volume moved between categories — not a net volume change.</div>
                <div class="tpd-logic">
                    <strong>Fetch logic</strong>
                    <ul>
                        <li><strong>Self Pay</strong> = Resulted + <code>ClientStatus = 'Self Pay'</code></li>
                        <li><strong>Client Bill</strong> = Resulted + <code>ClientStatus = 'Client Bill'</code></li>
                        <li><strong>%</strong> = count ÷ Total Samples × 100 (DayWindow)</li>
                    </ul>
                </div>
                <div class="tpd-chart">@Html.Raw(SvgTwoLines(labels, selfPct, clientPct, "Self Pay %", "Client Bill %", "#2563EB", "#D97706"))</div>
            </div>
        </details>

        <details class="tpd-card tpd-acc" open>
            <summary class="tpd-acc-head">
                <div class="tpd-acc-head-text">
                    <div class="tpd-card-title">LIS Monthly Detail</div>
                    <p class="tpd-card-sub">Month-by-month breakdown for the selected comparable window</p>
                </div>
                <span class="tpd-acc-chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="tpd-acc-body">
                @{ ViewData["GraphTitle"] = "LIS Monthly Detail"; }
                @await Html.PartialAsync("_ThreePillarGraphInsight", Model)
                <div class="tpd-logic">
                    <strong>Fetch logic</strong> — same filters as charts above; rows from <code>usp_GetBeechTree_ThreePillarLisDiagnostic</code> RS1.
                </div>
                <div class="tpd-scroll">
                <table class="tpd-tbl">
                    <thead>
                        <tr>
                            <th>Month</th><th class="num">Total Samples</th><th class="num">Resulted</th><th class="num">% Resulted</th>
                            <th class="num">Resulted (Ins)</th><th class="num">Billed to Ins</th><th class="num">% Billed of Resulted (Ins)</th>
                            <th class="num">Self Pay %</th><th class="num">Client Bill %</th><th class="num">Not Resulted</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var m in months)
                    {
                        <tr>
                            <td>@ShortLbl(m.SortYear, m.SortMonth)</td>
                            <td class="num">@Num(m.TotalSamples)</td>
                            <td class="num">@Num(m.Resulted)</td>
                            <td class="num">@Pct(m.PctResulted)</td>
                            <td class="num">@Num(m.ResultedInsurance)</td>
                            <td class="num">@Num(m.BilledToInsurance)</td>
                            <td class="num">@Pct(m.PctBilledOfResulted)</td>
                            <td class="num">@Pct(m.SelfPayPct)</td>
                            <td class="num">@Pct(m.ClientBillPct)</td>
                            <td class="num">@Num(m.NotResulted)</td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            </div>
        </details>
        </div><!-- /lis panel -->

        <div class="tpd-tab-panel" id="tpd-panel-pms" role="tabpanel" hidden>
            <h2 class="tpd-print-only tpd-print-pillar-h">Pillar 2 — PMS / Revenue Realization</h2>
            <div class="tpd-pillar">Pillar 2 — Revenue Realization (PMS)</div>
            <div class="tpd-lazy-host" data-tpd-lazy="pms">
                <div class="tpd-lazy-status">Click the PMS tab to load this pillar (loads when the SP is available).</div>
            </div>
        </div>

        <div class="tpd-tab-panel" id="tpd-panel-cash" role="tabpanel" hidden>
            <h2 class="tpd-print-only tpd-print-pillar-h">Pillar 3 — Cash / Leakage &amp; Risk</h2>
            <div class="tpd-pillar">Pillar 3 — Leakage &amp; Risk (Cash)</div>
            <div class="tpd-lazy-host" data-tpd-lazy="cash">
                <div class="tpd-lazy-status">Click the Cash tab to load this pillar (loads when the SP is available).</div>
            </div>
        </div>

        <div class="tpd-tab-panel" id="tpd-panel-insight" role="tabpanel" hidden>
            <div class="tpd-pillar">AI Three-Pillar Insights</div>
            <div class="tpd-lazy-host" data-tpd-lazy="insight">
                <div class="tpd-lazy-status">Click the Insight tab to load insights.json for this report week.</div>
            </div>
        </div>
    }
</div>

<script nonce="@Context.Items["CspNonce"]">
(function () {
    var tabs = document.querySelectorAll('.tpd-tab');
    var loaded = { lis: true };

    function showPanel(name) {
        document.querySelectorAll('.tpd-tab-panel').forEach(function (p) {
            var on = p.id === 'tpd-panel-' + name;
            p.classList.toggle('active', on);
            if (on) p.removeAttribute('hidden');
            else p.setAttribute('hidden', 'hidden');
        });
        tabs.forEach(function (t) {
            var on = t.getAttribute('data-tpd-tab') === name;
            t.classList.toggle('active', on);
            t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
    }

    function loadPanel(tab) {
        return new Promise(function (resolve, reject) {
            if (!tab) { resolve(); return; }
            var name = tab.getAttribute('data-tpd-tab');
            var url = tab.getAttribute('data-tpd-load');
            if (!url || loaded[name]) { resolve(); return; }
            var host = document.querySelector('[data-tpd-lazy="' + name + '"]');
            if (!host) { resolve(); return; }
            host.innerHTML = '<div class="tpd-lazy-status">Loading…</div>';
            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' })
                .then(function (r) {
                    if (!r.ok) throw new Error('HTTP ' + r.status);
                    return r.text();
                })
                .then(function (html) {
                    host.innerHTML = html;
                    loaded[name] = true;
                    resolve();
                })
                .catch(function (err) {
                    host.innerHTML = '<div class="tpd-lazy-status error">Could not load pillar: '
                        + (err && err.message ? err.message : 'unknown error') + '</div>';
                    reject(err);
                });
        });
    }

    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
            var name = tab.getAttribute('data-tpd-tab');
            showPanel(name);
            loadPanel(tab);
        });
    });

    showPanel('lis');

    var printTitles = {
        lis: 'Pillar 1 — LIS / Pipeline Health',
        pms: 'Pillar 2 — PMS / Revenue Realization',
        cash: 'Pillar 3 — Cash / Leakage & Risk',
        all: 'LIS + PMS + Cash'
    };

    function expandDetails(name) {
        var panel = document.getElementById('tpd-panel-' + name);
        if (!panel) return;
        panel.querySelectorAll('details.tpd-acc').forEach(function (d) { d.open = true; });
    }

    function downloadPdf(scope) {
        var names = scope === 'all' ? ['lis', 'pms', 'cash'] : [scope];
        var html = document.documentElement;
        ['lis', 'pms', 'cash', 'all'].forEach(function (k) {
            html.classList.remove('tpd-print-' + k);
        });
        html.classList.add(scope === 'all' ? 'tpd-print-all' : 'tpd-print-' + scope);
        var titleEl = document.getElementById('tpd-print-pillar');
        if (titleEl) titleEl.textContent = printTitles[scope] || scope;

        var btns = document.querySelectorAll('.tpd-pdf-btn');
        btns.forEach(function (b) { b.disabled = true; });

        var jobs = names.map(function (n) {
            var tab = document.querySelector('.tpd-tab[data-tpd-tab="' + n + '"]');
            return loadPanel(tab);
        });
        Promise.all(jobs).then(function () {
            names.forEach(expandDetails);
            window.setTimeout(function () { window.print(); }, 120);
        }).catch(function () {
            window.setTimeout(function () { window.print(); }, 120);
        }).then(function () {
            btns.forEach(function (b) { b.disabled = false; });
        });
    }

    document.querySelectorAll('[data-tpd-pdf]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            downloadPdf(btn.getAttribute('data-tpd-pdf'));
        });
    });
    window.addEventListener('afterprint', function () {
        ['lis', 'pms', 'cash', 'all'].forEach(function (k) {
            document.documentElement.classList.remove('tpd-print-' + k);
        });
    });
})();
</script>
<script nonce="@Context.Items["CspNonce"]">
(function () {
    var monthEl = document.getElementById('tpd-vol-month');
    var wrap = document.getElementById('tpd-vol-month-wrap');
    var svg = document.getElementById('tpd-vol-line');
    var dataEl = document.getElementById('tpd-vol-data');
    var data = {};
    try { data = JSON.parse(dataEl ? dataEl.textContent : '{}') || {}; } catch (e) { data = {}; }
    var selectedMonth = '';
    var clearBtn = document.getElementById('tpd-vol-clear');
    if (wrap) wrap.style.display = 'none';

    function esc(s) {
        return String(s || '').replace(/[&<>"']/g, function (c) {
            return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
        });
    }
    function fmt(n) {
        return Number(n || 0).toLocaleString('en-US');
    }
    function monthRec(month) {
        var key = String(month || '').toLowerCase();
        for (var p in data) {
            if (Object.prototype.hasOwnProperty.call(data, p) && String(p).toLowerCase() === key)
                return data[p];
        }
        return null;
    }
    function rowsFor(month, kind) {
        var rec = monthRec(month);
        if (!rec) return [];
        var list = kind === 'panel' ? rec.panels : rec.payers;
        return (list || []).slice().sort(function (a, b) { return (b.c || 0) - (a.c || 0); });
    }
    function renderAll(panel) {
        var body = panel.querySelector('[data-tpd-all-body]');
        var title = panel.querySelector('[data-tpd-all-title]');
        var sub = panel.querySelector('[data-tpd-all-sub]');
        var kind = panel.getAttribute('data-tpd-subpanel') || 'payer';
        var noun = kind === 'panel' ? 'panels' : 'payers';
        var rows = rowsFor(selectedMonth, kind);
        if (title) title.textContent = 'All ' + noun + ' — ' + selectedMonth;
        if (sub) sub.textContent = rows.length + ' ' + noun + ' · collected samples';
        if (!body) return;
        if (!rows.length) {
            body.innerHTML = '<div class="tpd-empty">No ' + noun + ' for ' + esc(selectedMonth) + '.</div>';
            return;
        }
        var max = 0;
        rows.forEach(function (r) { if ((r.c || 0) > max) max = r.c; });
        var html = '<div class="tpd-all-rows">';
        rows.forEach(function (r) {
            var pct = max > 0 ? (100 * (r.c || 0) / max) : 0;
            html += '<div class="tpd-all-row"><span class="tpd-all-name" title="' + esc(r.n) + '">' + esc(r.n) + '</span>'
                + '<span class="tpd-all-bar"><i style="width:' + pct.toFixed(1) + '%"></i></span>'
                + '<span class="tpd-all-n">' + fmt(r.c) + '</span></div>';
        });
        html += '</div>';
        body.innerHTML = html;
    }
    function applyMode() {
        if (monthEl) monthEl.textContent = selectedMonth || '';
        if (wrap) wrap.style.display = selectedMonth ? '' : 'none';
        document.querySelectorAll('.tpd-subpanel[data-tpd-subpanel="payer"], .tpd-subpanel[data-tpd-subpanel="panel"]').forEach(function (p) {
            var allEl = p.querySelector('.tpd-all-month');
            var top5 = p.querySelector('.tpd-top5');
            var on = !!selectedMonth;
            if (top5) {
                if (on) top5.setAttribute('hidden', 'hidden');
                else top5.removeAttribute('hidden');
            }
            if (allEl) {
                if (on) {
                    allEl.removeAttribute('hidden');
                    renderAll(p);
                } else {
                    allEl.setAttribute('hidden', 'hidden');
                }
            }
        });
        if (clearBtn) clearBtn.disabled = !selectedMonth;
        if (svg) {
            svg.querySelectorAll('.tpd-vol-pt').forEach(function (pt) {
                var on = !!selectedMonth && String(pt.getAttribute('data-month') || '').toLowerCase() === selectedMonth.toLowerCase();
                pt.classList.toggle('is-on', on);
                pt.setAttribute('r', on ? '6.5' : '4');
            });
        }
    }
    function selectMonth(month) {
        selectedMonth = month || '';
        applyMode();
        if (selectedMonth) showSub('payer');
    }
    function showSub(name) {
        document.querySelectorAll('.tpd-subtab').forEach(function (t) {
            var on = t.getAttribute('data-tpd-sub') === name;
            t.classList.toggle('active', on);
            t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        document.querySelectorAll('.tpd-subpanel').forEach(function (p) {
            var on = p.getAttribute('data-tpd-subpanel') === name;
            p.classList.toggle('active', on);
            if (on) p.removeAttribute('hidden');
            else p.setAttribute('hidden', 'hidden');
        });
    }
    function clearSelection() {
        selectedMonth = '';
        applyMode();
        showSub('chart');
    }
    document.querySelectorAll('.tpd-subtab').forEach(function (t) {
        t.addEventListener('click', function () {
            showSub(t.getAttribute('data-tpd-sub'));
        });
    });
    if (clearBtn) clearBtn.addEventListener('click', clearSelection);
    document.querySelectorAll('[data-tpd-all-back]').forEach(function (b) {
        b.addEventListener('click', clearSelection);
    });
    if (svg) {
        svg.addEventListener('click', function (e) {
            var t = e.target && e.target.closest ? e.target.closest('[data-month]') : null;
            if (!t) return;
            var month = t.getAttribute('data-month');
            if (month) selectMonth(month);
        });
        svg.addEventListener('keydown', function (e) {
            if (e.key !== 'Enter' && e.key !== ' ') return;
            var t = e.target && e.target.closest ? e.target.closest('[data-month]') : null;
            if (!t) return;
            e.preventDefault();
            selectMonth(t.getAttribute('data-month'));
        });
    }
})();
</script>
