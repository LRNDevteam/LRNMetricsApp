@model LabMetricsDashboard.Models.ExecSummaryThreePillarViewModel
@using System.Globalization
@using System.Text
@{
    ViewData["Title"] = "Three-Pillar Diagnostic — " + Model.LabName;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var ci = CultureInfo.InvariantCulture;
    string Num(long v) => v.ToString("N0", ci);
    string Pct(decimal? v) => v is { } d ? d.ToString("0.0", ci) + "%" : "—";
    string Dec(decimal? v) => v is { } d ? d.ToString("#,##0.#", ci) : "—";
    var monthOpts = new[] { 3, 6, 9, 12 };
    var months = Model.LisMonthly;
    var last = months.LastOrDefault();
    var buckets = Model.BacklogBuckets.OrderBy(b => b.SortOrder).ToList();

    // Compact month labels like reference charts: Jul25, Aug25, …
    string ShortLbl(int y, int m) =>
        CultureInfo.InvariantCulture.DateTimeFormat.GetAbbreviatedMonthName(m)[..3] + (y % 100).ToString("00", ci);

    const double ChartW = 780;
    string F(double v) => v.ToString("0.###", CultureInfo.InvariantCulture);
    string Esc(string? s) => System.Net.WebUtility.HtmlEncode(s ?? "");
    string FmtCnt(double v) => v >= 1000 ? v.ToString("#,##0", ci) : v.ToString("0.#", ci);
    string FmtPct(double v) => v.ToString("0.0", ci) + "%";

    void AppendRotatedLabel(StringBuilder sb, double cx, double cy, string text)
    {
        // ~-40° like the doc charts
        sb.Append($"<text x='{F(cx)}' y='{F(cy)}' text-anchor='end' class='tpd-axis' transform='rotate(-40 {F(cx)} {F(cy)})'>{Esc(text)}</text>");
    }

    string SvgLine(IReadOnlyList<string> labels, IReadOnlyList<double> values, string stroke, string yTitle,
        bool fill = false, string? fillColor = null, int? dashLast = null, bool asPct = false, bool rotateX = true)
    {
        if (labels.Count == 0 || values.Count == 0) return "<div class='tpd-empty'>No chart data.</div>";
        double W = ChartW, H = 400, L = 62, R = 20, T = 32, B = rotateX ? 62 : 44;
        var plotW = W - L - R; var plotH = H - T - B;
        var min = values.Min(); var max = values.Max();
        if (asPct) { min = 0; max = Math.Max(max * 1.05, 10); }
        else
        {
            if (Math.Abs(max - min) < 1e-9) { min = Math.Min(0, min); max = max + 1; }
            var pad = (max - min) * 0.12; min -= pad; max += pad;
            if (min > 0 && min < (max - min) * 0.2) min = Math.Max(0, min - (max - min) * 0.05);
        }
        double Xn(int i) => L + (labels.Count == 1 ? plotW / 2 : i * plotW / (labels.Count - 1));
        double Yn(double v) => T + plotH - (v - min) / (max - min) * plotH;
        var sb = new StringBuilder();
        sb.Append($"<svg viewBox='0 0 {W} {H}' class='tpd-svg' role='img' aria-label='{Esc(yTitle)}'>");
        // axis lines
        sb.Append($"<line x1='{F(L)}' y1='{F(T)}' x2='{F(L)}' y2='{F(T + plotH)}' class='tpd-axis-line'/>");
        sb.Append($"<line x1='{F(L)}' y1='{F(T + plotH)}' x2='{F(W - R)}' y2='{F(T + plotH)}' class='tpd-axis-line'/>");
        for (int g = 0; g <= 4; g++)
        {
            var gy = T + plotH * g / 4.0;
            var gv = max - (max - min) * g / 4.0;
            sb.Append($"<line x1='{F(L)}' y1='{F(gy)}' x2='{F(W - R)}' y2='{F(gy)}' class='tpd-grid'/>");
            var ax = asPct
                ? gv.ToString("0", ci)
                : (gv >= 1000 ? (gv / 1000).ToString("0.#", ci) + "k" : gv.ToString("0.#", ci));
            sb.Append($"<text x='{F(L - 8)}' y='{F(gy + 3)}' text-anchor='end' class='tpd-axis'>{Esc(ax)}</text>");
        }
        var pts = new StringBuilder();
        for (int i = 0; i < values.Count; i++)
            pts.Append($"{(i == 0 ? "M" : "L")}{F(Xn(i))},{F(Yn(values[i]))} ");
        if (fill)
        {
            var area = pts.ToString() + $"L{F(Xn(values.Count - 1))},{F(T + plotH)} L{F(Xn(0))},{F(T + plotH)} Z";
            sb.Append($"<path d='{area}' fill='{fillColor ?? "rgba(185,28,28,.12)"}' stroke='none'/>");
        }
        if (dashLast is int di && di > 0 && values.Count > 1)
        {
            var solid = new StringBuilder();
            for (int i = 0; i < values.Count; i++)
            {
                if (i == di) break;
                solid.Append($"{(i == 0 ? "M" : "L")}{F(Xn(i))},{F(Yn(values[i]))} ");
            }
            sb.Append($"<path d='{solid}' fill='none' stroke='{stroke}' stroke-width='2.2'/>");
            sb.Append($"<path d='M{F(Xn(di - 1))},{F(Yn(values[di - 1]))} L{F(Xn(di))},{F(Yn(values[di]))}' fill='none' stroke='{stroke}' stroke-width='2.2' stroke-dasharray='5 4' opacity='.7'/>");
        }
        else
            sb.Append($"<path d='{pts}' fill='none' stroke='{stroke}' stroke-width='2.2'/>");

        for (int i = 0; i < values.Count; i++)
        {
            var op = (dashLast is int d2 && i == d2) ? "0.6" : "1";
            var lbl = asPct ? FmtPct(values[i]) : FmtCnt(values[i]);
            sb.Append($"<circle cx='{F(Xn(i))}' cy='{F(Yn(values[i]))}' r='4' fill='{stroke}' opacity='{op}'><title>{Esc(labels[i])}: {Esc(lbl)}</title></circle>");
            sb.Append($"<text x='{F(Xn(i))}' y='{F(Yn(values[i]) - 9)}' text-anchor='middle' class='tpd-val'>{Esc(lbl)}</text>");
            if (rotateX) AppendRotatedLabel(sb, Xn(i), T + plotH + 14, labels[i]);
            else if (i % Math.Max(1, labels.Count / 8) == 0 || i == labels.Count - 1)
                sb.Append($"<text x='{F(Xn(i))}' y='{F(H - 10)}' text-anchor='middle' class='tpd-axis'>{Esc(labels[i])}</text>");
        }
        sb.Append($"<text x='14' y='{F(H / 2)}' transform='rotate(-90 14 {F(H / 2)})' text-anchor='middle' class='tpd-axis-title'>{Esc(yTitle)}</text>");
        sb.Append("</svg>");
        return sb.ToString();
    }

    string SvgBars(IReadOnlyList<string> labels, IReadOnlyList<double> values, Func<int, string> colorFn, string yTitle, bool rotateX = true)
    {
        if (labels.Count == 0) return "<div class='tpd-empty'>No chart data.</div>";
        double W = ChartW, H = 400, L = 58, R = 18, T = 32, B = rotateX ? 62 : 44;
        var plotW = W - L - R; var plotH = H - T - B;
        var max = Math.Max(1, values.Max());
        var gap = plotW / labels.Count;
        var bw = Math.Min(34, gap * 0.72);
        var sb = new StringBuilder();
        sb.Append($"<svg viewBox='0 0 {W} {H}' class='tpd-svg' role='img'>");
        sb.Append($"<line x1='{F(L)}' y1='{F(T)}' x2='{F(L)}' y2='{F(T + plotH)}' class='tpd-axis-line'/>");
        sb.Append($"<line x1='{F(L)}' y1='{F(T + plotH)}' x2='{F(W - R)}' y2='{F(T + plotH)}' class='tpd-axis-line'/>");
        for (int g = 0; g <= 4; g++)
        {
            var gy = T + plotH * g / 4.0;
            var gv = max - max * g / 4.0;
            sb.Append($"<text x='{F(L - 8)}' y='{F(gy + 3)}' text-anchor='end' class='tpd-axis'>{Esc(gv >= 1000 ? (gv / 1000).ToString("0.#", ci) + "k" : gv.ToString("0.#", ci))}</text>");
        }
        for (int i = 0; i < labels.Count; i++)
        {
            var bh = values[i] / max * plotH;
            var x = L + i * gap + (gap - bw) / 2;
            var y = T + plotH - bh;
            if (values[i] > 0)
            {
                sb.Append($"<rect x='{F(x)}' y='{F(y)}' width='{F(bw)}' height='{F(Math.Max(bh, 0.5))}' fill='{colorFn(i)}'><title>{Esc(labels[i])}: {FmtCnt(values[i])}</title></rect>");
                sb.Append($"<text x='{F(x + bw / 2)}' y='{F(y - 5)}' text-anchor='middle' class='tpd-val'>{FmtCnt(values[i])}</text>");
            }
            if (rotateX) AppendRotatedLabel(sb, x + bw / 2, T + plotH + 14, labels[i]);
        }
        sb.Append($"<text x='14' y='{F(H / 2)}' transform='rotate(-90 14 {F(H / 2)})' text-anchor='middle' class='tpd-axis-title'>{Esc(yTitle)}</text>");
        sb.Append("</svg>");
        return sb.ToString();
    }

    string SvgDualBarsLine(IReadOnlyList<string> labels, IReadOnlyList<double> bars, IReadOnlyList<double> line)
    {
        if (labels.Count == 0) return "<div class='tpd-empty'>No chart data.</div>";
        double W = ChartW, H = 420, L = 58, R = 52, T = 28, B = 62;
        var plotW = W - L - R; var plotH = H - T - B;
        var maxB = Math.Max(1, bars.Max());
        // Match reference: left 0→nice max; right typically ~80–105 for near-100% resulted
        var lineVals = line.Where(v => !double.IsNaN(v)).DefaultIfEmpty(100).ToList();
        var minL = Math.Min(80, Math.Floor(lineVals.Min() / 5) * 5 - 5);
        if (minL < 0) minL = 0;
        var maxL = Math.Max(105, Math.Ceiling(lineVals.Max() / 5) * 5 + 5);
        var gap = plotW / labels.Count;
        var bw = Math.Min(36, gap * 0.78);
        double Xcn(int i) => L + i * gap + gap / 2;
        double Ybn(double v) => T + plotH - v / maxB * plotH;
        double Yln(double v) => T + plotH - (v - minL) / (maxL - minL) * plotH;
        var lastIdx = labels.Count - 1;
        var sb = new StringBuilder();
        sb.Append($"<svg viewBox='0 0 {W} {H}' class='tpd-svg' role='img'>");
        sb.Append($"<line x1='{F(L)}' y1='{F(T)}' x2='{F(L)}' y2='{F(T + plotH)}' class='tpd-axis-line'/>");
        sb.Append($"<line x1='{F(W - R)}' y1='{F(T)}' x2='{F(W - R)}' y2='{F(T + plotH)}' class='tpd-axis-line'/>");
        sb.Append($"<line x1='{F(L)}' y1='{F(T + plotH)}' x2='{F(W - R)}' y2='{F(T + plotH)}' class='tpd-axis-line'/>");
        for (int g = 0; g <= 4; g++)
        {
            var gy = T + plotH * g / 4.0;
            var gv = maxB - maxB * g / 4.0;
            var lv = maxL - (maxL - minL) * g / 4.0;
            sb.Append($"<text x='{F(L - 8)}' y='{F(gy + 3)}' text-anchor='end' class='tpd-axis'>{Esc(gv >= 1000 ? (gv / 1000).ToString("0.#", ci) + "k" : gv.ToString("0", ci))}</text>");
            sb.Append($"<text x='{F(W - R + 8)}' y='{F(gy + 3)}' text-anchor='start' class='tpd-axis tpd-axis-red'>{Esc(lv.ToString("0", ci))}</text>");
        }
        for (int i = 0; i < labels.Count; i++)
        {
            var bh = bars[i] / maxB * plotH;
            var x = L + i * gap + (gap - bw) / 2;
            var y = T + plotH - bh;
            var fill = i == lastIdx ? "rgba(148,163,184,.55)" : "rgba(148,163,184,.85)";
            sb.Append($"<rect x='{F(x)}' y='{F(y)}' width='{F(bw)}' height='{F(Math.Max(bh, 0.5))}' fill='{fill}'><title>{Esc(labels[i])} samples: {FmtCnt(bars[i])}</title></rect>");
            sb.Append($"<text x='{F(x + bw / 2)}' y='{F(y - 4)}' text-anchor='middle' class='tpd-val'>{FmtCnt(bars[i])}</text>");
            AppendRotatedLabel(sb, Xcn(i), T + plotH + 14, labels[i]);
        }
        var path = new StringBuilder();
        for (int i = 0; i < line.Count; i++)
        {
            if (double.IsNaN(line[i])) continue;
            path.Append($"{(path.Length == 0 ? "M" : "L")}{F(Xcn(i))},{F(Yln(line[i]))} ");
        }
        if (path.Length > 0)
            sb.Append($"<path d='{path}' fill='none' stroke='#B91C1C' stroke-width='2.2'/>");
        for (int i = 0; i < line.Count; i++)
        {
            if (double.IsNaN(line[i])) continue;
            sb.Append($"<circle cx='{F(Xcn(i))}' cy='{F(Yln(line[i]))}' r='4' fill='#B91C1C'><title>{Esc(labels[i])} % Resulted: {FmtPct(line[i])}</title></circle>");
            sb.Append($"<text x='{F(Xcn(i))}' y='{F(Yln(line[i]) - 10)}' text-anchor='middle' class='tpd-val'>{FmtPct(line[i])}</text>");
        }
        sb.Append($"<text x='{F(W - 10)}' y='{F(H / 2)}' transform='rotate(90 {F(W - 10)} {F(H / 2)})' text-anchor='middle' class='tpd-axis-title tpd-axis-red'>% Resulted</text>");
        sb.Append("</svg>");
        return sb.ToString();
    }

    string SvgHFunnel(long collected, long resulted, long billed, decimal? pctR, decimal? pctBOfColl)
    {
        if (collected <= 0) return "<div class='tpd-empty'>No funnel data.</div>";
        double W = ChartW, H = 300, L = 100, R = 130, T = 22, B = 40;
        var plotW = W - L - R; var plotH = H - T - B;
        var rows = new[]
        {
            (Label: "Collected", N: (double)collected, Pct: 100.0, Color: "#1E3A8A"),
            (Label: "Resulted", N: (double)resulted, Pct: (double)(pctR ?? 0), Color: "#2563EB"),
            (Label: "Billed", N: (double)billed, Pct: (double)(pctBOfColl ?? 0), Color: "#93C5FD"),
        };
        var max = rows[0].N;
        // nice x max
        var xMax = Math.Ceiling(max / 50000.0) * 50000;
        if (xMax < max) xMax = max * 1.05;
        if (xMax <= 0) xMax = 1;
        var rowH = plotH / 3.15;
        var sb = new StringBuilder();
        sb.Append($"<svg viewBox='0 0 {W} {H}' class='tpd-svg' role='img'>");
        sb.Append($"<line x1='{F(L)}' y1='{F(T)}' x2='{F(L)}' y2='{F(T + plotH)}' class='tpd-axis-line'/>");
        sb.Append($"<line x1='{F(L)}' y1='{F(T + plotH)}' x2='{F(L + plotW)}' y2='{F(T + plotH)}' class='tpd-axis-line'/>");
        for (int t = 0; t <= 6; t++)
        {
            var xv = xMax * t / 6.0;
            var x = L + xv / xMax * plotW;
            var tick = xv >= 1000 ? (xv / 1000).ToString("0", ci) + "k" : xv.ToString("0", ci);
            sb.Append($"<text x='{F(x)}' y='{F(T + plotH + 16)}' text-anchor='middle' class='tpd-axis'>{Esc(tick)}</text>");
        }
        sb.Append($"<text x='{F(L + plotW / 2)}' y='{F(H - 4)}' text-anchor='middle' class='tpd-axis-title'>Samples</text>");
        for (int i = 0; i < rows.Length; i++)
        {
            var y = T + i * (plotH / 3.0) + 4;
            var bw = Math.Max(8, rows[i].N / xMax * plotW);
            sb.Append($"<text x='{F(L - 10)}' y='{F(y + rowH * 0.55)}' text-anchor='end' class='tpd-funnel-label'>{Esc(rows[i].Label)}</text>");
            sb.Append($"<rect x='{F(L)}' y='{F(y)}' width='{F(bw)}' height='{F(rowH * 0.7)}' fill='{rows[i].Color}'/>");
            sb.Append($"<text x='{F(L + bw + 8)}' y='{F(y + rowH * 0.52)}' class='tpd-funnel-val'>{rows[i].N.ToString("N0", ci)} ({rows[i].Pct.ToString("0.0", ci)}%)</text>");
        }
        sb.Append("</svg>");
        return sb.ToString();
    }

    string SvgAgeBars(IReadOnlyList<(string Label, long Count, string Color)> rows)
    {
        if (rows.Count == 0) return "<div class='tpd-empty'>No backlog.</div>";
        // Width fills the 65% column; keep height moderate (not oversized).
        double W = 720, H = 300, L = 58, R = 16, T = 28, B = 40;
        var plotW = W - L - R; var plotH = H - T - B;
        var max = Math.Max(1, rows.Max(r => r.Count));
        var gap = plotW / rows.Count;
        var bw = Math.Min(78, gap * 0.58);
        var sb = new StringBuilder();
        sb.Append($"<svg viewBox='0 0 {W} {H}' class='tpd-svg' role='img'>");
        sb.Append($"<line x1='{F(L)}' y1='{F(T)}' x2='{F(L)}' y2='{F(T + plotH)}' class='tpd-axis-line'/>");
        sb.Append($"<line x1='{F(L)}' y1='{F(T + plotH)}' x2='{F(W - R)}' y2='{F(T + plotH)}' class='tpd-axis-line'/>");
        for (int g = 0; g <= 4; g++)
        {
            var gy = T + plotH * g / 4.0;
            var gv = max - max * g / 4.0;
            sb.Append($"<text x='{F(L - 10)}' y='{F(gy + 4)}' text-anchor='end' class='tpd-axis'>{Esc(gv >= 1000 ? gv.ToString("#,##0", ci) : gv.ToString("0", ci))}</text>");
        }
        for (int i = 0; i < rows.Count; i++)
        {
            var bh = (double)rows[i].Count / max * plotH;
            var x = L + i * gap + (gap - bw) / 2;
            var y = T + plotH - bh;
            sb.Append($"<rect x='{F(x)}' y='{F(y)}' width='{F(bw)}' height='{F(Math.Max(bh, 0.5))}' fill='{rows[i].Color}'><title>{Esc(rows[i].Label)}: {rows[i].Count:N0}</title></rect>");
            sb.Append($"<text x='{F(x + bw / 2)}' y='{F(y - 8)}' text-anchor='middle' class='tpd-val-dark'>{rows[i].Count.ToString("N0", ci)}</text>");
            sb.Append($"<text x='{F(x + bw / 2)}' y='{F(T + plotH + 20)}' text-anchor='middle' class='tpd-axis'>{Esc(rows[i].Label)}</text>");
        }
        sb.Append($"<text x='16' y='{F(H / 2)}' transform='rotate(-90 16 {F(H / 2)})' text-anchor='middle' class='tpd-axis-title'>Sample count</text>");
        sb.Append("</svg>");
        return sb.ToString();
    }

    string SvgTwoLines(IReadOnlyList<string> labels, IReadOnlyList<double> a, IReadOnlyList<double> b, string nameA, string nameB, string colorA, string colorB)
    {
        if (labels.Count == 0) return "<div class='tpd-empty'>No chart data.</div>";
        var all = a.Concat(b).Where(v => !double.IsNaN(v)).ToList();
        if (all.Count == 0) return "<div class='tpd-empty'>No chart data.</div>";
        double W = ChartW, H = 420, L = 52, R = 20, T = 40, B = 62;
        var plotW = W - L - R; var plotH = H - T - B;
        var min = Math.Max(0, Math.Floor(all.Min() / 2.5) * 2.5 - 2.5);
        var max = Math.Ceiling(all.Max() / 2.5) * 2.5 + 2.5;
        if (max - min < 5) max = min + 5;
        double Xn(int i) => L + (labels.Count == 1 ? plotW / 2 : i * plotW / (labels.Count - 1));
        double Yn(double v) => T + plotH - (v - min) / (max - min) * plotH;
        var sb = new StringBuilder();
        sb.Append($"<svg viewBox='0 0 {W} {H}' class='tpd-svg' role='img'>");
        sb.Append($"<line x1='{F(L)}' y1='{F(T)}' x2='{F(L)}' y2='{F(T + plotH)}' class='tpd-axis-line'/>");
        sb.Append($"<line x1='{F(L)}' y1='{F(T + plotH)}' x2='{F(W - R)}' y2='{F(T + plotH)}' class='tpd-axis-line'/>");
        for (int g = 0; g <= 4; g++)
        {
            var gy = T + plotH * g / 4.0;
            var gv = max - (max - min) * g / 4.0;
            sb.Append($"<line x1='{F(L)}' y1='{F(gy)}' x2='{F(W - R)}' y2='{F(gy)}' class='tpd-grid'/>");
            sb.Append($"<text x='{F(L - 8)}' y='{F(gy + 3)}' text-anchor='end' class='tpd-axis'>{Esc(gv.ToString("0.#", ci))}</text>");
        }
        void Line(IReadOnlyList<double> vals, string color)
        {
            var p = new StringBuilder();
            for (int i = 0; i < vals.Count; i++)
            {
                if (double.IsNaN(vals[i])) continue;
                p.Append($"{(p.Length == 0 ? "M" : "L")}{F(Xn(i))},{F(Yn(vals[i]))} ");
            }
            sb.Append($"<path d='{p}' fill='none' stroke='{color}' stroke-width='2.2'/>");
            for (int i = 0; i < vals.Count; i++)
            {
                if (double.IsNaN(vals[i])) continue;
                sb.Append($"<circle cx='{F(Xn(i))}' cy='{F(Yn(vals[i]))}' r='4' fill='{color}'/>");
                sb.Append($"<text x='{F(Xn(i))}' y='{F(Yn(vals[i]) - 9)}' text-anchor='middle' class='tpd-val'>{FmtPct(vals[i])}</text>");
            }
        }
        Line(a, colorA); Line(b, colorB);
        for (int i = 0; i < labels.Count; i++)
            AppendRotatedLabel(sb, Xn(i), T + plotH + 14, labels[i]);
        sb.Append($"<text x='{F(L)}' y='16' class='tpd-legend' fill='{colorA}'>● {Esc(nameA)}</text>");
        sb.Append($"<text x='{F(L + 110)}' y='16' class='tpd-legend' fill='{colorB}'>● {Esc(nameB)}</text>");
        sb.Append($"<text x='14' y='{F(H / 2)}' transform='rotate(-90 14 {F(H / 2)})' text-anchor='middle' class='tpd-axis-title'>% of total samples</text>");
        sb.Append("</svg>");
        return sb.ToString();
    }

    var labels = months.Select(m => ShortLbl(m.SortYear, m.SortMonth)).ToList();
    var totals = months.Select(m => (double)m.TotalSamples).ToList();
    var resultedPct = months.Select(m => m.PctResulted is { } p ? (double)p : double.NaN).ToList();
    var billedPct = months.Select(m => m.PctBilledOfResulted is { } p ? (double)p : double.NaN).ToList();
    var notRes = months.Select(m => (double)m.NotResulted).ToList();
    var selfPct = months.Select(m => m.SelfPayPct is { } p ? (double)p : double.NaN).ToList();
    var clientPct = months.Select(m => m.ClientBillPct is { } p ? (double)p : double.NaN).ToList();
    var ageColors = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["0-7d"] = "#16A34A", ["8-14d"] = "#16A34A", ["15-30d"] = "#F59E0B", ["31-60d"] = "#F59E0B", ["60+d"] = "#DC2626"
    };
    var ageRows = buckets.Select(b => (b.AgeBucket, b.SampleCount, ageColors.TryGetValue(b.AgeBucket, out var c) ? c : "#3B82F6")).ToList();
    var dayWin = Model.DayWindow > 0 ? Model.DayWindow : 9;
    var asOfTxt = Model.AsOfDate?.ToString("yyyy-MM-dd") ?? "WeekRange end";
    var scopeMonths = Model.TrailingMonths;
}

<style>
