@using LabMetricsDashboard.Models.Menu
@model List<MenuItemVm>
@inject IConfiguration Configuration
@{
    // Denial Workflow lives in a separate React app, so its menu row (DenialWorkflow/Index)
    // drives visibility, order and placement while the link itself points at that app.
    var denialReactUrl = Configuration["DenialWorkflowReactUrl"] ?? "https://localhost:5173";
    var denialReactAgingUrl = denialReactUrl.Contains('#') ? denialReactUrl : $"{denialReactUrl}#aging";

    bool IsDenialWorkflow(MenuItemVm item) =>
        string.Equals(item.ControllerName, "DenialWorkflow", StringComparison.OrdinalIgnoreCase)
        && string.Equals(item.ActionName, "Index", StringComparison.OrdinalIgnoreCase);

    // Reimbursement Insights and Denial Workflow render as their own full-screen pages with no
    // dashboard chrome, so they open in a new tab rather than replacing the dashboard the user
    // is working in. Keyed on the controller because the Menu Master table has no
    // "open in new tab" column to drive it from.
    bool OpensInNewTab(MenuItemVm item) =>
        string.Equals(item.ControllerName, "ReimbursementChat", StringComparison.OrdinalIgnoreCase)
        || IsDenialWorkflow(item);

    // Href for a linkable item: the React app for Denial Workflow, the MVC route otherwise.
    string LinkFor(MenuItemVm item) => IsDenialWorkflow(item)
        ? denialReactAgingUrl
        : Url.Action(item.ActionName, item.ControllerName, new { area = item.AreaName ?? string.Empty })!;
}
@if (Model == null || Model.Count == 0)
{
    @* Menu system unavailable or user has no mappings yet - legacy static navbar *@
    @await Html.PartialAsync("_StaticMenuFallback")
}
else
{
    foreach (var menu in Model)
    {
        if (menu.Children.Any())
        {
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle @(menu.IsDisabled ? "disabled text-muted" : "")"
                   href="#" role="button"
                   data-bs-toggle="@(menu.IsDisabled ? null : "dropdown")"
                   aria-disabled="@menu.IsDisabled.ToString().ToLower()">
                    <i class="bi @menu.IconClass"></i> @menu.MenuName
                </a>
                @if (!menu.IsDisabled)
                {
                    <ul class="dropdown-menu">
                        @foreach (var child in menu.Children)
                        {
                            <li>
                                @if (child.IsDisabled || !child.HasLink)
                                {
                                    <span class="dropdown-item disabled" title="This menu is currently disabled">
                                        <i class="bi @child.IconClass"></i> @child.MenuName
                                    </span>
                                }
                                else
                                {
                                    <a class="dropdown-item"
                                       href="@LinkFor(child)"
                                       target="@(OpensInNewTab(child) ? "_blank" : null)"
                                       rel="@(OpensInNewTab(child) ? "noopener" : null)">
                                        <i class="bi @child.IconClass"></i> @child.MenuName
                                    </a>
                                }
                            </li>
                        }
                    </ul>
                }
            </li>
        }
        else
        {
            <li class="nav-item">
                @if (menu.IsDisabled || !menu.HasLink)
                {
                    <span class="nav-link disabled text-muted" title="This menu is currently disabled">
                        <i class="bi @menu.IconClass"></i> @menu.MenuName
                    </span>
                }
                else
                {
                    <a class="nav-link"
                       href="@LinkFor(menu)"
                       target="@(OpensInNewTab(menu) ? "_blank" : null)"
                       rel="@(OpensInNewTab(menu) ? "noopener" : null)">
                        <i class="bi @menu.IconClass"></i> @menu.MenuName
                    </a>
                }
            </li>
        }
    }
}
