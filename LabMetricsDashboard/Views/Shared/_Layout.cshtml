@using LabMetricsDashboard.Models
@inject LabSettings LabSettingsInstance
@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lab Revenue Intelligence</title>
    <script nonce='@Context.Items["CspNonce"]' type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LabMetricsDashboard.styles.css" asp-append-version="true" />
    <style>
        /* ── Global overrides ───────────────────────────────────────── */
        body {
        background-color: #f0f4f8;
        }

        /* ── Navbar ─────────────────────────────────────────────────── */
        .lmd-navbar {
        background: linear-gradient(135deg, #0d1b2a 0%, #1b3a5c 60%, #1565c0 100%);
        box-shadow: 0 2px 12px rgba(0, 0, 0, .35);
        }

        .lmd-navbar .navbar-brand {
        font-weight: 700;
        font-size: 1.25rem;
        letter-spacing: .03em;
        color: #fff !important;
        }

        .lmd-navbar .navbar-brand span {
        color: #64b5f6;
        }

        .lmd-navbar .nav-link,
        .lmd-navbar .dropdown-toggle {
        color: rgba(255, 255, 255, .85) !important;
        font-size: .9rem;
        }

        .lmd-navbar .nav-link:hover,
        .lmd-navbar .dropdown-toggle:hover {
        color: #fff !important;
        }

        .lmd-navbar .nav-link.active {
        color: #64b5f6 !important;
        font-weight: 600;
        }

        .lmd-navbar .dropdown-menu {
        background: #1b3a5c;
        border: 1px solid rgba(255, 255, 255, .12);
        }

        .lmd-navbar .dropdown-item {
        color: rgba(255, 255, 255, .85);
        font-size: .88rem;
        }

        .lmd-navbar .dropdown-item:hover {
        background: rgba(255, 255, 255, .1);
        color: #fff;
        }

        .lmd-navbar .dropdown-item.disabled {
        color: rgba(255, 255, 255, .3) !important;
        background: transparent;
        cursor: not-allowed;
        pointer-events: none;
        }

        .lmd-navbar .navbar-toggler {
        border-color: rgba(255, 255, 255, .3);
        }

        /* ── Navbar right-side toolbar (lab selector + future user) ── */
        .nav-toolbar {
        display: flex;
        align-items: center;
        gap: .6rem;
        flex-shrink: 0;
        }

        .nav-lab-wrap {
        position: relative;
        }

        .nav-lab-btn {
        display: flex;
        align-items: center;
        gap: .4rem;
        background: rgba(255, 255, 255, .12);
        border: 1px solid rgba(255, 255, 255, .25);
        border-radius: 20px;
        padding: .25em .85em .25em .7em;
        color: #fff;
        font-weight: 700;
        font-size: .8rem;
        letter-spacing: .02em;
        cursor: pointer;
        white-space: nowrap;
        transition: background .15s;
        }

        .nav-lab-btn:hover {
        background: rgba(255, 255, 255, .22);
        }

        .nav-lab-btn .bi-chevron-down {
        font-size: .55rem;
        opacity: .7;
        transition: transform .15s;
        }

        .nav-lab-panel {
        display: none;
        position: absolute;
        right: 0;
        top: calc(100% + 6px);
        background: #fff;
        border: 1px solid #ced4da;
        border-radius: .5rem;
        box-shadow: 0 8px 24px rgba(0, 0, 0, .22);
        min-width: 260px;
        max-height: 340px;
        overflow: hidden;
        z-index: 1100;
        flex-direction: column;
        }

        .nav-lab-panel.open {
        display: flex;
        }

        .nav-lab-search {
        border: none;
        border-bottom: 1px solid #e9ecef;
        padding: .5rem .75rem;
        font-size: .8rem;
        outline: none;
        width: 100%;
        }

        .nav-lab-list {
        overflow-y: auto;
        max-height: 270px;
        padding: .25rem 0;
        }

        .nav-lab-list a {
        display: block;
        padding: .4rem .8rem;
        font-size: .8rem;
        color: #1e293b;
        text-decoration: none;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        }

        .nav-lab-list a:hover,
        .nav-lab-list a.active {
        background: #eef4ff;
        }

        .nav-lab-list a.active {
        font-weight: 700;
        color: #1565c0;
        }

        .nav-lab-list a.nav-lab-hidden {
        display: none;
        }

        /* Separator between toolbar items (future: lab | user) */
        .nav-toolbar-sep {
        width: 1px;
        height: 20px;
        background: rgba(255, 255, 255, .2);
        }

        /* ── Breadcrumb bar ──────────────────────────────────────────── */
        .lmd-breadcrumb {
        background: linear-gradient(90deg, #1565c0 0%, #0097a7 100%);
        padding: .45rem 1.5rem;
        font-size: .82rem;
        }

        .lmd-breadcrumb a {
        color: rgba(255, 255, 255, .78);
        text-decoration: none;
        }

        .lmd-breadcrumb a:hover {
        color: #fff;
        text-decoration: underline;
        }

        .lmd-breadcrumb .bc-sep {
        color: rgba(255, 255, 255, .45);
        margin: 0 .4rem;
        }

        .lmd-breadcrumb .bc-current {
        color: #fff;
        font-weight: 600;
        }

        /* ── Full-screen loading overlay ─────────────────────────────── */
        #lmd-loader {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(13, 27, 42, .72);
        backdrop-filter: blur(3px);
        z-index: 9999;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.2rem;
        }

        #lmd-loader.active {
        display: flex;
        }

        .lmd-spinner {
        width: 56px;
        height: 56px;
        border: 5px solid rgba(255, 255, 255, .2);
        border-top-color: #64b5f6;
        border-radius: 50%;
        animation: lmd-spin .75s linear infinite;
        }

        @@keyframes lmd-spin {
        to {
        transform: rotate(360deg);
        }
        }

        .lmd-loader-text {
        color: #fff;
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: .04em;
        }

        /* ── Footer ──────────────────────────────────────────────────── */
        footer {
        background: #e8edf3;
        border-top: 1px solid #cdd5e0 !important;
        }

        .navbar .nav-link i,
        .navbar .dropdown-item i {
        font-size: 1.05rem; /* slightly bigger */
        margin-right: 6px;
        vertical-align: middle;
        }

        .navbar .nav-link {
        display: flex;
        align-items: center;
        gap: 4px;
        white-space: nowrap;
        }

        /* Keep navbar items on a single row; collapse to hamburger when too narrow. */
        .lmd-navbar .navbar-nav {
        flex-wrap: nowrap;
        }

        .lmd-navbar .dropdown-toggle {
        white-space: nowrap;
        }

        /* ── Two-row top header: brand bar + menu bar ───────────────── */
        .lmd-brandbar {
        background: linear-gradient(135deg, #0d1b2a 0%, #1b3a5c 60%, #1565c0 100%);
        box-shadow: 0 1px 0 rgba(255,255,255,.05);
        padding: .55rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        }

        .lmd-brandbar .brand-link {
        display: inline-flex;
        align-items: center;
        gap: .55rem;
        color: #fff;
        text-decoration: none;
        }

        .lmd-brandbar .brand-link img {
        height: 36px;
        width: auto;
        object-fit: contain;
        }

        .lmd-brandbar .brand-spacer {
        flex: 1 1 auto;
        }

        .lmd-menubar {
        background: #102b46; /* darker shade so menu sits visually below brand bar */
        border-top: 1px solid rgba(255,255,255,.06);
        box-shadow: 0 2px 12px rgba(0,0,0,.25);
        }

        .lmd-menubar .navbar {
        padding-top: .25rem;
        padding-bottom: .25rem;
        }

        .lmd-menubar .nav-link, .lmd-menubar .dropdown-toggle {
        color: rgba(255,255,255,.85) !important;
        font-size: .9rem;
        padding-top: .55rem;
        padding-bottom: .55rem;
        }

        .lmd-menubar .nav-link:hover, .lmd-menubar .dropdown-toggle:hover {
        color: #fff !important;
        }

        .lmd-menubar .nav-link.active {
        color: #64b5f6 !important;
        font-weight: 600;
        }

        .lmd-menubar .dropdown-menu {
        background: #1b3a5c;
        border: 1px solid rgba(255, 255, 255, .12);
        }

        .lmd-menubar .dropdown-item {
        color: rgba(255, 255, 255, .85);
        font-size: .88rem;
        }

        .lmd-menubar .dropdown-item:hover {
        background: rgba(255, 255, 255, .1);
        color: #fff;
        }

        .lmd-menubar .dropdown-item.disabled {
        color: rgba(255, 255, 255, .3) !important;
        background: transparent;
        cursor: not-allowed;
        pointer-events: none;
        }

        .lmd-menubar .navbar-toggler {
        border-color: rgba(255,255,255,.3);
        }

        /* ── Notification bell (payer mapping) ───────────────────── */
        .nav-bell-wrap { position: relative; display: inline-flex; align-items: center; }
        .nav-bell-btn { position: relative; color: #E8EEF5; cursor: pointer; padding: 6px 10px; border-radius: 6px; font-size: 1.05rem; }
        .nav-bell-btn:hover { background: rgba(255,255,255,.12); }
        #rptBtn { color: #FBBF24; }
        #rptBtn:hover { background: rgba(251,191,36,.16); }
        .nav-bell-badge { position: absolute; top: 0; right: 0; background: #E4572E; color: #fff; border-radius: 999px; font-size: .62rem; font-weight: 800; padding: 1px 5px; line-height: 1.2; }
        .nav-bell-panel { display: none; position: absolute; right: 0; top: calc(100% + 8px); width: 340px; background: #fff; color: #1F2937; border: 1px solid #d9e2ef; border-radius: 10px; box-shadow: 0 18px 40px rgba(15,23,42,.25); z-index: 1060; overflow: hidden; }
        .nav-bell-panel .nb-title { font-size: .68rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; color: #64748b; padding: 10px 12px 4px; }
        .nav-bell-panel .nb-counts { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 4px 12px 10px; border-bottom: 1px solid #eef2f7; }
        .nav-bell-panel .nb-count { display: block; text-decoration: none; border: 1px solid #e2e8f0; border-radius: 8px; padding: 6px 8px; font-size: .78rem; color: #334155; }
        .nav-bell-panel .nb-count b { font-size: .95rem; margin-right: 4px; }
        .nav-bell-panel .nb-count:hover { background: #f8fbff; border-color: #b6cdea; }
        .nav-bell-panel .nb-count.nb-ok b { color: #166534; }
        .nav-bell-panel .nb-count.nb-warn b { color: #B7791F; }
        .nav-bell-panel .nb-count.nb-bad b { color: #991b1b; }
        .nav-bell-panel .nb-count.nb-muted b { color: #475569; }
        .nav-bell-panel .nb-list { max-height: 240px; overflow: auto; }
        .nav-bell-panel .nb-item { padding: 8px 12px; border-bottom: 1px solid #f1f5f9; }
        .nav-bell-panel .nb-item-title { font-size: .78rem; font-weight: 700; color: #1F3B57; }
        .nav-bell-panel .nb-item-msg { font-size: .72rem; color: #64748b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .nav-bell-panel .nb-empty { padding: 12px; font-size: .78rem; color: #94a3b8; }
        .nav-bell-panel .nb-footer { display: block; text-align: center; padding: 8px; font-size: .76rem; font-weight: 700; color: #2E5C8A; text-decoration: none; background: #f8fafc; }
        .nav-bell-panel .nb-footer:hover { background: #eef6ff; }

        /* ── Reports badge (async report downloads) — separate from the bell ── */
        .rpt-panel { width: 400px; }
        #rptBadge.rpt-ready { background: #2E7D32; }
        .rpt-item { display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-bottom: 1px solid #f1f5f9; }
        .rpt-item-main { flex: 1 1 auto; min-width: 0; }
        .rpt-item-title { font-size: .78rem; font-weight: 700; color: #1F3B57; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .rpt-item-sub { font-size: .7rem; color: #64748b; }
        .rpt-item-err { font-size: .7rem; color: #991b1b; margin-top: 2px; white-space: normal; word-break: break-word; }
        .rpt-status { font-size: .66rem; font-weight: 800; border-radius: 999px; padding: 2px 8px; white-space: nowrap; }
        .rpt-status-ready { background: #dcfce7; color: #166534; }
        .rpt-status-processing { background: #fef9c3; color: #854d0e; min-width: 92px; text-align: center; }
        .rpt-status-failed { background: #fee2e2; color: #991b1b; }
        .rpt-status-queued { background: #e2e8f0; color: #475569; }
        .rpt-progress { width: 92px; flex-shrink: 0; }
        .rpt-progress-label { display: flex; justify-content: space-between; color: #854d0e; font-size: .65rem; font-weight: 800; }
        .rpt-progress-track { height: 5px; margin-top: 3px; overflow: hidden; border-radius: 999px; background: #fde68a; }
        .rpt-progress-bar { height: 100%; border-radius: inherit; background: linear-gradient(90deg,#f59e0b,#facc15); transition: width .35s ease; }
        .rpt-progress-bar.indeterminate { width: 42%; animation: rpt-progress-slide 1.1s ease-in-out infinite; }

        /* ── Report-type breakdown pills (Recent Reports panel) ── */
        .rpt-types { display: flex; flex-wrap: wrap; gap: 3px; padding: 4px 12px 10px; border-bottom: 1px solid #eef2f7; }
        .rpt-type-pill { display: inline-flex; align-items: center; gap: 3px; border-radius: 999px; padding: 2px 7px; font-size: .56rem; font-weight: 600; white-space: nowrap; }
        .rpt-type-pill b { font-size: .6rem; font-weight: 800; }
        .rpt-type-c1 { background: #e0edff; color: #1d4ed8; }
        .rpt-type-c2 { background: #ede9fe; color: #6d28d9; }
        .rpt-type-c3 { background: #ccfbf1; color: #0f766e; }
        .rpt-type-c4 { background: #fef3c7; color: #b45309; }
        .rpt-type-c5 { background: #dcfce7; color: #15803d; }
        .rpt-type-c6 { background: #fce7f3; color: #be185d; }
        @@keyframes rpt-progress-slide {
            0% { transform: translateX(-110%); }
            100% { transform: translateX(250%); }
        }
        .rpt-actions { display: flex; gap: 4px; flex-shrink: 0; }
        .rpt-actions a, .rpt-actions button { border: 1px solid #e2e8f0; background: #fff; border-radius: 6px; padding: 3px 7px; font-size: .72rem; line-height: 1; color: #334155; cursor: pointer; text-decoration: none; }
        .rpt-actions a:hover, .rpt-actions button:hover { background: #f8fbff; border-color: #b6cdea; }
        .rpt-actions .rpt-cancel { color: #b91c1c; border-color: #fecaca; }
        .rpt-actions .rpt-cancel:hover { background: #fef2f2; border-color: #f87171; }
        .rpt-actions .rpt-dl { color: #166534; border-color: #bbe5c8; font-weight: 700; }
        .rpt-actions .rpt-del:hover { color: #991b1b; border-color: #fecaca; }

        /* ── User chip + dropdown ────────────────────────────────── */
        .lmd-userchip {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.22);
        color: #fff;
        border-radius: 22px;
        padding: .2rem .85rem .2rem .25rem;
        font-weight: 600;
        font-size: .82rem;
        cursor: pointer;
        transition: background .15s, border-color .15s;
        }

        .lmd-userchip:hover {
        background: rgba(255,255,255,.18);
        border-color: rgba(255,255,255,.35);
        color: #fff;
        }

        .lmd-userchip:focus {
        outline: none;
        box-shadow: 0 0 0 3px rgba(100,181,246,.35);
        }

        .lmd-userchip::after {
        content: "";
        display: inline-block;
        width: 0;
        height: 0;
        margin-left: .15rem;
        border-left: 4px solid transparent;
        border-right: 4px solid transparent;
        border-top: 5px solid rgba(255,255,255,.85);
        }

        .lmd-useravatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #64b5f6, #1565c0);
        color: #fff;
        font-weight: 800;
        font-size: .72rem;
        box-shadow: 0 2px 8px rgba(0,0,0,.25);
        flex: 0 0 auto;
        }

        .lmd-usermenu {
        min-width: 260px;
        padding: 0;
        overflow: hidden;
        border: 1px solid #e4eaf3;
        border-radius: 14px;
        box-shadow: 0 18px 50px rgba(13,27,42,.22);
        }

        .lmd-usermenu .um-header {
        padding: 1rem 1rem .85rem;
        background: linear-gradient(135deg,#0d1b2a 0%,#1565c0 100%);
        color: #fff;
        display: flex;
        align-items: center;
        gap: .7rem;
        }

        .lmd-usermenu .um-header .um-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: rgba(255,255,255,.2);
        border: 1.5px solid rgba(255,255,255,.4);
        font-weight: 800;
        font-size: .9rem;
        }

        .lmd-usermenu .um-name {
        font-weight: 700;
        font-size: .95rem;
        line-height: 1.2;
        }

        .lmd-usermenu .um-handle {
        font-size: .76rem;
        color: rgba(255,255,255,.78);
        }

        .lmd-usermenu .um-roles {
        padding: .5rem 1rem .25rem;
        display: flex;
        flex-wrap: wrap;
        gap: .25rem;
        }

        .lmd-usermenu .um-role-pill {
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .04em;
        background: #e3f2fd;
        color: #1565c0;
        border: 1px solid #bbdefb;
        border-radius: 20px;
        padding: .15em .65em;
        text-transform: uppercase;
        }

        .lmd-usermenu .um-role-pill.admin {
        background: #e8f5e9;
        color: #2e7d32;
        border-color: #c8e6c9;
        }

        .lmd-usermenu .um-divider {
        height: 1px;
        background: #eef2f7;
        margin: .4rem 0;
        }

        .lmd-usermenu .um-action {
        width: 100%;
        text-align: left;
        background: none;
        border: none;
        padding: .55rem 1rem;
        font-size: .85rem;
        color: #243049;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: .55rem;
        transition: background .12s;
        }

        .lmd-usermenu .um-action:hover {
        background: #f0f8ff;
        color: #1565c0;
        }

        .lmd-usermenu .um-action.danger {
        color: #c62828;
        }

        .lmd-usermenu .um-action.danger:hover {
        background: #fdecea;
        color: #b71c1c;
        }

        .lmd-usermenu form {
        margin: 0;
        }

        /* -- Shared report alert toast -------------------------------- */
        .lrn-report-toast {
        position: fixed;
        top: 82px;
        right: 24px;
        z-index: 11050;
        width: 400px;
        max-width: calc(100vw - 32px);
        background: rgba(255, 255, 255, .82);
        border: 1px solid rgba(232, 237, 244, .86);
        border-radius: 16px;
        box-shadow: 0 16px 48px rgba(15, 23, 42, .14), 0 4px 12px rgba(15, 23, 42, .06);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        transform: translateX(calc(100% + 32px));
        opacity: 0;
        pointer-events: none;
        transition: transform .48s cubic-bezier(.2, .9, .25, 1), opacity .32s ease;
        overflow: hidden;
        }

        .lrn-report-toast.is-success {
        background: linear-gradient(135deg, rgba(236, 253, 245, .92) 0%, rgba(240, 253, 244, .84) 56%, rgba(255, 255, 255, .82) 100%);
        border-color: rgba(167, 243, 208, .88);
        }

        .lrn-report-toast.is-visible {
        transform: translateX(0);
        opacity: 1;
        pointer-events: auto;
        }

        .lrn-report-toast-inner {
        display: flex;
        align-items: flex-start;
        gap: .85rem;
        padding: 1.1rem 1rem .9rem 1.1rem;
        }

        .lrn-report-toast-badge {
        flex: 0 0 auto;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 1.15rem;
        margin-top: .05rem;
        }

        .lrn-report-toast.is-success .lrn-report-toast-badge {
        background: rgba(13, 133, 83, .12);
        color: #0d8553;
        box-shadow: inset 0 0 0 1px rgba(13, 133, 83, .12);
        }

        .lrn-report-toast.is-info .lrn-report-toast-badge {
        background: #eef4ff;
        color: #1565c0;
        }

        .lrn-report-toast.is-error .lrn-report-toast-badge {
        background: #fef2f2;
        color: #c62828;
        }

        .lrn-report-toast-content {
        flex: 1 1 auto;
        min-width: 0;
        padding-top: .1rem;
        }

        .lrn-report-toast-title {
        font-size: .98rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: .28rem;
        letter-spacing: -.01em;
        }

        .lrn-report-toast.is-success .lrn-report-toast-title {
        color: #0f5132;
        }

        .lrn-report-toast-message {
        font-size: .8rem;
        line-height: 1.55;
        color: #5b6b82;
        }

        .lrn-report-toast-actions {
        display: flex;
        align-items: center;
        gap: .55rem;
        margin-top: .8rem;
        }

        .lrn-report-toast-action {
        border: none;
        border-radius: 999px;
        padding: .42rem .82rem;
        font-size: .74rem;
        font-weight: 700;
        line-height: 1;
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease, background .15s ease, color .15s ease;
        }

        .lrn-report-toast-action:hover {
        transform: translateY(-1px);
        }

        .lrn-report-toast-action.primary {
        background: #eaf2ff;
        color: #1556a8;
        box-shadow: inset 0 0 0 1px #cfe0fb;
        }

        .lrn-report-toast.is-success .lrn-report-toast-action.primary {
        background: rgba(13, 133, 83, .10);
        color: #0d6b45;
        box-shadow: inset 0 0 0 1px rgba(13, 133, 83, .18);
        }

        .lrn-report-toast-action.primary:hover {
        background: #ddeafe;
        }

        .lrn-report-toast.is-success .lrn-report-toast-action.primary:hover {
        background: rgba(13, 133, 83, .16);
        }

        .lrn-report-toast-action.ghost {
        background: transparent;
        color: #64748b;
        box-shadow: inset 0 0 0 1px #d7e0ea;
        }

        .lrn-report-toast-action.ghost:hover {
        color: #334155;
        background: #f8fafc;
        }

        .lrn-report-toast-message strong {
        color: #334155;
        font-weight: 700;
        }

        .lrn-report-toast.is-success .lrn-report-toast-message {
        color: #466052;
        }

        .lrn-report-toast.is-success .lrn-report-toast-message strong {
        color: #0f5132;
        }

        .lrn-report-toast-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        margin: 0 .1rem;
        vertical-align: -5px;
        background: #eef5ff;
        color: #1565c0;
        border: 1px solid #d6e4fb;
        border-radius: 6px;
        font-size: .8rem;
        }

        .lrn-report-toast-close {
        flex: 0 0 auto;
        border: none;
        background: transparent;
        color: #9aa7b8;
        cursor: pointer;
        font-size: .85rem;
        padding: .2rem;
        line-height: 1;
        border-radius: 8px;
        margin-top: -.05rem;
        }

        .lrn-report-toast-close:hover {
        color: #5b6b82;
        background: #f1f4f8;
        }

        .lrn-report-toast-progress {
        height: 3px;
        background: rgba(241, 245, 249, .72);
        }

        .lrn-report-toast-progress-bar {
        height: 100%;
        width: 100%;
        transform-origin: left center;
        transform: scaleX(1);
        }

        .lrn-report-toast.is-success .lrn-report-toast-progress-bar {
        background: linear-gradient(90deg, #10b981, #0d8553);
        }

        .lrn-report-toast.is-info .lrn-report-toast-progress-bar {
        background: linear-gradient(90deg, #3b82f6, #1565c0);
        }

        .lrn-report-toast.is-error .lrn-report-toast-progress-bar {
        background: linear-gradient(90deg, #f59e0b, #c62828);
        }

        @@keyframes lrnRptBtnPulse {
        0% { box-shadow: 0 0 0 0 rgba(21, 101, 192, .45); }
        70% { box-shadow: 0 0 0 12px rgba(21, 101, 192, 0); }
        100% { box-shadow: 0 0 0 0 rgba(21, 101, 192, 0); }
        }

        #rptBtn.lrn-rpt-attention {
        border-radius: 50%;
        animation: lrnRptBtnPulse 1.2s ease-out 3;
        }
    </style>
</head>

<body>
@{
    var denialReactUrl = Configuration["DenialWorkflowReactUrl"] ?? "https://localhost:5173";
    var denialReactAgingUrl = denialReactUrl.Contains('#') ? denialReactUrl : $"{denialReactUrl}#aging";
}


    <!-- Full-screen loader overlay -->
    <div id="lmd-loader" role="status" aria-live="polite" aria-label="Loading">
        <div class="lmd-spinner"></div>
        <div class="lmd-loader-text" id="lmd-loader-text">Loading lab data…</div>
    </div>

    <header>
        @{
            var selectedLab = ViewData["SelectedLab"] as string;
            var pageLabel = ViewData["PageLabel"] as string;
            var allLabKeys = LabSettingsInstance.Labs.Keys.OrderBy(x => x).ToList();

            // Restrict the navbar lab selector to labs the signed-in user is assigned to.
            // Admins see every lab. Anonymous (login screen) sees nothing.
            var isAdmin = User?.IsInRole("Admin") ?? false;
            var isArManager = (User?.IsInRole("AR Manager") ?? false) || (User?.IsInRole("ARManager") ?? false);
            var isArReviewer = (User?.IsInRole("AR Reviewer") ?? false) || (User?.IsInRole("ARReviewer") ?? false) || (User?.IsInRole("AR Analyser") ?? false) || (User?.IsInRole("ARAnalyser") ?? false) || (User?.IsInRole("AR Analyzer") ?? false) || (User?.IsInRole("ARAnalyzer") ?? false);
            var isArRestricted = isArManager || isArReviewer;

            // Payer Master roles (Payer Master Requirements Spec §2)
            var isLrnAdmin = isAdmin || (User?.IsInRole("LRN Admin") ?? false) || (User?.IsInRole("LRNAdmin") ?? false);
            var isPayerPolicyAdmin = (User?.IsInRole("Payer Policy Admin") ?? false) || (User?.IsInRole("PayerPolicyAdmin") ?? false);
            var isReportsAnalyst = (User?.IsInRole("Reports Analyst") ?? false) || (User?.IsInRole("ReportsAnalyst") ?? false);
            var isReportsManager = (User?.IsInRole("Reports Manager") ?? false) || (User?.IsInRole("ReportsManager") ?? false);
            var isEtl = (User?.IsInRole("ETL") ?? false) || (User?.IsInRole("Etl") ?? false);
            var canSeePolicyMaster = isLrnAdmin || isPayerPolicyAdmin || isReportsAnalyst || isEtl;
            var canSeeLabMaster = isLrnAdmin || isReportsManager || isReportsAnalyst || isEtl;
            var userLabClaims = User?.Claims?
            .Where(c => c.Type == "LabName")
            .Select(c => c.Value)
            .ToHashSet(StringComparer.OrdinalIgnoreCase) ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            var availableLabs = isAdmin
            ? allLabKeys
            : allLabKeys.Where(l => userLabClaims.Contains(l)).ToList();

            // For the navbar lab selector: priority order:
            //   1. ViewData["SelectedLab"]  — set by most controllers after resolving the lab
            //   2. ?lab= query parameter    — present immediately on lab switch (before the
            //                                 response cookie can propagate to the next request)
            //   3. lmd_selected_lab cookie  — remembered from a prior navigation
            //   4. First available lab      — final fallback
            var activeLab = selectedLab;
            if (string.IsNullOrEmpty(activeLab))
            {
                var queryLab = Context.Request.Query["lab"].ToString();
                if (!string.IsNullOrWhiteSpace(queryLab)
                && availableLabs.Contains(queryLab, StringComparer.OrdinalIgnoreCase))
                {
                    activeLab = queryLab;
                }
                else
                {
                    Context.Request.Cookies.TryGetValue("lmd_selected_lab", out var cookieLab);
                    if (!string.IsNullOrWhiteSpace(cookieLab)
                    && availableLabs.Contains(cookieLab, StringComparer.OrdinalIgnoreCase))
                    {
                        activeLab = cookieLab;
                    }
                    else
                    {
                        activeLab = availableLabs.FirstOrDefault();
                    }
                }
            }

            // Get lab-specific feature toggles
            LabCsvConfig? labConfig = null;
            if (!string.IsNullOrEmpty(activeLab) && LabSettingsInstance.Labs.ContainsKey(activeLab))
            {
                labConfig = LabSettingsInstance.Labs[activeLab];
            }
        }
        <!-- ─── Top brand bar (logo + lab dropdown + user) ─── -->
        <div class="lmd-brandbar">
            <a class="brand-link" asp-controller="ReportBoard" asp-action="Index">
                <img src="~/images/LRN-White-Logo-footer-1-1.png" alt="LRN Logo" />
            </a>
            <div class="brand-spacer"></div>
            <div class="nav-toolbar">
                @if (!string.IsNullOrEmpty(activeLab) && availableLabs.Count > 0)
                {
                    <span class="nav-lab-wrap" id="navLabWrap">
                        <span class="nav-lab-btn" id="navLabBtn" tabindex="0" title="Switch lab">
                            <i class="bi bi-building"></i>
                            @activeLab
                            <i class="bi bi-chevron-down"></i>
                        </span>
                        <div class="nav-lab-panel" id="navLabPanel">
                            <input type="text" class="nav-lab-search" id="navLabSearch"
                                   placeholder="Search labs…" autocomplete="off" />
                            <div class="nav-lab-list" id="navLabList">
                                @foreach (var lab in availableLabs)
                                {
                                    <a href="#" data-lab="@lab"
                                       class="@(lab == activeLab ? "active" : "")">@lab</a>
                                }
                            </div>
                        </div>
                    </span>
                }
                @if ((User?.Identity?.IsAuthenticated ?? false) && canSeeLabMaster)
                {
                    <span class="nav-bell-wrap" id="navBellWrap">
                        <span class="nav-bell-btn" id="navBellBtn" tabindex="0" title="Payer mapping notifications">
                            <i class="bi bi-bell"></i>
                            <span class="nav-bell-badge" id="navBellBadge" style="display:none;">0</span>
                        </span>
                        <div class="nav-bell-panel" id="navBellPanel">
                            <div class="nb-title">Payer Mapping</div>
                            <div class="nb-counts" id="navBellCounts"><span class="text-muted">Loading…</span></div>
                            <div class="nb-title">Recent notifications</div>
                            <div class="nb-list" id="navBellList"></div>
                            <a class="nb-footer" href="@Url.Action("PayerMasterNotifications", "MasterValues")">View all notifications</a>
                        </div>
                    </span>
                }
                @if (User?.Identity?.IsAuthenticated ?? false)
                {
                    @* 📄 Reports badge — async report downloads. Independent of the
                       existing notification bell above (which is NOT modified). *@
                    <span class="nav-bell-wrap" id="rptWrap">
                        <span id="lrnReportsAf" hidden>@Html.AntiForgeryToken()</span>
                        <span class="nav-bell-btn" id="rptBtn" tabindex="0" title="My generated reports">
                            <i class="bi bi-file-earmark-arrow-down"></i>
                            <span class="nav-bell-badge" id="rptBadge" style="display:none;">0</span>
                        </span>
                        <div class="nav-bell-panel rpt-panel" id="rptPanel">
                            <div class="rpt-types" id="rptTypes"></div>
                            <div class="nb-title">Recent Reports <span class="text-muted fw-normal">(latest 15)</span></div>
                            <div class="nb-list" id="rptList"><div class="nb-empty">Loading…</div></div>
                            <a class="nb-footer" href="@Url.Action("Index", "UserReports")">View all reports</a>
                        </div>
                    </span>
                }
                @if (User?.Identity?.IsAuthenticated ?? false)
                {
                    var fullName = User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value;
                    if (string.IsNullOrWhiteSpace(fullName)) fullName = User.Identity!.Name;
                    var initials = string.IsNullOrWhiteSpace(fullName) ? "U"
                    : string.Concat(fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                    .Take(2).Select(p => char.ToUpperInvariant(p[0])));
                    var userRoles = User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
                    .Select(c => c.Value).Distinct(StringComparer.OrdinalIgnoreCase).ToList();

                    <div class="nav-toolbar-sep"></div>
                    <div class="dropdown">
                        <button class="lmd-userchip" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false"
                                title="Account">
                            <span class="lmd-useravatar">@initials</span>
                            <span>@fullName</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end lmd-usermenu p-0">
                            <div class="um-header">
                                <div class="um-avatar">@initials</div>
                                <div>
                                    <div class="um-name">@fullName</div>
                                    <div class="um-handle">@@@User.Identity!.Name</div>
                                </div>
                            </div>
                            @if (userRoles.Any())
                            {
                                <div class="um-roles">
                                    @foreach (var role in userRoles)
                                    {
                                        var isAdminRole = string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase);
                                        <span class="um-role-pill @(isAdminRole ? "admin" : "")">@role</span>
                                    }
                                </div>
                            }
                            <div class="um-divider"></div>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="um-action danger">
                                    <i class="bi bi-box-arrow-right"></i> Sign Out
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- ─── Menu bar (only menu items live here) ─── -->
        <nav class="navbar navbar-expand-xl lmd-menubar mb-0">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#lmdMainMenu" aria-controls="lmdMainMenu"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="lmdMainMenu">
                    <ul class="navbar-nav gap-2">
                        @if (isArRestricted)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@denialReactAgingUrl" target="_blank" rel="noopener">
                                    <i class="bi bi-kanban-fill"></i> Denial Workflow <span class="badge text-bg-info ms-1">React</span>
                                </a>
                            </li>
                        }
                        else
                        {
                            @* Database-driven navbar (Menu Master + Role Menu Mapping).
                               Falls back to the legacy static menu when unavailable. *@
                            @await Component.InvokeAsync("DynamicMenu")
                        }
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Breadcrumb bar — shown when a lab is selected -->
        @if (!string.IsNullOrEmpty(selectedLab))
        {
            <div class="lmd-breadcrumb d-flex align-items-center flex-wrap gap-1">
                <a asp-controller="ReportBoard" asp-action="Index">Home</a>
                @if (!string.IsNullOrEmpty(pageLabel))
                {
                    <span class="bc-sep">›</span>
                    <span class="bc-current">@pageLabel</span>
                }
            </div>
        }
    </header>

    <div class="container-fluid px-4 pt-3">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="footer py-2 mt-3">
        <div class="container-fluid px-4">
            <small class="text-muted">&copy; 2026 Lab Revenue Intelligence</small>
        </div>
    </footer>

    <script nonce='@Context.Items["CspNonce"]' src="~/lib/jquery/dist/jquery.min.js"></script>
    <script nonce='@Context.Items["CspNonce"]' src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script nonce='@Context.Items["CspNonce"]' src="~/lib/chart.js/chart.umd.js"></script>
    <script nonce='@Context.Items["CspNonce"]' src="~/js/site.js" asp-append-version="true"></script>
    <script nonce='@Context.Items["CspNonce"]'>
        // Payer mapping notification bell: MappingStatus counts + recent Payer Master notifications.
        (function () {
            var wrap = document.getElementById('navBellWrap');
            if (!wrap) return;
            var btn = document.getElementById('navBellBtn'),
                panel = document.getElementById('navBellPanel'),
                badge = document.getElementById('navBellBadge');
            var urls = {
                summary: '@Url.Action("MappingSummary", "MasterValues")',
                notes: '@Url.Action("NotificationsData", "MasterValues")',
                master: '@Url.Action("InsurancePayerMaster", "MasterValues")'
            };
            function esc(v) { return (v == null ? '' : String(v)).replace(/[&<>"']/g, function (m) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m]; }); }
            function countItem(label, n, filter, cls) {
                return '<a class="nb-count ' + cls + '" href="' + urls.master + '?mappingStatus=' + encodeURIComponent(filter) + '"><b>' + (n || 0) + '</b>' + label + '</a>';
            }
            async function refresh() {
                try {
                    var r = await fetch(urls.summary); if (!r.ok) return;
                    var s = await r.json();
                    var pending = s.pendingReview || 0;
                    badge.textContent = pending > 99 ? '99+' : String(pending);
                    badge.style.display = pending > 0 ? '' : 'none';
                    document.getElementById('navBellCounts').innerHTML =
                        countItem('Mapped', s.mapped, 'Mapped', 'nb-ok') +
                        countItem('Pending review', s.pendingReview, 'Unmapped - Pending Review', 'nb-warn') +
                        countItem('No match', s.noMatch, 'No Match Found', 'nb-bad') +
                        countItem('Unmapped', s.unmapped, 'Unmapped', 'nb-muted');
                } catch (e) { /* bell is best-effort; never break the page */ }
            }
            async function loadNotes() {
                try {
                    var r = await fetch(urls.notes + '?take=8'); if (!r.ok) return;
                    var list = await r.json();
                    document.getElementById('navBellList').innerHTML = (list && list.length)
                        ? list.map(function (x) {
                            return '<div class="nb-item"><div class="nb-item-title">' + esc(x.title) + '</div><div class="nb-item-msg" title="' + esc(x.message || '') + '">' + esc(x.message || '') + '</div></div>';
                        }).join('')
                        : '<div class="nb-empty">No notifications</div>';
                } catch (e) { }
            }
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                var open = panel.style.display === 'block';
                panel.style.display = open ? 'none' : 'block';
                if (!open) { refresh(); loadNotes(); }
            });
            document.addEventListener('click', function (e) { if (!wrap.contains(e.target)) panel.style.display = 'none'; });
            refresh();
            setInterval(refresh, 60000);
        })();
    </script>

    <script nonce='@Context.Items["CspNonce"]'>
        // 📄 Reports badge: async report queue (UserReqReports). Polls a lightweight
        // summary; polls faster while a report is generating so "Ready" appears quickly.
        (function () {
            var wrap = document.getElementById('rptWrap');
            if (!wrap) return;
            var btn = document.getElementById('rptBtn'),
                panel = document.getElementById('rptPanel'),
                badge = document.getElementById('rptBadge'),
                list = document.getElementById('rptList');
            var summaryUrl = '@Url.Action("Summary", "UserReports")',
                deleteUrl = '@Url.Action("Delete", "UserReports")',
                retryUrl = '@Url.Action("Retry", "UserReports")',
                cancelUrl = '@Url.Action("Cancel", "UserReports")';
            // BUSY_MS was 10s — progress % looked frozen until a long wait or hard refresh.
            var IDLE_MS = 30000, BUSY_MS = 2500, timer = null;

            function esc(v) { return (v == null ? '' : String(v)).replace(/[&<>"']/g, function (m) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m]; }); }
            function afToken() {
                var i = document.querySelector('#lrnReportsAf input[name="__RequestVerificationToken"]');
                return i ? i.value : '';
            }
            function statusChip(s, progress) {
                var cls = s === 'Ready' ? 'rpt-status-ready'
                        : s === 'Processing' ? 'rpt-status-processing'
                        : s === 'Failed' ? 'rpt-status-failed' : 'rpt-status-queued';
                if (s === 'Processing') {
                    var known = progress != null;
                    var pct = known ? Math.max(0, Math.min(100, Number(progress))) : null;
                    return '<div class="rpt-progress" role="progressbar"'
                        + (known ? ' aria-valuenow="' + pct + '" aria-valuemin="0" aria-valuemax="100"' : '')
                        + '><div class="rpt-progress-label"><span>Processing</span><span>'
                        + (known ? pct + '%' : '…')
                        + '</span></div><div class="rpt-progress-track"><div class="rpt-progress-bar'
                        + (known ? '' : ' indeterminate')
                        + '" style="' + (known ? 'width:' + pct + '%' : '') + '"></div></div></div>';
                }
                var label = s;
                return '<span class="rpt-status ' + cls + '">' + esc(label) + '</span>';
            }
            var TYPE_LABELS = {
                PayerPolicyValidation: 'Payer Policy Validation',
                PredictionAnalysis: 'Prediction Analysis',
                ForecastingSummary: 'Forecasting Summary',
                CollectionReport: 'Collection Report',
                ClaimLevelDetails: 'Claim Level Details',
                LineLevelDetails: 'Line Level Details',
                ExecutiveSummary: 'Executive Summary',
                ProductionReport: 'Production Report',
                RevenueDashboard: 'Revenue Dashboard',
                ClinicSummary: 'Clinic Summary',
                SalesRepSummary: 'Sales Rep Summary',
                LisSummary: 'LIS Summary'
            };
            var TYPE_COLORS = ['rpt-type-c1', 'rpt-type-c2', 'rpt-type-c3', 'rpt-type-c4', 'rpt-type-c5', 'rpt-type-c6'];
            function typeLabel(t) {
                return TYPE_LABELS[t] || String(t || '').replace(/([a-z])([A-Z])/g, '$1 $2');
            }
            function renderTypes(byType) {
                var typesEl = document.getElementById('rptTypes');
                if (!typesEl) return;
                var items = byType || [];
                typesEl.innerHTML = items.length ? items.map(function (t, i) {
                    return '<span class="rpt-type-pill ' + TYPE_COLORS[i % TYPE_COLORS.length] + '">'
                        + '<b>' + (t.count || 0) + '</b>' + esc(typeLabel(t.type)) + '</span>';
                }).join('') : '';
                typesEl.style.display = items.length ? '' : 'none';
            }
            function render(data) {
                var ready = data.ready || 0, busy = data.inProgress || 0;
                var count = ready + busy;
                badge.textContent = count > 99 ? '99+' : String(count);
                badge.style.display = count > 0 ? '' : 'none';
                badge.classList.toggle('rpt-ready', ready > 0);
                renderTypes(data.byType);

                var rows = data.reports || [];
                list.innerHTML = rows.length ? rows.map(function (r) {
                    var sub = esc(r.lab) + ' · ' + esc(r.requestedDate)
                            + (r.rowCount ? ' · ' + Number(r.rowCount).toLocaleString() + ' rows' : '')
                            + (r.fileSizeMb ? ' · ' + r.fileSizeMb + ' MB' : '')
                            + (r.expiryDate ? ' · expires ' + esc(r.expiryDate) : '');
                    var actions = '';
                    if (r.downloadUrl) actions += '<a class="rpt-dl" href="' + r.downloadUrl + '" title="Download"><i class="bi bi-download"></i></a>';
                    if (r.status === 'Failed') actions += '<button class="rpt-retry" data-lab="' + esc(r.lab) + '" data-id="' + r.reportId + '" title="Retry"><i class="bi bi-arrow-clockwise"></i></button>';
                    if (r.status === 'Queued' || r.status === 'Processing')
                        actions += '<button class="rpt-cancel" data-lab="' + esc(r.lab) + '" data-id="' + r.reportId + '" title="Cancel / kill report"><i class="bi bi-x-octagon"></i></button>';
                    if (r.status !== 'Queued' && r.status !== 'Processing')
                        actions += '<button class="rpt-del" data-lab="' + esc(r.lab) + '" data-id="' + r.reportId + '" title="Delete"><i class="bi bi-trash"></i></button>';
                    var err = (r.status === 'Failed' && r.error)
                        ? '<div class="rpt-item-err"><i class="bi bi-exclamation-triangle-fill me-1"></i>' + esc(r.error) + '</div>'
                        : '';
                    return '<div class="rpt-item">'
                        + '<div class="rpt-item-main">'
                        + '<div class="rpt-item-title" title="' + esc(r.fileName || '') + '">' + esc(r.reportType) + '</div>'
                        + '<div class="rpt-item-sub">' + sub + '</div>'
                        + err
                        + '</div>'
                        + statusChip(r.status, r.progress)
                        + '<div class="rpt-actions">' + actions + '</div>'
                        + '</div>';
                }).join('') : '<div class="nb-empty">No reports yet. Use Download Report on a report page.</div>';

                schedule(busy > 0 ? BUSY_MS : IDLE_MS);
            }
            async function refresh() {
                try {
                    var r = await fetch(summaryUrl); if (!r.ok) { schedule(IDLE_MS); return; }
                    render(await r.json());
                } catch (e) { schedule(IDLE_MS); }
            }
            function schedule(ms) {
                if (timer) clearTimeout(timer);
                timer = setTimeout(refresh, ms);
            }
            async function post(url, lab, id) {
                var body = new FormData();
                body.append('lab', lab); body.append('id', id);
                body.append('__RequestVerificationToken', afToken());
                try { await fetch(url, { method: 'POST', body: body }); } catch (e) { }
                refresh();
            }
            list.addEventListener('click', function (e) {
                var b = e.target.closest('button');
                if (!b) return;
                if (b.classList.contains('rpt-del')) post(deleteUrl, b.getAttribute('data-lab'), b.getAttribute('data-id'));
                if (b.classList.contains('rpt-retry')) post(retryUrl, b.getAttribute('data-lab'), b.getAttribute('data-id'));
                if (b.classList.contains('rpt-cancel')) {
                    if (confirm('Cancel this report? Generation will stop.'))
                        post(cancelUrl, b.getAttribute('data-lab'), b.getAttribute('data-id'));
                }
            });
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                var open = panel.style.display === 'block';
                panel.style.display = open ? 'none' : 'block';
                if (!open) refresh();
            });
            document.addEventListener('click', function (e) { if (!wrap.contains(e.target)) panel.style.display = 'none'; });
            window.lrnReportsBadgeRefresh = refresh;
            refresh();
        })();
    </script>

    <script nonce='@Context.Items["CspNonce"]'>
        // Show the loader whenever a lab-selector dropdown changes.
        // Any <select data-lab-selector> on the page triggers this.
        document.addEventListener('change', function (e) {
        const sel = e.target;
        if (!sel.matches('[data-lab-selector]')) return;
        const labName = sel.options[sel.selectedIndex]?.text ?? 'selected lab';
        const text = document.getElementById('lmd-loader-text');
        if (text) text.textContent = 'Loading ' + labName + '…';
        document.getElementById('lmd-loader').classList.add('active');
        });

        // Also show loader for Apply-Filter form submissions that contain a lab param.
        document.addEventListener('submit', function (e) {
        const form = e.target;
        if (!form.matches('[data-lab-form]')) return;
        const labInput = form.querySelector('[name="lab"]');
        const labName = labInput
        ? (labInput.tagName === 'SELECT'
        ? labInput.options[labInput.selectedIndex]?.text
        : labInput.value)
        : '';
        const text = document.getElementById('lmd-loader-text');
        if (text) text.textContent = labName ? 'Loading ' + labName + '…' : 'Loading…';
        document.getElementById('lmd-loader').classList.add('active');
        });

        // Hide loader when navigating back (bfcache restore).
        window.addEventListener('pageshow', function (e) {
        if (e.persisted) {
        document.getElementById('lmd-loader').classList.remove('active');
        }
        });

        // Show loader when clicking a tagged navigation link (e.g. Collection Summary).
        document.addEventListener('click', function (e) {
        const a = e.target.closest('a[data-lab-link]');
        if (!a) return;
        // Allow modifier-clicks (open in new tab) without showing loader.
        if (e.ctrlKey || e.metaKey || e.shiftKey || e.button === 1) return;
        const label = a.getAttribute('data-lab-link') || 'page';
        const text = document.getElementById('lmd-loader-text');
        if (text) text.textContent = 'Loading ' + label + '…';
        document.getElementById('lmd-loader').classList.add('active');
        });

        // Reusable Excel download with loading overlay.
        // Shows the full-screen loader, fetches the file as a blob,
        // triggers a browser download, then hides the loader.
        window.lmdExcelDownload = function (url) {
        var loader = document.getElementById('lmd-loader');
        var text = document.getElementById('lmd-loader-text');
        if (text) text.textContent = 'Generating Excel\u2026';
        if (loader) loader.classList.add('active');

        fetch(url, { credentials: 'same-origin' })
        .then(function (resp) {
        if (!resp.ok) throw new Error('Export failed (' + resp.status + ')');
        var cd = resp.headers.get('content-disposition') || '';
        var match = cd.match(/filename[^;=\n]*=(['"]?)([^'"\n;]+)\1/);
        var filename = match ? match[2] : 'export.xlsx';
        return resp.blob().then(function (blob) { return { blob: blob, filename: filename }; });
        })
        .then(function (result) {
        var a = document.createElement('a');
        a.href = URL.createObjectURL(result.blob);
        a.download = result.filename;
        document.body.appendChild(a);
        a.click();
        setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 100);
        })
        .catch(function (err) {
        console.error('Excel download error:', err);
        if (window.lrnShowReportAlert) {
        window.lrnShowReportAlert('error', {
        title: 'Export failed',
        message: 'Excel export failed. Please try again.'
        });
        }
        })
        .finally(function () {
        if (loader) loader.classList.remove('active');
        });
        };

        // ── Navbar lab selector ─────────────────────────────────────
        (function () {
        var btn = document.getElementById('navLabBtn');
        var panel = document.getElementById('navLabPanel');
        var search = document.getElementById('navLabSearch');
        var list = document.getElementById('navLabList');
        if (!btn || !panel) return;

        btn.addEventListener('click', function (e) {
        e.stopPropagation();
        panel.classList.toggle('open');
        if (panel.classList.contains('open') && search) {
        search.value = '';
        search.focus();
        list.querySelectorAll('a').forEach(function (a) { a.classList.remove('nav-lab-hidden'); });
        }
        });

        if (search) {
        search.addEventListener('input', function () {
        var q = this.value.toLowerCase();
        list.querySelectorAll('a').forEach(function (a) {
        a.classList.toggle('nav-lab-hidden', q.length > 0 && a.textContent.toLowerCase().indexOf(q) === -1);
        });
        });
        search.addEventListener('click', function (e) { e.stopPropagation(); });
        }

        panel.addEventListener('click', function (e) { e.stopPropagation(); });

        // When a lab is clicked, navigate to the current page with the new lab
        list.addEventListener('click', function (e) {
        var a = e.target.closest('a[data-lab]');
        if (!a) return;
        e.preventDefault();
        var newLab = a.getAttribute('data-lab');
        // Navigate to current path with only the lab param (clear filters)
        var url = new URL(window.location.pathname, window.location.origin);
        url.searchParams.set('lab', newLab);
        // Show loader
        var text = document.getElementById('lmd-loader-text');
        if (text) text.textContent = 'Loading ' + newLab + '\u2026';
        document.getElementById('lmd-loader').classList.add('active');
        window.location.href = url.toString();
        });

        // Close on outside click
        document.addEventListener('click', function () {
        panel.classList.remove('open');
        });
        })();
    </script>

    <script nonce='@Context.Items["CspNonce"]'>
        (function () {
        const heartbeatUrl = '@Url.Action("Heartbeat", "Usage")';
        if (!heartbeatUrl || !window.fetch || !window.sessionStorage) {
        return;
        }

        const tabStorageKey = 'lmd.usage.tabid';
        let tabId = sessionStorage.getItem(tabStorageKey);
        if (!tabId) {
        tabId = (window.crypto && window.crypto.randomUUID)
        ? window.crypto.randomUUID()
        : ('tab-' + Math.random().toString(36).slice(2) + Date.now().toString(36));
        sessionStorage.setItem(tabStorageKey, tabId);
        }

        let lastActionAt = Date.now();
        let geo = null;
        let lastSent = 0;
        let pendingLocationSend = false;

        function pageTitle() {
        return (document.title || '').replace(/\s*-\s*Lab Revenue Intelligence\s*$/i, '').trim() || 'Unknown';
        }

        function currentIdleSeconds() {
        return Math.max(0, Math.floor((Date.now() - lastActionAt) / 1000));
        }

        function markActivity() {
        lastActionAt = Date.now();
        }

        ['click', 'keydown', 'mousemove', 'scroll', 'touchstart', 'focus'].forEach(function (evt) {
        window.addEventListener(evt, markActivity, { passive: true });
        });

        document.addEventListener('visibilitychange', function () {
        if (!document.hidden) {
        markActivity();
        }
        sendHeartbeat(true);
        });

        function buildPayload() {
        return {
        tabId: tabId,
        pageName: pageTitle(),
        path: window.location.pathname,
        queryString: window.location.search || '',
        idleSeconds: currentIdleSeconds(),
        latitude: geo ? geo.latitude : null,
        longitude: geo ? geo.longitude : null,
        locationText: geo ? geo.locationText : null
        };
        }

        function sendHeartbeat(force) {
        const now = Date.now();
        if (!force && (now - lastSent) < 12000) {
        return;
        }
        lastSent = now;

        const body = JSON.stringify(buildPayload());
        fetch(heartbeatUrl, {
        method: 'POST',
        headers: {
        'Content-Type': 'application/json',
        'X-Lmd-TabId': tabId
        },
        body: body,
        credentials: 'same-origin',
        keepalive: true
        }).catch(function () { });
        }

        window.addEventListener('pagehide', function () {
        const body = JSON.stringify(buildPayload());
        if (navigator.sendBeacon) {
        const blob = new Blob([body], { type: 'application/json' });
        navigator.sendBeacon(heartbeatUrl, blob);
        } else {
        sendHeartbeat(true);
        }
        });

        if (navigator.permissions && navigator.geolocation) {
        navigator.permissions.query({ name: 'geolocation' }).then(function (result) {
        if (result.state === 'granted') {
        navigator.geolocation.getCurrentPosition(function (position) {
        geo = {
        latitude: Number(position.coords.latitude.toFixed(6)),
        longitude: Number(position.coords.longitude.toFixed(6)),
        locationText: Number(position.coords.latitude).toFixed(6) + ', ' + Number(position.coords.longitude).toFixed(6)
        };
        pendingLocationSend = true;
        sendHeartbeat(true);
        }, function () { }, { enableHighAccuracy: false, maximumAge: 600000, timeout: 8000 });
        }
        }).catch(function () { });
        }

        sendHeartbeat(true);
        window.setInterval(function () {
        sendHeartbeat(false);
        }, 15000);
        })();
    </script>

    <div id="lrnReportToast" class="lrn-report-toast" role="status" aria-live="polite" aria-atomic="true">
        <div class="lrn-report-toast-inner">
            <div class="lrn-report-toast-badge"><i class="bi bi-check-circle-fill"></i></div>
            <div class="lrn-report-toast-content">
                <div class="lrn-report-toast-title">Report queued</div>
                <div class="lrn-report-toast-message"></div>
                <div class="lrn-report-toast-actions">
                    <button type="button" class="lrn-report-toast-action primary" id="lrnReportToastOpen">
                        Open Reports
                    </button>
                    <button type="button" class="lrn-report-toast-action ghost" id="lrnReportToastDismiss">
                        Dismiss
                    </button>
                </div>
            </div>
            <button type="button" class="lrn-report-toast-close" id="lrnReportToastClose" aria-label="Dismiss">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="lrn-report-toast-progress"><div class="lrn-report-toast-progress-bar"></div></div>
    </div>

    <script nonce='@Context.Items["CspNonce"]'>
        (function () {
            var toast = document.getElementById('lrnReportToast');
            if (!toast) return;

            var badgeEl = toast.querySelector('.lrn-report-toast-badge i');
            var titleEl = toast.querySelector('.lrn-report-toast-title');
            var messageEl = toast.querySelector('.lrn-report-toast-message');
            var progressBar = toast.querySelector('.lrn-report-toast-progress-bar');
            var openBtn = document.getElementById('lrnReportToastOpen');
            var dismissBtn = document.getElementById('lrnReportToastDismiss');
            var hideTimer = null;
            var progressTimer = null;

            var defaults = {
                success: {
                    title: 'Report queued',
                    message: 'Your report is now in the queue. You can keep working while we generate it, then download it from <strong>Reports</strong> <span class="lrn-report-toast-chip"><i class="bi bi-file-earmark-arrow-down"></i></span> in the top right.',
                    icon: 'bi-check-circle-fill',
                    pulse: true
                },
                info: {
                    title: 'Generation already underway',
                    message: 'This same report is already running for your current filters. No need to start it again; it will appear in <strong>Reports</strong> <span class="lrn-report-toast-chip"><i class="bi bi-file-earmark-arrow-down"></i></span> as soon as it is ready.',
                    icon: 'bi-hourglass-split',
                    pulse: true
                },
                error: {
                    title: 'Unable to start report',
                    message: 'We could not start the report right now. Please try again in a moment. If the issue persists, refresh the page or check your connection.',
                    icon: 'bi-exclamation-triangle-fill',
                    pulse: false
                }
            };

            function hideReportAlert() {
                toast.classList.remove('is-visible');
                if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
                if (progressTimer) { clearInterval(progressTimer); progressTimer = null; }
            }

            function pulseReportsBtn() {
                var rptBtn = document.getElementById('rptBtn');
                if (!rptBtn) return;
                rptBtn.classList.remove('lrn-rpt-attention');
                void rptBtn.offsetWidth;
                rptBtn.classList.add('lrn-rpt-attention');
                setTimeout(function () { rptBtn.classList.remove('lrn-rpt-attention'); }, 4000);
            }

            function openReportsPanel() {
                var wrap = document.getElementById('rptWrap');
                var btn = document.getElementById('rptBtn');
                var panel = document.getElementById('rptPanel');
                if (!wrap || !btn || !panel) return;
                panel.style.display = 'block';
                if (typeof window.lrnReportsBadgeRefresh === 'function') {
                    window.lrnReportsBadgeRefresh();
                }
                hideReportAlert();
            }

            function startProgress(timeoutMs) {
                if (!progressBar) return;
                var start = Date.now();
                progressBar.style.transition = 'none';
                progressBar.style.transform = 'scaleX(1)';
                if (progressTimer) clearInterval(progressTimer);
                progressTimer = setInterval(function () {
                    var elapsed = Date.now() - start;
                    var pct = Math.max(0, 1 - (elapsed / timeoutMs));
                    progressBar.style.transform = 'scaleX(' + pct + ')';
                    if (pct <= 0) {
                        clearInterval(progressTimer);
                        progressTimer = null;
                    }
                }, 50);
            }

            window.lrnShowReportAlert = function (type, opts) {
                opts = opts || {};
                type = type || 'success';
                var preset = defaults[type] || defaults.success;

                toast.classList.remove('is-success', 'is-info', 'is-error');
                toast.classList.add('is-' + type);

                if (badgeEl) badgeEl.className = 'bi ' + (opts.icon || preset.icon);
                if (titleEl) titleEl.textContent = opts.title || preset.title;
                if (messageEl) {
                    if (opts.message) {
                        messageEl.textContent = opts.message;
                    } else {
                        messageEl.innerHTML = preset.message;
                    }
                }
                if (openBtn) openBtn.style.display = type === 'error' ? 'none' : '';

                var timeoutMs = opts.timeoutMs != null ? opts.timeoutMs : 9000;
                toast.classList.add('is-visible');
                startProgress(timeoutMs);

                if (hideTimer) clearTimeout(hideTimer);
                hideTimer = setTimeout(hideReportAlert, timeoutMs);

                if (preset.pulse && opts.pulse !== false) pulseReportsBtn();
            };

            window.lrnHideReportAlert = hideReportAlert;

            var closeBtn = document.getElementById('lrnReportToastClose');
            if (closeBtn) closeBtn.addEventListener('click', hideReportAlert);
            if (dismissBtn) dismissBtn.addEventListener('click', hideReportAlert);
            if (openBtn) openBtn.addEventListener('click', function () {
                hideReportAlert();
                // Navigate to the full "My Reports" (ViewReport) page rather than
                // only opening the top-right flyout panel.
                window.location.href = '@Url.Action("Index", "UserReports")';
            });
        })();
    </script>

    @await Html.PartialAsync("_HelpBotWidget")
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
