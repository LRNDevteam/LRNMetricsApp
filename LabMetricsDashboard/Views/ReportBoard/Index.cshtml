@model LabMetricsDashboard.Models.ReportBoardViewModel
@using LabMetricsDashboard.Models
@{
    ViewData["Title"] = "Report Control Board";

    // Same lab colour sequence as the original Home tiles, so a lab keeps its identity across pages.
    string[] palette =
    [
        "#1565c0", "#6a1b9a", "#1b3a5c", "#b71c1c", "#1e88e5", "#880e4f",
        "#e65100", "#4527a0", "#0277bd", "#42a5f5", "#4e342e", "#37474f"
    ];

    string BandClass(string group) => group switch
    {
        LabMetricsDashboard.Services.ReportCatalog.GroupSource => "b1",
        LabMetricsDashboard.Services.ReportCatalog.GroupSummary => "b2",
        _ => "b3"
    };

    // Colour states the RUN OUTCOME, never whether the current user can click through:
    // completed is green even when the report cannot be opened (unmapped lab, feature off,
    // role blocked). Those cells simply don't lift on hover, and the tooltip says why.
    // Only "not produced for this lab" is greyed out.
    string CellClass(LabReportStatus cell) => cell.Status switch
    {
        ReportRunStatus.Success => "ok",
        ReportRunStatus.Failed => "fail",
        ReportRunStatus.Pending => "running",
        ReportRunStatus.Overdue => "late",
        _ => "none"
    };

    /// <summary>Pill styling for the card list — same states as the matrix cells.</summary>
    string PillClass(LabReportStatus cell) => cell.Status switch
    {
        ReportRunStatus.Success => "done",
        ReportRunStatus.Failed => "bad",
        ReportRunStatus.Pending => "running",
        ReportRunStatus.Overdue => "late",
        _ => "off"
    };

    string StatusLabel(LabReportStatus cell) => cell.Status switch
    {
        ReportRunStatus.Success => cell.IsLinkable ? "Ready" : "Ready (blocked)",
        ReportRunStatus.Failed => "Failed",
        ReportRunStatus.Pending => "In progress",
        ReportRunStatus.Overdue => "Overdue",
        _ => "Not produced"
    };

    // Plain-English completion state — this is what every tooltip leads with, so the board
    // answers "did this report complete?" without the reader decoding a colour.
    string StatusWord(LabReportStatus cell) => cell.Status switch
    {
        ReportRunStatus.Success => cell.IsLinkable ? "Completed" : "Completed (cannot be opened from here)",
        ReportRunStatus.Failed => "Not completed (failed)",
        ReportRunStatus.Pending => "In progress — not yet produced for this run",
        ReportRunStatus.Overdue => "Overdue — still not produced more than a day after the source data landed",
        // Never marked as a failure: this report is simply not part of the lab's run.
        _ => "Not produced for this lab"
    };

    /// <summary>What clicking does, appended to the tooltip so the cell advertises its own action.</summary>
    string ActionHint(LabReportStatus cell) => cell.Status switch
    {
        ReportRunStatus.Success when cell.IsLinkable => " · click to open the report",
        ReportRunStatus.Failed => " · click to download the error log (Excel)",
        _ => string.Empty
    };

    /// <summary>
    /// The blocked reason, but only when it adds something <see cref="StatusWord"/> has not
    /// already said. For Failed / Pending / NotConfigured the controller's reason is a
    /// restatement ("Not produced for this lab." under "Not produced for this lab"), which is
    /// what made tooltips read the same sentence twice. Only a COMPLETED report has a reason
    /// worth showing — it explains why a finished report still cannot be opened.
    /// </summary>
    string ExtraReason(LabReportStatus cell)
    {
        if (cell.Status != ReportRunStatus.Success || string.IsNullOrWhiteSpace(cell.BlockedReason))
            return string.Empty;

        // Belt and braces: never repeat the status sentence even if the wording converges.
        var reason = cell.BlockedReason.TrimEnd('.', ' ');
        return reason.Equals(StatusWord(cell).TrimEnd('.', ' '), StringComparison.OrdinalIgnoreCase)
            ? string.Empty
            : $" · {reason}";
    }

    string Tooltip(LabReportStatus cell) =>
        $"{cell.Catalog.DisplayName} — {StatusWord(cell)}" + ExtraReason(cell) + ActionHint(cell);

    // Corner badge stamped on the report's own icon: tick = completed, cross = did not
    // complete, dash = not part of this lab's run.
    // Gear = the run is still working on it; warning triangle = it has stalled. Neither is a
    // cross: nothing has failed, the report simply is not there yet.
    string BadgeIcon(LabReportStatus cell) => cell.Status switch
    {
        ReportRunStatus.Success => "bi-check-lg",
        ReportRunStatus.Failed => "bi-x-lg",
        ReportRunStatus.Pending => "bi-gear-fill",
        ReportRunStatus.Overdue => "bi-exclamation-triangle-fill",
        _ => "bi-dash-lg"
    };

    string BadgeClass(LabReportStatus cell) => cell.Status switch
    {
        ReportRunStatus.Success => "bg-ok",
        ReportRunStatus.Failed => "bg-fail",
        ReportRunStatus.Pending => "bg-running",
        ReportRunStatus.Overdue => "bg-late",
        _ => "bg-none"
    };

    string DotClass(LabReportStatus cell) => cell.Status switch
    {
        ReportRunStatus.Success => "d-ok",
        ReportRunStatus.Failed => "d-fail",
        ReportRunStatus.Pending => "d-wait",
        _ => "d-none"
    };

    /// <summary>How many labs completed this report — shown under each column header.</summary>
    int CompletedFor(ReportCatalogEntry column) => Model.Rows.Count(r =>
        r.Reports.Any(x => x.Catalog.TrackerColumn == column.TrackerColumn
                           && x.Status == ReportRunStatus.Success));

    // Relative "run timeline" label for each lab's latest run (e.g. "6 d ago").
    string RelativeTime(DateTime? when)
    {
        if (when is null) return "no run yet";
        var span = DateTime.Now - when.Value;
        if (span.TotalSeconds < 0) return when.Value.ToString("dd MMM yyyy");
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} min ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} h ago";
        if (span.TotalDays < 30) return $"{(int)span.TotalDays} d ago";
        return when.Value.ToString("dd MMM yyyy");
    }
}

<style>
    .rcb { --ink:#0a1628; --ink-2:#1e293b; --muted:#64748b; --faint:#94a3b8;
           --line:#e2e8f0; --line-soft:#eef2f7;
           --ok:#10b981; --ok-bg:#ecfdf5; --ok-line:#a7f3d0;
           --fail:#ef4444; --fail-bg:#fef2f2; --fail-line:#fecaca;
           --wait:#f59e0b; --wait-bg:#fffbeb; --wait-line:#fde68a;
           --running:#2563eb; --running-bg:#eff6ff; --running-line:#bfdbfe;
           --late:#ea580c; --late-bg:#fff7ed; --late-line:#fed7aa;
           --none:#cbd5e1; --none-bg:#f8fafc;
           --mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,monospace; }

    /* hero */
    .rcb-hero { position:relative; border-radius:16px; padding:1.05rem 1.5rem; margin-bottom:1.1rem; overflow:hidden;
        background:linear-gradient(120deg,#0a1628 0%,#0e3460 40%,#0d5c74 75%,#0a7a74 100%);
        box-shadow:0 12px 40px rgba(7,24,39,.22),0 0 0 1px rgba(255,255,255,.07);
        display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap; }
    .rcb-hero::after { content:''; position:absolute; inset:0; opacity:.08; pointer-events:none;
        background-image:linear-gradient(rgba(255,255,255,.18) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.18) 1px,transparent 1px);
        background-size:24px 24px; mask-image:radial-gradient(circle at 20% 30%,black 30%,transparent 70%); }
    .rcb-hero h1 { margin:0; font-size:1.2rem; font-weight:800; color:#fff; display:flex; align-items:center; gap:.55rem; }
    .rcb-hero .ic { width:30px; height:30px; border-radius:9px; background:rgba(255,255,255,.14); border:1.5px solid rgba(255,255,255,.22); display:inline-flex; align-items:center; justify-content:center; font-size:.9rem; }
    .rcb-hero p { margin:.2rem 0 0 2.65rem; font-size:.76rem; color:rgba(255,255,255,.62); font-weight:500; }
    .rcb-kpis { display:flex; gap:.5rem; position:relative; z-index:1; flex-wrap:wrap; }
    .rcb-kpi { background:rgba(255,255,255,.11); border:1.5px solid rgba(255,255,255,.2); border-radius:12px; padding:.45rem .8rem; min-width:82px; }
    .rcb-kpi b { display:block; font-size:1.15rem; font-weight:800; color:#fff; line-height:1.1; }
    .rcb-kpi span { font-size:.62rem; text-transform:uppercase; letter-spacing:.08em; color:rgba(255,255,255,.6); font-weight:700; }
    .rcb-kpi.bad b { color:#fca5a5; }
    .rcb-kpi.late b { color:#fdba74; }

    /* Stalled-run banner */
    .rcb-warncard { position:relative; background:var(--late-bg); border:1px solid var(--late-line); border-left:4px solid var(--late);
        border-radius:14px; padding:.85rem 2.6rem .85rem 1.1rem; margin-bottom:1.1rem; }
    .rcb-warncard h2 { font-size:.9rem; font-weight:800; color:#9a3412; margin:0 0 .35rem; display:flex; align-items:center; gap:.45rem; }
    .rcb-warn-x { position:absolute; top:.6rem; right:.7rem; width:26px; height:26px; border-radius:8px;
        border:1px solid var(--late-line); background:#fff; color:#9a3412; cursor:pointer; font-size:.95rem;
        line-height:1; display:flex; align-items:center; justify-content:center; padding:0; }
    .rcb-warn-x:hover { background:var(--late); border-color:var(--late); color:#fff; }
    .rcb-warncard ul { margin:0; padding-left:1.1rem; font-size:.8rem; color:var(--ink-2); }
    .rcb-warncard li { margin-bottom:.15rem; }
    .rcb-warncard .lab { font-weight:700; }
    .rcb-warncard .rp { color:#9a3412; }

    /* toolbar */
    .rcb-toolbar { display:flex; align-items:center; gap:.6rem; flex-wrap:wrap; margin-bottom:.9rem; }
    .rcb-seg { display:inline-flex; background:#fff; border:1px solid var(--line); border-radius:11px; padding:3px; gap:2px; box-shadow:0 1px 2px rgba(15,23,42,.05); }
    .rcb-seg a { border:0; background:transparent; padding:.4rem .85rem; border-radius:8px; font-size:.79rem; font-weight:700; color:var(--muted); text-decoration:none; }
    .rcb-seg a[aria-pressed="true"] { background:#0d6efd; color:#fff; }
    .rcb-search { flex:1; min-width:200px; }
    .rcb-search input { width:100%; border:1px solid var(--line); border-radius:11px; padding:.55rem .8rem; font-size:.85rem; background:#fff; }
    .rcb-chips { display:flex; gap:.35rem; }
    .rcb-chip { border:1px solid var(--line); background:#fff; border-radius:20px; padding:.4rem .8rem; font-size:.76rem; font-weight:700; color:var(--muted); cursor:pointer; font-family:inherit; }
    .rcb-chip[aria-pressed="true"] { background:var(--ink); color:#fff; border-color:var(--ink); }
    .rcb-chip.danger[aria-pressed="true"] { background:var(--fail); border-color:var(--fail); }
    .rcb input:focus-visible, .rcb button:focus-visible, .rcb a:focus-visible, .rcb [tabindex]:focus-visible { outline:2px solid #0d6efd; outline-offset:2px; }

    /* matrix */
    .rcb-board { background:#fff; border:1px solid var(--line); border-radius:16px; overflow:hidden; box-shadow:0 6px 24px rgba(15,23,42,.06); }
    .rcb-scroll { overflow:auto; max-height:74vh; }
    .rcb-board table { border-collapse:separate; border-spacing:0; width:100%; font-size:.78rem; margin:0; }
    .rcb-board thead th { position:sticky; top:0; z-index:3; background:#f8fafc; border-bottom:1px solid var(--line);
        padding:.5rem .4rem; font-weight:700; color:var(--muted); text-align:center; white-space:nowrap;
        font-size:.65rem; text-transform:uppercase; letter-spacing:.045em; }
    .rcb-board thead tr.band th { top:0; font-size:.6rem; letter-spacing:.12em; color:#fff; padding:.3rem .4rem; }
    .rcb-board thead tr.cols th { top:23px; }
    .rcb-board .band .b1 { background:#0e3460; } .rcb-board .band .b2 { background:#0d5c74; }
    .rcb-board .band .b3 { background:#0a7a74; } .rcb-board .band .b0 { background:#0a1628; }
    /* Explicit width, not min-width: table-layout:fixed ignores min-width when sizing columns. */
    .rcb-board th.lab-h, .rcb-board td.lab-c { position:sticky; left:0; z-index:2; background:#fff; text-align:left; width:270px; min-width:270px; border-right:1px solid var(--line); }
    .rcb-board thead th.lab-h { z-index:5; background:#f8fafc; }
    .rcb-board thead tr.band th.lab-h { background:#0a1628; }
    .rcb-board tbody tr:hover td { background:#f8fbff; }
    .rcb-board tbody tr:hover td.lab-c { background:#f1f7ff; }
    /* Padding leaves room for the status badge that overhangs each cell on two sides. */
    .rcb-board td { border-bottom:1px solid var(--line-soft); padding:.55rem .25rem; text-align:center; vertical-align:middle; }

    /* Every report column is the SAME width, declared on a <colgroup>. Left to size themselves,
       "FORECAST" and "COLLECT" made their columns far wider than "LIS" or "LINE", so the icons
       below sat at uneven spacings and no longer lined up with their headers.
       The widths MUST come from <col>: with table-layout:fixed the browser otherwise takes them
       from the first row, which here is the band row of colspan cells, and divides those across
       the columns they span — which skews every group differently. */
    .rcb-board table { table-layout:fixed; width:auto; min-width:100%; }
    .rcb-board col.rcb-lab-col { width:270px; }
    .rcb-board col.rcb-rep-col { width:64px; }
    .rcb-board thead tr.cols th { padding-left:.15rem; padding-right:.15rem; }
    .rcb-board td.lab-c { padding:.6rem .8rem; }
    .rcb-labrow { display:flex; align-items:center; gap:.6rem; cursor:pointer; }
    .rcb-av { width:32px; height:32px; border-radius:9px; color:#fff; font-weight:800; display:flex; align-items:center; justify-content:center; font-size:.85rem; flex:0 0 auto; }
    .rcb-labname { font-weight:700; color:var(--ink); font-size:.85rem; line-height:1.2; }
    .rcb-labmeta { font-size:.66rem; color:var(--faint); font-family:var(--mono); margin-top:1px; }
    .rcb-labweek { font-size:.64rem; color:#0d6efd; background:#eff6ff; border-radius:5px; padding:1px 5px; display:inline-block; margin-top:2px; font-weight:700; }
    .rcb-unmapped { font-size:.6rem; color:#b45309; background:#fffbeb; border:1px solid var(--wait-line); border-radius:5px; padding:0 4px; margin-left:.3rem; font-weight:700; }

    /* Column header carries the report's OWN icon, so every cell beneath it is visibly the
       same report as the card list and the drawer use. */
    .rcb-colhead { display:flex; flex-direction:column; align-items:center; gap:1px; line-height:1.15; }
    .rcb-colhead > i { font-size:.95rem; color:var(--ink-2); }
    .rcb-colhead .lbl { font-size:.63rem; }
    .rcb-colhead .cnt { font-size:.58rem; font-weight:700; color:var(--faint); font-family:var(--mono); letter-spacing:0; text-transform:none; }

    .rcb-cell { position:relative; display:inline-flex; align-items:center; justify-content:center; width:32px; height:32px; border-radius:9px; font-size:.9rem; text-decoration:none; border:1px solid transparent; transition:transform .12s ease, box-shadow .12s ease; }
    .rcb-cell.ok { background:var(--ok-bg); border-color:var(--ok-line); color:#047857; }
    .rcb-cell.ok:hover { transform:translateY(-2px); box-shadow:0 4px 10px rgba(16,185,129,.28); }
    .rcb-cell.fail { background:var(--fail-bg); border-color:var(--fail-line); color:#b91c1c; }
    .rcb-cell.fail:hover { transform:translateY(-2px); box-shadow:0 4px 10px rgba(239,68,68,.25); }
    .rcb-cell.wait { background:var(--wait-bg); border-color:var(--wait-line); color:#b45309; }
    /* In progress — blue, and the gear turns so it reads as "working", not "broken". */
    .rcb-cell.running { background:var(--running-bg); border-color:var(--running-line); color:#1d4ed8; }
    .rcb-cell.late { background:var(--late-bg); border-color:var(--late-line); color:#c2410c; }
    .rcb-cell.none { background:var(--none-bg); border-color:#e2e8f0; color:var(--none); }
    /* Completed but not openable — keeps its green "done" colour, loses the click affordance. */
    .rcb-cell.blocked { cursor:default; opacity:.72; }
    .rcb-cell.blocked:hover { transform:none; box-shadow:none; }

    /* Tick / cross stamped on the report icon — status readable without relying on colour. */
    /* 18px with a .68rem glyph: a tick reads fine at 8px, but a gear or a warning triangle is
       an unrecognisable blob until roughly this size. */
    .rcb-badge { position:absolute; right:-5px; bottom:-5px; width:18px; height:18px; border-radius:50%;
        display:flex; align-items:center; justify-content:center; color:#fff; font-weight:700;
        border:2px solid #fff; box-shadow:0 1px 3px rgba(15,23,42,.28); }
    .rcb-badge i { font-size:.68rem; line-height:1; display:block; }
    .rcb-badge.bg-ok { background:var(--ok); } .rcb-badge.bg-fail { background:var(--fail); }
    .rcb-badge.bg-wait { background:var(--wait); } .rcb-badge.bg-none { background:#cbd5e1; }
    .rcb-badge.bg-running { background:var(--running); }
    .rcb-badge.bg-late { background:var(--late); }
    /* Slow, continuous turn — a live "this is working" cue that is easy to ignore. */
    .rcb-badge.bg-running i { animation:rcb-spin 3.2s linear infinite; }
    @@keyframes rcb-spin { from { transform:rotate(0deg); } to { transform:rotate(360deg); } }
    .rcb-badge.bg-noroute { background:#7c3aed; }

    .rcb-legend { padding:.7rem 1rem .75rem; background:#0a1628; color:rgba(255,255,255,.82); font-size:.72rem; font-weight:600; }
    .rcb-legend-items { display:flex; flex-wrap:wrap; gap:.4rem .45rem; }
    .rcb-legend .lg { display:inline-flex; align-items:center; gap:.4rem; white-space:nowrap;
        background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.13); border-radius:999px; padding:.24rem .7rem .24rem .3rem; }
    .rcb-legend .lg.dim { opacity:.68; }
    .rcb-legend .lg em { font-style:normal; font-weight:500; color:rgba(255,255,255,.52); }
    .rcb-legend .mk { width:17px; height:17px; border-radius:50%; color:#fff; display:inline-flex;
        align-items:center; justify-content:center; flex:0 0 auto; }
    .rcb-legend .mk i { font-size:.55rem; line-height:1; }
    .rcb-legend .mk.ok { background:var(--ok); } .rcb-legend .mk.fail { background:var(--fail); }
    .rcb-legend .mk.wait { background:var(--wait); } .rcb-legend .mk.none { background:#94a3b8; }
    .rcb-legend .mk.running { background:var(--running); } .rcb-legend .mk.late { background:var(--late); }
    .rcb-legend-hint { margin-top:.55rem; padding-top:.5rem; border-top:1px solid rgba(255,255,255,.1);
        display:flex; align-items:center; gap:.4rem; font-size:.69rem; font-weight:500; color:rgba(255,255,255,.55); }

    /* cards */
    .rcb-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(370px,1fr)); gap:1.1rem; }
    .rcb-card { background:#fff; border:1px solid var(--line); border-radius:18px; overflow:hidden; box-shadow:0 6px 22px rgba(15,23,42,.07); display:flex; flex-direction:column; }
    .rcb-card-head { padding:.85rem 1rem; color:#fff; display:flex; align-items:center; gap:.65rem; }
    .rcb-card-head .n { font-weight:800; font-size:1rem; line-height:1.15; }
    .rcb-card-head .r { font-size:.64rem; font-family:var(--mono); opacity:.75; }
    .rcb-card-head .w { margin-left:auto; background:rgba(255,255,255,.18); border:1px solid rgba(255,255,255,.28); border-radius:20px; padding:.2rem .6rem; font-size:.62rem; font-weight:700; white-space:nowrap; }
    .rcb-ready { display:flex; align-items:center; gap:.5rem; padding:.5rem 1rem; background:#f8fafc; border-bottom:1px solid var(--line-soft); font-size:.7rem; font-weight:700; color:var(--muted); }
    .rcb-bar { flex:1; height:6px; border-radius:6px; background:#e2e8f0; overflow:hidden; }
    .rcb-bar i { display:block; height:100%; background:linear-gradient(90deg,#10b981,#34d399); }
    .rcb-replist { padding:.55rem .7rem; display:flex; flex-direction:column; gap:2px; flex:1; }
    .rcb-rep { display:flex; align-items:center; gap:.5rem; padding:.34rem .5rem; border-radius:8px; text-decoration:none; color:var(--ink-2); font-size:.78rem; font-weight:600; }
    a.rcb-rep:hover { background:#f1f7ff; color:#0d6efd; }
    .rcb-rep .dot { width:7px; height:7px; border-radius:50%; flex:0 0 auto; }
    .rcb-rep .arrow { margin-left:auto; color:var(--faint); font-size:.75rem; }
    /* Same report icon + tick/cross the matrix uses, so a report looks identical in both views. */
    .rcb-rep .rep-ic { font-size:.82rem; color:var(--muted); flex:0 0 auto; }
    .rcb-rep .mk { font-size:.75rem; margin-left:.15rem; flex:0 0 auto; }
    .rcb-rep .mk.ok { color:var(--ok); } .rcb-rep .mk.fail { color:var(--fail); }
    .rcb-rep .mk.wait { color:var(--wait); } .rcb-rep .mk.none { color:var(--none); }
    .rcb-rep .mk.running { color:var(--running); } .rcb-rep .mk.late { color:var(--late); }
    a.rcb-rep:hover .rep-ic { color:#0d6efd; }
    .rcb-rep.off { color:var(--faint); font-weight:500; }
    .rcb-rep.bad { color:#b91c1c; }
    .d-ok { background:var(--ok); } .d-fail { background:var(--fail); } .d-none { background:var(--none); } .d-wait { background:var(--wait); }
    .rcb-groupname { font-size:.6rem; letter-spacing:.1em; text-transform:uppercase; color:#94a3b8; font-weight:800; padding:.45rem .5rem .15rem; }
    /* Batch-style single line: report tiles in a group flow inline as compact pills (Claim + Line on one row). */
    .rcb-rep-row { display:flex; flex-wrap:wrap; gap:6px; padding:0 .5rem .35rem; }
    .rcb-rep-row .rcb-rep { flex:0 0 auto; border:1px solid var(--line); background:#f8fafc; padding:.3rem .6rem; border-radius:999px; font-size:.72rem; }
    a.rcb-rep-row .rcb-rep:hover, .rcb-rep-row a.rcb-rep:hover { background:#eff6ff; border-color:#bfdbfe; color:#0d6efd; }
    .rcb-rep-row .rcb-rep .arrow { margin-left:2px; }
    /* Every pill is tinted by its run outcome, so a card reads at a glance like the matrix row. */
    .rcb-rep-row .rcb-rep.done { border-color:var(--ok-line); background:var(--ok-bg); color:#065f46; }
    .rcb-rep-row a.rcb-rep.done:hover { background:#d1fae5; border-color:#6ee7b7; color:#047857; }
    .rcb-rep-row .rcb-rep.done .rep-ic { color:#059669; }
    .rcb-rep-row .rcb-rep.bad { border-color:var(--fail-line); background:var(--fail-bg); color:#b91c1c; }
    .rcb-rep-row a.rcb-rep.bad:hover { background:#fee2e2; border-color:#fca5a5; color:#991b1b; }
    .rcb-rep-row .rcb-rep.bad .rep-ic { color:#dc2626; }
    .rcb-rep-row .rcb-rep.running { border-color:var(--running-line); background:var(--running-bg); color:#1d4ed8; }
    .rcb-rep-row .rcb-rep.running .rep-ic { color:#2563eb; }
    .rcb-rep-row .rcb-rep.late { border-color:var(--late-line); background:var(--late-bg); color:#c2410c; }
    .rcb-rep-row .rcb-rep.late .rep-ic { color:#ea580c; }
    /* Only "not produced for this lab" stays grey. */
    .rcb-rep-row .rcb-rep.off { border-style:dashed; }
    .rcb-card-foot { padding:.55rem .8rem; border-top:1px solid var(--line-soft); display:flex; gap:.35rem; flex-wrap:wrap; }
    .rcb-btn-s { border:1px solid var(--line); background:#fff; border-radius:8px; padding:.3rem .65rem; font-size:.7rem; font-weight:700; color:var(--ink-2); text-decoration:none; }
    .rcb-btn-s.pri { background:#0d6efd; border-color:#0d6efd; color:#fff; }

    /* drawer */
    .rcb-scrim { position:fixed; inset:0; background:rgba(10,22,40,.45); opacity:0; pointer-events:none; transition:opacity .2s; z-index:1045; }
    .rcb-scrim.on { opacity:1; pointer-events:auto; }
    .rcb-drawer { position:fixed; top:0; right:0; height:100%; width:min(460px,94vw); background:#fff; z-index:1050; transform:translateX(100%); transition:transform .26s cubic-bezier(.4,0,.2,1); display:flex; flex-direction:column; box-shadow:-16px 0 48px rgba(10,22,40,.24); }
    .rcb-drawer.on { transform:none; }
    .rcb-dr-head { padding:1.1rem 1.2rem; color:#fff; display:flex; align-items:flex-start; gap:.7rem; }
    .rcb-dr-head .x { margin-left:auto; background:rgba(255,255,255,.16); border:0; color:#fff; width:28px; height:28px; border-radius:8px; cursor:pointer; font-size:1rem; }
    .rcb-dr-body { overflow:auto; padding:.9rem 1.1rem 2rem; }
    .rcb-dr-sec { font-size:.62rem; text-transform:uppercase; letter-spacing:.1em; color:var(--faint); font-weight:800; margin:1rem 0 .4rem; }
    .rcb-dr-item { display:flex; align-items:center; gap:.65rem; padding:.55rem .6rem; border:1px solid var(--line-soft); border-radius:10px; margin-bottom:.35rem; text-decoration:none; color:var(--ink-2); font-size:.83rem; font-weight:600; }
    a.rcb-dr-item:hover { border-color:#bfdbfe; background:#f8fbff; }
    .rcb-dr-item .st { margin-left:auto; font-size:.62rem; font-weight:800; text-transform:uppercase; letter-spacing:.05em; padding:.15rem .45rem; border-radius:5px; }
    .st.ok { background:var(--ok-bg); color:#047857; } .st.fail { background:var(--fail-bg); color:#b91c1c; }
    .st.none { background:#f1f5f9; color:var(--faint); } .st.wait { background:var(--wait-bg); color:#b45309; }
    .st.noroute { background:#f5f3ff; color:#7c3aed; }
    .rcb-meta { display:grid; grid-template-columns:auto 1fr; gap:.2rem .8rem; font-size:.75rem; padding:.6rem .7rem; background:#f8fafc; border-radius:10px; margin:0; }
    .rcb-meta dt { color:var(--faint); font-weight:600; }
    .rcb-meta dd { margin:0; font-family:var(--mono); color:var(--ink); font-size:.72rem; }
    .rcb-note { font-size:.72rem; color:var(--muted); background:#fffbeb; border:1px solid var(--wait-line); border-radius:9px; padding:.5rem .65rem; margin-top:.8rem; }

    .rcb-empty { background:#fff; border:1px solid var(--line); border-radius:16px; padding:2rem; text-align:center; color:var(--muted); }
    .rcb-errorcard { background:#fff; border:1px solid var(--fail-line); border-left:4px solid var(--fail); border-radius:14px; padding:1rem 1.2rem; margin-bottom:1.1rem; }
    .rcb-hidden { display:none !important; }

    @@media (max-width:900px) { .rcb-board { display:none; } }
    @@media (prefers-reduced-motion:reduce) { .rcb * { transition:none !important; animation:none !important; } }
</style>

<div class="rcb">
    <div class="rcb-hero">
        <div>
            <h1><span class="ic"><i class="bi bi-grid-3x3-gap-fill"></i></span> Report Control Board</h1>
            <p>Every report produced by the latest run for each lab. Green opens the report.</p>
        </div>
        <div class="rcb-kpis">
            <div class="rcb-kpi"><b>@Model.Rows.Count</b><span>Labs</span></div>
            <div class="rcb-kpi"><b>@Model.Columns.Count</b><span>Reports</span></div>
            <div class="rcb-kpi"><b>@Model.TotalReady</b><span>Available</span></div>
            <div class="rcb-kpi @(Model.TotalFailed > 0 ? "bad" : "")"><b>@Model.TotalFailed</b><span>Failed</span></div>
            <div class="rcb-kpi @(Model.TotalOverdue > 0 ? "late" : "")"><b>@Model.TotalOverdue</b><span>Overdue</span></div>
            <div class="rcb-kpi"><b>@(Model.LastSyncedOn?.ToString("dd MMM") ?? "—")</b><span>Last sync</span></div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.DataError))
    {
        <div class="rcb-errorcard">
            <div class="fw-bold text-danger mb-1"><i class="bi bi-exclamation-octagon-fill"></i> The report workflow tracker is unavailable</div>
            <div class="small text-muted mb-2">
                @Model.DataError
                @if (Model.LastGoodAt.HasValue)
                {
                    <text> Showing the last good copy, read at <b>@Model.LastGoodAt.Value.ToString("dd MMM HH:mm")</b>.</text>
                }
                else
                {
                    <text> No cached copy is available yet.</text>
                }
            </div>
            <a class="btn btn-sm btn-outline-danger" asp-action="Index" asp-route-view="@Model.View" asp-route-sort="@Model.Sort" asp-route-refresh="true">
                <i class="bi bi-arrow-clockwise"></i> Retry
            </a>
        </div>
    }

    @* Source data landed over a day ago and these reports never followed — the pipeline has
       stalled, which is otherwise invisible because nothing "failed". *@
    @if (Model.OverdueRows.Count > 0)
    {
        // Signature of WHAT is overdue, so dismissing today's warning does not hide tomorrow's
        // different one — a new lab, run or report brings the banner back.
        var warnSignature = string.Join("|", Model.OverdueRows
            .Select(r => $"{r.LabConfigKey}:{r.RunId}:{string.Join(",", r.OverdueReports)}"));

        <div class="rcb-warncard" role="alert" id="rcbWarn" data-warn-key="@warnSignature.GetHashCode():X">
            <button type="button" class="rcb-warn-x" id="rcbWarnClose" aria-label="Dismiss this warning" title="Dismiss">
                <i class="bi bi-x-lg"></i>
            </button>
            <h2>
                <i class="bi bi-exclamation-triangle-fill"></i>
                @Model.TotalOverdue report@(Model.TotalOverdue == 1 ? "" : "s") not generated
                more than a day after the run's source data
            </h2>
            <ul>
                @foreach (var row in Model.OverdueRows)
                {
                    <li>
                        <span class="lab">@row.LabDisplayName</span>
                        <span class="text-muted">(@(row.RunId ?? "no run"), synced @RelativeTime(row.SyncedOn))</span>
                        — <span class="rp">@string.Join(", ", row.OverdueReports)</span>
                    </li>
                }
            </ul>
        </div>
    }

    <div class="rcb-toolbar">
        <div class="rcb-seg" role="group" aria-label="View">
            <a asp-action="Index" asp-route-view="matrix" asp-route-sort="@Model.Sort" aria-pressed="@(Model.View == "matrix" ? "true" : "false")" id="rcbViewMatrix">Worklist (table)</a>
            <a asp-action="Index" asp-route-view="cards" asp-route-sort="@Model.Sort" aria-pressed="@(Model.View == "cards" ? "true" : "false")" id="rcbViewCards">Grid View</a>
        </div>
        <div class="rcb-search">
            <label class="visually-hidden" for="rcbSearch">Search labs or run ID</label>
            <input id="rcbSearch" type="search" placeholder="Search labs or run ID…" autocomplete="off" />
        </div>
        <div class="rcb-chips" role="group" aria-label="Filter">
            <button type="button" class="rcb-chip" data-filter="all" aria-pressed="@(Model.Filter == "all" ? "true" : "false")">All</button>
            <button type="button" class="rcb-chip danger" data-filter="failed" aria-pressed="@(Model.Filter == "failed" ? "true" : "false")">Needs attention</button>
            <button type="button" class="rcb-chip" data-filter="incomplete" aria-pressed="@(Model.Filter == "incomplete" ? "true" : "false")">Incomplete runs</button>
        </div>
        <div class="rcb-seg" role="group" aria-label="Sort">
            <a asp-action="Index" asp-route-view="@Model.View" asp-route-sort="latest" aria-pressed="@(Model.Sort == "latest" ? "true" : "false")">Latest</a>
            <a asp-action="Index" asp-route-view="@Model.View" asp-route-sort="az" aria-pressed="@(Model.Sort == "az" ? "true" : "false")">A–Z</a>
        </div>
    </div>

    @if (Model.Rows.Count == 0)
    {
        <div class="rcb-empty">
            <i class="bi bi-inbox" style="font-size:2rem;"></i>
            <div class="fw-bold mt-2">No report runs to show</div>
            <div class="small">@(string.IsNullOrWhiteSpace(Model.DataError)
                ? "The tracker returned no runs for the labs assigned to you."
                : "The tracker could not be read, so there is nothing to display yet.")</div>
        </div>
    }
    else
    {
        <!-- ── Matrix ────────────────────────────────────────────────────── -->
        <div class="rcb-board @(Model.View == "cards" ? "rcb-hidden" : "")" id="rcbMatrix">
            <div class="rcb-scroll">
                <table>
                    @* Column widths live here so the colspan band row cannot skew them. *@
                    <colgroup>
                        <col class="rcb-lab-col" />
                        @for (var c = 0; c < Model.Columns.Count; c++)
                        {
                            <col class="rcb-rep-col" />
                        }
                    </colgroup>
                    <thead>
                        <tr class="band">
                            <th class="lab-h b0" rowspan="2">Lab &amp; latest run</th>
                            @foreach (var band in Model.ColumnBands)
                            {
                                <th class="@BandClass(band.Group)" colspan="@band.Span">@band.Group</th>
                            }
                        </tr>
                        <tr class="cols">
                            @foreach (var column in Model.Columns)
                            {
                                var done = CompletedFor(column);
                                <th title="@column.DisplayName — @done of @Model.Rows.Count lab@(Model.Rows.Count == 1 ? "" : "s") completed">
                                    <span class="rcb-colhead">
                                        <i class="bi @column.Icon" aria-hidden="true"></i>
                                        <span class="lbl">@column.ShortName</span>
                                        <span class="cnt">@done/@Model.Rows.Count</span>
                                    </span>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Rows.Count; i++)
                        {
                            var row = Model.Rows[i];
                            var colour = palette[i % palette.Length];
                            <tr class="rcb-row"
                                data-search="@($"{row.LabDisplayName} {row.RunId}".ToLowerInvariant())"
                                data-failed="@(row.HasFailures ? "1" : "0")"
                                data-overdue="@(row.HasOverdue ? "1" : "0")"
                                data-ready="@row.ReadyCount">
                                <td class="lab-c">
                                    <div class="rcb-labrow" role="button" tabindex="0" data-drawer="@i" aria-label="Open all reports for @row.LabDisplayName">
                                        <div class="rcb-av" style="background:@colour">@row.Initial</div>
                                        <div>
                                            <div class="rcb-labname">
                                                @row.LabDisplayName
                                                @if (!row.IsMapped)
                                                {
                                                    <span class="rcb-unmapped" title="Lab not mapped to a configuration">unmapped</span>
                                                }
                                            </div>
                                            <div class="rcb-labmeta">@row.RunId</div>
                                            @if (!string.IsNullOrWhiteSpace(row.Week))
                                            {
                                                <div class="rcb-labweek">@row.Week</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                @foreach (var cell in row.Reports)
                                {
                                    @* Every state renders the report's OWN icon (the one in its column header,
                                       card list and drawer) with a tick/cross badge for the run outcome — the
                                       cell never changes identity, only its stamp. *@
                                    <td>
                                        @if (cell.IsLinkable)
                                        {
                                            <a class="rcb-cell ok" title="@Tooltip(cell)" aria-label="@Tooltip(cell)"
                                               asp-controller="@cell.Catalog.Controller" asp-action="@cell.Catalog.Action"
                                               asp-route-lab="@row.LabConfigKey" asp-route-runId="@row.RunId" asp-route-ActiveTab="@cell.Catalog.LinkTab">
                                                <i class="bi @cell.Catalog.Icon" aria-hidden="true"></i>
                                                <span class="rcb-badge @BadgeClass(cell)" aria-hidden="true"><i class="bi @BadgeIcon(cell)"></i></span>
                                            </a>
                                        }
                                        else if (cell.Status == ReportRunStatus.Failed)
                                        {
                                            <a class="rcb-cell fail" title="@Tooltip(cell)" aria-label="@Tooltip(cell)" download
                                               asp-action="RunErrorsCsv" asp-route-runId="@row.RunId"
                                               asp-route-lab="@row.LabConfigKey" asp-route-labName="@row.LabDisplayName"
                                               asp-route-report="@cell.Catalog.TrackerColumn">
                                                <i class="bi @cell.Catalog.Icon" aria-hidden="true"></i>
                                                <span class="rcb-badge @BadgeClass(cell)" aria-hidden="true"><i class="bi @BadgeIcon(cell)"></i></span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="rcb-cell @CellClass(cell) @(cell.Status == ReportRunStatus.Success ? "blocked" : "")"
                                                  title="@Tooltip(cell)" aria-label="@Tooltip(cell)" tabindex="0">
                                                <i class="bi @cell.Catalog.Icon" aria-hidden="true"></i>
                                                <span class="rcb-badge @BadgeClass(cell)" aria-hidden="true"><i class="bi @BadgeIcon(cell)"></i></span>
                                            </span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="rcb-legend">
                <div class="rcb-legend-items">
                    <span class="lg"><span class="mk ok"><i class="bi bi-check-lg"></i></span>Completed <em>— click to open</em></span>
                    <span class="lg"><span class="mk fail"><i class="bi bi-x-lg"></i></span>Failed <em>— click for the error log</em></span>
                    <span class="lg"><span class="mk running"><i class="bi bi-gear-fill"></i></span>In progress <em>— not produced yet</em></span>
                    <span class="lg"><span class="mk late"><i class="bi bi-exclamation-triangle-fill"></i></span>Overdue <em>— over a day late</em></span>
                    <span class="lg dim"><span class="mk ok"><i class="bi bi-check-lg"></i></span>Completed <em>— faded, cannot open here</em></span>
                    <span class="lg"><span class="mk none"><i class="bi bi-dash-lg"></i></span>Not produced for this lab</span>
                </div>
                <div class="rcb-legend-hint">
                    <i class="bi bi-info-circle"></i>
                    Hover any icon for its report name and status · click a lab name for the full list
                </div>
            </div>
        </div>

        <!-- ── Cards ─────────────────────────────────────────────────────── -->
        <div class="rcb-grid @(Model.View == "cards" ? "" : "rcb-hidden")" id="rcbCards">
            @for (var i = 0; i < Model.Rows.Count; i++)
            {
                var row = Model.Rows[i];
                var colour = palette[i % palette.Length];
                var pct = Model.Columns.Count == 0 ? 0 : (int)Math.Round(row.ReadyCount * 100.0 / Model.Columns.Count);
                <div class="rcb-card rcb-row"
                     data-search="@($"{row.LabDisplayName} {row.RunId}".ToLowerInvariant())"
                     data-failed="@(row.HasFailures ? "1" : "0")"
                                data-overdue="@(row.HasOverdue ? "1" : "0")"
                     data-ready="@row.ReadyCount">
                    <div class="rcb-card-head" style="background:linear-gradient(135deg,@colour,@(colour)cc)">
                        <div>
                            <div class="n">@row.LabDisplayName</div>
                            <div class="r"><i class="bi bi-clock-history"></i> Updated: @RelativeTime(row.SyncedOn) · Run: @row.RunId</div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(row.Week))
                        {
                            <div class="w">@row.Week</div>
                        }
                    </div>
                    <div class="rcb-ready">
                        <span>@row.ReadyCount/@Model.Columns.Count ready</span>
                        <span class="rcb-bar"><i style="width:@(pct)%"></i></span>
                        @if (row.HasFailures)
                        {
                            <span style="color:#b91c1c">@row.FailedCount failed</span>
                        }
                        @if (row.HasOverdue)
                        {
                            <span style="color:#c2410c"><i class="bi bi-exclamation-triangle-fill"></i> @row.OverdueCount overdue</span>
                        }
                        else if (row.PendingCount > 0)
                        {
                            <span style="color:#1d4ed8"><i class="bi bi-gear-fill"></i> @row.PendingCount running</span>
                        }
                        else if (!row.HasFailures)
                        {
                            <span style="color:#10b981">healthy</span>
                        }
                    </div>
                    <div class="rcb-replist">
                        @foreach (var group in row.Reports.GroupBy(r => r.Catalog.Group))
                        {
                            <div class="rcb-groupname">@group.Key</div>
                            <div class="rcb-rep-row">
                            @foreach (var cell in group)
                            {
                                @* Report icon + tick/cross, matching the matrix cell for the same report. *@
                                if (cell.IsLinkable)
                                {
                                    <a class="rcb-rep done" title="@Tooltip(cell)" aria-label="@Tooltip(cell)"
                                       asp-controller="@cell.Catalog.Controller" asp-action="@cell.Catalog.Action"
                                       asp-route-lab="@row.LabConfigKey" asp-route-runId="@row.RunId" asp-route-ActiveTab="@cell.Catalog.LinkTab">
                                        <i class="bi @cell.Catalog.Icon rep-ic" aria-hidden="true"></i>@cell.Catalog.DisplayName<i class="bi @BadgeIcon(cell) mk ok" aria-hidden="true"></i>
                                    </a>
                                }
                                else if (cell.Status == ReportRunStatus.Failed)
                                {
                                    <a class="rcb-rep bad" title="@Tooltip(cell)" aria-label="@Tooltip(cell)" download
                                       asp-action="RunErrorsCsv" asp-route-runId="@row.RunId"
                                       asp-route-lab="@row.LabConfigKey" asp-route-labName="@row.LabDisplayName"
                                       asp-route-report="@cell.Catalog.TrackerColumn">
                                        <i class="bi @cell.Catalog.Icon rep-ic" aria-hidden="true"></i>@cell.Catalog.DisplayName<i class="bi @BadgeIcon(cell) mk fail" aria-hidden="true"></i><span class="arrow">↓</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="rcb-rep @PillClass(cell)" title="@Tooltip(cell)" aria-label="@Tooltip(cell)">
                                        <i class="bi @cell.Catalog.Icon rep-ic" aria-hidden="true"></i>@cell.Catalog.DisplayName<i class="bi @BadgeIcon(cell) mk @CellClass(cell)" aria-hidden="true"></i>
                                    </span>
                                }
                            }
                            </div>
                        }
                    </div>
                    <div class="rcb-card-foot">
                        @if (row.IsMapped)
                        {
                            <a class="rcb-btn-s pri" asp-controller="Dashboard" asp-action="Index" asp-route-lab="@row.LabConfigKey">Revenue dashboard</a>
                        }
                        <button type="button" class="rcb-btn-s" data-drawer="@i">All reports</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="rcb-scrim" id="rcbScrim"></div>
<aside class="rcb-drawer" id="rcbDrawer" role="dialog" aria-modal="true" aria-label="Lab reports" aria-hidden="true">
    <div class="rcb-dr-head" id="rcbDrawerHead"></div>
    <div class="rcb-dr-body" id="rcbDrawerBody"></div>
</aside>

@* Drawer content is pre-rendered server-side (routes, permissions and flags are all resolved
   there) and cloned into the drawer on demand, so no link is ever built in JavaScript. *@
<div class="rcb-hidden" id="rcbDrawerSource">
    @for (var i = 0; i < Model.Rows.Count; i++)
    {
        var row = Model.Rows[i];
        var colour = palette[i % palette.Length];
        <div data-drawer-for="@i" data-colour="@colour" data-lab="@row.LabDisplayName" data-initial="@row.Initial" data-run="@row.RunId">
            <dl class="rcb-meta">
                <dt>Run ID</dt><dd>@(row.RunId ?? "—")</dd>
                <dt>Week</dt><dd>@(row.Week ?? "—")</dd>
                <dt>Synced</dt><dd>@(row.SyncedOn?.ToString("dd MMM yyyy") ?? "—")</dd>
                <dt>Ready</dt><dd>@row.ReadyCount of @Model.Columns.Count</dd>
            </dl>
            @foreach (var group in row.Reports.GroupBy(r => r.Catalog.Group))
            {
                <div class="rcb-dr-sec">@group.Key</div>
                @foreach (var cell in group)
                {
                    @* Same report icon everywhere; the pill states completion in words. *@
                    if (cell.IsLinkable)
                    {
                        <a class="rcb-dr-item" title="@Tooltip(cell)" asp-controller="@cell.Catalog.Controller" asp-action="@cell.Catalog.Action"
                           asp-route-lab="@row.LabConfigKey" asp-route-runId="@row.RunId" asp-route-ActiveTab="@cell.Catalog.LinkTab">
                            <i class="bi @cell.Catalog.Icon"></i> @cell.Catalog.DisplayName<span class="st ok"><i class="bi bi-check-lg"></i> Completed · open</span>
                        </a>
                    }
                    else if (cell.Status == ReportRunStatus.Failed)
                    {
                        <a class="rcb-dr-item" title="@Tooltip(cell)" download asp-action="RunErrorsCsv" asp-route-runId="@row.RunId"
                           asp-route-lab="@row.LabConfigKey" asp-route-labName="@row.LabDisplayName"
                           asp-route-report="@cell.Catalog.TrackerColumn">
                            <i class="bi @cell.Catalog.Icon"></i> @cell.Catalog.DisplayName<span class="st fail"><i class="bi bi-x-lg"></i> Not completed · error log</span>
                        </a>
                    }
                    else
                    {
                        <div class="rcb-dr-item" title="@Tooltip(cell)">
                            <i class="bi @cell.Catalog.Icon"></i> @cell.Catalog.DisplayName
                            <span class="st @CellClass(cell)"><i class="bi @BadgeIcon(cell)"></i> @StatusLabel(cell)</span>
                        </div>
                    }
                }
            }
            @if (row.HasFailures)
            {
                <div class="rcb-note">
                    <b>@row.FailedCount report@(row.FailedCount == 1 ? "" : "s") failed in this run.</b>
                    Click any red row to download the run's error log (Excel) and see what stopped it.
                </div>
            }
            @if (!row.IsMapped)
            {
                <div class="rcb-note">
                    <b>This lab is not mapped to a configuration.</b>
                    The tracker calls it &ldquo;@row.LabDisplayName&rdquo;, which matches no key in LabConfig, so its
                    reports cannot be opened from here.
                </div>
            }
        </div>
    }
</div>

@section Scripts {
<script nonce='@Context.Items["CspNonce"]'>
(function(){
  // Dismissible stalled-run warning. Keyed by WHAT is overdue, so closing it hides only this
  // exact set — a new lab, run or report shows the banner again. Session-scoped: it comes back
  // in a new browser session even if nothing changed.
  const warn = document.getElementById('rcbWarn');
  if (warn) {
    const key = 'rcbWarnDismissed:' + (warn.dataset.warnKey || '');
    try { if (sessionStorage.getItem(key) === '1') warn.style.display = 'none'; } catch (e) { }
    const closeBtn = document.getElementById('rcbWarnClose');
    if (closeBtn) closeBtn.addEventListener('click', function () {
      warn.style.display = 'none';
      try { sessionStorage.setItem(key, '1'); } catch (e) { }
    });
  }

  // Search / filter / drawer only. View and sort are server-rendered links so the URL keeps state.
  const rows = Array.from(document.querySelectorAll('.rcb-row'));
  const search = document.getElementById('rcbSearch');
  const chips = Array.from(document.querySelectorAll('.rcb-chip'));
  const columnCount = @Model.Columns.Count;
  // "Incomplete" means fewer than half the report columns produced anything.
  const incompleteBelow = Math.max(1, Math.ceil(columnCount / 2));
  let filter = @Html.Raw(Json.Serialize(Model.Filter));

  function apply(){
    const q = (search.value || '').trim().toLowerCase();
    rows.forEach(row => {
      let show = true;
      if (q && !(row.dataset.search || '').includes(q)) show = false;
      else if (filter === "failed" && row.dataset.failed !== "1" && row.dataset.overdue !== "1") show = false;
      else if (filter === 'incomplete' && Number(row.dataset.ready) >= incompleteBelow) show = false;
      row.classList.toggle('rcb-hidden', !show);
    });
  }
  search.addEventListener('input', apply);
  chips.forEach(chip => chip.addEventListener('click', () => {
    filter = chip.dataset.filter;
    chips.forEach(c => c.setAttribute('aria-pressed', String(c === chip)));
    apply();
    // Keep the chosen filter in the URL without a round trip, so a refresh keeps it.
    const url = new URL(window.location.href);
    url.searchParams.set('filter', filter);
    history.replaceState(null, '', url);
  }));
  apply();

  // ── drawer ──────────────────────────────────────────────────────────────
  const drawer = document.getElementById('rcbDrawer');
  const scrim = document.getElementById('rcbScrim');
  const head = document.getElementById('rcbDrawerHead');
  const body = document.getElementById('rcbDrawerBody');
  const source = document.getElementById('rcbDrawerSource');
  let lastFocus = null;

  function openDrawer(index){
    const panel = source.querySelector('[data-drawer-for="' + index + '"]');
    if (!panel) return;
    lastFocus = document.activeElement;
    head.style.background = 'linear-gradient(135deg,' + panel.dataset.colour + ',' + panel.dataset.colour + 'cc)';
    head.innerHTML = '';
    const avatar = document.createElement('div');
    avatar.className = 'rcb-av';
    avatar.style.background = 'rgba(255,255,255,.2)';
    avatar.textContent = panel.dataset.initial;
    const title = document.createElement('div');
    const name = document.createElement('div');
    name.style.cssText = 'font-weight:800;font-size:1.05rem';
    name.textContent = panel.dataset.lab;
    const run = document.createElement('div');
    run.style.cssText = 'font-size:.7rem;opacity:.8;font-family:var(--mono)';
    run.textContent = panel.dataset.run || '';
    title.append(name, run);
    const close = document.createElement('button');
    close.type = 'button';
    close.className = 'x';
    close.setAttribute('aria-label', 'Close');
    close.textContent = '×';
    close.addEventListener('click', closeDrawer);
    head.append(avatar, title, close);

    body.replaceChildren(...Array.from(panel.cloneNode(true).childNodes));
    drawer.classList.add('on');
    scrim.classList.add('on');
    drawer.setAttribute('aria-hidden', 'false');
    (drawer.querySelector('a, button') || drawer).focus();
    document.addEventListener('keydown', onKeydown);
  }
  function closeDrawer(){
    drawer.classList.remove('on');
    scrim.classList.remove('on');
    drawer.setAttribute('aria-hidden', 'true');
    document.removeEventListener('keydown', onKeydown);
    if (lastFocus) lastFocus.focus();
  }
  // Esc closes; Tab is trapped inside the drawer while it is open.
  function onKeydown(e){
    if (e.key === 'Escape'){ closeDrawer(); return; }
    if (e.key !== 'Tab') return;
    const focusable = drawer.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])');
    if (!focusable.length) return;
    const first = focusable[0], last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first){ e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last){ e.preventDefault(); first.focus(); }
  }
  scrim.addEventListener('click', closeDrawer);
  document.querySelectorAll('[data-drawer]').forEach(el => {
    el.addEventListener('click', () => openDrawer(el.dataset.drawer));
    el.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' '){ e.preventDefault(); openDrawer(el.dataset.drawer); }
    });
  });

  // Below 900px the matrix is hidden by CSS, so send narrow screens to the cards view.
  if (window.matchMedia('(max-width:900px)').matches){
    document.getElementById('rcbCards')?.classList.remove('rcb-hidden');
  }
})();
</script>
}
