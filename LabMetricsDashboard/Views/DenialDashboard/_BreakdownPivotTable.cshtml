@model LabMetricsDashboard.ViewModels.BreakdownPivotViewModel
@using System.Globalization

@{
    var tableId = "pivot_" + Guid.NewGuid().ToString("N");
    var groupNumber = 0;
    string? currentGroupKey = null;
    var monthly = Model.Periods.Any(x => x.IsYearTotal);

    // Cells line up with Periods by index; this marks the ones under a year-subtotal column.
    string YearTotalClass(int index) =>
        index < Model.Periods.Count && Model.Periods[index].IsYearTotal ? " pivot-year-total" : string.Empty;
}

<div class="breakdown-pivot-shell">
    @if (Model.HasData)
    {
        <div class="table-frame breakdown-pivot-frame denial-pivot-scroll" id="@tableId">
            <table class="table table-sm app-table breakdown-pivot-table denial-pivot-freeze mb-0">
                @* The table is table-layout:fixed, where column widths come from <col> first and
                   otherwise from the FIRST row - which here is a band of colspans, so the widths
                   declared on the body cells never applied and the last column could clip its
                   value. These <col>s give the fixed algorithm something real to work from.
                   They are inert unless a stylesheet sizes them, so pages that were happy with the
                   distributed widths are unaffected. *@
                <colgroup>
                    <col class="pivot-col-index" />
                    <col class="pivot-col-label" />
                    @foreach (var period in Model.Periods)
                    {
                        <col class="pivot-col-claims" />
                        <col class="pivot-col-balance" />
                    }
                    <col class="pivot-col-claims pivot-col-total" />
                    <col class="pivot-col-balance pivot-col-total" />
                </colgroup>
                <thead>
                    @* Two header bands were stacked here: a full-width one carrying the coverage
                       caption ("All Months | Top N Payers | Covering X% of the AR | ..."), and
                       under it a band that only repeated SectionTitle — "Monthly Summary" /
                       "Weekly Summary" — which the tab above already says. The repeat is gone and
                       the caption moved down into the surviving band, so the table keeps the one
                       piece of information the header actually carried and gets a row of height
                       back on every scroll.

                       SectionTitle is still set on the view model and still used by the Excel
                       export (DenialDashboardExcelExportBuilder), where the sheets have no tabs
                       to name them. *@
                    <tr>
                        <th class="pivot-side-title pivot-freeze-both" colspan="2" rowspan="@(monthly ? 4 : 3)">Insurance &amp; Top Denials</th>
                        <th class="pivot-section-title" colspan="@(Model.Periods.Count * 2)" title="@Model.HeaderTitle">@Model.HeaderTitle</th>
                        <th class="pivot-total-title" colspan="2" rowspan="@(monthly ? 3 : 2)">@(monthly ? Model.GrandTotalTitle : "Total")</th>
                    </tr>
                    @if (monthly)
                    {
                        <tr>
                            @foreach (var group in Model.ColumnGroups.Where(x => !string.Equals(x.Label, Model.GrandTotalTitle, StringComparison.OrdinalIgnoreCase)))
                            {
                                <th class="pivot-period-title" colspan="@group.ColumnSpan">@group.Label</th>
                            }
                        </tr>
                    }
                    @* pivot-year-total / pivot-grand-total mark the total columns so a page can band
                       them the way Production Summary does. They carry no styling of their own, so
                       a page that does not opt in renders exactly as before. *@
                    <tr>
                        @foreach (var period in Model.Periods)
                        {
                            <th class="pivot-period-title@(period.IsYearTotal ? " pivot-year-total" : "")" colspan="2">@period.Label</th>
                        }
                    </tr>
                    <tr>
                        @foreach (var period in Model.Periods)
                        {
                            <th class="pivot-metric-title@(period.IsYearTotal ? " pivot-year-total" : "")">No. of Claims</th>
                            <th class="pivot-metric-title@(period.IsYearTotal ? " pivot-year-total" : "")">Insurance Balance</th>
                        }
                        <th class="pivot-metric-title pivot-grand-total">No. of Claims</th>
                        <th class="pivot-metric-title pivot-grand-total">Insurance Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        if (row.IsInsuranceRow)
                        {
                            groupNumber++;
                            currentGroupKey = $"{tableId}_g{groupNumber}";
                            var childCount = Model.Rows.SkipWhile(r => !object.ReferenceEquals(r, row)).Skip(1).TakeWhile(r => !r.IsInsuranceRow).Count();
                            <tr class="pivot-insurance-row pivot-group-header" data-group="@currentGroupKey" data-expanded="true">
                                <td class="pivot-index pivot-freeze-1">@row.IndexLabel</td>
                                <td class="pivot-label pivot-freeze-2">
                                    <div class="pivot-group-cell">
                                    <button type="button" class="pivot-collapse-btn" aria-expanded="true" aria-controls="@currentGroupKey" title="Hide or show denial rows">
                                        <span class="pivot-chevron">▾</span>
                                    </button>
                                    <span class="pivot-group-text">@row.Label</span>
                                    @if (childCount > 0)
                                    {
                                        <span class="pivot-group-count">@childCount denial@(childCount == 1 ? "" : "s")</span>
                                    }
                                    </div>
                                </td>
                                @for (var ci = 0; ci < row.Cells.Count; ci++)
                                {
                                    var cell = row.Cells[ci];
                                    var yt = YearTotalClass(ci);
                                    <td class="text-end pivot-claims@(yt)">@(cell.ClaimCount == 0 ? "-" : cell.ClaimCount.ToString("N0"))</td>
                                    <td class="text-end pivot-balance@(yt)">@Acct2(cell.DenialBalance)</td>
                                }
                                <td class="text-end pivot-claims total-col pivot-grand-total">@(row.TotalClaimCount == 0 ? "-" : row.TotalClaimCount.ToString("N0"))</td>
                                <td class="text-end pivot-balance total-col pivot-grand-total">@Acct2(row.TotalBalance)</td>
                            </tr>
                        }
                        else
                        {
                            <tr class="pivot-denial-row pivot-child-row" data-parent-group="@currentGroupKey">
                                <td class="pivot-index pivot-freeze-1">@row.IndexLabel</td>
                                <td class="pivot-label pivot-child-label pivot-freeze-2">@row.Label</td>
                                @for (var ci = 0; ci < row.Cells.Count; ci++)
                                {
                                    var cell = row.Cells[ci];
                                    var yt = YearTotalClass(ci);
                                    <td class="text-end pivot-claims@(yt)">@(cell.ClaimCount == 0 ? "-" : cell.ClaimCount.ToString("N0"))</td>
                                    <td class="text-end pivot-balance@(yt)">@Acct2(cell.DenialBalance)</td>
                                }
                                <td class="text-end pivot-claims total-col pivot-grand-total">@(row.TotalClaimCount == 0 ? "-" : row.TotalClaimCount.ToString("N0"))</td>
                                <td class="text-end pivot-balance total-col pivot-grand-total">@Acct2(row.TotalBalance)</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr class="pivot-footer-row">
                        <th class="pivot-footer-title pivot-freeze-both" colspan="2">Total</th>
                        @for (var ti = 0; ti < Model.TotalsByPeriod.Count; ti++)
                        {
                            var total = Model.TotalsByPeriod[ti];
                            var yt = YearTotalClass(ti);
                            <th class="text-end@(yt)">@total.ClaimCount.ToString("N0")</th>
                            <th class="text-end@(yt)">@Acct2(total.DenialBalance)</th>
                        }
                        <th class="text-end pivot-grand-total">@Model.GrandTotalClaimCount.ToString("N0")</th>
                        <th class="text-end pivot-grand-total">@Acct2(Model.GrandTotalBalance)</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else
    {
        <div class="text-center text-muted py-4">No breakdown rows were found for the selected lab and filters.</div>
    }
</div>

<script nonce='@Context.Items["CspNonce"]'>
    (function () {
        const root = document.getElementById('@tableId');
        if (!root) return;

        const thead = root.querySelector('.denial-pivot-freeze')?.tHead;

        // Stack each sticky header row at its real layout position. offsetTop is an integer and is
        // unaffected by scroll or by the sticky shift itself, so the bands stay flush with no
        // sub-pixel seams (summing fractional row heights used to drift and shimmer while scrolling).
        const updateStickyHeaderOffsets = () => {
            if (!thead || !thead.rows.length) return;
            const rows = Array.from(thead.rows);
            const base = rows[0].offsetTop;
            let headerBottom = 0;
            rows.forEach(row => {
                const offset = row.offsetTop - base;
                Array.from(row.cells).forEach(cell => {
                    cell.style.setProperty('--pivot-sticky-top', `${offset}px`);
                });
                headerBottom = Math.max(headerBottom, offset + row.offsetHeight);
            });
            root.style.setProperty('--pivot-header-height', `${headerBottom}px`);
        };

        requestAnimationFrame(updateStickyHeaderOffsets);
        window.addEventListener('resize', updateStickyHeaderOffsets, { passive: true });
        window.addEventListener('load', updateStickyHeaderOffsets);
        // Recompute once header row heights settle (web-font swap, late reflow).
        if (window.ResizeObserver && thead) {
            new ResizeObserver(() => updateStickyHeaderOffsets()).observe(thead);
        }

        const toggleGroup = (groupKey, expanded) => {
            const childRows = root.querySelectorAll(`.pivot-child-row[data-parent-group="${groupKey}"]`);
            childRows.forEach(row => {
                row.style.display = expanded ? '' : 'none';
            });
        };

        root.querySelectorAll('.pivot-group-header').forEach(headerRow => {
            const btn = headerRow.querySelector('.pivot-collapse-btn');
            if (!btn) return;

            const groupKey = headerRow.getAttribute('data-group');
            const applyState = (expanded) => {
                headerRow.setAttribute('data-expanded', expanded ? 'true' : 'false');
                btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
                const chevron = btn.querySelector('.pivot-chevron');
                if (chevron) chevron.textContent = expanded ? '▾' : '▸';
                toggleGroup(groupKey, expanded);
            };

            btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                const expanded = headerRow.getAttribute('data-expanded') === 'true';
                applyState(!expanded);
            });

            headerRow.addEventListener('dblclick', function () {
                const expanded = headerRow.getAttribute('data-expanded') === 'true';
                applyState(!expanded);
            });

            applyState(true);
            requestAnimationFrame(updateStickyHeaderOffsets);
        });
    })();
</script>
