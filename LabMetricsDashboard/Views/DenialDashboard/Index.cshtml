        ("Payment Days", "lis-number-cell", x => Cnt(x.PaymentDays)),
        ("Expected Payment Date", "lis-date-cell", x => Dt(x.ExpectedPaymentDate)),
        ("Expected Payment Month", "", x => Txt(x.ExpectedPaymentMonth)),
        ("Billing Provider", "lis-wide-cell", x => Txt(x.BillingProvider)),
        ("Denial Classification", "lis-wide-cell", x => Txt(x.CleanDenialClassification)),
        ("Denial Type", "", x => Txt(x.DenialType)),
        ("Action Category", "lis-wide-cell", x => Txt(x.CleanActionCategory)),
        ("Action Code", "", x => Txt(x.ActionCode)),
        ("Recommended Action", "lis-wide-cell", x => Txt(x.RecommendedAction)),
        ("Task Guidance", "lis-wide-cell", x => Txt(x.TaskGuidance)),
