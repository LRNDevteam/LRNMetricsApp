        ("Rolling Days", "", x => Txt(x.RollingDays)),
        ("Days to Bill", "lis-number-cell", x => Cnt(x.DaystoBill)),
        ("Days to Post", "lis-number-cell", x => Cnt(x.DaystoPost)),
        ("Run ID", "", x => Txt(x.RunId)),
        ("Created On", "lis-date-cell", x => Dt(x.CreatedOn))
    };
}
<style>
    .filter-shell {
        border-radius: 1rem;
        background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    }

    .section-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #1b3a5c;
        letter-spacing: .01em;
    }

    .section-subtitle {
        color: #6b7280;
        font-size: .92rem;
        margin-top: .15rem;
    }

    .filter-select,
    .table-search-input,
    .accordion-search-input {
        border-radius: .75rem;
        border: 1px solid #d8e2ee;
        min-height: 42px;
    }

        .filter-select:focus,
        .table-search-input:focus,
        .accordion-search-input:focus {
            border-color: #5b9df9;
            box-shadow: 0 0 0 .2rem rgba(91, 157, 249, .15);
        }

    .msf {
        position: relative;
    }

    .msf-toggle {
        display: flex;
        align-items: center;
        min-height: 42px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .msf-menu {
        position: absolute;
        inset: calc(100% + .35rem) 0 auto 0;
        z-index: 1080;
        background: #fff;
        border: 1px solid #d8e2ee;
        border-radius: .9rem;
        padding: .6rem;
    }

    .msf-search-wrap {
        margin-bottom: .45rem;
    }

    .msf-actions {
        display: flex;
        justify-content: space-between;
        font-size: .82rem;
        margin-bottom: .45rem;
    }

    .msf-options {
        max-height: 210px;
        overflow: auto;
        display: grid;
        gap: .2rem;
    }

    .msf-option {
        display: flex;
        align-items: center;
        gap: .5rem;
        padding: .3rem .25rem;
        border-radius: .55rem;
        cursor: pointer;
    }

        .msf-option:hover {
            background: #f4f8fd;
        }

        .msf-option input {
            margin: 0;
        }

    .msf-empty {
        padding: .5rem .35rem;
        color: #6b7280;
        font-size: .85rem;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .35rem .7rem;
        border-radius: 999px;
        background: #eef4fb;
        color: #294766;
        font-size: .8rem;
        font-weight: 600;
        border: 1px solid #d9e5f2;
    }

    .chip-muted {
        background: #f3f4f6;
        border-color: #e5e7eb;
        color: #4b5563;
    }

    .chip-warning {
        background: #fff8e6;
        border-color: #fde7a8;
        color: #9a6700;
    }

    .chip-success {
        background: #e9f9ef;
        border-color: #b7ebc7;
        color: #146c43;
    }

    .chip-danger {
        background: #feeaec;
        border-color: #f5b9c0;
        color: #b42318;
    }

    .dashboard-tabs {
        gap: .6rem;
        border-bottom: 0;
    }

        .dashboard-tabs .nav-link {
            border: 1px solid #d8e2ee;
            color: #34516f;
            border-radius: .85rem;
            background: #fff;
            padding: .65rem 1rem;
            font-weight: 600;
            box-shadow: 0 4px 14px rgba(15, 23, 42, .04);
        }

            .dashboard-tabs .nav-link:hover {
                background: #f4f8fd;
                border-color: #c6d7ea;
            }

            .dashboard-tabs .nav-link.active {
                color: #fff;
                border-color: #1f6feb;
                background: linear-gradient(135deg, #1565c0 0%, #1f6feb 100%);
                box-shadow: 0 10px 24px rgba(31, 111, 235, .25);
            }

    .mini-panel,
    .table-card {
        border: 1px solid #e3ebf5;
        border-radius: 1rem;
        background: #fff;
        padding: 1rem;
        height: auto;
    }

    .mini-panel-title {
        font-weight: 700;
        color: #294766;
        margin-bottom: .8rem;
        font-size: .95rem;
    }

    .kpi-card {
        border-radius: 1rem;
        padding: 1rem 1.1rem;
