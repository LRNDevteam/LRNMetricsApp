        ("Paid Line Item Count", "lis-number-cell", x => Cnt(x.PaidLineItemCount)),
        ("Paid Line Item Count %", "lis-number-cell", x => Dec(x.PaidLineItemCountPercent)),
        ("Payer Found In Policy", "", x => Txt(x.PayerFoundInPolicy)),
        ("Date of Service", "lis-date-cell", x => Dt(x.DateOfService)),
        ("First Billed Date", "lis-date-cell", x => Dt(x.FirstBilledDate)),
        ("Denial Date", "lis-date-cell", x => Dt(x.DenialDate)),
        ("Panel Name", "lis-wide-cell", x => Txt(x.PanelName)),
        ("LIS ICD10 Codes", "lis-wide-cell", x => Txt(x.LisIcd10Codes)),
        ("CCW ICD10 Code", "lis-wide-cell", x => Txt(x.CcwIcd10Code)),
        ("Units", "lis-number-cell", x => Cnt(x.Units)),
        ("Modifier", "", x => Txt(x.Modifier)),
        ("Referring Provider", "lis-wide-cell", x => Txt(x.ReferringProvider)),
        ("Clinic Name", "lis-wide-cell", x => Txt(x.ClinicName)),
        ("Sales Rep", "lis-wide-cell", x => Txt(x.SalesRepname)),
        ("Denial Code Original", "", x => Txt(x.DenialCodeOriginal)),
        ("Denial Code Normalized", "", x => Txt(x.DenialCodeNormalized)),
        ("Denial Description", "lis-wide-cell", x => Txt(x.DenialDescription)),
        ("Billed Amount", "lis-number-cell", x => Amt(x.BilledAmount)),
        ("Allowed Amount", "lis-number-cell", x => Amt(x.AllowedAmount)),
        ("Insurance Payment", "lis-number-cell", x => Amt(x.InsurancePayment)),
        ("Insurance Adjustment", "lis-number-cell", x => Amt(x.InsuranceAdjustment)),
        ("Patient Paid Amount", "lis-number-cell", x => Amt(x.PatientPaidAmount)),
        ("Patient Adjustment", "lis-number-cell", x => Amt(x.PatientAdjustment)),
        ("Insurance Balance", "lis-number-cell", x => Amt(x.InsuranceBalance)),
        ("Patient Balance", "lis-number-cell", x => Amt(x.PatientBalance)),
        ("Total Balance", "lis-number-cell", x => Amt(x.TotalBalance)),
        ("Medicare Fee", "lis-number-cell", x => Amt(x.MedicareFee)),
        ("Final Claim Status", "", x => Txt(x.FinalClaimStatus)),
        ("Covered ICD10 Codes Billed", "lis-wide-cell", x => Txt(x.CoveredIcd10CodesBilled)),
        ("Non Covered ICD10 Codes Billed", "lis-wide-cell", x => Txt(x.NonCoveredIcd10CodesBilled)),
        ("Billed ICD Codes Not In Payer Policy", "lis-wide-cell", x => Txt(x.BilledIcdCodesNotAvailableInPayerPolicy)),
        ("Coverage Status", "", x => Txt(x.CoverageStatus)),
        ("Final Coverage Status", "", x => Txt(x.FinalCoverageStatus)),
        ("Covered ICD10 Codes Per Payer Policy", "lis-wide-cell", x => Txt(x.CoveredIcd10CodesAsPerPayerPolicy)),
        ("Non Covered ICD10 Codes Per Payer Policy", "lis-wide-cell", x => Txt(x.NonCoveredIcd10CodesAsPerPayerPolicy)),
        ("Action Comment", "lis-wide-cell", x => Txt(x.ActionComment)),
        ("Resolution", "", x => Txt(x.Resolution)),
        ("Lab Name", "lis-wide-cell", x => Txt(x.LabName)),
        ("Coding Validation", "", x => Txt(x.CodingValidation)),
        ("Coding Validation Sub Status", "lis-wide-cell", x => Txt(x.CodingValidationSubStatus)),
        ("ICD Compliance Status", "", x => Txt(x.IcdComplianceStatus)),
        ("ICD Compliance Substatus", "lis-wide-cell", x => Txt(x.IcdComplianceSubstatus)),
        ("ICD Primary Indicator Available", "", x => Txt(x.IcdPrimaryIndicatorAvailable)),
        ("Covered ICD Presence", "", x => Txt(x.CoveredIcdPresence)),
        ("ICD Validation Confidence", "", x => Txt(x.IcdValidationConfidence)),
        ("Frequency Condition Met", "", x => Txt(x.FrequencyConditionMet)),
        ("Gender Condition Met", "", x => Txt(x.GenderConditionMet)),
        ("Payability", "", x => Txt(x.Payability)),
        ("Forecasting Payability", "", x => Txt(x.ForecastingPayability)),
        ("Policy Coverage Expectation", "lis-wide-cell", x => Txt(x.PolicyCoverageExpectation)),
        ("Denial Validity", "", x => Txt(x.DenialValidity)),
        ("Coverage Expectation Remarks", "lis-wide-cell", x => Txt(x.CoverageExpectationRemarks)),
        ("Expected Average Allowed Amount", "lis-number-cell", x => Amt(x.ExpectedAverageAllowedAmount)),
        ("Expected Average Insurance Payment", "lis-number-cell", x => Amt(x.ExpectedAverageInsurancePayment)),
        ("Expected Allowed Amount Same Lab", "lis-number-cell", x => Amt(x.ExpectedAllowedAmountSameLab)),
        ("Expected Insurance Payment Same Lab", "lis-number-cell", x => Amt(x.ExpectedInsurancePaymentSameLab)),
        ("Mode Allowed Amount Same Lab", "lis-number-cell", x => Amt(x.ModeAllowedAmountSameLab)),
        ("Mode Insurance Paid Same Lab", "lis-number-cell", x => Amt(x.ModeInsurancePaidSameLab)),
        ("Mode Allowed Amount Peer", "lis-number-cell", x => Amt(x.ModeAllowedAmountPeer)),
        ("Mode Insurance Paid Peer", "lis-number-cell", x => Amt(x.ModeInsurancePaidPeer)),
        ("Median Allowed Amount Same Lab", "lis-number-cell", x => Amt(x.MedianAllowedAmountSameLab)),
        ("Median Insurance Paid Same Lab", "lis-number-cell", x => Amt(x.MedianInsurancePaidSameLab)),
        ("Median Allowed Amount Peer", "lis-number-cell", x => Amt(x.MedianAllowedAmountPeer)),
