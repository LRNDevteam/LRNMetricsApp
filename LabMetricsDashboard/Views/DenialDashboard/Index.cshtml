    string RecordsPageUrl(int page, string? tabOverride = null) => DashboardUrl(tabOverride ?? activeTab, page, Model.Filters.PageSize, Model.Filters.InsightPage, Model.Filters.InsightPageSize, Model.Filters.LineItemPage, Model.Filters.LineItemPageSize);
    string RecordsPageSizeUrl(int pageSize) => DashboardUrl(activeTab, 1, pageSize, Model.Filters.InsightPage, Model.Filters.InsightPageSize, Model.Filters.LineItemPage, Model.Filters.LineItemPageSize);

    string InsightPageUrl(int page) => DashboardUrl("denial-insight", Model.Filters.Page, Model.Filters.PageSize, page, Model.Filters.InsightPageSize, Model.Filters.LineItemPage, Model.Filters.LineItemPageSize);
    string InsightPageSizeUrl(int pageSize) => DashboardUrl("denial-insight", Model.Filters.Page, Model.Filters.PageSize, 1, pageSize, Model.Filters.LineItemPage, Model.Filters.LineItemPageSize);

    string LineItemPageUrl(int page) => DashboardUrl("line-item", Model.Filters.Page, Model.Filters.PageSize, Model.Filters.InsightPage, Model.Filters.InsightPageSize, page, Model.Filters.LineItemPageSize);
    string LineItemPageSizeUrl(int pageSize) => DashboardUrl("line-item", Model.Filters.Page, Model.Filters.PageSize, Model.Filters.InsightPage, Model.Filters.InsightPageSize, 1, pageSize);

    // Base URLs for the AJAX-swappable grids: carry the current global filters; the client appends
    // page / page-size / per-column filter params (ColumnFilters[Col]=value) before fetching.
    object GridRouteValues(string tab) => new
    {
        lab = Model.CurrentLabName,
        LabId = Model.Filters.LabId,
        DenialCode = Model.Filters.DenialCode,
        Status = Model.Filters.Status,
        Priority = Model.Filters.Priority,
        ActionCategory = Model.Filters.ActionCategory,
        Deadline = Model.Filters.Deadline,
        Classification = Model.Filters.Classification,
        SalesRepname = Model.Filters.SalesRepname,
        ClinicName = Model.Filters.ClinicName,
        ReferringProvider = Model.Filters.ReferringProvider,
        PayerName = Model.Filters.PayerName,
        PayerType = Model.Filters.PayerType,
        PanelName = Model.Filters.PanelName,
        FirstBilledDateFrom = Model.Filters.FirstBilledDateFrom?.ToString("yyyy-MM-dd"),
        FirstBilledDateTo = Model.Filters.FirstBilledDateTo?.ToString("yyyy-MM-dd"),
        DateOfServiceFrom = Model.Filters.DateOfServiceFrom?.ToString("yyyy-MM-dd"),
        DateOfServiceTo = Model.Filters.DateOfServiceTo?.ToString("yyyy-MM-dd"),
        DenialDateFrom = Model.Filters.DenialDateFrom?.ToString("yyyy-MM-dd"),
        DenialDateTo = Model.Filters.DenialDateTo?.ToString("yyyy-MM-dd"),
        ActiveTab = tab
    };
    string LineItemGridUrl() => Url.Action("LineItemGrid", "DenialDashboard", GridRouteValues("line-item")) ?? "#";
    string InsightGridUrl() => Url.Action("InsightGrid", "DenialDashboard", GridRouteValues("denial-insight")) ?? "#";

    // Cell formatters for the DenialLineItem grid.
    const string Dash = "-";
    string Txt(string? value) => string.IsNullOrWhiteSpace(value) ? Dash : value.Trim();
    string Dt(DateTime? value) => value?.ToString("MM/dd/yyyy") ?? Dash;
    string Cnt(int? value) => value?.ToString("N0", usd) ?? Dash;
    string Amt(decimal? value) => value.HasValue ? value.Value.ToString("C2", usd) : Dash;
    string Dec(decimal? value) => value?.ToString("N2", usd) ?? Dash;

    // Every dbo.DenialLineItem column carried by DenialLineItemRecord, in table order.
    // Css: lis-number-cell = right aligned + tabular, lis-date-cell = tabular, lis-wide-cell = clamped width.
    var lineItemColumns = new (string Header, string Css, Func<DenialLineItemRecord, string> Value)[]
    {
        ("Accession No", "fw-semibold", x => Txt(x.AccessionNo)),
        ("Visit Number", "", x => Txt(x.VisitNumber)),
        ("CPT Code", "", x => Txt(x.CptCode)),
        // PatientDOB is deliberately not rendered - PHI, and it was never on this grid before.
        ("Payer Code", "lis-number-cell", x => Cnt(x.PayerCode)),
        ("Payer Name", "lis-wide-cell", x => Txt(x.PayerName)),
        ("Payer Name Normalized", "lis-wide-cell", x => Txt(x.PayerNameNormalized)),
        ("Payer Type", "", x => Txt(x.PayerType)),
        ("Pay Status", "", x => Txt(x.PayStatus)),
        ("Historical Payment", "", x => Txt(x.HistoricalPayment)),
        ("Historical Paid Line Item Count", "lis-number-cell", x => Txt(x.HistoricalPaidLineItemCount)),
        ("Historical Payment Confidence Score", "lis-number-cell", x => Txt(x.HistoricalPaymentConfidenceScore)),
