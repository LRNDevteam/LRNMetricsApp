                    <div>
                        <div class="section-title"><i class="bi bi-bar-chart-line-fill me-2"></i>Insights &nbsp;&nbsp;<span class="chip chip-muted">Run Id: @(string.IsNullOrWhiteSpace(Model.CurrentRunId) ? "-" : Model.CurrentRunId)</span></div>


                    </div>

