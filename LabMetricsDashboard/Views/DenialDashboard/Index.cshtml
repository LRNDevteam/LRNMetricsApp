        margin-bottom: .45rem;
    }

    .kpi-value {
        font-size: 1.65rem;
        font-weight: 800;
        line-height: 1.15;
        color: #0f2942;
    }

    .table-search {
        position: relative;
        min-width: 240px;
    }

        .table-search .bi-search {
            position: absolute;
            top: 50%;
            left: .85rem;
            transform: translateY(-50%);
            color: #7b8794;
            z-index: 2;
        }

        .table-search .form-control {
            padding-left: 2.35rem;
            border-radius: .8rem;
        }

    .app-table thead th {
        background: #f6f9fc;
        color: #37516b;
        font-size: .82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .03em;
        border-bottom-width: 1px;
        white-space: nowrap;
