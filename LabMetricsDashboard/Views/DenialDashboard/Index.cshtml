<script nonce='@Context.Items["CspNonce"]'>
    document.addEventListener('DOMContentLoaded', function () {
        const loader = document.getElementById('pageLoader');
        const activeTabInput = document.getElementById('activeTabInput');
        const tabButtons = document.querySelectorAll('#dashboardTabs button[data-bs-toggle="pill"]');
        const form = document.getElementById('dashboardFilterForm');
        const exportButton = document.getElementById('exportExcelBtn');
        const labSelect = document.getElementById('labSelect');
        const filterCollapse = document.getElementById('dashboardFiltersCollapse');
        const filterToggleText = document.querySelector('#filterCollapseToggle .filter-toggle-text');
        const filterStateKey = 'denialDashboard.filtersCollapsed';

        function showLoader() {
            if (loader) {
                loader.classList.remove('hidden');
            }
        }

        function updateFilterToggleLabel(isShown) {
            if (filterToggleText) {
                filterToggleText.textContent = isShown ? 'Hide Filters' : 'Show Filters';
            }
        }

        if (filterCollapse) {
            const savedState = localStorage.getItem(filterStateKey);
            if (savedState === 'true') {
                filterCollapse.classList.remove('show');
                updateFilterToggleLabel(false);
            }
            else {
                updateFilterToggleLabel(true);
            }

            filterCollapse.addEventListener('shown.bs.collapse', function () {
                localStorage.setItem(filterStateKey, 'false');
                updateFilterToggleLabel(true);
            });

            filterCollapse.addEventListener('hidden.bs.collapse', function () {
                localStorage.setItem(filterStateKey, 'true');
                updateFilterToggleLabel(false);
            });
        }

        function navigateToTab(nextTab) {
            if (!form || !nextTab) {
                return;
            }

            if (activeTabInput) {
                activeTabInput.value = nextTab;
            }

            const pageInput = form.querySelector('input[name="Page"]');
            const insightPageInput = form.querySelector('input[name="InsightPage"]');
            const lineItemPageInput = form.querySelector('input[name="LineItemPage"]');
            if (pageInput) pageInput.value = '1';
            if (insightPageInput) insightPageInput.value = '1';
            if (lineItemPageInput) lineItemPageInput.value = '1';

            const formData = new FormData(form);
            formData.set('ActiveTab', nextTab);
            formData.set('Page', '1');
            formData.set('InsightPage', '1');
            formData.set('LineItemPage', '1');

            const params = new URLSearchParams();
            formData.forEach(function (value, key) {
                if (value === null || value === undefined) {
                    return;
                }

                const text = String(value).trim();
                if (text === '') {
                    return;
                }

                params.append(key, text);
            });

            showLoader();
            window.location.assign(form.action + '?' + params.toString());
        }

        tabButtons.forEach(function (button) {
            button.addEventListener('click', function (event) {
                const target = button.getAttribute('data-bs-target');
                if (!target) {
                    return;
                }

                const nextTab = target.replace('#', '');
                const currentActive = document.querySelector('#dashboardTabs .nav-link.active');
                const currentTarget = currentActive ? ((currentActive.getAttribute('data-bs-target') || '').replace('#', '')) : '';
                if (nextTab === currentTarget) {
                    return;
                }

                event.preventDefault();
                navigateToTab(nextTab);
            });

            button.addEventListener('keydown', function (event) {
                if (event.key === 'Enter' || event.key === ' ') {
                    const target = button.getAttribute('data-bs-target');
                    if (!target) {
                        return;
                    }

                    event.preventDefault();
                    navigateToTab(target.replace('#', ''));
                }
            });
        });

        if (form) {
            form.addEventListener('submit', function () {
                showLoader();
            });
        }

        document.querySelectorAll('.js-loader-link').forEach(function (link) {
            link.addEventListener('click', function () {
                showLoader();
            });
        });

        document.addEventListener('change', function (event) {
            const select = event.target.closest('[data-pager-size]');
            if (!select || !select.value) {
                return;
            }

            showLoader();
            window.location.assign(select.value);
        });

        document.querySelectorAll('.js-loader-button').forEach(function (button) {
            button.addEventListener('click', function () {
                if (!button.id || button.id !== 'exportExcelBtn') {
                    showLoader();
                }
            });
        });

        if (exportButton) {
            exportButton.addEventListener('click', function () {
                if (!form) {
                    return;
                }

                const formData = new FormData(form);
                const labId = formData.get('LabId');
                if (!labId) {
                    alert('Please select a lab first.');
                    return;
                }

                const params = new URLSearchParams();
                formData.forEach(function (value, key) {
                    if (value !== null && value !== undefined && value !== '') {
                        params.append(key, value.toString());
                    }
                });

                showLoader();
                const url = '@Url.Action("ExportToExcel", "DenialDashboard")' + '?' + params.toString();
                window.location.href = url;
                setTimeout(function () {
                    if (loader) {
                        loader.classList.add('hidden');
                    }
                }, 3000);
            });
        }

        document.querySelectorAll('.task-upload-form').forEach(function (formElement) {
            const trigger = formElement.querySelector('.task-upload-trigger');
            const input = formElement.querySelector('.task-upload-input');
            if (!trigger || !input) return;

            trigger.addEventListener('click', function () {
                input.click();
            });

            input.addEventListener('change', function () {
                if (!input.files || input.files.length === 0) {
                    return;
                }
                showLoader();
                formElement.submit();
            });
        });

        document.querySelectorAll('.table-search-input').forEach(function (input) {
            input.addEventListener('input', function () {
                const tableId = input.getAttribute('data-target-table');
                const table = document.getElementById(tableId);
                if (!table) return;
                const searchText = (input.value || '').trim().toLowerCase();
                table.querySelectorAll('tbody tr').forEach(function (row) {
                    const text = (row.innerText || '').toLowerCase();
                    row.style.display = text.includes(searchText) ? '' : 'none';
                });
            });
        });

        // Fullscreen toggle for the main data tables. Each scroll pane is wrapped in a .fs-host and
        // gets a .fs-bar toolbar ABOVE it. Fullscreen expands the pane to a full-viewport overlay
        // and reveals a filter box that hides non-matching rows.
        // Included: the Weekly/Monthly Breakdown pivots (.breakdown-pivot-frame) plus the main
        // data tables. Opted out: the Filter Panel's small summary tables (.panel-table-wrap)
        // and anything marked .no-fs.
        (function setupTableFullscreen() {
            const panes = document.querySelectorAll('.tab-content .table-responsive, .tab-content .lis-scroll, .tab-content .breakdown-pivot-frame');
            // One-shot flag: paging inside fullscreen reloads the page, so we stash
            // which table was expanded and re-open it once the new page arrives.
            const RESTORE_KEY = 'denial-dashboard:fs-restore';
            let activeHost = null;
            function label(btn, on) {
                btn.innerHTML = on
                    ? '<i class="bi bi-fullscreen-exit"></i><span class="fs-label">Exit fullscreen</span>'
                    : '<i class="bi bi-arrows-fullscreen"></i><span class="fs-label">Fullscreen</span>';
                btn.setAttribute('title', on ? 'Exit fullscreen (Esc)' : 'View this table in fullscreen');
            }
            function applyFilter(pane, term) {
                const text = (term || '').trim().toLowerCase();
                pane.querySelectorAll('tbody tr').forEach(function (row) {
                    row.style.display = (!text || (row.innerText || '').toLowerCase().includes(text)) ? '' : 'none';
                });
            }
            // Finds the pager that belongs to a pane: the first .pager-shell that follows the pane
            // in document order, whether it's a direct sibling or sits after the pane's wrapping form.
            function findPagerFor(pane) {
                function nextPagerSibling(node) {
                    let sib = node ? node.nextElementSibling : null;
                    while (sib) {
                        if (sib.classList && sib.classList.contains('pager-shell')) return sib;
                        sib = sib.nextElementSibling;
                    }
                    return null;
                }
                return nextPagerSibling(pane) || nextPagerSibling(pane.closest('form'));
            }
            // Identifies a host across a page reload by the id of the table it wraps.
            function paneKey(host) {
                const table = host.querySelector('table[id]');
                return table ? table.id : '';
            }
            function rememberForRestore(host) {
                const key = paneKey(host);
                if (!key) return;
                try { sessionStorage.setItem(RESTORE_KEY, key); } catch (_) { /* storage disabled */ }
            }
            function toggle(host) {
                const btn = host.querySelector('.fs-btn');
                const filter = host.querySelector('.fs-filter');
                const pane = host.querySelector('.table-responsive, .lis-scroll, .breakdown-pivot-frame');
                const pager = host._pager;
                const on = host.classList.toggle('is-fs');
                document.body.classList.toggle('fs-lock', on);
                activeHost = on ? host : null;
                label(btn, on);
                if (on) {
                    // Pull the server-rendered pager into the overlay so paging stays reachable.
                    if (pager) host.appendChild(pager);
                    filter.value = '';
                    setTimeout(function () { filter.focus(); }, 50);
                } else {
                    // Put the pager back exactly where it was rendered (may be outside the host's form).
                    if (pager && host._pagerHome) host._pagerHome.parent.insertBefore(pager, host._pagerHome.next);
                    if (pane) applyFilter(pane, ''); // restore all rows on exit
                }
            }
            panes.forEach(function (pane) {
                if (pane.closest('.fs-host') || pane.classList.contains('no-fs') || pane.classList.contains('panel-table-wrap')) return;
                const host = document.createElement('div');
                host.className = 'fs-host';
                pane.parentNode.insertBefore(host, pane);

                // A server-rendered pager follows the pane (directly, or after the form the pane
                // is wrapped in - e.g. the Task Board). Keep a handle plus its exact original spot
                // so fullscreen can host it and we can put it back precisely on exit.
                const maybePager = findPagerFor(pane);
                if (maybePager) {
                    host._pager = maybePager;
                    host._pagerHome = { parent: maybePager.parentNode, next: maybePager.nextSibling };
                }

                const bar = document.createElement('div');
                bar.className = 'fs-bar';
                const filter = document.createElement('input');
                filter.type = 'text';
                filter.className = 'fs-filter';
                filter.placeholder = 'Filter rows in fullscreen…';
                filter.addEventListener('input', function () { applyFilter(pane, filter.value); });
                // The insight table's pane sits inside a form - don't let Enter submit it.
                filter.addEventListener('keydown', function (e) { if (e.key === 'Enter') e.preventDefault(); });
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'fs-btn';
                label(btn, false);
                btn.addEventListener('click', function () { toggle(host); });
                bar.appendChild(filter);
                bar.appendChild(btn);

                host.appendChild(bar);
                host.appendChild(pane);

                // Paging from inside the overlay navigates away; flag a re-open first.
                if (host._pager) {
                    host._pager.addEventListener('click', function (e) {
                        const link = e.target.closest('a.pager-btn');
                        if (!link || link.classList.contains('disabled') || !host.classList.contains('is-fs')) return;
                        rememberForRestore(host);
                    });
                    host._pager.addEventListener('change', function (e) {
                        if (!e.target.closest('[data-pager-size]') || !host.classList.contains('is-fs')) return;
                        rememberForRestore(host);
                    });
                }
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && activeHost) toggle(activeHost);
            });

            // Re-enter fullscreen when a paging reload asked us to.
            let restoreKey = null;
            try { restoreKey = sessionStorage.getItem(RESTORE_KEY); } catch (_) { /* storage disabled */ }
            if (restoreKey) {
                try { sessionStorage.removeItem(RESTORE_KEY); } catch (_) { /* storage disabled */ }
                const target = Array.prototype.find.call(document.querySelectorAll('.fs-host'), function (host) {
                    return paneKey(host) === restoreKey;
                });
                if (target) toggle(target);
            }
        })();

        // Excel-style AJAX grids (Line Item + Denial Insight): server-side paging and per-column
        // filtering that swap only the grid body, with a loading overlay and a persistent fullscreen
        // shell so paging/filtering never drops you out of fullscreen.
        (function setupAjaxGrids() {
            document.querySelectorAll('.ajax-grid').forEach(function (grid) {
                const base = grid.getAttribute('data-grid-base');
                const pageParam = grid.getAttribute('data-page-param');
                const sizeParam = grid.getAttribute('data-size-param');
                const content = grid.querySelector('.grid-content');
                const loading = grid.querySelector('.grid-loading');
                const fsBtn = grid.querySelector('.grid-fs-btn');
                if (!base || !content) return;

                let debounceTimer = null;
                let pendingFocusCol = null;
                let pendingCaret = null;

                function collectColumnFilters() {
                    const parts = [];
                    grid.querySelectorAll('.col-filter').forEach(function (input) {
                        const value = (input.value || '').trim();
                        if (value) {
                            const col = input.getAttribute('data-col');
                            parts.push('ColumnFilters[' + encodeURIComponent(col) + ']=' + encodeURIComponent(value));
                        }
                    });
                    return parts;
                }

                function currentSize() {
                    const select = grid.querySelector('[data-grid-size]');
                    return select ? select.value : null;
                }

                function buildUrl(page, size) {
                    const parts = [];
                    if (page != null) parts.push(encodeURIComponent(pageParam) + '=' + encodeURIComponent(page));
                    if (size != null) parts.push(encodeURIComponent(sizeParam) + '=' + encodeURIComponent(size));
                    collectColumnFilters().forEach(function (p) { parts.push(p); });
                    if (!parts.length) return base;
                    return base + (base.indexOf('?') >= 0 ? '&' : '?') + parts.join('&');
                }

                function reapplyQuickSearch() {
                    // Re-run the loaded-rows quick search against the freshly swapped table.
                    const container = grid.closest('.card-body') || document;
                    container.querySelectorAll('.table-search-input').forEach(function (input) {
                        if (input.value) input.dispatchEvent(new Event('input', { bubbles: true }));
                    });
                }

                function restoreFocus() {
                    if (!pendingFocusCol) return;
                    const selector = '.col-filter[data-col="' + pendingFocusCol.replace(/"/g, '\\"') + '"]';
                    const input = grid.querySelector(selector);
                    if (input) {
                        input.focus();
                        const caret = pendingCaret == null ? input.value.length : pendingCaret;
                        try { input.setSelectionRange(caret, caret); } catch (e) { }
                    }
                    pendingFocusCol = null;
                    pendingCaret = null;
                }

                async function load(page, size) {
                    const url = buildUrl(page, size != null ? size : currentSize());
                    if (loading) loading.hidden = false;
                    grid.classList.add('is-loading');
                    try {
                        const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' });
                        if (!response.ok) throw new Error('Grid load failed: ' + response.status);
                        content.innerHTML = await response.text();
                        restoreFocus();
                        reapplyQuickSearch();
                        // The swapped-in grid table is a fresh element - re-wire column sorting on it.
                        if (window.initSortableTables) window.initSortableTables(content);
                    } catch (err) {
                        console.error(err);
                    } finally {
                        if (loading) loading.hidden = true;
                        grid.classList.remove('is-loading');
                    }
                }

                grid.addEventListener('click', function (e) {
                    const btn = e.target.closest('.grid-page-btn');
                    if (!btn || btn.disabled || btn.classList.contains('disabled')) return;
                    e.preventDefault();
                    const page = parseInt(btn.getAttribute('data-page'), 10);
                    if (!isNaN(page)) load(page, null);
                });

                grid.addEventListener('change', function (e) {
                    const select = e.target.closest('[data-grid-size]');
                    if (!select) return;
                    e.preventDefault();
                    load(1, select.value);
                });

                grid.addEventListener('input', function (e) {
                    const input = e.target.closest('.col-filter');
                    if (!input) return;
                    pendingFocusCol = input.getAttribute('data-col');
                    pendingCaret = input.selectionStart;
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(function () { load(1, null); }, 450);
                });

                grid.addEventListener('keydown', function (e) {
                    if (e.key !== 'Enter') return;
                    const input = e.target.closest('.col-filter');
                    if (!input) return;
                    e.preventDefault();
                    pendingFocusCol = input.getAttribute('data-col');
                    pendingCaret = input.selectionStart;
                    clearTimeout(debounceTimer);
                    load(1, null);
                });

                function setFsLabel(on) {
                    if (!fsBtn) return;
                    fsBtn.innerHTML = on
                        ? '<i class="bi bi-fullscreen-exit"></i><span class="fs-label">Exit fullscreen</span>'
                        : '<i class="bi bi-arrows-fullscreen"></i><span class="fs-label">Fullscreen</span>';
                    fsBtn.setAttribute('title', on ? 'Exit fullscreen (Esc)' : 'View this grid in fullscreen');
                }

                if (fsBtn) {
                    fsBtn.addEventListener('click', function () {
                        const on = grid.classList.toggle('is-grid-fs');
                        setFsLabel(on);
                        document.body.classList.toggle('fs-lock', on || document.querySelector('.fs-host.is-fs') != null);
                    });
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key !== 'Escape') return;
                const open = document.querySelector('.ajax-grid.is-grid-fs');
                if (!open) return;
                open.classList.remove('is-grid-fs');
                const btn = open.querySelector('.grid-fs-btn');
                if (btn) btn.innerHTML = '<i class="bi bi-arrows-fullscreen"></i><span class="fs-label">Fullscreen</span>';
                if (!document.querySelector('.fs-host.is-fs')) document.body.classList.remove('fs-lock');
            });
        })();

        document.querySelectorAll('.accordion-search-input').forEach(function (input) {
            input.addEventListener('input', function () {
                const accordionId = input.getAttribute('data-target-accordion');
                const accordion = document.getElementById(accordionId);
                if (!accordion) return;
                const searchText = (input.value || '').trim().toLowerCase();
                accordion.querySelectorAll('.claim-group-item').forEach(function (item) {
                    const text = (item.innerText || '').toLowerCase();
                    item.style.display = text.includes(searchText) ? '' : 'none';
                });
            });
        });

        const autocompleteUrl = '@Url.Action("GetFilterAutocompleteOptions", "DenialDashboard")';
        const autocompleteCachePrefix = 'denial-dashboard:autocomplete:';
        const labIdHidden = document.getElementById('labIdHidden');

        function uniqueValues(values) {
            const seen = new Set();
            return (values || []).filter(function (value) {
                const normalized = (value || '').trim();
                if (!normalized) return false;
                const key = normalized.toLowerCase();
                if (seen.has(key)) return false;
                seen.add(key);
                return true;
            });
        }

        function summarizeSelection(values, placeholder) {
            const selected = uniqueValues(values);
            if (!selected.length) return placeholder;
            if (selected.length === 1) return selected[0];
            if (selected.length === 2) return selected.join(', ');
            return selected.length + ' selected';
        }

        function initMultiSelect(container) {
            const name = container.dataset.name;
            const placeholder = container.dataset.placeholder || 'Select';
            const parsedOptions = JSON.parse(container.dataset.options || '[]');
            const parsedSelected = JSON.parse(container.dataset.selected || '[]');
            let options = uniqueValues(parsedOptions);
            let selected = uniqueValues(parsedSelected);

            container.innerHTML = '';
            container.classList.add('msf');
            container.innerHTML = `
                    <input type="hidden" name="${name}" class="msf-hidden" />
                    <button type="button" class="form-select filter-select text-start msf-toggle"></button>
                    <div class="msf-menu shadow-sm d-none">
                        <div class="msf-search-wrap"><input type="text" class="form-control form-control-sm msf-search" placeholder="Search..." autocomplete="off" /></div>
                        <div class="msf-actions">
                            <button type="button" class="btn btn-link btn-sm p-0 msf-select-all">Select all</button>
                            <button type="button" class="btn btn-link btn-sm p-0 msf-clear">Clear</button>
                        </div>
                        <div class="msf-options"></div>
                    </div>`;

            const hiddenInput = container.querySelector('.msf-hidden');
            const toggle = container.querySelector('.msf-toggle');
            const menu = container.querySelector('.msf-menu');
            const search = container.querySelector('.msf-search');
            const optionsWrap = container.querySelector('.msf-options');
            const selectAllButton = container.querySelector('.msf-select-all');
            const clearButton = container.querySelector('.msf-clear');

            function syncHidden() {
                hiddenInput.value = uniqueValues(selected).join('|');
                toggle.textContent = summarizeSelection(selected, placeholder);
            }

            function renderOptions(filterText) {
                const term = (filterText || '').trim().toLowerCase();
                const optionList = term
                    ? options.filter(function (value) { return value.toLowerCase().includes(term); })
                    : options.slice();

                optionsWrap.innerHTML = '';
                if (!optionList.length) {
                    optionsWrap.innerHTML = '<div class="msf-empty">No matches</div>';
                    return;
                }

                optionList.forEach(function (value) {
                    const row = document.createElement('label');
                    row.className = 'msf-option';
                    const checked = selected.some(function (item) { return item.toLowerCase() === value.toLowerCase(); });
                    row.innerHTML = `<input type="checkbox" value="${value.replace(/"/g, '&quot;')}" ${checked ? 'checked' : ''} /> <span>${value}</span>`;
                    const input = row.querySelector('input');
                    input.addEventListener('change', function () {
                        if (input.checked) {
                            selected.push(value);
                        } else {
                            selected = selected.filter(function (item) { return item.toLowerCase() !== value.toLowerCase(); });
                        }
                        selected = uniqueValues(selected);
                        syncHidden();
                    });
                    optionsWrap.appendChild(row);
                });
            }

            function setOptions(nextOptions) {
                options = uniqueValues([].concat(nextOptions || [], selected));
                renderOptions(search.value);
                syncHidden();
            }

            toggle.addEventListener('click', function () {
                document.querySelectorAll('.msf-menu').forEach(function (item) {
                    if (item !== menu) item.classList.add('d-none');
                });
                menu.classList.toggle('d-none');
                if (!menu.classList.contains('d-none')) {
                    search.focus();
                }
            });

            search.addEventListener('input', function () {
                renderOptions(search.value);
            });

            selectAllButton.addEventListener('click', function () {
                selected = uniqueValues(options.slice());
                renderOptions(search.value);
                syncHidden();
            });

            clearButton.addEventListener('click', function () {
                selected = [];
                renderOptions(search.value);
                syncHidden();
            });

            container._multiSelect = { setOptions: setOptions, getSelected: function () { return selected.slice(); } };
            renderOptions('');
            syncHidden();
        }

        document.querySelectorAll('.multi-select-filter').forEach(initMultiSelect);

        document.addEventListener('click', function (event) {
            document.querySelectorAll('.multi-select-filter').forEach(function (container) {
                if (!container.contains(event.target)) {
                    const menu = container.querySelector('.msf-menu');
                    if (menu) menu.classList.add('d-none');
                }
            });
        });

        function getAutocompleteLabId() {
            return labIdHidden ? (labIdHidden.value || '').trim() : '';
        }

        function syncSelectedLabId() {
            if (!labSelect || !labIdHidden) return;
            const selectedOption = labSelect.options[labSelect.selectedIndex];
            const nextLabId = selectedOption ? (selectedOption.getAttribute('data-lab-id') || '') : '';
            labIdHidden.value = nextLabId;
        }

        syncSelectedLabId();

        function applyAutocompletePayload(payload) {
            if (!payload) return;

            const payloadMap = {
                payerNames: payload.payerNames || payload.PayerNames || [],
                payerTypes: payload.payerTypes || payload.PayerTypes || [],
                panelNames: payload.panelNames || payload.PanelNames || [],
                referringProviders: payload.referringProviders || payload.ReferringProviders || [],
                clinicNames: payload.clinicNames || payload.ClinicNames || [],
                salesRepnames: payload.salesRepnames || payload.SalesRepnames || []
            };

            document.querySelectorAll('.remote-multi-select').forEach(function (container) {
                const key = container.dataset.remoteKey;
                if (container._multiSelect && payloadMap[key]) {
                    container._multiSelect.setOptions(payloadMap[key]);
                }
            });
        }

        async function loadFilterAutocomplete(forceRefresh) {
            const labId = getAutocompleteLabId();
            if (!labId) return;

            const cacheKey = autocompleteCachePrefix + labId;
            if (!forceRefresh) {
                const cached = localStorage.getItem(cacheKey);
                if (cached) {
                    try {
                        applyAutocompletePayload(JSON.parse(cached));
                        return;
                    } catch (error) {
                        localStorage.removeItem(cacheKey);
                    }
                }
            }

            try {
                const response = await fetch(autocompleteUrl + '?labId=' + encodeURIComponent(labId), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (!response.ok) return;

                const payload = await response.json();
                localStorage.setItem(cacheKey, JSON.stringify(payload));
                applyAutocompletePayload(payload);
            } catch (error) {
                console.warn('Unable to load filter autocomplete values.', error);
            }
        }

        if (labSelect) {
            const loadAutocompleteIfVisible = function (forceRefresh) {
                const collapseHidden = filterCollapse && !filterCollapse.classList.contains('show');
                if (collapseHidden) {
                    return;
                }
                loadFilterAutocomplete(forceRefresh);
            };

            loadAutocompleteIfVisible(false);

            if (filterCollapse) {
                filterCollapse.addEventListener('shown.bs.collapse', function () {
                    loadAutocompleteIfVisible(false);
                });
            }

            labSelect.addEventListener('change', function () {
                syncSelectedLabId();
                loadAutocompleteIfVisible(true);
            });
        }

        function parseSortableValue(value) {
            const raw = (value || '').trim();
            const cleaned = raw.replace(/[$,%]/g, '').replace(/,/g, '').trim();
            const numeric = Number(cleaned);
            if (cleaned !== '' && !Number.isNaN(numeric)) {
                return numeric;
            }

            const parsedDate = Date.parse(raw);
            if (!Number.isNaN(parsedDate)) {
                return parsedDate;
            }

            return raw.toLowerCase();
        }

        // Client-side column sorting for every .sortable-table. Reusable + idempotent so it can be
        // re-run after an AJAX grid swap (Line Item) without double-binding. Sorts the current page's
        // rows. Only the column-HEADER row is wired - a secondary column-filter row (excel grids like
        // Line Item render filter inputs in a second <thead> row) is skipped.
        function initSortableTables(root) {
            (root || document).querySelectorAll('table.sortable-table').forEach(function (table) {
                if (table.dataset.sortableInit === '1') return;
                const tbody = table.querySelector('tbody');
                if (!tbody) return;
                const headRow = table.querySelector('thead tr.grid-head-row') || table.querySelector('thead tr');
                if (!headRow) return;
                table.dataset.sortableInit = '1';

                const headers = Array.from(headRow.children).filter(function (el) { return el.tagName === 'TH'; });
                headers.forEach(function (header) {
                    const index = header.cellIndex; // column position -> matching <td> index in each row
                    header.classList.add('sortable-header');
                    header.setAttribute('role', 'button');
                    header.setAttribute('tabindex', '0');
                    header.setAttribute('title', 'Sort');

                    function sortTable() {
                        const currentDirection = header.getAttribute('data-sort-direction') === 'asc' ? 'asc' : 'desc';
                        const nextDirection = currentDirection === 'asc' ? 'desc' : 'asc';
                        headers.forEach(function (th) {
                            th.removeAttribute('data-sort-direction');
                            th.classList.remove('sorted-asc', 'sorted-desc');
                        });
                        header.setAttribute('data-sort-direction', nextDirection);
                        header.classList.add(nextDirection === 'asc' ? 'sorted-asc' : 'sorted-desc');

                        const rows = Array.from(tbody.querySelectorAll('tr')).filter(function (row) {
                            return !row.querySelector('td[colspan]');
                        });

                        rows.sort(function (a, b) {
                            const aText = a.children[index] ? a.children[index].innerText : '';
                            const bText = b.children[index] ? b.children[index].innerText : '';
                            const aValue = parseSortableValue(aText);
                            const bValue = parseSortableValue(bText);

                            if (aValue < bValue) return nextDirection === 'asc' ? -1 : 1;
                            if (aValue > bValue) return nextDirection === 'asc' ? 1 : -1;
                            return 0;
                        });

                        rows.forEach(function (row) {
                            tbody.appendChild(row);
                        });
                    }

                    header.addEventListener('click', sortTable);
                    header.addEventListener('keydown', function (event) {
                        if (event.key === 'Enter' || event.key === ' ') {
                            event.preventDefault();
                            sortTable();
                        }
                    });
                });
            });
        }
        window.initSortableTables = initSortableTables;
        initSortableTables(document);
    });
</script>