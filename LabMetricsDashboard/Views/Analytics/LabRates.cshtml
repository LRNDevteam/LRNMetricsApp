@model LabMetricsDashboard.Models.LabRatePageViewModel
@{
    ViewData["Title"] = Model.Title;
}

<style>
    .lr-shell { display: flex; flex-direction: column; gap: 1rem; }
    .lr-titlebar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .lr-title { display: flex; align-items: center; gap: .8rem; }
    .lr-title-icon { width: 44px; height: 44px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #2563eb, #7c3aed); color: #fff; font-size: 1.25rem; box-shadow: 0 8px 18px rgba(37, 99, 235, .3); }
    .lr-title h2 { margin: 0; font-size: 1.45rem; font-weight: 800; color: #162033; }
    .lr-title small { color: #64748b; font-weight: 600; }
    .lr-card { background: #fff; border: 1px solid #d9e2ef; border-radius: 10px; box-shadow: 0 6px 18px rgba(15, 23, 42, .06); }
    .lr-filter { padding: 1rem 1rem .9rem; }
    .lr-filter .form-label { margin-bottom: .25rem; font-size: .72rem; color: #475569; font-weight: 800; text-transform: uppercase; letter-spacing: .03em; }
    .lr-combo { position: relative; }
    .lr-combo > input { padding-right: 1.9rem; }
    .lr-combo::after { content: "\F282"; font-family: "bootstrap-icons"; position: absolute; right: .65rem; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: .7rem; pointer-events: none; }
    .lr-combo-list { position: absolute; top: 100%; left: 0; right: 0; z-index: 40; margin-top: .3rem; background: #fff; border: 1px solid #cbd5e1; border-radius: .55rem; box-shadow: 0 14px 30px rgba(15, 23, 42, .18); max-height: 265px; overflow: auto; display: none; }
    .lr-combo-list.open { display: block; }
    .lr-combo-item { padding: .42rem .75rem; cursor: pointer; font-size: .82rem; color: #1e293b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .lr-combo-item:hover { background: #eff6ff; color: #1d4ed8; }
    .lr-combo-empty { padding: .55rem .75rem; color: #94a3b8; font-size: .78rem; }
    .lr-grid-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .65rem 1rem; border-bottom: 1px solid #e2e8f0; background: linear-gradient(180deg, #fbfdff, #f4f7fb); border-radius: 10px 10px 0 0; flex-wrap: wrap; }
    .lr-chip { display: inline-flex; align-items: center; gap: .4rem; background: #eef2ff; color: #3730a3; border-radius: 999px; padding: .28rem .8rem; font-size: .76rem; font-weight: 800; }
    .lr-pagesize { display: flex; align-items: center; gap: .5rem; font-size: .76rem; color: #475569; font-weight: 700; }
    .lr-pagesize select { width: auto; font-size: .8rem; }
    .lr-grid-wrap { position: relative; }
    .lr-grid-scroll { overflow: auto; max-height: calc(100vh - 360px); min-height: 280px; }
    .lr-table { min-width: 1250px; font-size: .8rem; }
    .lr-table th, .lr-table td { border: 1px solid #d8e1ee; }
    .lr-table thead th { position: sticky; top: 0; z-index: 2; background: #f8fafc; color: #0f172a; white-space: nowrap; font-size: .73rem; text-transform: uppercase; letter-spacing: .02em; }
    .lr-table thead th.lr-sort { cursor: pointer; user-select: none; }
    .lr-table thead th.lr-sort:hover { background: #e8eef7; }
    .lr-table thead th .lr-dir { color: #2563eb; margin-left: .25rem; }
    .lr-table tbody tr:nth-child(even) { background: #fbfdff; }
    .lr-table tbody tr:hover { background: #f0f6ff; }
    .lr-table tbody td { white-space: nowrap; max-width: 240px; overflow: hidden; text-overflow: ellipsis; vertical-align: middle; }
    .lr-table td.lr-num, .lr-table th.lr-num { text-align: right; font-variant-numeric: tabular-nums; }
    .lr-loader { display: none; position: absolute; inset: 0; z-index: 5; align-items: center; justify-content: center; background: rgba(248, 250, 252, .74); }
    .lr-loader.active { display: flex; }
    .lr-loader-box { background: #0f172a; color: white; border-radius: 8px; padding: .75rem 1rem; display: inline-flex; gap: .7rem; align-items: center; }
    .lr-empty { padding: 3.5rem 1rem; text-align: center; color: #64748b; }
    .lr-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .75rem 1rem; border-top: 1px solid #e2e8f0; flex-wrap: wrap; }
    .lr-note { font-size: .76rem; color: #9AA5B1; }
</style>

<div class="lr-shell">
    <div class="lr-titlebar">
        <div class="lr-title">
            <span class="lr-title-icon"><i class="bi @(Model.Title == "Modes" ? "bi-bar-chart-line" : "bi-graph-up")"></i></span>
            <div>
                <h2>@Model.Title</h2>
                <small>@Model.Subtitle</small>
            </div>
        </div>
        <button class="btn btn-success" type="button" id="exportBtn">
            <i class="bi bi-file-earmark-excel"></i> Export to Excel
        </button>
    </div>

    <div class="lr-card lr-filter">
        <form id="filterForm" class="row g-3 align-items-end">
            <div class="col-lg-3 col-md-6">
                <label class="form-label">Payer Name</label>
                <div class="lr-combo" data-field="payerName">
                    <input class="form-control" name="payerName" autocomplete="off" placeholder="All payers" />
                    <div class="lr-combo-list"></div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">Panel Name</label>
                <div class="lr-combo" data-field="panelName">
                    <input class="form-control" name="panelName" autocomplete="off" placeholder="All panels" />
                    <div class="lr-combo-list"></div>
                </div>
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label">CPT Code</label>
                <div class="lr-combo" data-field="cptCode">
                    <input class="form-control" name="cptCode" autocomplete="off" placeholder="All CPT codes" />
                    <div class="lr-combo-list"></div>
                </div>
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label">Lab</label>
                <select class="form-select" name="labId" id="labSelect"><option value="">All Labs</option></select>
            </div>
            <div class="col-lg-2 col-md-12 d-flex gap-2 justify-content-end">
                <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Search</button>
                <button class="btn btn-outline-secondary" type="button" id="resetBtn" title="Clear all filters"><i class="bi bi-arrow-counterclockwise"></i></button>
            </div>
        </form>
    </div>

    <div class="lr-card lr-grid-wrap">
        <div class="lr-grid-head">
            <span class="lr-chip"><i class="bi bi-collection"></i> <span id="totalChip">0 records</span></span>
            <div class="lr-pagesize">
                <span>Rows per page</span>
                <select class="form-select form-select-sm" id="pageSizeSelect">
                    <option selected>50</option>
                    <option>100</option>
                    <option>250</option>
                    <option>500</option>
                    <option>1000</option>
                </select>
            </div>
        </div>
        <div class="lr-loader" id="gridLoader"><div class="lr-loader-box"><span class="spinner-border spinner-border-sm"></span><span>Loading...</span></div></div>
        <div class="lr-grid-scroll">
            <table class="table table-sm table-hover table-bordered align-middle lr-table mb-0">
                <thead><tr id="headRow"></tr></thead>
                <tbody id="rows"></tbody>
            </table>
        </div>
        <div class="lr-footer">
            <small id="pageInfo" class="text-muted"></small>
            <div class="btn-group">
                <button class="btn btn-outline-secondary btn-sm" id="firstBtn" title="First page"><i class="bi bi-chevron-double-left"></i></button>
                <button class="btn btn-outline-secondary btn-sm" id="prevBtn"><i class="bi bi-chevron-left"></i> Previous</button>
                <button class="btn btn-outline-secondary btn-sm" id="nextBtn">Next <i class="bi bi-chevron-right"></i></button>
                <button class="btn btn-outline-secondary btn-sm" id="lastBtn" title="Last page"><i class="bi bi-chevron-double-right"></i></button>
            </div>
        </div>
    </div>
    <p class="lr-note mb-0">View-only reference data. Click a column header to sort; click again to reverse. Export downloads every row matching the current filters.</p>
</div>

@section Scripts {
<script nonce='@Context.Items["CspNonce"]'>
(function(){
const columns=@Html.Raw(Json.Serialize(Model.Columns));
const urls={data:'@Model.DataUrl',labs:'@Model.LabsUrl',options:'@Model.OptionsUrl',exportUrl:'@Model.ExportUrl'};
let page=1,pageSize=50,totalPages=1,sortColumn='payerName',sortDirection='asc';
const loader=document.getElementById('gridLoader');
const usd=new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'});
const num=new Intl.NumberFormat('en-US');
function esc(v){return (v??'').toString().replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}
function setBusy(on){loader.classList.toggle('active',on);}
function fmt(v,type){
  if(v===null||v===undefined||v==='')return '&#8212;';
  if(type==='money')return esc(usd.format(v));
  if(type==='int')return esc(num.format(v));
  return esc(v);
}
function filterParams(){
  const fd=new FormData(document.getElementById('filterForm'));
  fd.set('sortColumn',sortColumn);fd.set('sortDirection',sortDirection);
  return fd;
}
function renderHead(){
  document.getElementById('headRow').innerHTML=columns.map(c=>{
    const dir=sortColumn===c.key?`<span class="lr-dir">${sortDirection==='asc'?'&#9650;':'&#9660;'}</span>`:'';
    const numCls=c.type==='money'||c.type==='int'?' lr-num':'';
    return `<th class="lr-sort${numCls}" data-key="${esc(c.key)}" title="Sort by ${esc(c.label)}">${esc(c.label)}${dir}</th>`;
  }).join('');
  document.querySelectorAll('#headRow th.lr-sort').forEach(th=>{
    th.onclick=()=>{
      const key=th.dataset.key;
      if(sortColumn===key){sortDirection=sortDirection==='asc'?'desc':'asc';}
      else{sortColumn=key;sortDirection='asc';}
      page=1;load();
    };
  });
}
function renderRows(items){
  document.getElementById('rows').innerHTML=(items||[]).map(x=>
    `<tr>${columns.map(c=>{
      const numCls=c.type==='money'||c.type==='int'?' class="lr-num"':'';
      return `<td${numCls} title="${esc(x[c.key])}">${fmt(x[c.key],c.type)}</td>`;
    }).join('')}</tr>`
  ).join('')||`<tr><td colspan="${columns.length}"><div class="lr-empty"><div class="fw-bold">No records found</div><div>Adjust the filters above.</div></div></td></tr>`;
}
function updatePager(){
  document.getElementById('firstBtn').disabled=document.getElementById('prevBtn').disabled=page<=1;
  document.getElementById('nextBtn').disabled=document.getElementById('lastBtn').disabled=page>=totalPages;
}
async function load(){
  setBusy(true);
  try{
    const fd=filterParams();
    fd.set('page',page);fd.set('pageSize',pageSize);
    const r=await fetch(urls.data+'?'+new URLSearchParams(fd));
    const d=await r.json();
    totalPages=Math.max(1,d.totalPages||1);
    if(page>totalPages)page=totalPages;
    const total=d.totalCount||0;
    const from=total===0?0:((d.page-1)*d.pageSize)+1;
    const to=Math.min(d.page*d.pageSize,total);
    document.getElementById('totalChip').textContent=`${num.format(total)} record${total===1?'':'s'}`;
    document.getElementById('pageInfo').textContent=`Showing ${num.format(from)}-${num.format(to)} of ${num.format(total)} - Page ${d.page||1} of ${totalPages}`;
    renderHead();
    renderRows(d.items);
    updatePager();
  }catch(e){document.getElementById('rows').innerHTML=`<tr><td colspan="${columns.length}"><div class="lr-empty text-danger">Unable to load the data. Please try again.</div></td></tr>`;}
  finally{setBusy(false);}
}
async function loadLabs(){
  try{
    const r=await fetch(urls.labs);
    const labs=await r.json();
    document.getElementById('labSelect').innerHTML='<option value="">All Labs</option>'+(labs||[]).map(l=>`<option value="${l.labId}">${esc(l.labName)}</option>`).join('');
  }catch(e){/* lab filter stays on All Labs */}
}
// Searchable autocomplete dropdowns for Payer / Panel / CPT (server-side distinct values).
function initCombo(wrap){
  const input=wrap.querySelector('input');
  const list=wrap.querySelector('.lr-combo-list');
  const field=wrap.dataset.field;
  let timer=null;
  async function fetchOptions(){
    const p=new URLSearchParams({field,term:input.value||''});
    const lab=document.getElementById('labSelect').value;
    if(lab)p.set('labId',lab);
    let items=[];
    try{const r=await fetch(urls.options+'?'+p);items=await r.json();}catch(e){}
    if(document.activeElement!==input)return;
    list.innerHTML=(items&&items.length)
      ?items.map(v=>`<div class="lr-combo-item" data-value="${esc(v)}" title="${esc(v)}">${esc(v)}</div>`).join('')
      :'<div class="lr-combo-empty">No matches</div>';
    list.querySelectorAll('.lr-combo-item').forEach(el=>{
      el.onmousedown=e=>{
        e.preventDefault();
        input.value=el.getAttribute('data-value');
        list.classList.remove('open');
        page=1;load();
      };
    });
    list.classList.add('open');
  }
  input.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(fetchOptions,250);});
  input.addEventListener('focus',fetchOptions);
  input.addEventListener('blur',()=>setTimeout(()=>list.classList.remove('open'),150));
  input.addEventListener('keydown',e=>{if(e.key==='Escape')list.classList.remove('open');});
}
document.querySelectorAll('.lr-combo').forEach(initCombo);
document.getElementById('filterForm').onsubmit=e=>{e.preventDefault();page=1;load();};
document.getElementById('labSelect').onchange=()=>{page=1;load();};
document.getElementById('resetBtn').onclick=()=>{
  document.getElementById('filterForm').reset();
  document.getElementById('pageSizeSelect').value='50';
  pageSize=50;sortColumn='payerName';sortDirection='asc';page=1;load();
};
document.getElementById('pageSizeSelect').onchange=e=>{pageSize=parseInt(e.target.value,10)||50;page=1;load();};
document.getElementById('firstBtn').onclick=()=>{if(page>1){page=1;load();}};
document.getElementById('prevBtn').onclick=()=>{if(page>1){page--;load();}};
document.getElementById('nextBtn').onclick=()=>{if(page<totalPages){page++;load();}};
document.getElementById('lastBtn').onclick=()=>{if(page<totalPages){page=totalPages;load();}};
document.getElementById('exportBtn').onclick=()=>{
  window.location=urls.exportUrl+'?'+new URLSearchParams(filterParams());
};
renderHead();
loadLabs();
load();
})();
</script>
}
