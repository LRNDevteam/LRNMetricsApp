@{
    Layout = null;
    ViewData["Title"] = "Access pending";
    var pendingUser = TempData["PendingUser"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access pending</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <style>
        body{background:linear-gradient(135deg,#0d1b2a,#1565c0);min-height:100vh;display:grid;place-items:center;color:#fff;font-family:'Segoe UI',sans-serif;padding:1rem}
        .box{background:#fff;color:#1a2744;padding:2.5rem 2.75rem;border-radius:18px;box-shadow:0 30px 80px rgba(0,0,0,.4);max-width:480px;text-align:center}
        .icon{font-size:2.75rem;color:#b45309;line-height:1}
    </style>
</head>
<body>
    <div class="box">
        <div class="icon mb-2"><i class="bi bi-hourglass-split"></i></div>
        <h3 class="fw-bold mb-2">Access pending</h3>
        <p class="mb-2">
            You signed in successfully@(string.IsNullOrWhiteSpace(pendingUser) ? "" : $" as {pendingUser}"),
            but your account has no LRN role yet.
        </p>
        <p class="text-muted mb-4">Ask your LRN administrator to assign you a role and lab(s), then sign in again.</p>
        <div class="d-flex flex-column gap-2">
            <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Back to sign in</a>
            @if (ViewData["EnableMicrosoftLogin"] is true)
            {
                <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="MicrosoftLogin">Use a different Microsoft account</a>
            }
        </div>
    </div>
</body>
</html>
