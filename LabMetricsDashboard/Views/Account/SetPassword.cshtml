@model LabMetricsDashboard.Controllers.SetPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Create your password - Lab Revenue Intelligence";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <style>
        * { box-sizing: border-box; }
        html, body { min-height: 100%; margin: 0; }
        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background:
                radial-gradient(1100px 600px at 12% 18%, rgba(100,181,246,.18), transparent 60%),
                radial-gradient(900px 600px at 92% 84%, rgba(0,184,212,.18), transparent 60%),
                linear-gradient(135deg, #0d1b2a 0%, #1b3a5c 55%, #1565c0 100%);
            min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem 1rem;
        }
        .sp-card {
            width: 100%; max-width: 460px; background: rgba(255,255,255,.97); color: #1a2744;
            border-radius: 24px; box-shadow: 0 30px 80px rgba(0,0,0,.4); padding: 2.25rem 2.25rem 1.75rem;
        }
        .sp-brand { display: flex; align-items: center; justify-content: center; gap: .6rem; margin-bottom: 1.1rem; }
        .sp-brand img { height: 38px; width: auto; filter: brightness(.2); }
        .sp-brand .name { font-weight: 800; color: #0d1b2a; font-size: .95rem; letter-spacing: .04em; line-height: 1.1; }
        .sp-brand .name small { display: block; font-weight: 600; color: #64748b; font-size: .62rem; letter-spacing: .18em; text-transform: uppercase; }
        h2 { margin: 0 0 .25rem; font-weight: 800; color: #0d1b2a; font-size: 1.5rem; }
        .subtitle { color: #64748b; font-size: .88rem; margin-bottom: 1.3rem; }
        .form-label { font-size: .72rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: #5a6a8a; margin-bottom: .35rem; }
        .form-control { padding: .7rem .85rem; font-size: .95rem; border-radius: 12px; border-color: #d1d9e6; }
        .form-control:focus { border-color: #1565c0; box-shadow: 0 0 0 3px rgba(21,101,192,.12); }
        .otp { font-family: Consolas, monospace; letter-spacing: .25em; text-transform: uppercase; }
        .user-chip { background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 12px; padding: .6rem .85rem; font-family: Consolas, monospace; font-weight: 600; }
        .btn-primary-lrn {
            width: 100%; background: linear-gradient(135deg, #1565c0, #00b8d4); color: #fff; font-weight: 700;
            border: none; border-radius: 12px; padding: .85rem 1rem; font-size: .95rem; letter-spacing: .04em;
            box-shadow: 0 8px 22px rgba(21,101,192,.35);
        }
        .btn-primary-lrn:hover { filter: brightness(1.05); color: #fff; }
        .alert-sp { border-radius: 12px; padding: .7rem .9rem; font-size: .85rem; background: #fff5f5; color: #b91c1c; border: 1px solid #fecaca; display: flex; gap: .5rem; }
        .hint { font-size: .78rem; color: #64748b; }
        .footer { margin-top: 1.4rem; text-align: center; color: #94a3b8; font-size: .78rem; }
    </style>
</head>
<body>
<main class="sp-card">
    <div class="sp-brand">
        <img src="~/images/LRN-White-Logo-footer-1-1.png" alt="LRN Logo" />
        <div class="name">Lab Revenue Intelligence<small>Navigator</small></div>
    </div>

    @if (!Model.LinkValid)
    {
        <h2>Link not valid</h2>
        <div class="subtitle">This password link can no longer be used.</div>
        <div class="alert-sp mb-3">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>@(Model.Message ?? "The link has expired, has already been used, or was replaced by a newer invitation. Ask your administrator to resend the invitation email.")</div>
        </div>
        <a class="btn btn-primary-lrn" href="./Login">Go to sign in</a>
    }
    else
    {
        <h2>Create your password</h2>
        <div class="subtitle">Enter the one-time password from your invitation email, then choose a new password.</div>

        <form action="./SetPassword" method="post" autocomplete="off" id="setPasswordForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Token" value="@Model.Token" />

            <div class="mb-3">
                <span class="form-label d-block">Username</span>
                <div class="user-chip">@Model.UserName</div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="OneTimePassword">One-time password</label>
                <input name="OneTimePassword" id="OneTimePassword" class="form-control otp" maxlength="20" required autofocus
                       autocomplete="one-time-code" value="" />
                <span asp-validation-for="OneTimePassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" for="NewPassword">New password</label>
                <input name="NewPassword" id="NewPassword" type="password" class="form-control" maxlength="128" required autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                <div class="hint mt-1">At least 8 characters, with a letter and a number.</div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="ConfirmPassword">Confirm new password</label>
                <input name="ConfirmPassword" id="ConfirmPassword" type="password" class="form-control" maxlength="128" required autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="showPwd" />
                <label class="form-check-label small" for="showPwd">Show passwords</label>
            </div>

            <button type="submit" class="btn btn-primary-lrn"><i class="bi bi-shield-lock me-1"></i> Set password</button>
        </form>
    }

    <div class="footer">Need help? Contact your administrator.</div>
</main>

<script nonce='@Context.Items["CspNonce"]'>
    (function () {
        var box = document.getElementById('showPwd');
        if (!box) return;
        box.addEventListener('change', function () {
            ['NewPassword', 'ConfirmPassword'].forEach(function (id) {
                var el = document.getElementById(id);
                if (el) el.type = box.checked ? 'text' : 'password';
            });
        });
    })();
</script>
</body>
</html>
