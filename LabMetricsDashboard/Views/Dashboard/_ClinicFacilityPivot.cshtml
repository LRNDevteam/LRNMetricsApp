@model ClinicFacilityPivotViewModel

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning" style="font-size:.85rem">
        <i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage
    </div>
    return;
}

@if (Model.Clinics.Count == 0)
{
    <div class="text-center text-muted py-4" style="font-size:.85rem">No data available.</div>
    return;
}

@{
    var monthNames = new[] { "", "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
    var yearMonths = Model.Years.ToDictionary(y => y, y => Model.Columns.Where(c => c.Year == y).ToList());
    var amountHeader = Model.HasPanelRows ? "Ins Payment" : "Charges";
    var tableId = Model.HasPanelRows ? "cfc" : "cfpr";
}

<style>
.cfx-scroll { max-height: 72vh; overflow: auto; }
.cfx-table { border-collapse: separate; border-spacing: 0; font-size: .74rem; }
.cfx-table thead th {
    background: linear-gradient(135deg, #0a1628 0%, #0e3460 50%, #0d5c74 100%);
    color: rgba(255,255,255,.9); font-weight: 700; font-size: .62rem;
    letter-spacing: .04em; text-transform: uppercase;
    padding: .45rem .6rem; text-align: center;
    white-space: nowrap; height: 28px; box-sizing: border-box;
    position: sticky; z-index: 3;
    border-bottom: 1px solid #0a2a4a;
    border-right: 1px solid rgba(255,255,255,.08);
}
.cfx-table thead tr:nth-child(1) th { top: 0;    z-index: 4; }
.cfx-table thead tr:nth-child(2) th { top: 28px; }
.cfx-table thead tr:nth-child(3) th { top: 56px; font-size: .58rem; }
.cfx-table thead tr:first-child th:first-child {
    text-align: left; min-width: 260px; left: 0; z-index: 5;
    background: linear-gradient(135deg, #0a1628 0%, #0e3460 100%);
}
.cfx-table thead th.cfx-sep { border-left: 2px solid rgba(255,255,255,.25); }
.cfx-table thead th.cfx-total-hdr { background: linear-gradient(135deg, #1a2e1a 0%, #2d5a2d 100%); }
.cfx-table td {
    padding: .4rem .6rem; vertical-align: middle; text-align: right; white-space: nowrap;
    border-right: 1px solid #e5e7eb; border-bottom: 1px solid #e5e7eb;
    font-variant-numeric: tabular-nums;
}
.cfx-table td:first-child {
    text-align: left; font-weight: 600; color: #1e293b;
    position: sticky; left: 0; z-index: 1; background: #fff;
}
.cfx-table tbody tr:hover td { background: #f0f4ff; }
.cfx-table td.cfx-sep { border-left: 2px solid #dde3ea; }
.cfx-table td.cfx-total { font-weight: 700; color: #0e3460; background: #f4f8ee; }
.cfx-zero { color: #c0c4cc; }
.cfx-clinic-row[data-cfx-toggle] { cursor: pointer; }
.cfx-clinic-row[data-cfx-toggle] td:first-child .bi { transition: transform .15s; display: inline-block; }
.cfx-clinic-row.cfx-expanded td:first-child .bi { transform: rotate(90deg); }
.cfx-panel-row { display: none; }
.cfx-panel-row.cfx-open { display: table-row; }
.cfx-panel-row td:first-child { padding-left: 2rem; font-weight: 400; color: #475569; }
.cfx-table tfoot td {
    background: #f1f5f9; font-weight: 700; color: #0e3460;
    padding: .5rem .6rem; border-top: 2px solid #0a2a4a;
    position: sticky; bottom: 0; z-index: 2;
}
.cfx-table tfoot td:first-child { z-index: 3; background: #f1f5f9; }
.cfx-table tfoot td.cfx-total { background: #e8f0dc; }
</style>

@functions {
    private Microsoft.AspNetCore.Html.IHtmlContent Cells(ClinicFacilityPivotCell? cell, string cssClass)
    {
        var count = cell?.ClaimCount ?? 0;
        var amount = cell?.Amount ?? 0m;
        var builder = new Microsoft.AspNetCore.Html.HtmlContentBuilder();
        builder.AppendHtml($"<td class=\"cfx-sep {cssClass} {(count == 0 ? "cfx-zero" : "")}\">{count.N0OrDash()}</td>");
        builder.AppendHtml($"<td class=\"{cssClass}\">");
        builder.AppendHtml(Acct2(amount));
        builder.AppendHtml("</td>");
        return builder;
    }

    private Microsoft.AspNetCore.Html.IHtmlContent RowCells(ClinicFacilityPivotRow row, List<int> years, Dictionary<int, List<(int Year, int Month)>> yearMonths)
    {
        var builder = new Microsoft.AspNetCore.Html.HtmlContentBuilder();
        foreach (var y in years)
        {
            foreach (var col in yearMonths[y])
                builder.AppendHtml(Cells(row.Months.GetValueOrDefault(ClinicFacilityPivotViewModel.ColKey(col.Year, col.Month)), ""));
            builder.AppendHtml(Cells(row.Years.GetValueOrDefault(y), "cfx-total"));
        }
        builder.AppendHtml(Cells(row.Total, "cfx-total"));
        return builder;
    }
}

<div class="cfx-scroll" id="@(tableId)Root">
    <table class="cfx-table">
        <thead>
            <tr>
                <th rowspan="3"><i class="bi bi-building me-1"></i>@(Model.HasPanelRows ? "Clinic Name / Panel Name" : "Clinic Name")</th>
                @foreach (var y in Model.Years)
                {
                    <th class="cfx-sep" colspan="@(yearMonths[y].Count * 2)">@Model.DateBasisLabel @y</th>
                    <th class="cfx-sep cfx-total-hdr" colspan="2" rowspan="2">@y Total</th>
                }
                <th class="cfx-sep cfx-total-hdr" colspan="2" rowspan="2">Grand Total</th>
            </tr>
            <tr>
                @foreach (var y in Model.Years)
                {
                    foreach (var col in yearMonths[y])
                    {
                        <th class="cfx-sep" colspan="2">@monthNames[col.Month] @col.Year</th>
                    }
                }
            </tr>
            <tr>
                @for (var g = 0; g < Model.Columns.Count + Model.Years.Count + 1; g++)
                {
                    <th class="cfx-sep">Claims</th>
                    <th>@amountHeader</th>
                }
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Model.Clinics.Count; i++)
            {
                var clinic = Model.Clinics[i];
                var groupId = $"{tableId}-{i}";
                if (Model.HasPanelRows && clinic.Children.Count > 0)
                {
                    <tr class="cfx-clinic-row" data-cfx-toggle="@groupId" title="Show / hide panels">
                        <td><i class="bi bi-chevron-right me-1"></i>@clinic.Name</td>
                        @RowCells(clinic, Model.Years, yearMonths)
                    </tr>
                    foreach (var panel in clinic.Children)
                    {
                        <tr class="cfx-panel-row" data-cfx-parent="@groupId">
                            <td>@panel.Name</td>
                            @RowCells(panel, Model.Years, yearMonths)
                        </tr>
                    }
                }
                else
                {
                    <tr class="cfx-clinic-row">
                        <td>@clinic.Name</td>
                        @RowCells(clinic, Model.Years, yearMonths)
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr>
                <td>Grand Total</td>
                @foreach (var y in Model.Years)
                {
                    foreach (var col in yearMonths[y])
                    {
                        @Cells(Model.ColumnTotals.GetValueOrDefault(ClinicFacilityPivotViewModel.ColKey(col.Year, col.Month)), "")
                    }
                    @Cells(Model.YearTotals.GetValueOrDefault(y), "cfx-total")
                }
                @Cells(Model.GrandTotal, "cfx-total")
            </tr>
        </tfoot>
    </table>
</div>

<div class="text-muted mt-2" style="font-size:.68rem">
    @Model.Note @(Model.HasPanelRows ? "· Click a clinic to show its panels" : "") · Lab: @Model.SelectedLab
</div>
