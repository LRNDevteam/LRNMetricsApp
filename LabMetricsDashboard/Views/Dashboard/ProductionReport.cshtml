    }

    <div class="tab-content" id="prTabContent"
         data-pr-key="@ViewData["PrCacheKey"]"
         data-pr-tab-url="@Url.Action("ProductionSummaryReportTab", "Dashboard")"
         data-pr-meta-url="@Url.Action("ProductionSummaryReportMeta", "Dashboard")">

        <!-- ??? Monthly Claim Volume tab pane ????????????????????? -->
        @if (prChrome || PrShow("monthly-pane"))
        {
        <div class="tab-pane fade show active" id="monthly-pane" role="tabpanel" aria-labelledby="monthly-tab" data-pr-lazy="monthly-pane">
            @if (PrShow("monthly-pane"))
            {
            @if (Model.PanelRows.Count > 0 && validYears.Count > 0)
            {
                <div class="pr-wrap">
                    <div class="pr-scroll">
                        <table class="pr-table">
                            <colgroup>
                                <col style="width:200px" />
                                @foreach (var year in validYears)
                                {
                                    var cgMons = monthsByYear.ContainsKey(year) ? monthsByYear[year] : new List<string>();
                                    foreach (var mk in cgMons)
                                    {
                                        <col style="width:52px" />
                                        <col style="width:68px" />
                                    }
                                    <col style="width:72px" />
                                    <col style="width:86px" />
                                }
                                <col style="width:72px" />
                                <col style="width:86px" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th rowspan="3">Panel &amp; Insurance</th>
                                    @foreach (var year in validYears)
                                    {
                                        var mons = monthsByYear.ContainsKey(year) ? monthsByYear[year] : new List<string>();
                                        int monthDataCols = mons.Count * 2;
                                        int yearTotalCols = 2;
                                        <th colspan="@(monthDataCols + yearTotalCols)">
                                            Data based on Billed Date &mdash; @year
                                        </th>
                                    }
                                    <th colspan="2" class="pr-grand-total">Grand Total</th>
                                </tr>
                                <tr>
                                    @foreach (var year in validYears)
                                    {
                                        var mons = monthsByYear.ContainsKey(year) ? monthsByYear[year] : new List<string>();
                                        foreach (var mk in mons)
                                        {
                                            <th colspan="2">@MonthLabel(mk)</th>
                                        }
                                        <th colspan="2" class="pr-year-total">@year Total</th>
                                    }
                                    <th colspan="2" class="pr-grand-total"></th>
                                </tr>
                                <tr>
                                    @foreach (var year in validYears)
                                    {
                                        var mons = monthsByYear.ContainsKey(year) ? monthsByYear[year] : new List<string>();
                                        foreach (var mk in mons)
                                        {
                                            <th class="pr-month-data">No. of Claims</th>
                                            <th class="pr-month-data">Total Billed Charges</th>
                                        }
                                        <th class="pr-year-total">No. of Claims</th>
                                        <th class="pr-year-total">Total Billed Charges</th>
                                    }
                                    <th class="pr-grand-total">No. of Claims</th>
                                    <th class="pr-grand-total">Total Billed Charges</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int panelIdx = 0; }
                                @foreach (var panel in Model.PanelRows)
                                {
                                    var letter = (char)('A' + panelIdx % 26);
                                    var mcvGroupId = $"mcv-{panelIdx}";
                                    <tr class="pr-panel-row pr-hp-toggle" data-hp-group="@mcvGroupId" role="button" aria-expanded="false" title="Open / close payers">
                                        <td><i class="bi bi-chevron-right pr-hp-chevron" aria-hidden="true"></i>@letter &nbsp; @panel.PanelName</td>
                                        @foreach (var year in validYears)
                                        {
                                            var mons = monthsByYear.ContainsKey(year) ? monthsByYear[year] : new List<string>();
                                            foreach (var mk in mons)
                                            {
                                                <td class="pr-month-data">@CellClaims(panel.ByMonth, mk).ToString("N0")</td>
                                                <td class="pr-month-data">@Acct(CellCharges(panel.ByMonth, mk))</td>
                                            }
                                            <td class="pr-year-total">@YearClaims(panel.ByYear, year).ToString("N0")</td>
                                            <td class="pr-year-total">@Acct(YearCharges(panel.ByYear, year))</td>
                                        }
                                        <td class="pr-grand-total">@panel.TotalClaims.ToString("N0")</td>
                                        <td class="pr-grand-total">@Acct(panel.TotalCharges)</td>
                                    </tr>

                                    @foreach (var payer in panel.TopPayers)
                                    {
                                        <tr class="pr-payer-row pr-hp-child" data-hp-parent="@mcvGroupId">
                                            <td>@payer.PayerName</td>
                                            @foreach (var year in validYears)
                                            {
                                                var mons = monthsByYear.ContainsKey(year) ? monthsByYear[year] : new List<string>();
                                                foreach (var mk in mons)
                                                {
                                                    <td class="pr-month-data">@CellClaims(payer.ByMonth, mk).ToString("N0")</td>
                                                    <td class="pr-month-data">@Acct(CellCharges(payer.ByMonth, mk))</td>
                                                }
                                                <td class="pr-year-total">@YearClaims(payer.ByYear, year).ToString("N0")</td>
                                                <td class="pr-year-total">@Acct(YearCharges(payer.ByYear, year))</td>
                                            }
                                            <td class="pr-grand-total">@payer.TotalClaims.ToString("N0")</td>
                                            <td class="pr-grand-total">@Acct(payer.TotalCharges)</td>
                                        </tr>
                                    }

                                    panelIdx++;
                                }
                            </tbody>
                            <tfoot>
                                <tr class="pr-total-row">
                                    <td>Grand Total</td>
                                    @foreach (var year in validYears)
                                    {
                                        var mons = monthsByYear.ContainsKey(year) ? monthsByYear[year] : new List<string>();
                                        foreach (var mk in mons)
                                        {
                                            <td class="pr-month-data">@CellClaims(Model.GrandTotalByMonth, mk).ToString("N0")</td>
                                            <td class="pr-month-data">@Acct(CellCharges(Model.GrandTotalByMonth, mk))</td>
                                        }
                                        <td class="pr-year-total">@GrandYearClaims(year).ToString("N0")</td>
                                        <td class="pr-year-total">@Acct(GrandYearCharges(year))</td>
                                    }
                                    <td class="pr-grand-total">@grandClaims.ToString("N0")</td>
                                    <td class="pr-grand-total">@Acct(grandCharges)</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    
                    <div class="px-3 py-2 small text-muted">
                        @{
                            var ppRule = Model.ProductionSummaryRule;
                            var ppUsesCharge = string.Equals(ppRule, "Rule1", StringComparison.OrdinalIgnoreCase)
                                || string.Equals(ppRule, "Rule2", StringComparison.OrdinalIgnoreCase)
                                || string.Equals(ppRule, "Rule3", StringComparison.OrdinalIgnoreCase)
                                || string.Equals(ppRule, "Rule4", StringComparison.OrdinalIgnoreCase);
                            var ppDateLabel = ppUsesCharge ? "Charge Entered Date" : "First Billed Date";
                            var ppSelectedPayers = Model.FilterPayerNames != null && Model.FilterPayerNames.Count > 0
                                ? string.Join(", ", Model.FilterPayerNames) : "All";
                            var ppSelectedPanels = Model.FilterPanelNames != null && Model.FilterPanelNames.Count > 0
                                ? string.Join(", ", Model.FilterPanelNames) : "All";
                            var ppFbFromLbl = string.IsNullOrWhiteSpace(Model.FilterFirstBillFrom) ? "-" : Model.FilterFirstBillFrom;
                            var ppFbToLbl = string.IsNullOrWhiteSpace(Model.FilterFirstBillTo) ? "-" : Model.FilterFirstBillTo;
                        }
                        <strong>Date axis:</strong> @ppDateLabel
                        &nbsp;|&nbsp; <strong>Payers:</strong> @ppSelectedPayers
                        &nbsp;|&nbsp; <strong>Panels:</strong> @ppSelectedPanels
                        &nbsp;|&nbsp; <strong>Filter Range:</strong> @ppFbFromLbl — @ppFbToLbl
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <div style="font-size:2rem;opacity:.4">&#128202;</div>
                    <div class="fw-semibold mt-2">No monthly claim volume data available</div>
                    <div class="small mt-1">Try adjusting your filters or selecting a different lab.</div>
                </div>
            }

            @* ── Active rule footer (dull) ────────────────────────────── *@
            @* <div class="pr-rule-footer mt-3 small text-muted" style="opacity:.65;line-height:1.45;border-top:1px dashed #cfd6df;padding-top:.5rem">
                <div><span class="fw-semibold">Active Rule:</span> @activeRule</div>
                @if (isRule1)
                {
                    <div class="mt-1"><span class="fw-semibold">Rule1 Logic:</span></div>
                    <ul class="mb-0 ps-3" style="font-size:.78rem">
                        <li>Source: <code>ClaimLevelData</code> (all rows)</li>
                        <li>Rows: <code>PanelName</code> &nbsp;·&nbsp; Drill-down: Top 3 <code>PayerName</code> by <code>COUNT(DISTINCT ClaimID)</code></li>
                        <li>Columns: <code>YEAR(ChargeEnteredDate)</code> / <code>MONTH(ChargeEnteredDate)</code></li>
                        <li>Filter: <code>PayerName</code> not blank &nbsp;·&nbsp; <code>FirstBilledDate</code> is a valid date</li>
                        <li>Rank by: <code>COUNT(DISTINCT ClaimID)</code> &nbsp;·&nbsp; Sort: Grand Total descending</li>
                        <li>Cell metrics: <code>COUNT(DISTINCT ClaimID)</code> + <code>SUM(ChargeAmount)</code></li>
                    </ul>
                }
                else if (isRule2)
                {
                    <div class="mt-1"><span class="fw-semibold">Rule2 Logic</span> <span class="fst-italic">(Certus Laboratories)</span><span class="fw-semibold">:</span></div>
