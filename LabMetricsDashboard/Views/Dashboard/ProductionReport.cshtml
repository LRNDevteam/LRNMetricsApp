        <li class="nav-item" role="presentation">
            <button class="nav-link" id="unbilled-aging-tab" data-bs-toggle="pill"
                    data-bs-target="#unbilled-aging-pane" type="button" role="tab"
                    aria-controls="unbilled-aging-pane" aria-selected="false">
                <i class="bi bi-hourglass-split"></i> Unbilled X Aging
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="cpt-breakdown-tab" data-bs-toggle="pill"
                    data-bs-target="#cpt-breakdown-pane" type="button" role="tab"
                    aria-controls="cpt-breakdown-pane" aria-selected="false">
                <i class="bi bi-list-ol"></i> CPT Breakdown
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="panel-breakdown-tab" data-bs-toggle="pill"
