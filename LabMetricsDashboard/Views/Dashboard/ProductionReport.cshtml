        @if (Model.IsNorthWestLab)
        {
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="insight-tab" data-bs-toggle="pill"
                    data-bs-target="#insight-pane" type="button" role="tab"
                    aria-controls="insight-pane" aria-selected="false">
                <i class="bi bi-lightbulb"></i> Insight
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="highest-payer-tab" data-bs-toggle="pill"
                    data-bs-target="#highest-payer-pane" type="button" role="tab"
                    aria-controls="highest-payer-pane" aria-selected="false">
                <i class="bi bi-trophy"></i> Highest payer Breakdown
            </button>
