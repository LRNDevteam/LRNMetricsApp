                    || string.Equals(pbRuleLocal, "Rule3", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(pbRuleLocal, "Rule4", StringComparison.OrdinalIgnoreCase);
                var pbDateColLocal = pbUsesChargeLocal ? "ChargeEnteredDate" : "FirstBilledDate";
