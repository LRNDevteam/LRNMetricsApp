@if (prChrome)
{
<script nonce='@Context.Items["CspNonce"]'>
    // Multi-select dropdown widget (matches Clinic Summary pattern)
    document.addEventListener('DOMContentLoaded', function () {
        var tabHost = document.getElementById('prTabContent');
        if (tabHost) {
            var tabUrl = tabHost.getAttribute('data-pr-tab-url');
            var tabKey = tabHost.getAttribute('data-pr-key');
            var metaUrl = tabHost.getAttribute('data-pr-meta-url');
            function fillMsList(listEl, names, inputName) {
                if (!listEl || !names || !names.length) return;
                listEl.innerHTML = '';
                names.forEach(function (name) {
                    var label = document.createElement('label');
                    var input = document.createElement('input');
                    input.type = 'checkbox';
                    input.name = inputName;
                    input.value = name;
                    label.appendChild(input);
                    label.appendChild(document.createTextNode(' ' + name));
                    listEl.appendChild(label);
                });
            }
            function fillBanner(d) {
                var el = document.getElementById('pr-analysis-banner');
                if (!el || !d || !(d.weekFolder || d.runId || d.inserted)) return;
                var wrap = document.createElement('div');
                wrap.className = 'd-flex flex-wrap gap-3 align-items-center mb-3 px-1';
                wrap.style.fontSize = '.82rem';
                wrap.style.color = '#374151';
                function addPair(label, value) {
                    if (!value) return;
                    var span = document.createElement('span');
                    var lab = document.createElement('span');
                    lab.className = 'fw-semibold text-secondary';
                    lab.style.fontSize = '.72rem';
                    lab.style.letterSpacing = '.04em';
                    lab.style.textTransform = 'uppercase';
                    lab.textContent = label;
                    var val = document.createElement('span');
                    val.className = 'ms-1 fw-semibold';
                    val.style.color = '#0e3460';
                    val.textContent = value;
                    span.appendChild(lab);
                    span.appendChild(val);
                    wrap.appendChild(span);
                }
                var range = document.createElement('span');
                range.innerHTML = '<span class="fw-semibold text-secondary" style="font-size:.72rem;letter-spacing:.04em;text-transform:uppercase;">Analysis Range:</span><span class="ms-1 fw-semibold text-dark">Billed Week Range</span>';
                if (d.weekFolder) {
                    var dash = document.createElement('span');
                    dash.className = 'ms-1 text-muted';
                    dash.textContent = ' — ';
                    var folder = document.createElement('span');
                    folder.className = 'ms-1 fw-semibold';
                    folder.style.color = '#0e3460';
                    folder.textContent = d.weekFolder;
                    range.appendChild(dash);
                    range.appendChild(folder);
                }
                wrap.appendChild(range);
                addPair('ReportId (RunID):', d.runId);
                addPair('Inserted Date:', d.inserted);
                el.innerHTML = '';
                el.appendChild(wrap);
            }
            if (metaUrl && tabKey) {
                fetch(metaUrl + '?key=' + encodeURIComponent(tabKey), { credentials: 'same-origin' })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (d) {
                        if (!d) return;
                        fillMsList(document.getElementById('prPayerList'), d.payers, 'filterPayerNames');
                        fillMsList(document.getElementById('prPanelList'), d.panels, 'filterPanelNames');
                        fillBanner(d);
                    })
                    .catch(function () { });
            }
            function loadPrPane(pane) {
                if (!pane || !pane.hasAttribute('data-pr-lazy') || pane.getAttribute('data-pr-loaded') === '1') return;
                if (!tabUrl || !tabKey) return;
                pane.setAttribute('data-pr-loaded', '1');
                pane.innerHTML = '<div class="pr-tab-loading"><div class="pr-tab-spinner" role="status" aria-label="Loading"></div><div>' +
                    (pane.id === 'monthly-pane' ? 'Loading monthly data\u2026' : 'Loading tab\u2026') + '</div></div>';
                if (pane.id === 'monthly-pane' && window.lmdFpLog) {
                    window.lmdFpLog('spinner-on', 'page landed — in-tab spinner on');
                }
                fetch(tabUrl + '?key=' + encodeURIComponent(tabKey) + '&pane=' + encodeURIComponent(pane.id), { credentials: 'same-origin' })
                    .then(function (r) {
                        if (!r.ok) throw new Error('tab ' + r.status);
                        return r.text();
                    })
                    .then(function (html) {
                        var tmp = document.createElement('div');
                        tmp.innerHTML = html;
                        var inner = tmp.querySelector('#' + pane.id) || tmp;
                        pane.innerHTML = inner.id === pane.id ? inner.innerHTML : tmp.innerHTML;
                        if (pane.id === 'monthly-pane' && window.lmdFpLog) {
                            window.lmdFpLog('monthly-html', 'monthly tab HTML on screen');
                        }
                    })
                    .catch(function () {
                        pane.setAttribute('data-pr-loaded', '0');
                        pane.innerHTML = '<div class="text-center py-5 text-danger">Could not load this tab. Refresh the page.</div>';
                    });
            }
            document.getElementById('prTabs')?.addEventListener('show.bs.tab', function (e) {
                var btn = e.target.closest('[data-bs-target]');
                var sel = btn && btn.getAttribute('data-bs-target');
                loadPrPane(sel && document.querySelector(sel));
            });
            loadPrPane(document.querySelector('#prTabContent .tab-pane.active[data-pr-lazy]'));
        }

        var sourceToggle = document.getElementById('insightSourceToggle');
        if (sourceToggle) {
            sourceToggle.addEventListener('click', function (e) {
                var btn = e.target.closest('.pr-source-toggle-btn');
                if (!btn) return;
                sourceToggle.querySelectorAll('.pr-source-toggle-btn').forEach(function (b) {
                    var on = b === btn;
                    b.classList.toggle('active', on);
                    b.setAttribute('aria-selected', on ? 'true' : 'false');
                });
            });
        }

        var cptSourceToggle = document.getElementById('cptSourceToggle');
        if (cptSourceToggle) {
            cptSourceToggle.addEventListener('click', function (e) {
                var btn = e.target.closest('.pr-source-toggle-btn');
                if (!btn) return;
                cptSourceToggle.querySelectorAll('.pr-source-toggle-btn').forEach(function (b) {
                    var on = b === btn;
                    b.classList.toggle('active', on);
                    b.setAttribute('aria-selected', on ? 'true' : 'false');
                });
            });
        }

        document.addEventListener('click', function (e) {
            var srcBtn = e.target.closest ? e.target.closest('.pr-source-toggle-btn') : null;
            if (srcBtn) {
                var toggle = srcBtn.closest('.pr-source-toggle');
                if (toggle) {
                    toggle.querySelectorAll('.pr-source-toggle-btn').forEach(function (b) {
                        var on = b === srcBtn;
                        b.classList.toggle('active', on);
                        b.setAttribute('aria-selected', on ? 'true' : 'false');
                    });
                }
            }
            var row = e.target.closest ? e.target.closest('.pr-hp-toggle') : null;
            if (!row) return;
            var group = row.getAttribute('data-hp-group');
            if (!group) return;
            var table = row.closest('table');
            var open = row.classList.toggle('pr-hp-open');
            row.setAttribute('aria-expanded', open ? 'true' : 'false');
            var children = (table || document).querySelectorAll('.pr-hp-child[data-hp-parent="' + group + '"]');
            children.forEach(function (child) {
                child.classList.toggle('pr-hp-shown', open);
            });
        });

        document.querySelectorAll('.pr-ms').forEach(function (ms) {
            var btn = ms.querySelector('.pr-ms-btn');
            var panel = ms.querySelector('.pr-ms-panel');
            var search = ms.querySelector('.pr-ms-search');
            var labelEl = ms.querySelector('.pr-ms-label');
            var countEl = ms.querySelector('.pr-ms-count');
            function liveLabels() { return ms.querySelectorAll('.pr-ms-list label'); }

            function updateLabel() {
                var checked = ms.querySelectorAll('.pr-ms-list input:checked');
                if (checked.length === 0) {
                    labelEl.textContent = 'All';
                    countEl.style.display = 'none';
                } else if (checked.length === 1) {
                    labelEl.textContent = checked[0].value;
                    countEl.style.display = 'none';
                } else {
                    labelEl.textContent = checked[0].value;
                    countEl.textContent = '+' + (checked.length - 1);
                    countEl.style.display = '';
                }
            }

            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                document.querySelectorAll('.pr-ms-panel.open').forEach(function (p) {
                    if (p !== panel) p.classList.remove('open');
                });
                panel.classList.toggle('open');
                if (panel.classList.contains('open') && search) {
                    search.value = '';
                    search.focus();
                    liveLabels().forEach(function (l) { l.classList.remove('pr-ms-hidden'); });
                }
            });

            if (search) {
                search.addEventListener('input', function () {
                    var q = this.value.toLowerCase();
                    liveLabels().forEach(function (l) {
                        var text = l.textContent.toLowerCase();
                        l.classList.toggle('pr-ms-hidden', q.length > 0 && text.indexOf(q) === -1);
                    });
                });
            }

            var list = ms.querySelector('.pr-ms-list');
            if (list) list.addEventListener('change', updateLabel);

            panel.addEventListener('click', function (e) { e.stopPropagation(); });

            updateLabel();
        });

        document.addEventListener('click', function () {
            document.querySelectorAll('.pr-ms-panel.open').forEach(function (p) {
                p.classList.remove('open');
            });
        });

        // Export Excel with progress overlay
        var exportBtn = document.getElementById('exportExcelBtn');
        if (exportBtn) {
            var overlay = document.getElementById('prExportOverlay');
            var bar = document.getElementById('prExportBar');
            var pctLabel = document.getElementById('prExportPct');
            var statusLabel = document.getElementById('prExportStatus');
            var cancelBtn = document.getElementById('prExportCancelBtn');

            var steps = [
                { pct: 8,  text: 'Connecting to database\u2026' },
                { pct: 18, text: 'Fetching Monthly Claim Volume\u2026' },
                { pct: 26, text: 'Fetching Weekly Claim Volume\u2026' },
                { pct: 34, text: 'Fetching Coding data\u2026' },
                { pct: 42, text: 'Fetching Payer Breakdown\u2026' },
                { pct: 50, text: 'Fetching Payer x Panel\u2026' },
                { pct: 56, text: 'Fetching Unbilled Aging\u2026' },
                { pct: 62, text: 'Fetching CPT Breakdown\u2026' },
                { pct: 70, text: 'Fetching ClaimLevelData rows\u2026' },
                { pct: 78, text: 'Fetching LineLevelData rows\u2026' },
                { pct: 86, text: 'Building Excel workbook\u2026' },
                { pct: 94, text: 'Finalizing sheets & formatting\u2026' }
            ];

            function prGetCookie(name) {
                var m = document.cookie.match('(^|;)\\s*' + name + '=([^;]*)');
                return m ? m[2] : null;
            }
            function prDeleteCookie(name) {
                document.cookie = name + '=; path=/; max-age=0';
            }
            function prCleanup(p, c, s, iframe) {
                clearInterval(p); clearInterval(c); clearInterval(s);
                if (iframe && iframe.parentNode) document.body.removeChild(iframe);
            }

            // ── Async export (preferred): queue via UserReqReports; LRN.ReportWorker
            // generates the workbook in the background and the 📄 Reports badge
            // notifies when ready. Falls back to the legacy synchronous download
            // when the lab has no queue table (400) or the queue call fails.
            exportBtn.addEventListener('click', function () {
                var form = document.getElementById('prFilterForm');
                if (!form) return;

                var fd = new FormData(form);
                var val = function (n) { return (fd.get(n) || '').toString().trim() || null; };
                var all = function (n) {
                    var v = fd.getAll(n).map(function (x) { return x.toString().trim(); })
                             .filter(function (x) { return x.length > 0; });
                    return v.length > 0 ? v : null;
                };
                var filters = {
                    PayerNames:      all('filterPayerNames'),
                    PanelNames:      all('filterPanelNames'),
                    DosFrom:         val('filterDosFrom'),
                    DosTo:           val('filterDosTo'),
                    FirstBillFrom:   val('filterFirstBillFrom'),
                    FirstBillTo:     val('filterFirstBillTo'),
                    FirstBilledFrom: val('filterFirstBilledFrom'),
                    FirstBilledTo:   val('filterFirstBilledTo')
                };

                var body = new FormData();
                body.append('lab', '@Model.SelectedLab');
                body.append('reportType', 'ProductionReport');
                body.append('filterDetails', JSON.stringify(filters));
                var af = document.querySelector('#lrnReportsAf input[name="__RequestVerificationToken"]');
                if (af) body.append('__RequestVerificationToken', af.value);

                var original = exportBtn.innerHTML;
                exportBtn.disabled = true;
                window.rptExportBusy(exportBtn, '<span class="spinner-border spinner-border-sm"></span> Queuing…');

                fetch('@Url.Action("Queue", "UserReports")', { method: 'POST', body: body })
                    .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, status: r.status, j: j }; }); })
                    .then(function (res) {
                        if (res.ok) {
                            window.rptExportBusy(exportBtn, '<i class="bi bi-check-circle"></i> Generating — watch Reports');
                            if (window.lrnShowReportAlert) window.lrnShowReportAlert('success');
                            if (window.lrnReportsBadgeRefresh) window.lrnReportsBadgeRefresh();
                            setTimeout(function () { window.rptExportIdle(exportBtn, original); }, 8000);
                        } else if (res.status === 400) {
                            window.rptExportIdle(exportBtn, original);
                            legacySyncExport();
                        } else {
                            window.rptExportIdle(exportBtn, original);
                            var qMsg = res.j && res.j.message ? res.j.message : '';
                            if (window.lrnShowReportAlert) {
                                if (res.status === 409 || /already/i.test(qMsg)) {
                                    window.lrnShowReportAlert('info');
                                } else {
                                    window.lrnShowReportAlert('error', { message: qMsg || 'Could not queue the report.' });
                                }
                            }
                        }
                    })
                    .catch(function () {
                        window.rptExportIdle(exportBtn, original);
                        legacySyncExport();
                    });
            });

            // Legacy synchronous export with the fake-progress overlay (fallback path).
            function legacySyncExport() {
                var form = document.getElementById('prFilterForm');
                if (!form) return;

                prDeleteCookie('prExportDone');
                overlay.style.display = 'flex';
                bar.style.width = '0%';
                pctLabel.textContent = '0%';
                statusLabel.textContent = 'Starting export\u2026';

                var startTime = Date.now();
                function elapsed() {
                    var secs = Math.floor((Date.now() - startTime) / 1000);
                    var m = Math.floor(secs / 60), s = secs % 60;
                    return m > 0 ? m + 'm ' + s + 's' : s + 's';
                }

                var stepIdx = 0, currentPct = 0;
                var stepTimer = setInterval(function () {
                    if (stepIdx < steps.length) {
                        currentPct = steps[stepIdx].pct;
                        bar.style.width = currentPct + '%';
                        pctLabel.textContent = currentPct + '%';
                        statusLabel.textContent = steps[stepIdx].text;
                        stepIdx++;
                    } else { clearInterval(stepTimer); }
                }, 1800);

                var creepTimer = setInterval(function () {
                    if (stepIdx >= steps.length) {
                        if (currentPct < 99) currentPct += 0.15;
                        var p = Math.min(Math.round(currentPct), 99);
                        bar.style.width = p + '%';
                        pctLabel.textContent = p + '%';
                        var msgs = [
                            'Writing ClaimLevelData sheet\u2026',
                            'Writing LineLevelData sheet\u2026',
                            'Formatting report sheets\u2026',
                            'Almost there, please wait\u2026',
                            'Large dataset \u2014 still processing\u2026',
                            'Compressing workbook\u2026',
                            'Hang tight, almost done\u2026'
                        ];
                        var msgIdx = Math.floor((Date.now() - startTime) / 4000) % msgs.length;
                        statusLabel.textContent = msgs[msgIdx] + '  (' + elapsed() + ')';
                    }
                }, 1000);

                var params = new URLSearchParams(new FormData(form));
                var url = '@Url.Action(exportAction, "Dashboard")' + '?' + params.toString();
                var iframe = document.createElement('iframe');
                iframe.style.display = 'none';
                iframe.src = url;
                document.body.appendChild(iframe);

                var pollTimer = setInterval(function () {
                    if (prGetCookie('prExportDone')) {
                        prCleanup(pollTimer, creepTimer, stepTimer, iframe);
                        prDeleteCookie('prExportDone');
                        bar.style.width = '100%';
                        pctLabel.textContent = '100%';
                        statusLabel.textContent = 'Download complete!  (' + elapsed() + ')';
                        setTimeout(function () { overlay.style.display = 'none'; }, 900);
                    }
                }, 500);

                var onCancel = function () {
                    prCleanup(pollTimer, creepTimer, stepTimer, iframe);
                    prDeleteCookie('prExportDone');
                    overlay.style.display = 'none';
                    cancelBtn.removeEventListener('click', onCancel);
                };
                cancelBtn.addEventListener('click', onCancel);

                setTimeout(function () {
                    prCleanup(pollTimer, creepTimer, stepTimer, iframe);
                    overlay.style.display = 'none';
                }, 600000);
            }
        }
    });
</script>
}
