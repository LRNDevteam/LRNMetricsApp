        <!-- ??? Weekly Claim Volume tab pane ?????????????????????? -->
        @if (prChrome || PrShow("weekly-pane"))
        {
        <div class="tab-pane fade" id="weekly-pane" role="tabpanel" aria-labelledby="weekly-tab" data-pr-lazy="weekly-pane">
            @if (PrShow("weekly-pane"))
            {
            @if (Model.WeeklyPanelRows.Count > 0 && Model.WeekColumns.Count > 0)
            {
                var weeks = Model.WeekColumns;
                var headerWeekRule = !string.IsNullOrWhiteSpace(Model.ProductionSummaryWeekRule)
                    ? Model.ProductionSummaryWeekRule
                    : Model.ProductionSummaryRule;
                var headerUsesChargeEntered =
                    string.Equals(headerWeekRule, "Rule3", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(headerWeekRule, "Rule4", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(headerWeekRule, "Rule5", StringComparison.OrdinalIgnoreCase);
                var headerDateLabel = headerUsesChargeEntered ? "ChargeEnteredDate" : "FirstBilledDate";

                <div class="pr-wrap">
                    <div class="pr-scroll">
                        <table class="pr-table" style="width:100%; min-width:838px;">
                            <colgroup>
                                <col style="width:200px" />
                                @foreach (var wk in weeks)
                                {
                                    <col style="width:52px" />
                                    <col style="width:68px" />
                                }
                                <col style="width:72px" />
                                <col style="width:86px" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th rowspan="3">Panel &amp; Insurance</th>
                                    <th colspan="@(weeks.Count * 2)">
                                        Data based on Last 4 Week [@headerDateLabel]
                                    </th>
                                    <th colspan="2" class="pr-grand-total">Grand Total</th>
                                </tr>
                                <tr>
                                    @for (int wi = 0; wi < weeks.Count; wi++)
                                    {
                                        <th colspan="2">
                                            @weeks[wi].WeekStart.ToString("M/d/yyyy") &ndash; @weeks[wi].WeekEnd.ToString("M/d/yyyy")
                                        </th>
                                    }
                                    <th colspan="2" class="pr-grand-total"></th>
                                </tr>
                                <tr>
                                    @foreach (var wk in weeks)
                                    {
                                        <th class="pr-month-data">No. of Claims</th>
                                        <th class="pr-month-data">Total Billed Charges</th>
                                    }
                                    <th class="pr-grand-total">No. of Claims</th>
                                    <th class="pr-grand-total">Total Billed Charges</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int wPanelIdx = 0; }
                                @foreach (var panel in Model.WeeklyPanelRows)
                                {
                                    var wLetter = (char)('A' + wPanelIdx % 26);
                                    var wcvGroupId = $"wcv-{wPanelIdx}";
                                    <tr class="pr-panel-row pr-hp-toggle" data-hp-group="@wcvGroupId" role="button" aria-expanded="false" title="Open / close payers">
                                        <td><i class="bi bi-chevron-right pr-hp-chevron" aria-hidden="true"></i>@wLetter &nbsp; @panel.PanelName</td>
                                        @foreach (var wk in weeks)
                                        {
                                            <td class="pr-month-data">@CellClaims(panel.ByWeek, wk.Key).ToString("N0")</td>
                                            <td class="pr-month-data">@Acct(CellCharges(panel.ByWeek, wk.Key))</td>
                                        }
                                        <td class="pr-grand-total">@panel.TotalClaims.ToString("N0")</td>
                                        <td class="pr-grand-total">@Acct(panel.TotalCharges)</td>
                                    </tr>

                                    @foreach (var payer in panel.TopPayers)
                                    {
                                        <tr class="pr-payer-row pr-hp-child" data-hp-parent="@wcvGroupId">
                                            <td>@payer.PayerName</td>
                                            @foreach (var wk in weeks)
                                            {
                                                <td class="pr-month-data">@CellClaims(payer.ByWeek, wk.Key).ToString("N0")</td>
                                                <td class="pr-month-data">@Acct(CellCharges(payer.ByWeek, wk.Key))</td>
                                            }
                                            <td class="pr-grand-total">@payer.TotalClaims.ToString("N0")</td>
                                            <td class="pr-grand-total">@Acct(payer.TotalCharges)</td>
                                        </tr>
                                    }

                                    wPanelIdx++;
                                }
                            </tbody>
                            <tfoot>
                                <tr class="pr-total-row">
                                    <td>Grand Total</td>
                                    @foreach (var wk in weeks)
                                    {
                                        <td class="pr-month-data">@CellClaims(Model.WeeklyGrandTotalByWeek, wk.Key).ToString("N0")</td>
                                        <td class="pr-month-data">@Acct(CellCharges(Model.WeeklyGrandTotalByWeek, wk.Key))</td>
                                    }
                                    <td class="pr-grand-total">@Model.WeeklyGrandTotalClaims.ToString("N0")</td>
                                    <td class="pr-grand-total">@Acct(Model.WeeklyGrandTotalCharges)</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div class="px-3 py-2 small text-muted">
                    @{
                        var uaRule = Model.ProductionSummaryRule;
                        var uaUsesCharge = string.Equals(uaRule, "Rule1", StringComparison.OrdinalIgnoreCase)
                            || string.Equals(uaRule, "Rule2", StringComparison.OrdinalIgnoreCase)
                            || string.Equals(uaRule, "Rule3", StringComparison.OrdinalIgnoreCase)
                            || string.Equals(uaRule, "Rule4", StringComparison.OrdinalIgnoreCase);
                        var uaDateLabel = uaUsesCharge ? "Charge Entered Date" : "First Billed Date";
                        var uaSelectedPanels = Model.FilterPanelNames != null && Model.FilterPanelNames.Count > 0
                            ? string.Join(", ", Model.FilterPanelNames) : "All";
                        var uaFbFromLbl = string.IsNullOrWhiteSpace(Model.FilterFirstBillFrom) ? "-" : Model.FilterFirstBillFrom;
                        var uaFbToLbl = string.IsNullOrWhiteSpace(Model.FilterFirstBillTo) ? "-" : Model.FilterFirstBillTo;
                    }
                    <strong>Date axis & filters:</strong> @uaDateLabel (rule: @(!string.IsNullOrWhiteSpace(uaRule) ? uaRule : "Default"))
                    &nbsp;|&nbsp; <strong>Panels:</strong> @uaSelectedPanels
                    &nbsp;|&nbsp; <strong>Filter Range:</strong> @uaFbFromLbl — @uaFbToLbl
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <div style="font-size:2rem;opacity:.4">&#128202;</div>
                    <div class="fw-semibold mt-2">No weekly claim volume data available</div>
                    <div class="small mt-1">No billed claims found in the last 4 weeks. Try adjusting your filters.</div>
                </div>
            }

            @* ── Active rule + week-range footer (dull) ────────────────── *@
            var weeklyRule = !string.IsNullOrWhiteSpace(Model.ProductionSummaryWeekRule)
                ? Model.ProductionSummaryWeekRule
                : Model.ProductionSummaryRule;
            var weeklyActiveRule = string.IsNullOrWhiteSpace(weeklyRule) ? "Default" : weeklyRule!;
            var weeklyActiveWeek = string.IsNullOrWhiteSpace(Model.ProductionSummaryWeekRange)
                ? "Mon to Sun (default)"
                : Model.ProductionSummaryWeekRange!;
            var weeklyUsesChargeEntered =
                string.Equals(weeklyRule, "Rule1", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(weeklyRule, "Rule3", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(weeklyRule, "Rule4", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(weeklyRule, "Rule5", StringComparison.OrdinalIgnoreCase);
            var weeklyDateColumn = weeklyUsesChargeEntered ? "ChargeEnteredDate" : "FirstBilledDate";
            var weeklyIsRule5 = string.Equals(weeklyRule, "Rule5", StringComparison.OrdinalIgnoreCase);
            var weeklyIsRule34 =
                string.Equals(weeklyRule, "Rule3", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(weeklyRule, "Rule4", StringComparison.OrdinalIgnoreCase);
            <div class="pr-rule-footer mt-3 small text-muted" style="opacity:.65;line-height:1.45;border-top:1px dashed #cfd6df;padding-top:.5rem">
                <div><span class="fw-semibold">Week Range:</span> @weeklyActiveWeek</div>
                <ul class="mb-0 ps-3" style="font-size:.78rem">
                    <li>Source: <code>ClaimLevelData</code> · Last 4 complete <code>@weeklyActiveWeek</code> weeks</li>
                    <li>Rows: <code>PanelName</code> &nbsp;·&nbsp; Drill-down: Top 3 <code>PayerName</code> by <code>COUNT(DISTINCT ClaimID)</code></li>
                    <li>Columns: Week of <code>@weeklyDateColumn</code></li>
                    @if (weeklyIsRule5)
                    {
                        <li>Filter: Exclude <code>PayerName_Raw</code> containing <code>None</code>, <code>Accu Labs</code>, <code>Client Bill</code>, <code>Client</code>, <code>Patient</code>, <code>Patient Pay</code> &nbsp;·&nbsp; <code>FirstBilledDate</code> is a valid date</li>
                    }
                    else if (weeklyIsRule34)
                    {
                        <li>Filter: <code>PayerName</code> not blank &nbsp;·&nbsp; <code>ChargeEnteredDate</code> is a valid date &nbsp;·&nbsp; <code>FirstBilledDate</code> is a valid date</li>
                    }
                    else
                    {
                        <li>Filter: <code>PayerName</code> not blank &nbsp;·&nbsp; <code>FirstBilledDate</code> is a valid date</li>
                    }
                    <li>Rank by: <code>COUNT(DISTINCT ClaimID)</code> &nbsp;·&nbsp; Sort: Grand Total descending</li>
                    <li>Cell metrics: <code>COUNT(DISTINCT ClaimID)</code> + <code>SUM(ChargeAmount)</code></li>
                </ul>
            </div>
            }
        </div>
        }

