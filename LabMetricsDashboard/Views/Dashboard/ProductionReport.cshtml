@using LRN.ProductionReports.Models
@model LRN.ProductionReports.Models.ProductionReportViewModel
@{
    ViewData["Title"]       = $"Production Report - {Model.SelectedLab}";
    ViewData["SelectedLab"] = Model.SelectedLab;
    ViewData["PageLabel"]   = "Production Report";
    if (ViewData["PrPaneOnly"] is string paneOnly && !string.IsNullOrEmpty(paneOnly))
        Layout = null;

    // Allows ProductionSummaryReport.cshtml to reuse this view by overriding the form target.
    var formAction = ViewData["FormAction"] as string ?? "ProductionSummaryReport";
    var exportAction = formAction == "ProductionSummaryReport"
                       && string.Equals(Model.SelectedLab, "NorthWest", StringComparison.OrdinalIgnoreCase)
        ? "ExportNorthWestProductionReportExcel"
        : "ExportProductionReportExcel";
                <style>
                .pr-filter-summary { font-size:.85rem; color:#6b7280; padding:.45rem .75rem; }
                .pr-filter-summary .filter-dot { display:inline-block; width:10px; color:#9ca3af; margin-right:.5rem; }
                .pr-filter-summary .filter-label { font-weight:600; margin-right:.35rem; }
                .pr-filter-summary .filter-key { color:#d946ef; font-weight:600; }
                .pr-filter-summary .filter-key-2 { color:#16a34a; font-weight:600; }
                </style>

    // Filter out year 1900 on the view side as well
    var validYears  = Model.Years.Where(y => y > 1900).ToList();
    var validMonths = Model.Months.Where(m => int.Parse(m[..4]) > 1900).ToList();

    var monthsByYear = validMonths
        .GroupBy(m => int.Parse(m[..4]))
        .OrderBy(g => g.Key)
        .ToDictionary(g => g.Key, g => g.OrderBy(m => m).ToList());

    string MonthLabel(string ym)
    {
        var parts = ym.Split('-');
        return new DateTime(int.Parse(parts[0]), int.Parse(parts[1]), 1).ToString("MMM");
    }

    int CellClaims(Dictionary<string, ProductionMonthCell>? d, string mk)
        => d is not null && d.TryGetValue(mk, out var c) ? c.ClaimCount : 0;
    decimal CellCharges(Dictionary<string, ProductionMonthCell>? d, string mk)
        => d is not null && d.TryGetValue(mk, out var c) ? c.BilledCharges : 0m;
    int YearClaims(Dictionary<int, ProductionYearTotal>? d, int y)
        => d is not null && d.TryGetValue(y, out var t) ? t.ClaimCount : 0;
    decimal YearCharges(Dictionary<int, ProductionYearTotal>? d, int y)
        => d is not null && d.TryGetValue(y, out var t) ? t.BilledCharges : 0m;

    int GrandYearClaims(int year) =>
        Model.GrandTotalByMonth.Where(kv => kv.Key.StartsWith($"{year:D4}")).Sum(kv => kv.Value.ClaimCount);
    decimal GrandYearCharges(int year) =>
        Model.GrandTotalByMonth.Where(kv => kv.Key.StartsWith($"{year:D4}")).Sum(kv => kv.Value.BilledCharges);

    // Recompute grand totals excluding 1900
    int grandClaims = Model.GrandTotalByMonth
        .Where(kv => int.Parse(kv.Key[..4]) > 1900).Sum(kv => kv.Value.ClaimCount);
    decimal grandCharges = Model.GrandTotalByMonth
        .Where(kv => int.Parse(kv.Key[..4]) > 1900).Sum(kv => kv.Value.BilledCharges);

    // Payer Breakdown helpers
    var pbYears  = Model.PayerBreakdownYears.Where(y => y > 1900).ToList();
    var pbMonths = Model.PayerBreakdownMonths.Where(m => int.Parse(m[..4]) > 1900).ToList();
    var pbMonthsByYear = pbMonths
        .GroupBy(m => int.Parse(m[..4]))
        .OrderBy(g => g.Key)
        .ToDictionary(g => g.Key, g => g.OrderBy(m => m).ToList());

    var pbShowCharges = true;
    int PbCell(Dictionary<string, int>? d, string mk)
        => d is not null && d.TryGetValue(mk, out var v) ? v : 0;
    int PbYear(Dictionary<int, int>? d, int y)
        => d is not null && d.TryGetValue(y, out var v) ? v : 0;
    decimal PbCharges(Dictionary<string, decimal>? d, string mk)
        => d is not null && d.TryGetValue(mk, out var v) ? v : 0m;
    decimal PbYearCharges(Dictionary<int, decimal>? d, int y)
        => d is not null && d.TryGetValue(y, out var v) ? v : 0m;
    int PbGrandYear(int year) =>
        Model.PayerBreakdownGrandByMonth.Where(kv => kv.Key.StartsWith($"{year:D4}")).Sum(kv => kv.Value);
    decimal PbGrandYearCharges(int year) =>
        Model.PayerBreakdownGrandChargesByMonth.Where(kv => kv.Key.StartsWith($"{year:D4}")).Sum(kv => kv.Value);
    int pbGrandTotal = Model.PayerBreakdownGrandByMonth
        .Where(kv => int.Parse(kv.Key[..4]) > 1900).Sum(kv => kv.Value);
    decimal pbGrandTotalCharges = Model.PayerBreakdownGrandChargesByMonth
        .Where(kv => int.Parse(kv.Key[..4]) > 1900).Sum(kv => kv.Value);

    // Panel Breakdown helpers (same month/year layout as Payer Breakdown)
    var pnlYears  = Model.PanelBreakdownYears.Where(y => y > 1900).ToList();
    var pnlMonths = Model.PanelBreakdownMonths.Where(m => int.Parse(m[..4]) > 1900).ToList();
    var pnlMonthsByYear = pnlMonths
        .GroupBy(m => int.Parse(m[..4]))
        .OrderBy(g => g.Key)
        .ToDictionary(g => g.Key, g => g.OrderBy(m => m).ToList());
    int PnlGrandYear(int year) =>
        Model.PanelBreakdownGrandByMonth.Where(kv => kv.Key.StartsWith($"{year:D4}")).Sum(kv => kv.Value);
    decimal PnlGrandYearCharges(int year) =>
        Model.PanelBreakdownGrandChargesByMonth.Where(kv => kv.Key.StartsWith($"{year:D4}")).Sum(kv => kv.Value);
    int pnlGrandTotal = Model.PanelBreakdownGrandByMonth
        .Where(kv => int.Parse(kv.Key[..4]) > 1900).Sum(kv => kv.Value);
    decimal pnlGrandTotalCharges = Model.PanelBreakdownGrandChargesByMonth
        .Where(kv => int.Parse(kv.Key[..4]) > 1900).Sum(kv => kv.Value);

    Dictionary<int, List<string>> InsightMonthsByYear(IEnumerable<string> months) => months
        .Where(m => int.Parse(m[..4]) > 1900)
        .GroupBy(m => int.Parse(m[..4]))
        .OrderBy(g => g.Key)
        .ToDictionary(g => g.Key, g => g.OrderBy(m => m).ToList());
    int InsightGrandYear(Dictionary<string, int> byMonth, int year) =>
        byMonth.Where(kv => kv.Key.StartsWith($"{year:D4}")).Sum(kv => kv.Value);
    decimal InsightGrandYearCharges(Dictionary<string, decimal> byMonth, int year) =>
        byMonth.Where(kv => kv.Key.StartsWith($"{year:D4}")).Sum(kv => kv.Value);

    var daqYears = Model.InsightDaqYears.Where(y => y > 1900).ToList();
    var daqMonthsByYear = InsightMonthsByYear(Model.InsightDaqMonths);
    int daqGrandTotal = Model.InsightDaqGrandByMonth
        .Where(kv => int.Parse(kv.Key[..4]) > 1900).Sum(kv => kv.Value);
    decimal daqGrandTotalCharges = Model.InsightDaqGrandChargesByMonth
        .Where(kv => int.Parse(kv.Key[..4]) > 1900).Sum(kv => kv.Value);

    var webYears = Model.InsightWebPmYears.Where(y => y > 1900).ToList();
    var webMonthsByYear = InsightMonthsByYear(Model.InsightWebPmMonths);
    int webGrandTotal = Model.InsightWebPmGrandByMonth
        .Where(kv => int.Parse(kv.Key[..4]) > 1900).Sum(kv => kv.Value);
    decimal webGrandTotalCharges = Model.InsightWebPmGrandChargesByMonth
        .Where(kv => int.Parse(kv.Key[..4]) > 1900).Sum(kv => kv.Value);

    var hpYears = Model.HighestPayerYears.Where(y => y > 1900).ToList();
    var hpMonthsByYear = InsightMonthsByYear(Model.HighestPayerMonths);
    int HpGrandYearClaims(int year) =>
        Model.HighestPayerGrandByMonth.Where(kv => kv.Key.StartsWith($"{year:D4}")).Sum(kv => kv.Value.ClaimCount);
    decimal HpGrandYearCharges(int year) =>
        Model.HighestPayerGrandByMonth.Where(kv => kv.Key.StartsWith($"{year:D4}")).Sum(kv => kv.Value.BilledCharges);
    int hpGrandClaims = Model.HighestPayerGrandByMonth
        .Where(kv => int.Parse(kv.Key[..4]) > 1900).Sum(kv => kv.Value.ClaimCount);
    decimal hpGrandCharges = Model.HighestPayerGrandByMonth
        .Where(kv => int.Parse(kv.Key[..4]) > 1900).Sum(kv => kv.Value.BilledCharges);

    // Payer X Panel helpers
    var pxpPanels = Model.PayerPanelColumns;
    int PxpClaims(Dictionary<string, ProductionMonthCell>? d, string pk)
        => d is not null && d.TryGetValue(pk, out var c) ? c.ClaimCount : 0;
    decimal PxpCharges(Dictionary<string, ProductionMonthCell>? d, string pk)
        => d is not null && d.TryGetValue(pk, out var c) ? c.BilledCharges : 0m;

    // Unbilled X Aging helpers
    var agingBuckets = AgingBuckets.All;
    int UaClaims(Dictionary<string, ProductionMonthCell>? d, string bk)
        => d is not null && d.TryGetValue(bk, out var c) ? c.ClaimCount : 0;
    decimal UaCharges(Dictionary<string, ProductionMonthCell>? d, string bk)
        => d is not null && d.TryGetValue(bk, out var c) ? c.BilledCharges : 0m;

    // CPT Breakdown helpers
    var cptShowUnits = Model.CptUnitsLabel != "No. of Claims";
    var cptShowCountOfUnits = Model.CptUnitsLabel is "Count of CPT" or "Count of Units" or "No. of Claims";
    var cptUnitsHeader = string.IsNullOrWhiteSpace(Model.CptUnitsLabel) ? "Count of Units" : Model.CptUnitsLabel;
    var cptYears  = Model.CptBreakdownYears.Where(y => y > 1900).ToList();
    var cptMonths = Model.CptBreakdownMonths.Where(m => int.Parse(m[..4]) > 1900).ToList();
    var cptMonthsByYear = cptMonths
        .GroupBy(m => int.Parse(m[..4]))
        .OrderBy(g => g.Key)
        .ToDictionary(g => g.Key, g => g.OrderBy(m => m).ToList());

    decimal CptUnits(Dictionary<string, CptBreakdownCell>? d, string mk)
        => d is not null && d.TryGetValue(mk, out var c) ? c.Units : 0m;
    decimal CptCharges(Dictionary<string, CptBreakdownCell>? d, string mk)
        => d is not null && d.TryGetValue(mk, out var c) ? c.BilledCharges : 0m;
    int CptClaims(Dictionary<string, CptBreakdownCell>? d, string mk)
        => d is not null && d.TryGetValue(mk, out var c) ? c.ClaimCount : 0;
    decimal CptYearUnits(Dictionary<int, CptBreakdownCell>? d, int y)
        => d is not null && d.TryGetValue(y, out var t) ? t.Units : 0m;
    decimal CptYearCharges(Dictionary<int, CptBreakdownCell>? d, int y)
        => d is not null && d.TryGetValue(y, out var t) ? t.BilledCharges : 0m;
    int CptYearClaims(Dictionary<int, CptBreakdownCell>? d, int y)
        => d is not null && d.TryGetValue(y, out var t) ? t.ClaimCount : 0;
    decimal CptGrandYearUnits(int year) =>
        Model.CptBreakdownGrandByMonth.Where(kv => kv.Key.StartsWith($"{year:D4}")).Sum(kv => kv.Value.Units);
    decimal CptGrandYearCharges(int year) =>
        Model.CptBreakdownGrandByMonth.Where(kv => kv.Key.StartsWith($"{year:D4}")).Sum(kv => kv.Value.BilledCharges);
    int CptGrandYearClaims(int year) =>
        Model.CptBreakdownGrandByMonth.Where(kv => kv.Key.StartsWith($"{year:D4}")).Sum(kv => kv.Value.ClaimCount);
    decimal cptGrandUnits = Model.CptBreakdownGrandByMonth
        .Where(kv => int.Parse(kv.Key[..4]) > 1900).Sum(kv => kv.Value.Units);
    decimal cptGrandCharges = Model.CptBreakdownGrandByMonth
        .Where(kv => int.Parse(kv.Key[..4]) > 1900).Sum(kv => kv.Value.BilledCharges);
    int cptGrandClaims = Model.CptBreakdownGrandByMonth
        .Where(kv => int.Parse(kv.Key[..4]) > 1900).Sum(kv => kv.Value.ClaimCount);

    // Shell first: no tab HTML until JS fetches ProductionSummaryReportTab.
    var prPaneOnly = ViewData["PrPaneOnly"] as string;
    var prChrome = string.IsNullOrEmpty(prPaneOnly);
    bool PrShow(string paneId) =>
        !string.IsNullOrEmpty(prPaneOnly)
            && string.Equals(prPaneOnly, paneId, StringComparison.OrdinalIgnoreCase);
}

@if (prChrome)
{
<style>
/* ?? Production Report styles ??????????????????????????????? */
.pr-wrap {
    border-radius: 14px; overflow: hidden;
    background: #fff; border: 1px solid #e0e6ed;
    box-shadow: 0 2px 12px rgba(0,0,0,.05);
}
.pr-scroll { max-height: 78vh; overflow: auto; }
.pr-tab-loading {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: .75rem; padding: 3.5rem 1rem; color: #6b7280; font-size: .9rem;
}
.pr-tab-spinner {
    width: 40px; height: 40px;
    border: 4px solid rgba(14,52,96,.15);
    border-top-color: #0e3460;
    border-radius: 50%;
    animation: lmd-boot-spin .75s linear infinite;
}

.pr-table {
    border-collapse: separate; border-spacing: 0;
    font-size: .72rem;
    table-layout: fixed;
}

.pr-table thead th {
    background: linear-gradient(135deg, #0a1628 0%, #0e3460 50%, #0d5c74 100%);
    color: rgba(255,255,255,.92); font-weight: 700; font-size: .62rem;
    letter-spacing: .04em; text-transform: uppercase;
    padding: .5rem .4rem; text-align: center;
    white-space: normal; word-wrap: break-word;
    position: sticky; top: 0; z-index: 5;
    border-bottom: 1px solid #0a2a4a;
    border-right: 1px solid rgba(255,255,255,.08);
    line-height: 1.25;
}

/* Visible header rows are 1, 2, 3 (no hidden sizing row) */
.pr-table thead tr:nth-child(2) th {
    top: 30px; z-index: 4;
    background: linear-gradient(135deg, #162d50 0%, #1b4a6c 100%);
    font-size: .58rem;
}
.pr-table thead tr:nth-child(3) th {
    top: 56px; z-index: 3;
    background: #1e5a8a;
    font-size: .56rem; font-weight: 600;
}

.pr-table thead th:first-child {
    text-align: left; position: sticky; left: 0; z-index: 7;
}
.pr-table thead tr:nth-child(2) th:first-child { z-index: 6; }
.pr-table thead tr:nth-child(3) th:first-child { z-index: 5; }

.pr-table td {
    padding: .35rem .5rem; vertical-align: middle;
    text-align: right; white-space: nowrap;
    border-right: 1px solid #e2e8f0;
