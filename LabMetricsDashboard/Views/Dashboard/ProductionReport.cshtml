<!-- Page heading -->
<div class="rpt-page-head">
    <div class="rpt-page-head-main">
        <h2 class="mb-0 fw-bold">Production Report <span class="badge bg-primary bg-gradient fw-semibold" style="font-size:.45em;vertical-align:middle;border-radius:20px;padding:.35em .85em">@Model.SelectedLab</span></h2>
    </div>
    <div class="rpt-page-head-right">
        @if (!string.IsNullOrWhiteSpace(Model.SelectedLab))
        {
            <div class="rpt-toolbar">
                <button type="button" id="exportExcelBtn" class="btn btn-sm btn-outline-success rpt-toolbar-btn"
                        title="Download Excel" aria-label="Download Excel">
                    <i class="bi bi-file-earmark-excel"></i>
                </button>
                <button type="button" id="riAddInsightBtn" class="btn btn-sm btn-primary rpt-toolbar-btn"
                        title="Add Insight" aria-label="Add Insight">
                    <i class="bi bi-plus-lg"></i>
                </button>
                <a class="btn btn-sm btn-outline-primary rpt-toolbar-btn"
                   asp-controller="InsightTemplate" asp-action="Production"
                   asp-route-lab="@Model.SelectedLab"
                   title="Insight Templates" aria-label="Insight Templates">
                    <i class="bi bi-layout-text-sidebar-reverse"></i>
                </a>
            </div>
        }
        <a asp-controller="Dashboard" asp-action="ClaimLevel" asp-route-lab="@Model.SelectedLab"
           class="btn btn-sm btn-outline-primary">
            <i class="bi bi-clipboard-data me-1"></i>Claim Level Details
        </a>
    </div>
</div>

@if (string.IsNullOrWhiteSpace(Model.SelectedLab) && string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning">
