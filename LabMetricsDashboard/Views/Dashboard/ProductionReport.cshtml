@if (!string.IsNullOrWhiteSpace(Model.SelectedLab) && string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    @if (prChrome)
    {
    <!-- ??? Premium Tabs ????????????????????????????????????????? -->
    <ul class="nav nav-pills pr-tabs mb-3" id="prTabs" role="tablist">
        <li class="nav-item" role="presentation">
