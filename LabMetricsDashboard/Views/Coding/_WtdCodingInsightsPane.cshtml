@model LabMetricsDashboard.Models.CodingSummaryViewModel
@{
    // CVBILL-1.4 (2026-07-27): week labels are billed-date ranges "MM/dd/yyyy to MM/dd/yyyy" — sort by END date.
    Func<string, DateTime> WeekEnd = w =>
        (!string.IsNullOrWhiteSpace(w) && w.Length >= 10 && DateTime.TryParse(w.Substring(w.Length - 10), out var d))
            ? d : DateTime.MinValue;
    var weeks = Model.WtdInsightRows.Select(r => r.WeekFolder).Distinct().OrderByDescending(WeekEnd).ToList();
    // CVUI-INS (2026-07-27): Short() truncation removed — CPT columns now show full text.
}
@if (!weeks.Any())
{
    <div class="cs-table-wrap p-4"><div class="cs-empty"><div class="fw-semibold">No WTD insight data available.</div></div></div>
}
else
{
    <div class="small text-muted mb-2">@Model.WtdInsightRows.Count rows. Full CPT detail in Download Excel.</div>
}
@foreach (var week in weeks)
{
    var wrows = Model.WtdInsightRows.Where(r => r.WeekFolder == week).ToList();
    <div class="cs-year-section">
        <div class="cs-year-header">
            <span class="cs-year-pill">@week</span>
            <span class="cs-year-count">@wrows.Count rows</span>
        </div>
        @* CVUI-INS (2026-07-27): always-frozen header + first 2 columns, 400px tall, horizontal scroll.
           REVERT: remove 'has-many-rows cs-always-frozen' below. *@
        <div class="cs-table-wrap"><div class="cs-table-scroll has-many-rows cs-always-frozen">
        <table class="cs-table">
            <thead><tr>
                <th style="text-align:left">Week</th>
                <th class="cs-nowrap" style="text-align:left">Panel</th>
                <th style="text-align:left">Billable CPT</th>
                <th>Claims</th>
                <th>Total Billed Charges</th>@* CVTOTCHG (2026-07-28): label aligned with YTD (already SUM) *@
                <th style="text-align:left">Billed CPT</th>
                <th style="text-align:left">Missing</th>
                <th>Missing $</th>
                <th>Rev Loss</th>
                <th style="text-align:left">Additional</th>
                <th>Addl $</th>
                <th>Recoup</th>
                <th>Net</th>
                <th style="text-align:center">Calc</th>
            </tr></thead>
            <tbody>
            @foreach (var r in wrows)
            {
                var ni = r.NetImpact;
                <tr data-week="@r.WeekFolder" data-panel="@r.PanelName">
                    <td class="cs-nowrap">@r.WeekFolder</td>
                    <td class="cs-nowrap">@r.PanelName</td>
                    <td class="cpt-full" title="@r.BillableCptCombo">@(string.IsNullOrWhiteSpace(r.BillableCptCombo) ? "-" : r.BillableCptCombo)</td>
                    <td class="r"><strong>@r.TotalClaims.ToString("N0")</strong></td>
                    <td class="r">$@r.TotalBilledCharges.ToString("N2")</td>
                    <td class="cpt-full" title="@r.BilledCptCombo">@(string.IsNullOrWhiteSpace(r.BilledCptCombo) ? "-" : r.BilledCptCombo)</td>
                    <td class="cpt-full" title="@r.MissingCpts">@(string.IsNullOrWhiteSpace(r.MissingCpts) ? "-" : r.MissingCpts)</td>
                    <td class="r">$@r.BilledChargesForMissingCpts.ToString("N2")</td>
                    <td class="r">$@r.RevenueLoss.ToString("N2")</td>
                    <td class="cpt-full" title="@r.AdditionalCpts">@(string.IsNullOrWhiteSpace(r.AdditionalCpts) ? "-" : r.AdditionalCpts)</td>
                    <td class="r">$@r.BilledChargesForAdditionalCpts.ToString("N2")</td>
                    <td class="r">$@r.PotentialRecoupment.ToString("N2")</td>
                    <td class="r">@(ni < 0 ? "-" : ni > 0 ? "+" : "")$@Math.Abs(ni).ToString("N2")</td>
                    <td class="r" style="text-align:center">
                        <button type="button" class="btn btn-sm cs-view-calc"
                                data-scope="wtd"
                                data-week="@r.WeekFolder"
                                data-panel="@r.PanelName"
                                data-missing="@r.MissingCpts"
                                data-additional="@r.AdditionalCpts"
                                title="View calculation">
                            <i class="bi bi-calculator"></i>View
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div></div>
    </div>
}