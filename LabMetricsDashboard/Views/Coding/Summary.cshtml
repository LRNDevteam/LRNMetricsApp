            <select id="flt-wtd-summary-week" class="cs-filter-select" style="min-width:220px">
                <option value="">All Weeks</option>
                @foreach (var w in Model.WtdSummaryRows.Select(r => r.WeekFolder).Distinct().OrderByDescending(x => x))
                { <option value="@w">@w</option> }
            </select>
            <span class="cs-filter-label">Panel</span>
            <select id="flt-wtd-summary-panel" class="cs-filter-select">
                <option value="">All Panels</option>
                @foreach (var p in Model.WtdSummaryRows.Select(r => r.PanelName).Distinct().OrderBy(x => x))
                { <option value="@p">@p</option> }
            </select>
            <button class="cs-filter-reset" data-reset="wtd-summary">&#10005; Clear</button>
            <span class="cs-filter-count" id="flt-wtd-summary-count"></span>
            <button type="button" class="exportCodingExcelBtn btn btn-sm btn-outline-success" style="margin-left:auto;font-size:.76rem;border-radius:20px;padding:.3em .9em">
                <i class="bi bi-@(Model.PackageAverageFiles ? "file-earmark-zip" : "file-earmark-excel") me-1"></i>@(Model.PackageAverageFiles ? "Download ZIP" : "Download Excel")
            </button>
        </div>
        @{
            var wtdSummaryWeeks = Model.WtdSummaryRows.Select(r => r.WeekFolder)
                                        .Distinct().OrderByDescending(w => w).ToList();
        }
        @if (!wtdSummaryWeeks.Any())
        {
            <div class="cs-table-wrap p-4">
                <div class="cs-empty">
                    <div class="cs-empty-icon">&#128196;</div>
                    <div class="fw-semibold">No WTD summary data available.</div>
                </div>
            </div>
        }
        @foreach (var week in wtdSummaryWeeks)
        {
            var wrows = Model.WtdSummaryRows.Where(r => r.WeekFolder == week).ToList();
            <div class="cs-year-section">
                <div class="cs-year-header">
                    <span class="cs-year-pill">&#128197;&thinsp; @week</span>
                    <span class="cs-year-count">@wrows.Count panel@(wrows.Count == 1 ? "" : "s")</span>
                </div>
                <div class="cs-table-wrap">
                    <div class="cs-table-scroll">
                        <table class="cs-table">
                            <thead>
                                <tr>
                                    <th style="text-align:left">Panel</th>
                                    <th>Total No.<br/>of Claims</th>
                                    <th>Distinct Claims<br/>with Missing CPTs</th>
                                    <th>Total Billed Charges<br/>for Missing CPTs</th>
                                    <th>Total Average Allowed Amount<br/>for Missing CPTs</th>
                                </tr>
                            </thead>
                            <tbody id="tbody-wtd-summary-@week.GetHashCode()">
                                @foreach (var r in wrows)
                                {
                                    <tr data-week="@r.WeekFolder" data-panel="@r.PanelName">
                                        <td><span class="panel-chip">@r.PanelName</span></td>
                                        <td class="r"><strong>@r.TotalClaims.ToString("N0")</strong></td>
                                        <td class="r">@r.DistinctClaimsWithMissingCpts.ToString("N0")</td>
                                        <td class="r money money-neutral">$&thinsp;@r.TotalBilledChargesForMissingCpts.ToString("N2")</td>
                                        <td class="r money money-neutral">$&thinsp;@r.AvgAllowedAmountForMissingCpts.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- ?? Tab: Financial Dashboard ??????????????????????????????? -->
    <div class="cs-tab-pane mt-3" id="pane-financial">
        <!-- Filter bar -->
        <div class="cs-filter-bar">
            <span class="cs-filter-label">&#9660; Filter</span>
            <span class="cs-filter-label" style="margin-left:.25rem">Week</span>
            <select id="flt-fin-week" class="cs-filter-select" style="min-width:240px">
                <option value="">All Weeks</option>
                @foreach (var w in Model.FinancialRows.Select(r => r.WeekFolder).Distinct().OrderByDescending(x => x))
                { <option value="@w">@w</option> }
            </select>
            <button class="cs-filter-reset" id="resetFinancialBtn">&#10005; Clear</button>
            <span class="cs-filter-count" id="flt-fin-count"></span>
        </div>

        @if (!Model.FinancialRows.Any())
        {
            <div class="cs-table-wrap p-4">
                <div class="cs-empty">
                    <div class="cs-empty-icon">&#128184;</div>
                    <div class="fw-semibold">No Financial Dashboard data available.</div>
                    <div class="small mt-1">Ensure CaptureDataApp has processed at least one Coding Master report.</div>
                </div>
            </div>
        }
        else
        {
            @await Html.PartialAsync("_CodingFinancialGrid", Model.FinancialRows.ToList())
        }
    </div><!-- /#pane-financial - removed; content is now in KPI strip above -->

    <!-- ?? Tab: Validation Detail ??????????????????????????????????????????? -->
    <div class="cs-tab-pane mt-3" id="pane-detail" data-lazy-url="@Url.Action("DetailPane", "Coding", new { lab = Model.LabName })">
    <div class="cs-filter-bar">
        <span class="cs-filter-label">&#9660; Filter</span>
        <span class="cs-filter-label" style="margin-left:.25rem">Panel</span>
        <select id="flt-det-panel" class="cs-filter-select">
            <option value="">All Panels</option>
        </select>
        <span class="cs-filter-label">Status</span>
        <select id="flt-det-status" class="cs-filter-select">
            <option value="">All Statuses</option>
        </select>
        <span class="cs-filter-label">Search</span>
        <input type="text" id="flt-det-search" class="cs-filter-select" placeholder="Accession / CPT..." style="min-width:180px" />
        <button class="cs-filter-reset" id="resetDetailBtn">&#10005; Clear</button>
        <span class="cs-filter-count" id="flt-det-count"></span>
        <button type="button" class="exportCodingExcelBtn btn btn-sm btn-outline-success" style="margin-left:auto;font-size:.76rem;border-radius:20px;padding:.3em .9em">
            <i class="bi bi-@(Model.PackageAverageFiles ? "file-earmark-zip" : "file-earmark-excel") me-1"></i>@(Model.PackageAverageFiles ? "Download ZIP" : "Download Excel")
        </button>
    </div>
    <div class="cs-lazy-placeholder p-5 text-center text-muted">
        <div class="loading-spinner mx-auto mb-2"></div>
        <div>Open this tab to load Validation Detail...</div>
    </div>
</div><!-- /#pane-detail -->

<!-- Shared View Calculation modal -->
<div class="modal fade" id="codingCalcModal" tabindex="-1" aria-labelledby="codingCalcModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="codingCalcModalTitle">View calculation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="codingCalcModalBody">
                <div class="text-center text-muted py-4">Loading calculation…</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
}

@section Scripts {
<script nonce='@Context.Items["CspNonce"]'>
(function () {
    'use strict';

    // Script loaded timestamp - for cache verification
    console.log('[Coding Summary] Script loaded at:', new Date().toISOString());
    console.log('[Coding Summary] Loading overlay element exists:', !!document.getElementById('csTabLoadingOverlay'));

    var codingCalcUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("CalculationDetail", "Coding")));
    var codingCalcLab = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LabName));

    function openCodingCalc(btn) {
        if (!btn || !codingCalcUrl) return;
        var params = new URLSearchParams();
        params.set('lab', codingCalcLab || '');
        params.set('scope', btn.getAttribute('data-scope') || 'ytd');
        var year = btn.getAttribute('data-year');
        var week = btn.getAttribute('data-week');
        var panel = btn.getAttribute('data-panel');
        if (year) params.set('year', year);
        if (week) params.set('week', week);
        if (panel) params.set('panel', panel);
        if (btn.hasAttribute('data-missing'))
            params.set('missing', btn.getAttribute('data-missing') || '');
        if (btn.hasAttribute('data-additional'))
            params.set('additional', btn.getAttribute('data-additional') || '');

        var title = 'View calculation';
        if (panel) title += ' — ' + panel;
        if (year) title += ' (' + year + ')';
        if (week) title += ' · ' + week;

        var modalEl = document.getElementById('codingCalcModal');
        var bodyEl = document.getElementById('codingCalcModalBody');
        var titleEl = document.getElementById('codingCalcModalTitle');
        if (!modalEl || !bodyEl) return;
        if (titleEl) titleEl.textContent = title;
        bodyEl.innerHTML = '<div class="text-center text-muted py-4"><div class="loading-spinner mx-auto mb-2"></div>Loading calculation…</div>';

        var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();

        fetch(codingCalcUrl + '?' + params.toString(), { credentials: 'same-origin' })
            .then(function (res) {
                if (!res.ok) throw new Error('Failed to load calculation (' + res.status + ')');
                return res.text();
            })
            .then(function (html) { bodyEl.innerHTML = html; })
            .catch(function (err) {
                bodyEl.innerHTML = '<div class="alert alert-danger m-0">' +
                    (err && err.message ? err.message : 'Failed to load calculation.') + '</div>';
            });
    }

    document.addEventListener('click', function (e) {
        var btn = e.target && e.target.closest ? e.target.closest('.cs-view-calc') : null;
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        openCodingCalc(btn);
    });

    // Tab switcher + lazy-load insight panes on first visit
    function loadLazyPane(pane) {
        if (!pane || pane.dataset.lazyLoaded === '1' || pane.dataset.lazyLoaded === 'loading') {
            return Promise.resolve();
        }
        var url = pane.getAttribute('data-lazy-url');
        if (!url) return Promise.resolve();

        pane.dataset.lazyLoaded = 'loading';
        var overlay = document.getElementById('csTabLoadingOverlay');
        if (overlay) overlay.classList.add('active');
        var loadingText = overlay ? overlay.querySelector('.loading-text') : null;
        if (loadingText) loadingText.textContent = 'Loading data...';

        var controller = (typeof AbortController !== 'undefined') ? new AbortController() : null;
        var timeoutId = setTimeout(function () {
            if (controller) controller.abort();
        }, 90000);

        return fetch(url, {
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'text/html' },
            credentials: 'same-origin',
            signal: controller ? controller.signal : undefined
        })
            .then(function (resp) {
                if (!resp.ok) throw new Error('HTTP ' + resp.status);
                return resp.text();
            })
            .then(function (html) {
                // Clear overlay BEFORE inserting HTML so the UI never stays stuck
                // if DOM insert is heavy.
                clearTimeout(timeoutId);
                if (overlay) overlay.classList.remove('active');
                pane.innerHTML = html;
                pane.dataset.lazyLoaded = '1';
            })
            .catch(function (err) {
                clearTimeout(timeoutId);
                pane.dataset.lazyLoaded = '';
                var msg = (err && err.name === 'AbortError')
                    ? 'Timed out loading this tab. Try again or use Download Excel.'
                    : ('Failed to load tab data: ' + (err && err.message ? err.message : err));
                pane.innerHTML = '<div class="alert alert-danger m-3">' + msg + '</div>';
                if (overlay) overlay.classList.remove('active');
            });
    }

    document.querySelectorAll('#csTabs .cs-tab-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.querySelectorAll('#csTabs .cs-tab-btn').forEach(function (b) { b.classList.remove('active'); });
            document.querySelectorAll('.cs-tab-pane').forEach(function (p) { p.classList.remove('active'); });
            btn.classList.add('active');
            var pane = document.getElementById('pane-' + btn.dataset.tab);
            if (!pane) return;
            pane.classList.add('active');

            loadLazyPane(pane).then(function () {
                updateSharedFilterVisibility();
                applyAllTabFilters();
                // Skip CPT pill measurement for insight panes (plain text now).
                if (pane.querySelector('.cpt-pill-block')) {
                    refreshCptPillToggles(pane);
                }
                applyScrollbarClasses(pane);
                setStickyColumnPositions(pane);
            });
        });
    });

    // ????????????????????????????????????????????????????????????
    // Filter engine
    // Each tab config: { pane, rows selector, filter specs, count el id }
    // ????????????????????????????????????????????????????????????
    var tabFilters = [
        {
            pane:    'pane-insights',
            rowSel:  '#pane-insights tbody tr',
            countId: 'flt-shared-count',
            filters: [
                { selId: 'flt-shared-year',  attr: 'data-year'  },
                { selId: 'flt-shared-panel', attr: 'data-panel' }
            ]
        },
        {
            pane:    'pane-summary',
            rowSel:  '#pane-summary tbody tr',
            countId: 'flt-shared-count',
            filters: [
                { selId: 'flt-shared-year',  attr: 'data-year'  },
                { selId: 'flt-shared-panel', attr: 'data-panel' }
            ]
        },
        {
            pane:    'pane-wtd-insights',
            rowSel:  '#pane-wtd-insights tbody tr',
            countId: 'flt-shared-count',
            filters: [
                { selId: 'flt-shared-week',  attr: 'data-week'  },
                { selId: 'flt-shared-panel', attr: 'data-panel' }
            ]
        },
        {
            pane:    'pane-wtd-summary',
            rowSel:  '#pane-wtd-summary tbody tr',
            countId: 'flt-shared-count',
            filters: [
                { selId: 'flt-shared-week',  attr: 'data-week'  },
                { selId: 'flt-shared-panel', attr: 'data-panel' }
            ]
        }
    ];

    function getActivePaneId() {
        var active = document.querySelector('.cs-tab-pane.active');
        return active ? active.id : 'pane-summary';
    }

    function updateSharedFilterVisibility() {
        // Show Year filters for YTD tabs; Week for WTD tabs; hide entire bar for Financial/Detail tabs.
        var paneId = getActivePaneId();
        var isWtd  = paneId === 'pane-wtd-summary' || paneId === 'pane-wtd-insights';
        var isYtd  = paneId === 'pane-summary' || paneId === 'pane-insights';
        var isSharedTab = isYtd || isWtd;

        var sharedBar = document.getElementById('csSharedFilterBar');
        var yearLabel = document.getElementById('csSharedYearLabel');
        var yearSel   = document.getElementById('flt-shared-year');
        var weekLabel = document.getElementById('csSharedWeekLabel');
        var weekSel   = document.getElementById('flt-shared-week');

        // Hide entire shared filter bar for Financial Dashboard and Validation Detail tabs
        if (sharedBar) sharedBar.style.display = isSharedTab ? '' : 'none';

        if (yearLabel) yearLabel.style.display = isYtd ? '' : 'none';
        if (yearSel)   yearSel.style.display   = isYtd ? '' : 'none';
        if (weekLabel) weekLabel.style.display = isWtd ? '' : 'none';
        if (weekSel)   weekSel.style.display   = isWtd ? '' : 'none';
    }

    function applyFilter(cfg) {
        var rows    = document.querySelectorAll(cfg.rowSel);
        var visible = 0;
        rows.forEach(function (row) {
            var show = cfg.filters.every(function (f) {
                var sel = document.getElementById(f.selId);
                if (!sel) return true;
                var val = sel.value;
                if (!val) return true;                          // "All" option selected
                return row.getAttribute(f.attr) === val;
            });
            row.classList.toggle('cs-row-hidden', !show);
            if (show) visible++;
        });
        // Show/hide entire year/week section when all its rows are filtered out
        document.querySelectorAll('#' + cfg.pane + ' .cs-year-section').forEach(function (sec) {
            var anyVisible = sec.querySelectorAll('tbody tr:not(.cs-row-hidden)').length > 0;
            sec.style.display = anyVisible ? '' : 'none';
        });
        // Only show counts for the active tab in the shared filter bar.
        if (cfg.pane === getActivePaneId()) {
            var countEl = document.getElementById(cfg.countId);
            if (countEl) countEl.textContent = visible + ' row' + (visible !== 1 ? 's' : '');
        }
    }

    function applyAllTabFilters() {
        var activePane = getActivePaneId();
        tabFilters.forEach(function (cfg) {
            if (cfg.pane === activePane) applyFilter(cfg);
        });
        if (typeof applyScrollbarClasses === 'function') {
            setTimeout(function () {
                var pane = document.getElementById(activePane);
                applyScrollbarClasses(pane);
                if (typeof setStickyColumnPositions === 'function') {
                    setStickyColumnPositions(pane);
                }
            }, 50);
        }
    }

    // Wire up shared filter bar change listeners
    ['flt-shared-year', 'flt-shared-week', 'flt-shared-panel'].forEach(function (id) {
        var sel = document.getElementById(id);
        if (sel) sel.addEventListener('change', function () { applyAllTabFilters(); });
    });

    // Shared clear button
    var sharedClear = document.getElementById('flt-shared-clear');
    if (sharedClear) {
        sharedClear.addEventListener('click', function () {
            var y = document.getElementById('flt-shared-year'); if (y) y.value = '';
            var w = document.getElementById('flt-shared-week'); if (w) w.value = '';
            var p = document.getElementById('flt-shared-panel'); if (p) p.value = '';
            applyAllTabFilters();
        });
    }

    // Init
    updateSharedFilterVisibility();
    applyAllTabFilters();

    // Toggle full / clamped CPT pills inside any cpt-pill-block
    window.cptPillsToggle = function (btn, evt) {
        if (!btn) return;
        var block = btn.closest('.cpt-pill-block');
        if (!block) return;
        var pills = block.querySelector('.cpt-pills');
        if (!pills) return;
        var collapsed = pills.classList.toggle('cpt-pills-collapsed');
        pills.classList.toggle('cpt-pills-expanded', !collapsed);
        btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
        var more = btn.getAttribute('data-more') || '+ more';
        var less = btn.getAttribute('data-less') || '- less';
        btn.innerHTML = collapsed ? more : less;
        // Don't bubble click into row toggles in the Summary tabs
        if (evt && evt.stopPropagation) evt.stopPropagation();
    };

    // After render, reveal "+ more" only where the clamped pills actually overflow.
    function refreshCptPillToggles(root) {
        var scope = root || document.querySelector('.cs-tab-pane.active') || document;
        scope.querySelectorAll('.cpt-pill-block').forEach(function (block) {
            var pills  = block.querySelector('.cpt-pills');
            var toggle = block.querySelector('.cpt-pill-toggle');
            if (!pills || !toggle) return;
            // Only meaningful while collapsed; if user expanded, leave toggle visible.
            if (!pills.classList.contains('cpt-pills-collapsed')) {
                toggle.style.display = '';
                return;
            }
            var overflowing = pills.scrollHeight > pills.clientHeight + 1;
            toggle.style.display = overflowing ? '' : 'none';
        });
    }
    // Expose globally so handlers in nested IIFEs (rowToggle) can re-trigger it.
    window.refreshCptPillToggles = refreshCptPillToggles;
    // Initial pass + re-run on resize (column widths change - wrapping changes)
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () {
            refreshCptPillToggles(document.getElementById('pane-summary'));
            applyScrollbarClasses(document.getElementById('pane-summary'));
        });
    } else {
        refreshCptPillToggles(document.getElementById('pane-summary'));
        applyScrollbarClasses(document.getElementById('pane-summary'));
    }
    var _cptResizeTimer;
    window.addEventListener('resize', function () {
        clearTimeout(_cptResizeTimer);
        _cptResizeTimer = setTimeout(function () {
            refreshCptPillToggles(document.querySelector('.cs-tab-pane.active'));
        }, 150);
    });

    // ============================================================================
    // Apply vertical scrollbar to tables/cards with more than 25 rows/items
    // ============================================================================
    function applyScrollbarClasses(root) {
        var scope = root || document;
        scope.querySelectorAll('.cs-table-scroll').forEach(function (scrollDiv) {
            var table = scrollDiv.querySelector('table');
            if (!table) return;
            var tbody = table.querySelector('tbody');
            if (!tbody) return;
            // Count visible rows (not .cs-row-hidden, not .row-expand, not .det-row-expand)
            var visibleRows = tbody.querySelectorAll('tr:not(.cs-row-hidden):not(.row-expand):not(.det-row-expand)');
            if (visibleRows.length > 25) {
                scrollDiv.classList.add('has-many-rows');
            } else {
                scrollDiv.classList.remove('has-many-rows');
            }
        });


    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () {
            applyScrollbarClasses(document.getElementById('pane-summary'));
        });
    } else {
        applyScrollbarClasses(document.getElementById('pane-summary'));
    }

    window.addEventListener('resize', function () {
        setTimeout(function () {
            applyScrollbarClasses(document.querySelector('.cs-tab-pane.active'));
        }, 100);
    });

    // ============================================================================
    // Calculate and set sticky column positions for first two columns
    // ============================================================================
    function setStickyColumnPositions(root) {
        var scope = root || document;
        scope.querySelectorAll('.cs-table-scroll.has-many-rows').forEach(function (scrollDiv) {
            var table = scrollDiv.querySelector('.cs-table');
            if (!table) return;

            // Get the width of the first column
            var firstTh = table.querySelector('thead th:nth-child(1)');
            var firstTd = table.querySelector('tbody tr:first-child td:nth-child(1)');
            var firstColWidth = firstTh ? firstTh.offsetWidth : (firstTd ? firstTd.offsetWidth : 0);

            if (firstColWidth > 0) {
                // Set left position for second column (header and body cells)
                var secondHeaders = table.querySelectorAll('thead th:nth-child(2)');
                var secondCells = table.querySelectorAll('tbody tr td:nth-child(2)');

                secondHeaders.forEach(function (th) {
                    th.style.left = firstColWidth + 'px';
                });
                secondCells.forEach(function (td) {
                    td.style.left = firstColWidth + 'px';
                });
            }
        });
    }

    // Apply sticky positions after scrollbar classes are applied
    window.addEventListener('load', function () {
        setTimeout(function () {
            var pane = document.querySelector('.cs-tab-pane.active');
            applyScrollbarClasses(pane);
            setStickyColumnPositions(pane);
        }, 100);
    });

    // Re-apply on resize
    window.addEventListener('resize', function () {
        setTimeout(function () {
            setStickyColumnPositions(document.querySelector('.cs-tab-pane.active'));
        }, 200);
    });

    // ============================================================================
    // Event listeners for row expand/collapse and CPT pill toggles
    // ============================================================================

    // YTD/WTD row toggles
    document.addEventListener('click', function (evt) {
        var mainRow = evt.target.closest('.row-main');
        if (mainRow) {
            evt.preventDefault();
            window.rowToggle(mainRow);
        }
    });

    // Validation Detail row toggles
    document.addEventListener('click', function (evt) {
        var detRow = evt.target.closest('.det-row-main');
        if (detRow) {
            evt.preventDefault();
            window.detToggle(detRow);
        }
    });

    // CPT pill toggle buttons
    document.addEventListener('click', function (evt) {
        var pillToggle = evt.target.closest('.cpt-pill-toggle');
        if (pillToggle) {
            evt.preventDefault();
            evt.stopPropagation();
            window.cptPillsToggle(pillToggle, evt);
        }
    });

    // Filter reset buttons with data-reset attribute
    document.addEventListener('click', function (evt) {
        var resetBtn = evt.target.closest('[data-reset]');
        if (resetBtn) {
            evt.preventDefault();
            var tabKey = resetBtn.getAttribute('data-reset');
            if (tabKey) {
                window.resetFilter(tabKey);
            }
        }
    });

    // Financial reset button
    var resetFinBtn = document.getElementById('resetFinancialBtn');
    if (resetFinBtn) {
        resetFinBtn.addEventListener('click', function (evt) {
            evt.preventDefault();
            window.resetFinancialFilter();
        });
    }

    // Detail reset button
    var resetDetBtn = document.getElementById('resetDetailBtn');
    if (resetDetBtn) {
        resetDetBtn.addEventListener('click', function (evt) {
            evt.preventDefault();
            window.resetDetailFilter();
        });
    }

    // ============================================================================
    // Shared filter reset function for YTD/WTD tabs
    // ============================================================================
    window.resetFilter = function (tabKey) {
        // Reset shared filters
        var yearSel = document.getElementById('flt-shared-year');
        var weekSel = document.getElementById('flt-shared-week');
        var panelSel = document.getElementById('flt-shared-panel');
        if (yearSel) yearSel.value = '';
        if (weekSel) weekSel.value = '';
        if (panelSel) panelSel.value = '';
        applyAllTabFilters();
    };

    // ============================================================================
    // Financial Dashboard filter
    // ============================================================================
    function applyFinancialFilter() {
        var weekSel = document.getElementById('flt-fin-week');
        var weekVal = weekSel ? weekSel.value : '';
        var rows = document.querySelectorAll('.cs-fin-row');
        rows.forEach(function (row) {
            var rowWeek = row.getAttribute('data-fin-week');
            var show = !weekVal || rowWeek === weekVal;
            row.classList.toggle('is-hidden', !show);
        });
        var visible = document.querySelectorAll('.fin-section:first-of-type .cs-fin-row:not(.is-hidden)').length;
        var countEl = document.getElementById('flt-fin-count');
        if (countEl) countEl.textContent = visible + ' week' + (visible !== 1 ? 's' : '');
        if (typeof applyScrollbarClasses === 'function') {
            setTimeout(applyScrollbarClasses, 50);
        }
    }

    window.resetFinancialFilter = function () {
        var weekSel = document.getElementById('flt-fin-week');
        if (weekSel) weekSel.value = '';
        applyFinancialFilter();
    };

    var finWeekSel = document.getElementById('flt-fin-week');
    if (finWeekSel) {
        finWeekSel.addEventListener('change', applyFinancialFilter);
        applyFinancialFilter(); // Initial filter application
    }

    // Wire up Download buttons → My Reports queue (async).
    // Falls back to synchronous ExportCodingExcel if the queue is unavailable (400).
    // When Avgs is configured, both sync and ReportWorker package Excel + average CSVs as a ZIP.
    (function () {
        var exportUrl = '@Url.Action("ExportCodingExcel", "Coding", new { lab = Model.LabName })';
        var queueUrl  = '@Url.Action("Queue", "UserReports")';
        var labName   = '@Model.LabName';
        var packageAvgs = @(Model.PackageAverageFiles ? "true" : "false");

        var overlay     = document.getElementById('csExportOverlay');
        var bar         = document.getElementById('csExportBar');
        var pctLabel    = document.getElementById('csExportPct');
        var statusLabel = document.getElementById('csExportStatus');
        var cancelBtn   = document.getElementById('csExportCancelBtn');

        function csGetCookie(name) {
            var m = document.cookie.match('(^|;)\\s*' + name + '=([^;]*)');
            return m ? m[2] : null;
        }
        function csDeleteCookie(name) {
            document.cookie = name + '=; path=/; max-age=0';
        }
        function csCleanup(p, c, s, iframe) {
            clearInterval(p); clearInterval(c); clearInterval(s);
            if (iframe && iframe.parentNode) document.body.removeChild(iframe);
        }

        function legacySyncDownload() {
            if (!overlay || !bar || !pctLabel || !statusLabel || !cancelBtn) {
                var iframeOnly = document.createElement('iframe');
                iframeOnly.style.display = 'none';
                iframeOnly.src = exportUrl;
                document.body.appendChild(iframeOnly);
                setTimeout(function () {
                    if (iframeOnly.parentNode) document.body.removeChild(iframeOnly);
                }, 600000);
                return;
            }

            csDeleteCookie('csExportDone');
            overlay.style.display = 'flex';
            bar.style.width = '0%';
            pctLabel.textContent = '0%';
            statusLabel.textContent = packageAvgs
                ? 'Building ZIP (Coding Summary + averages)\u2026'
                : 'Starting export\u2026';

            var startTime = Date.now();
            function elapsed() {
                var secs = Math.floor((Date.now() - startTime) / 1000);
                var m = Math.floor(secs / 60), s = secs % 60;
                return m > 0 ? m + 'm ' + s + 's' : s + 's';
            }

            var steps = [
                { pct: 18, text: 'Fetching Coding Summary data\u2026' },
                { pct: 45, text: 'Building Excel workbook\u2026' },
                { pct: 75, text: 'Formatting sheets\u2026' },
                { pct: 92, text: 'Finalizing download\u2026' }
            ];
            var stepIdx = 0, currentPct = 0;
            var stepTimer = setInterval(function () {
                if (stepIdx < steps.length) {
                    currentPct = steps[stepIdx].pct;
                    bar.style.width = currentPct + '%';
                    pctLabel.textContent = currentPct + '%';
                    statusLabel.textContent = steps[stepIdx].text;
                    stepIdx++;
                } else { clearInterval(stepTimer); }
            }, 1500);

            var creepTimer = setInterval(function () {
                if (stepIdx >= steps.length && currentPct < 99) {
                    currentPct += 0.2;
                    var p = Math.min(Math.round(currentPct), 99);
                    bar.style.width = p + '%';
                    pctLabel.textContent = p + '%';
                    statusLabel.textContent = 'Almost there\u2026  (' + elapsed() + ')';
                }
            }, 1000);

            var iframe = document.createElement('iframe');
            iframe.style.display = 'none';
            iframe.src = exportUrl;
            document.body.appendChild(iframe);

            var pollTimer = setInterval(function () {
                if (csGetCookie('csExportDone')) {
                    csCleanup(pollTimer, creepTimer, stepTimer, iframe);
                    csDeleteCookie('csExportDone');
                    bar.style.width = '100%';
                    pctLabel.textContent = '100%';
                    statusLabel.textContent = 'Download complete!  (' + elapsed() + ')';
                    setTimeout(function () { overlay.style.display = 'none'; }, 900);
                }
            }, 500);

            var onCancel = function () {
                csCleanup(pollTimer, creepTimer, stepTimer, iframe);
                csDeleteCookie('csExportDone');
                overlay.style.display = 'none';
                cancelBtn.removeEventListener('click', onCancel);
            };
            cancelBtn.addEventListener('click', onCancel);

            setTimeout(function () {
                csCleanup(pollTimer, creepTimer, stepTimer, iframe);
                overlay.style.display = 'none';
            }, 600000);
        }

        function queueExport(btn) {
            var body = new FormData();
            body.append('lab', labName);
            body.append('reportType', 'CodingSummary');
            body.append('filterDetails', JSON.stringify({}));
            var af = document.querySelector('#lrnReportsAf input[name="__RequestVerificationToken"]');
            if (af) body.append('__RequestVerificationToken', af.value);

            var original = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Queuing\u2026';

            fetch(queueUrl, { method: 'POST', body: body })
                .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, status: r.status, j: j }; }); })
                .then(function (res) {
                    if (res.ok) {
                        btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Generating - watch Reports';
                        if (window.lrnShowReportAlert) window.lrnShowReportAlert('success');
                        if (window.lrnReportsBadgeRefresh) window.lrnReportsBadgeRefresh();
                        setTimeout(function () { btn.disabled = false; btn.innerHTML = original; }, 8000);
                    } else if (res.status === 400) {
                        btn.disabled = false; btn.innerHTML = original;
                        legacySyncDownload();
                    } else {
                        btn.disabled = false; btn.innerHTML = original;
                        var msg = res.j && res.j.message ? res.j.message : '';
                        if (window.lrnShowReportAlert) {
                            if (res.status === 409 || /already/i.test(msg)) {
                                window.lrnShowReportAlert('info');
                            } else {
                                window.lrnShowReportAlert('error', { message: msg || 'Could not queue the report. Please try again.' });
                            }
                        }
                    }
                })
                .catch(function () {
                    btn.disabled = false; btn.innerHTML = original;
                    if (window.lrnShowReportAlert) {
                        window.lrnShowReportAlert('error', { message: 'Could not reach the server. Please try again.' });
                    }
                });
        }

        document.querySelectorAll('.exportCodingExcelBtn').forEach(function (btn) {
            btn.addEventListener('click', function () { queueExport(btn); });
        });
    }());


    // ?? Validation Detail: filter + pager + expand ???????????????????????
    (function () {
        var PAGE_SIZE = 50;
        var allRows   = [];   // {main, expand, panel, status, search, visible}
        var filtered  = [];   // subset after filters applied
        var curPage   = 1;

        function buildIndex() {
            var mains = document.querySelectorAll('#tbody-detail .det-row-main');
            mains.forEach(function (m) {
                allRows.push({
                    main:   m,
                    expand: m.nextElementSibling,
                    panel:  m.getAttribute('data-panel')  || '',
                    status: m.getAttribute('data-status') || '',
                    search: (m.getAttribute('data-search') || '').toLowerCase()
                });
            });
        }

        function applyFilters() {
            var panel  = (document.getElementById('flt-det-panel')  || {}).value || '';
            var status = (document.getElementById('flt-det-status') || {}).value || '';
            var search = ((document.getElementById('flt-det-search') || {}).value || '').toLowerCase();
            filtered = allRows.filter(function (r) {
                return (!panel  || r.panel  === panel)
                    && (!status || r.status === status)
                    && (!search || r.search.indexOf(search) !== -1);
            });
            var cnt = document.getElementById('flt-det-count');
            if (cnt) cnt.textContent = filtered.length + ' row' + (filtered.length !== 1 ? 's' : '');
            curPage = 1;
            renderPage();
            // Re-apply scrollbar classes after filter changes row visibility
            if (typeof applyScrollbarClasses === 'function') {
                setTimeout(applyScrollbarClasses, 50);
            }
        }

        function renderPage() {
            // Hide all rows first
            allRows.forEach(function (r) {
                r.main.style.display   = 'none';
                r.expand.style.display = 'none';
                r.expand.classList.remove('open');
                r.main.classList.remove('open');
            });

            var start = (curPage - 1) * PAGE_SIZE;
            var page  = filtered.slice(start, start + PAGE_SIZE);
            page.forEach(function (r) { r.main.style.display = ''; });

            // Pager info
            var info = document.getElementById('det-pager-info');
            if (info) {
                var from = filtered.length === 0 ? 0 : start + 1;
                var to   = Math.min(start + PAGE_SIZE, filtered.length);
                info.textContent = 'Showing ' + from + '-' + to + ' of ' + filtered.length + ' rows';
            }
            renderPagerBtns();
        }

        function renderPagerBtns() {
            var container = document.getElementById('det-pager-btns');
            if (!container) return;
            container.innerHTML = '';
            var totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
            if (totalPages <= 1) return;

            function mkBtn(label, page, disabled, active) {
                var b = document.createElement('button');
                b.className = 'det-pager-btn' + (active ? ' active' : '');
                b.textContent = label;
                b.disabled = !!disabled;
                if (!disabled) b.addEventListener('click', function () { curPage = page; renderPage(); });
                return b;
            }

            container.appendChild(mkBtn('<<', 1,          curPage === 1, false));
            container.appendChild(mkBtn('<', curPage - 1, curPage === 1, false));

            // page number buttons - show window of -2 around current
            var lo = Math.max(1, curPage - 2);
            var hi = Math.min(totalPages, curPage + 2);
            if (lo > 1)          { container.appendChild(mkBtn('1', 1, false, false)); if (lo > 2) { var e=document.createElement('span'); e.className='det-pager-ellipsis'; e.textContent='...'; container.appendChild(e); } }
            for (var p = lo; p <= hi; p++) container.appendChild(mkBtn(String(p), p, false, p === curPage));
            if (hi < totalPages) { if (hi < totalPages-1) { var e2=document.createElement('span'); e2.className='det-pager-ellipsis'; e2.textContent='...'; container.appendChild(e2); } container.appendChild(mkBtn(String(totalPages), totalPages, false, false)); }

            container.appendChild(mkBtn('>', curPage + 1, curPage === totalPages, false));
            container.appendChild(mkBtn('>>', totalPages,  curPage === totalPages, false));
        }

        // Row expand/collapse - Validation Detail
        window.detToggle = function (mainRow) {
            var exp  = mainRow.nextElementSibling;
            var open = exp.classList.toggle('open');
            mainRow.classList.toggle('open', open);
            exp.style.display = open ? '' : 'none';
        };

        // Row expand/collapse - YTD/WTD tables
        window.rowToggle = function (mainRow) {
            var exp  = mainRow.nextElementSibling;
            var open = exp.classList.toggle('open');
            mainRow.classList.toggle('open', open);
            exp.style.display = open ? '' : 'none';
            // Child sub-table just became visible/hidden - re-evaluate CPT pill clamping.
            if (typeof refreshCptPillToggles === 'function') {
                setTimeout(refreshCptPillToggles, 30);
            }
        };

        window.resetDetailFilter = function () {
            ['flt-det-panel', 'flt-det-status'].forEach(function (id) {
                var el = document.getElementById(id); if (el) el.value = '';
            });
            var s = document.getElementById('flt-det-search'); if (s) s.value = '';
            applyFilters();
        };

        ['flt-det-panel', 'flt-det-status'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) el.addEventListener('change', applyFilters);
        });
        var detSearch = document.getElementById('flt-det-search');
        if (detSearch) detSearch.addEventListener('input', applyFilters);

        buildIndex();
        applyFilters();
    }());

}());
</script>
