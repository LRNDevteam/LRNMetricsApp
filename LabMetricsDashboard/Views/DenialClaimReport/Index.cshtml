@using LabMetricsDashboard.Models
@model LabMetricsDashboard.ViewModels.DenialClaimReportViewModel
@{
    ViewData["Title"] = "Denial Summary";
    ViewData["SelectedLab"] = Model.CurrentLab;

    var tab = Model.ActiveTab;
}

@* The layout has no Styles section, so these go in the body the same way the original Denial
   Summary page links its own stylesheet. denial_dashboard.css carries the pivot table's frozen
   columns and sticky header bands, which the Monthly and Weekly tabs reuse from that page. *@
<link href="~/css/denial_dashboard.css" rel="stylesheet" />
<link href="~/css/denial_claim_report.css" rel="stylesheet" />

<div class="container-fluid px-3 py-3 dcr-page">

    @* Same header as the other report pages: title on the left, toolbar pinned right. The
       description sits below the row so its length can never push the button onto a new line. *@
    <div class="rpt-page-head mb-1">
        <div class="rpt-page-head-main">
            <h4 class="mb-0">Denial Summary</h4>
        </div>
        <div class="rpt-page-head-right">
            <div class="rpt-toolbar">
                @* Queued through LRN.ReportWorker (the Reports badge says when it is ready). The href
                   is the direct download, used when the lab has no report queue or JS is off. *@
                <a id="dcrExportExcelBtn" class="btn btn-sm btn-outline-success rpt-toolbar-btn"
                   asp-action="ExportWorkbook" asp-route-lab="@Model.CurrentLab" asp-route-bucket="@Model.Insight.Bucket"
                   data-lab="@Model.CurrentLab" data-bucket="@Model.Insight.Bucket"
                   data-week-starts-on="@(ViewData["DenialWeekStartsOn"] as string)"
                   data-date-column="@(ViewData["DenialDateColumn"] as string)"
                   data-run-id="@Model.RunId" data-week-folder="@Model.WeekRange"
                   title="Download Excel - Monthly Summary, Weekly Summary, Denial Insight and Denial Claim Level in one workbook"
                   aria-label="Download Excel">
                    <i class="bi bi-file-earmark-excel"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="text-muted mb-3" style="font-size:.85rem;">
        Calculated from <strong>@Model.CurrentLab</strong>&rsquo;s claim-level data &mdash; denied claims with an
        insurance balance still outstanding, grouped on @(ViewData["DenialDateColumn"] as string is { Length: > 0 } dc ? dc : "Denial Date"). Denial codes roll up to their
        common code, so CO45, PI45 and PR45 all count as 45.
    </div>

    @* Week range and RunId, in the same shape Production Report uses, so the page states the window
       it reports on and the load that produced it rather than leaving both to be inferred. *@
    @await Html.PartialAsync("_AnalysisRangeBanner", new LabMetricsDashboard.Models.AnalysisRangeInfo
    {
        WeekFolder = Model.WeekRange,
        RunId = Model.RunId
    })

    @if (TempData["DenialClaimReportSuccess"] is string ok)
    {
        <div class="alert alert-success py-2 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill"></i><span>@ok</span>
        </div>
    }
    @if (TempData["DenialClaimReportError"] is string err)
    {
        <div class="alert alert-danger py-2 d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill"></i><span>@err</span>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-warning py-2">@Model.Error</div>
    }

    <div class="row g-2 mb-3">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100"><div class="card-body py-2">
                <div class="text-muted text-uppercase" style="font-size:.7rem;font-weight:800;">Denied Claims</div>
                <div class="fw-bold fs-5">@Model.TotalClaims.ToString("N0")</div>
            </div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100"><div class="card-body py-2">
                <div class="text-muted text-uppercase" style="font-size:.7rem;font-weight:800;">Insurance Balance</div>
                <div class="fw-bold fs-5">@Acct2(Model.TotalInsuranceBalance)</div>
            </div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100"><div class="card-body py-2">
                <div class="text-muted text-uppercase" style="font-size:.7rem;font-weight:800;">Denial Codes</div>
                <div class="fw-bold fs-5">@Model.DenialCodeCount.ToString("N0")</div>
            </div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100"><div class="card-body py-2">
                <div class="text-muted text-uppercase" style="font-size:.7rem;font-weight:800;">Insurances</div>
                <div class="fw-bold fs-5">@Model.PayerCount.ToString("N0")</div>
            </div></div>
        </div>
    </div>

    @if (Model.UndatedGroups > 0)
    {
        <div class="alert alert-info py-2" style="font-size:.85rem;">
            <i class="bi bi-info-circle"></i>
            @Model.UndatedGroups.ToString("N0") denial group(s) have no Denial Date, so they cannot sit in a
            month or week column. They are counted in the totals above but not in the Monthly or Weekly
            Summary.
        </div>
    }

    <ul class="nav nav-pills denial-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(tab == "monthly" ? "active" : "")" data-bs-toggle="pill"
                    data-bs-target="#dcr-monthly" type="button" data-tab-key="monthly">
                <i class="bi bi-calendar-month me-2"></i>Monthly Summary
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(tab == "weekly" ? "active" : "")" data-bs-toggle="pill"
                    data-bs-target="#dcr-weekly" type="button" data-tab-key="weekly">
                <i class="bi bi-calendar-week me-2"></i>Weekly Summary
            </button>
        </li>
        @if (Model.HasDenialLists)
        {
            <li class="nav-item" role="presentation">
                <button class="nav-link @(tab == "list" ? "active" : "")" data-bs-toggle="pill"
                        data-bs-target="#dcr-list" type="button" data-tab-key="list">
                    <i class="bi bi-list-ol me-2"></i>Denial List
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(tab == "plantype" ? "active" : "")" data-bs-toggle="pill"
                        data-bs-target="#dcr-plantype" type="button" data-tab-key="plantype">
                    <i class="bi bi-diagram-3 me-2"></i>Denial List - Plan Type
                </button>
            </li>
        }
        <li class="nav-item" role="presentation">
            <button class="nav-link @(tab == "insight" ? "active" : "")" data-bs-toggle="pill"
                    data-bs-target="#dcr-insight" type="button" data-tab-key="insight">
                <i class="bi bi-lightbulb me-2"></i>Denial Insight
                @{
                    // The two tabs only. Archived rows are retained but out of the working view, so
                    // counting them here would claim more insights than the tab can show.
                    var insightCount = Model.Insight.BucketCounts.GetValueOrDefault(DenialInsightBuckets.Current)
                                     + Model.Insight.BucketCounts.GetValueOrDefault(DenialInsightBuckets.Previous);
                }
                @if (insightCount > 0)
                {
                    <span class="badge rounded-pill bg-light text-dark ms-2">@insightCount.ToString("N0")</span>
                }
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(tab == "claims" ? "active" : "")" data-bs-toggle="pill"
                    data-bs-target="#dcr-claims" type="button" data-tab-key="claims">
                <i class="bi bi-list-columns-reverse me-2"></i>Claim Level
                @if (Model.Claims.HasFilter)
                {
                    <span class="badge rounded-pill bg-warning text-dark ms-2">Filtered</span>
                }
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade @(tab == "monthly" ? "show active" : "")" id="dcr-monthly">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="fs-host" id="monthlyFsHost">
                        <div class="fs-bar">
                            <button type="button" class="fs-btn" data-fs-target="#monthlyFsHost">
                                <i class="bi bi-arrows-fullscreen"></i><span class="fs-label">Fullscreen</span>
                            </button>
                        </div>
                        @await Html.PartialAsync("_DenialPivotGrid", Model.Monthly)
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade @(tab == "weekly" ? "show active" : "")" id="dcr-weekly">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="fs-host" id="weeklyFsHost">
                        <div class="fs-bar">
                            <button type="button" class="fs-btn" data-fs-target="#weeklyFsHost">
                                <i class="bi bi-arrows-fullscreen"></i><span class="fs-label">Fullscreen</span>
                            </button>
                        </div>
                        @await Html.PartialAsync("_DenialPivotGrid", Model.Weekly)
                    </div>
                </div>
            </div>
        </div>

        @if (Model.HasDenialLists)
        {
            <div class="tab-pane fade @(tab == "list" ? "show active" : "")" id="dcr-list">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <form method="get" asp-action="Index" class="dcr-list-search" role="search">
                            <input type="hidden" name="lab" value="@Model.CurrentLab" />
                            <input type="hidden" name="tab" value="list" />
                            <input type="hidden" name="bucket" value="@Model.Insight.Bucket" />
                            <label for="dcrListCode" class="dcr-list-search-label">Denial Code</label>
                            <div class="input-group input-group-sm dcr-list-search-box">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input id="dcrListCode" name="listCode" type="search" class="form-control"
                                       list="dcrListCodeOptions" value="@Model.DenialListSearch"
                                       placeholder="Search denial code, e.g. CO-16" autocomplete="off" maxlength="200" />
                                <button class="btn btn-primary" type="submit">Search</button>
                            </div>
                            @if (Model.DenialListSearch is not null)
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Index"
                                   asp-route-lab="@Model.CurrentLab" asp-route-tab="list" asp-route-bucket="@Model.Insight.Bucket">
                                    <i class="bi bi-x-lg"></i> Clear
                                </a>
                                <span class="dcr-list-search-result">
                                    @Model.DenialList.Count(r => r.RowType == "D").ToString("N0") denial code row(s) with
                                    &ldquo;<strong>@Model.DenialListSearch</strong>&rdquo;
                                </span>
                            }
                            <datalist id="dcrListCodeOptions">
                                @foreach (var code in Model.DenialListCodeOptions)
                                {
                                    <option value="@code"></option>
                                }
                            </datalist>
                        </form>
                        @{ ViewData["DenialListSearch"] = Model.DenialListSearch; }
                        @await Html.PartialAsync("_DenialListGrid", Model.DenialList)
                    </div>
                </div>
            </div>

            <div class="tab-pane fade @(tab == "plantype" ? "show active" : "")" id="dcr-plantype">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        @await Html.PartialAsync("_DenialPlanTypeGrid", Model.PlanType)
                    </div>
                </div>
            </div>
        }

        <div class="tab-pane fade @(tab == "insight" ? "show active" : "")" id="dcr-insight">
            @await Html.PartialAsync("_DenialInsightPanel", Model.Insight)
        </div>

        <div class="tab-pane fade @(tab == "claims" ? "show active" : "")" id="dcr-claims">
            @await Html.PartialAsync("_DenialClaimLevelTab", Model.Claims)
        </div>
    </div>
</div>

@section Scripts {
    <script nonce="@Context.Items["CspNonce"]">
        // ── Production-style grids: insurance / denial code rows open their child rows ──
        document.addEventListener('click', function (e) {
            var row = e.target && e.target.closest ? e.target.closest('.dcr-page tr.pr-hp-toggle') : null;
            if (!row) return;
            var group = row.getAttribute('data-hp-group');
            var table = row.closest('table');
            if (!group || !table) return;
            var open = row.classList.toggle('pr-hp-open');
            row.setAttribute('aria-expanded', open ? 'true' : 'false');
            table.querySelectorAll('tr.pr-hp-child[data-hp-parent="' + group + '"]').forEach(function (child) {
                child.classList.toggle('pr-hp-shown', open);
            });
        });

        // ── Excel download ───────────────────────────────────────────────────
        // Queues a DenialSummary report; LRN.ReportWorker builds the four-sheet workbook (Monthly,
        // Weekly, Denial Insight and the Denial Claim Level rows) and the Reports badge says when
        // it is ready. Falls back to the button's own href - the direct download - when the lab
        // has no report queue.
        (function () {
            var btn = document.getElementById('dcrExportExcelBtn');
            if (!btn) return;

            btn.addEventListener('click', function (e) {
                if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
                e.preventDefault();

                var direct = function () { window.location.href = btn.getAttribute('href'); };
                var lab = btn.dataset.lab;
                if (!lab) { direct(); return; }

                // The Insight week tab swaps without a reload but the address bar follows it, so
                // the URL is the current choice; the attribute is only the first render's.
                var bucket = new URLSearchParams(window.location.search).get('bucket') || btn.dataset.bucket || null;

                var filters = {
                    Bucket:       bucket,
                    WeekStartsOn: btn.dataset.weekStartsOn || null,
                    DateColumn:   btn.dataset.dateColumn || null,
                    // Not filters - these name the downloaded file after the run it came from.
                    RunId:        btn.dataset.runId || null,
                    WeekFolder:   btn.dataset.weekFolder || null
                };

                var body = new FormData();
                body.append('lab', lab);
                body.append('reportType', 'DenialSummary');
                body.append('filterDetails', JSON.stringify(filters));
                var af = document.querySelector('#lrnReportsAf input[name="__RequestVerificationToken"]');
                if (af) body.append('__RequestVerificationToken', af.value);

                var original = btn.innerHTML;
                btn.classList.add('disabled');
                window.rptExportBusy(btn, '<span class="spinner-border spinner-border-sm"></span> Queuing…');

                fetch('@Url.Action("Queue", "UserReports")', { method: 'POST', body: body })
                    .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, status: r.status, j: j }; }); })
                    .then(function (res) {
                        if (res.ok) {
                            window.rptExportBusy(btn, '<i class="bi bi-check-circle"></i> Generating — watch Reports');
                            if (window.lrnShowReportAlert) window.lrnShowReportAlert('success');
                            if (window.lrnReportsBadgeRefresh) window.lrnReportsBadgeRefresh();
                            setTimeout(function () { btn.classList.remove('disabled'); window.rptExportIdle(btn, original); }, 8000);
                            return;
                        }

                        btn.classList.remove('disabled');
                        window.rptExportIdle(btn, original);

                        if (res.status === 400) { direct(); return; }

                        var qMsg = res.j && res.j.message ? res.j.message : '';
                        if (window.lrnShowReportAlert) {
                            if (res.status === 409 || /already/i.test(qMsg)) window.lrnShowReportAlert('info');
                            else window.lrnShowReportAlert('error', { message: qMsg || 'Could not queue the report.' });
                        }
                    })
                    .catch(function () {
                        btn.classList.remove('disabled');
                        window.rptExportIdle(btn, original);
                        direct();
                    });
            });
        })();

        (function () {
            // Keep the open tab in the URL. A save, an import or a delete redirects back here, and
            // without this the lab picker in the header would drop the user on Monthly Summary
            // every time instead of where they were.
            document.querySelectorAll('[data-tab-key]').forEach(function (btn) {
                btn.addEventListener('shown.bs.tab', function () {
                    var url = new URL(window.location.href);
                    url.searchParams.set('tab', btn.dataset.tabKey);
                    window.history.replaceState({}, '', url);
                });
            });

            // ── Panel swapping ───────────────────────────────────────────────
            // Switching insight weeks, paging claims and drilling through from an insight all
            // replace one panel instead of reloading the page. Every such link still carries a real
            // href to the full page, so this is an enhancement - with JavaScript off the links
            // navigate as they always did.
            var panes = { insight: document.getElementById('dcr-insight'), claims: document.getElementById('dcr-claims') };

            var showTab = function (key) {
                var btn = document.querySelector('[data-tab-key="' + key + '"]');
                if (btn && window.bootstrap) bootstrap.Tab.getOrCreateInstance(btn).show();
            };

            var loadPanel = function (link) {
                var key = link.dataset.panel;
                var pane = panes[key];
                if (!pane) return false;

                pane.classList.add('panel-loading');

                fetch(link.dataset.panelUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) {
                        if (!r.ok) throw new Error('HTTP ' + r.status);
                        return r.text();
                    })
                    .then(function (html) {
                        pane.innerHTML = html;
                        // The replaced markup has no handlers of its own - rebind before the user
                        // can click anything in it.
                        initPanels();
                        if (link.dataset.panelTab) showTab(link.dataset.panelTab);
                        // The address bar follows the panel, so a refresh or a copied link lands
                        // back on what is actually on screen.
                        window.history.replaceState({}, '', link.getAttribute('href'));
                        pane.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                    })
                    .catch(function () {
                        // A failed swap falls back to the ordinary navigation rather than leaving
                        // the user looking at a panel that did not change.
                        window.location.href = link.getAttribute('href');
                    })
                    .finally(function () { pane.classList.remove('panel-loading'); });

                return true;
            };

            // Delegated, so links inside a freshly swapped panel work without rebinding this.
            document.addEventListener('click', function (e) {
                var link = e.target.closest ? e.target.closest('a[data-panel-url]') : null;
                if (!link) return;
                if (link.classList.contains('disabled')) { e.preventDefault(); return; }
                if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;  // let new-tab work

                if (loadPanel(link)) e.preventDefault();
            });

            // Everything below binds to markup that a panel swap replaces, so it lives in one
            // function that is called on load and again after every swap. Elements already wired
            // carry data-bound so a re-run does not stack duplicate handlers on them.
            function initPanels() {

            // The import panel's checkbox picks between replacing Current Week and rolling it
            // forward. Both notes are already in the DOM; this shows the one that applies, so the
            // consequence is on screen before the file is sent.
            var replace = document.getElementById('replaceCurrentWeek');
            if (replace) {
                var noteRoll = document.getElementById('noteRollForward');
                var noteReplace = document.getElementById('noteReplace');
                var submit = document.getElementById('insightImportSubmit');
                var submitLabel = document.getElementById('insightImportSubmitLabel');

                var applyImportMode = function () {
                    var replacing = replace.checked;
                    noteRoll.hidden = replacing;
                    noteReplace.hidden = !replacing;
                    submitLabel.textContent = replacing
                        ? 'Replace Current Week'
                        : 'Import as new Current Week';
                    // Replacing discards work, so the button carries the warning colour rather than
                    // looking identical to the safe path.
                    submit.classList.toggle('btn-primary', !replacing);
                    submit.classList.toggle('btn-danger', replacing);
                };

                replace.addEventListener('change', applyImportMode);
                applyImportMode();
            }

            // Previous Week's import is the same idea with a radio pair: Append keeps what is there,
            // Override empties the tab first. Append is checked by default, so an untouched panel
            // does the non-destructive thing.
            var prevAppend = document.getElementById('previousModeAppend');
            var prevOverride = document.getElementById('previousModeOverride');
            if (prevAppend && prevOverride) {
                var noteAppend = document.getElementById('notePreviousAppend');
                var noteOverride = document.getElementById('notePreviousOverride');
                var prevSubmit = document.getElementById('insightImportPreviousSubmit');
                var prevSubmitLabel = document.getElementById('insightImportPreviousSubmitLabel');

                var applyPreviousMode = function () {
                    var overriding = prevOverride.checked;
                    noteAppend.hidden = overriding;
                    noteOverride.hidden = !overriding;
                    prevSubmitLabel.textContent = overriding
                        ? 'Delete and import into Previous Week'
                        : 'Append to Previous Week';
                    // Override deletes rows, so the button carries the warning colour rather than
                    // looking identical to the safe path.
                    prevSubmit.classList.toggle('btn-primary', !overriding);
                    prevSubmit.classList.toggle('btn-danger', overriding);
                };

                [prevAppend, prevOverride].forEach(function (radio) {
                    if (radio.dataset.bound) return;
                    radio.dataset.bound = '1';
                    radio.addEventListener('change', applyPreviousMode);
                });
                applyPreviousMode();
            }

            // Click-to-sort, used by both the Claim Level grid and the Denial Insight grid. Rows are
            // reordered in place rather than reloaded, so sorting is instant.
            //
            // Money and dates have to compare as values, not as the strings they are rendered as:
            // "$9,100.00" sorts above "$103,472.40" alphabetically, which is nonsense.
            var sortKey = function (cell, type) {
                // An insight cell holds its read view and its (hidden) editor; sort on what is shown.
                var view = cell.querySelector('.cell-view');
                var text = ((view || cell).textContent || '').trim();
                if (type === 'number' || /^[-+$(]?[\d,]+(\.\d+)?\)?%?$/.test(text)) {
                    var negative = /^\(.*\)$/.test(text);
                    var n = parseFloat(text.replace(/[^0-9.\-]/g, ''));
                    if (!isNaN(n)) return { n: negative ? -n : n };
                }
                var t = Date.parse(text);
                if (!isNaN(t) && /[\/\-]/.test(text) && text.length >= 6) return { n: t };
                return { s: text.toLowerCase() };
            };

            var makeSortable = function (table) {
                if (!table) return;
                var tbody = table.tBodies[0];
                if (!tbody) return;

                table.querySelectorAll('th.sortable:not([data-bound])').forEach(function (th) {
                    th.dataset.bound = '1';

                    // The header's own column, not its position among the sortable headers: the
                    // insight grid has unsortable columns (Observation, Data, Action...) in between.
                    var index = th.cellIndex;
                    th.setAttribute('role', 'button');
                    th.setAttribute('tabindex', '0');

                    var sortNow = function () {
                        var ascending = th.dataset.dir !== 'asc';

                        table.querySelectorAll('th.sortable').forEach(function (other) {
                            if (other !== th) { delete other.dataset.dir; other.classList.remove('sorted'); }
                        });
                        th.dataset.dir = ascending ? 'asc' : 'desc';
                        th.classList.add('sorted');

                        // Previous Week is split into week blocks by a divider row. Sorting across
                        // the dividers would destroy the grouping, so each week is sorted on its
                        // own and the dividers stay where they are.
                        var blocks = [];
                        var current = { divider: null, rows: [] };

                        Array.prototype.slice.call(tbody.rows).forEach(function (r) {
                            if (r.classList.contains('week-divider')) {
                                blocks.push(current);
                                current = { divider: r, rows: [] };
                            } else if (r.cells.length > 1) {
                                current.rows.push(r);
                            }
                        });
                        blocks.push(current);

                        var compare = function (a, b) {
                            var x = sortKey(a.cells[index], th.dataset.sortType);
                            var y = sortKey(b.cells[index], th.dataset.sortType);

                            // Blanks sink to the bottom either way - an empty cell is not the
                            // smallest value, it is the absence of one.
                            var xEmpty = x.s === '', yEmpty = y.s === '';
                            if (xEmpty && !yEmpty) return 1;
                            if (!xEmpty && yEmpty) return -1;

                            var result;
                            if ('n' in x && 'n' in y) result = x.n - y.n;
                            else result = String('s' in x ? x.s : x.n).localeCompare(String('s' in y ? y.s : y.n));

                            return ascending ? result : -result;
                        };

                        blocks.forEach(function (block) {
                            block.rows.sort(compare);
                            if (block.divider) tbody.appendChild(block.divider);
                            block.rows.forEach(function (r) { tbody.appendChild(r); });
                        });
                    };

                    th.addEventListener('click', sortNow);
                    th.addEventListener('keydown', function (e) {
                        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); sortNow(); }
                    });
                });
            };

            makeSortable(document.getElementById('claimsTable'));
            makeSortable(document.getElementById('insightTable'));

            // Rows-per-page. Rebuilds the panel URL with the chosen size and reuses the same swap
            // path the links use, so changing it does not reload the page either.
            var pageSize = document.getElementById('claimsPageSize');
            if (pageSize && !pageSize.dataset.bound) {
                pageSize.dataset.bound = '1';
                pageSize.addEventListener('change', function () {
                    var withSize = function (base) {
                        return base + (base.indexOf('?') >= 0 ? '&' : '?') + 'claimPageSize=' + pageSize.value;
                    };
                    var link = document.createElement('a');
                    link.dataset.panel = 'claims';
                    link.dataset.panelUrl = withSize(pageSize.dataset.panelUrlTemplate);
                    link.setAttribute('href', withSize(pageSize.dataset.pageUrlTemplate));
                    if (!loadPanel(link)) window.location.href = link.getAttribute('href');
                });
            }

            // Fullscreen for the wide tables, matching the Denial Summary page. The .fs-host /
            // .fs-btn styling already ships in denial_dashboard.css, which this page loads.
            document.querySelectorAll('.fs-btn[data-fs-target]:not([data-bound])').forEach(function (btn) {
                var host = document.querySelector(btn.dataset.fsTarget);
                if (!host) return;
                btn.dataset.bound = '1';

                var setState = function (on) {
                    host.classList.toggle('is-fs', on);
                    document.body.classList.toggle('fs-open', on);
                    btn.innerHTML = on
                        ? '<i class="bi bi-fullscreen-exit"></i><span class="fs-label">Exit fullscreen</span>'
                        : '<i class="bi bi-arrows-fullscreen"></i><span class="fs-label">Fullscreen</span>';
                    btn.setAttribute('title', on ? 'Exit fullscreen (Esc)' : 'View this table in fullscreen');
                };

                btn.addEventListener('click', function () {
                    setState(!host.classList.contains('is-fs'));
                });

                // Esc is what people reach for, and without it a fullscreen table with no visible
                // exit button after scrolling would be a trap.
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape' && host.classList.contains('is-fs')) setState(false);
                });
            });

            // Row-level edit on the Denial Insight grid. Edit flips one row into .is-editing (CSS
            // swaps each cell's read view for its editor); Cancel puts every editor back to what was
            // rendered; Save posts that row's own form.
            var insightTable = document.getElementById('insightTable');
            if (insightTable && !insightTable.dataset.rowEditBound) {
                insightTable.dataset.rowEditBound = '1';

                var resetRow = function (tr) {
                    tr.querySelectorAll('.cell-edit input:not([type="hidden"]), .cell-edit textarea').forEach(function (el) {
                        el.value = el.defaultValue;
                        if (el.classList.contains('cat-input')) el.dispatchEvent(new Event('input'));
                    });
                    tr.querySelectorAll('.rich-editor').forEach(function (editor) {
                        if (editor.dataset.original !== undefined) editor.innerHTML = editor.dataset.original;
                    });
                    tr.classList.remove('is-editing');
                };

                insightTable.addEventListener('click', function (e) {
                    var btn = e.target.closest('.row-edit, .row-cancel');
                    if (!btn) return;
                    var tr = btn.closest('tr');
                    if (!tr) return;

                    if (btn.classList.contains('row-edit')) {
                        tr.querySelectorAll('.rich-editor').forEach(function (editor) {
                            editor.dataset.original = editor.innerHTML;
                        });
                        tr.classList.add('is-editing');
                        var first = tr.querySelector('.cell-edit input:not([type="hidden"])');
                        if (first) first.focus();
                    } else {
                        resetRow(tr);
                    }
                });

                // Esc inside an editing row cancels it.
                insightTable.addEventListener('keydown', function (e) {
                    if (e.key !== 'Escape') return;
                    var tr = e.target.closest && e.target.closest('tr.is-editing');
                    if (tr) { e.stopPropagation(); resetRow(tr); }
                });
            }

            // The Observation / Action cells are contenteditable so the workbook's bold and bullets
            // stay visible while editing. They are not form fields, so their HTML is copied into the
            // hidden input beside them just before the row's form serializes.
            document.querySelectorAll('form.insight-row-form:not([data-bound])').forEach(function (form) {
                form.dataset.bound = '1';
                form.addEventListener('submit', function () {
                    var tr = document.querySelector('#insightTable tr[data-row-id="' + form.dataset.rowId + '"]');
                    if (!tr) return;
                    tr.querySelectorAll('.rich-editor').forEach(function (editor) {
                        var hidden = editor.parentElement
                            ? editor.parentElement.querySelector('input[type="hidden"][name="' + editor.dataset.target + '"]')
                            : null;
                        if (hidden) hidden.value = editor.innerHTML;
                    });
                    tr.querySelectorAll('.row-save').forEach(function (b) { b.disabled = true; });
                });
            });

            // Re-band the Category cell as it is typed, so the colour tracks the value instead of
            // waiting for a save to catch up.
            var bands = [
                { test: function (t) { return t.indexOf('appeal') >= 0 && (t.indexOf('mr') >= 0 || t.indexOf('medical record') >= 0); }, cls: 'cat-appeal-mr' },
                { test: function (t) { return t.indexOf('appeal') >= 0; }, cls: 'cat-appeal' },
                { test: function (t) { return t.indexOf('rebill') >= 0 || t.indexOf('reprocess') >= 0; }, cls: 'cat-rebill' },
                { test: function (t) { return t.indexOf('review') >= 0 || t.indexOf('write off') >= 0 || t.indexOf('write-off') >= 0; }, cls: 'cat-review' }
            ];
            var allBands = ['cat-appeal-mr', 'cat-appeal', 'cat-rebill', 'cat-review', 'cat-other'];

            document.querySelectorAll('.cat-input:not([data-bound])').forEach(function (input) {
                input.dataset.bound = '1';
                input.addEventListener('input', function () {
                    var text = (input.value || '').trim().toLowerCase();
                    var cls = 'cat-other';
                    if (text.length) {
                        for (var i = 0; i < bands.length; i++) {
                            if (bands[i].test(text)) { cls = bands[i].cls; break; }
                        }
                    }
                    var cell = input.closest('td');
                    allBands.forEach(function (b) { input.classList.remove(b); if (cell) cell.classList.remove(b); });
                    if (text.length) { input.classList.add(cls); if (cell) cell.classList.add(cls); }
                });
            });

            // The delete button only opens the dialog; the POST fires from inside it, so a row
            // cannot be deleted by a stray click on the grid.
            var deleteModal = document.getElementById('confirmDeleteModal');
            if (deleteModal) {
                deleteModal.addEventListener('show.bs.modal', function (event) {
                    var btn = event.relatedTarget;
                    if (!btn) return;
                    document.getElementById('deleteRowId').value = btn.dataset.rowId || '';
                    document.getElementById('deleteRowCode').textContent = btn.dataset.rowCode || '';
                    var payer = btn.dataset.rowPayer;
                    document.getElementById('deleteRowPayer').textContent = payer ? ' (' + payer + ')' : '';
                });
            }

            var confirmCopy = document.getElementById('confirmCopyBtn');
            if (confirmCopy && !confirmCopy.dataset.bound) {
                confirmCopy.dataset.bound = '1';
                confirmCopy.addEventListener('click', function () {
                    confirmCopy.disabled = true;
                    document.getElementById('copyPreviousForm').submit();
                });
            }

            }

            initPanels();
        })();
    </script>
}
