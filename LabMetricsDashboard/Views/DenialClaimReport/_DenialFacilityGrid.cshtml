@model IReadOnlyList<LabMetricsDashboard.Models.DenialFacilityRow>
@* NorthWest Facility wise Denial Breakdown - dbo.usp_GetNW_DenialByFacility *@
@if (Model.Count == 0)
{
    <div class="text-center text-muted py-4">No facility denial rows were found for the selected lab.</div>
}
else
{
    <div class="pr-wrap">
        <div class="pr-scroll dcr-pr-scroll">
            <table class="pr-table" style="width:100%">
                <thead>
                    <tr>
                        <th>Clinic Name</th>
                        <th>Denial Code</th>
                        <th>No. of Claims</th>
                        <th class="pr-grand-total">Insurance Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Where(r => r.RowType != "T"))
                    {
                        var isClinic = r.RowType == "F";
                        <tr class="@(isClinic ? "pr-panel-row" : "pr-hp-child")">
                            <td>@(isClinic ? r.ClinicName : "")</td>
                            <td>@(isClinic ? "" : r.DenialCode)</td>
                            <td>@r.ClaimCount.N0OrDash()</td>
                            <td class="pr-grand-total">@Acct2(r.TotalInsuranceBalance)</td>
                        </tr>
                    }
                </tbody>
                @if (Model.FirstOrDefault(r => r.RowType == "T") is { } total)
                {
                    <tfoot>
                        <tr class="pr-total-row">
                            <td colspan="2">Grand Total</td>
                            <td>@total.ClaimCount.N0OrDash()</td>
                            <td>@Acct2(total.TotalInsuranceBalance)</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
}
<div class="dcr-pr-note">
    <strong>Source:</strong> Claim Level &nbsp;|&nbsp; <strong>Filter:</strong> Denial Code not blank and InsuranceBalance &gt; 0
    &nbsp;|&nbsp; <strong>Rows:</strong> ClinicName, Denial Code
    &nbsp;|&nbsp; <strong>Sorted by:</strong> Claim Count DESC
</div>
