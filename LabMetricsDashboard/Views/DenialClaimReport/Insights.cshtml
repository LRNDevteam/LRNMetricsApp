@using LabMetricsDashboard.Models
@model LabMetricsDashboard.ViewModels.DenialInsightClaimLevelViewModel
@{
    ViewData["Title"] = "Denial Insights";
    string Money(decimal v) => v.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"));

    var tabs = new (string Key, string Label, string Hint)[]
    {
        (DenialInsightBuckets.Current,  "Current Week",  "What you have imported and are working on."),
        (DenialInsightBuckets.Previous, "Previous Week", $"The latest {DenialInsightBuckets.PreviousWeeksRetained} weeks."),
        (DenialInsightBuckets.Archive,  "Archive",       $"Older than {DenialInsightBuckets.PreviousWeeksRetained} weeks.")
    };

    var editable = Model.IsEditableTab;
    var activeHint = tabs.First(t => t.Key == Model.Bucket).Hint;
}

@* Observation and Action hold sanitized HTML (bold, bullets) from the uploaded workbook, so they are
   rendered as markup. Sanitizing happens on the way in AND on the way out of the database -
   see DenialInsightRichText - so a row edited directly in SQL cannot inject script here. *@

<div class="container-fluid px-3 py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div>
            <h4 class="mb-1">Denial Insights</h4>
            <div class="text-muted" style="font-size:.85rem;">
                Your imported analytical layer for this lab. Import your Denial Insight workbook, edit it here, and save.
                Importing never changes the claim-level data behind the summaries.
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <form method="get" asp-action="Insights" class="d-flex gap-2 align-items-center">
                <input type="hidden" name="bucket" value="@Model.Bucket" />
                <select name="lab" class="form-select form-select-sm" style="min-width:180px;" onchange="this.form.submit()">
                    @foreach (var lab in Model.Labs)
                    {
                        <option value="@lab" selected="@(string.Equals(lab, Model.CurrentLab, StringComparison.OrdinalIgnoreCase))">@lab</option>
                    }
                </select>
            </form>
            <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-lab="@Model.CurrentLab">
                <i class="bi bi-table"></i> Denial Summary
            </a>
            <a class="btn btn-sm btn-outline-secondary" asp-action="ExportInsights"
               asp-route-lab="@Model.CurrentLab" asp-route-bucket="@Model.Bucket">
                <i class="bi bi-download"></i> Download Template
            </a>
            @if (Model.CanEdit && Model.Bucket == DenialInsightBuckets.Current)
            {
                <form method="post" asp-action="UploadInsights" asp-route-lab="@Model.CurrentLab" enctype="multipart/form-data" class="d-inline-block">
                    @Html.AntiForgeryToken()
                    <label class="btn btn-sm btn-outline-primary mb-0">
                        <i class="bi bi-upload"></i> Import Denial Insight
                        <input type="file" name="insightFile" accept=".xlsx,.xlsm" hidden onchange="this.form.submit()" />
                    </label>
                </form>

                <form method="post" asp-action="CopyToPreviousWeek" asp-route-lab="@Model.CurrentLab"
                      class="d-inline-block" id="copyPreviousForm">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#confirmCopyModal"
                            @(Model.BucketCounts.GetValueOrDefault(DenialInsightBuckets.Current) == 0 ? "disabled" : "")>
                        <i class="bi bi-arrow-right-circle"></i> Copy Data to Previous Week
                    </button>
                </form>
            }
        </div>
    </div>

    @if (TempData["DenialClaimReportSuccess"] is string ok)
    {
        <div class="alert alert-success py-2">@ok</div>
    }
    @if (TempData["DenialClaimReportError"] is string err)
    {
        <div class="alert alert-danger py-2">@err</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-warning">@Model.Error</div>
    }

    <ul class="nav nav-tabs mb-0">
        @foreach (var tab in tabs)
        {
            <li class="nav-item">
                <a class="nav-link @(tab.Key == Model.Bucket ? "active fw-semibold" : "")"
                   asp-action="Insights" asp-route-lab="@Model.CurrentLab" asp-route-bucket="@tab.Key">
                    @tab.Label
                    <span class="badge rounded-pill @(tab.Key == Model.Bucket ? "bg-primary" : "bg-secondary-subtle text-secondary-emphasis")">
                        @Model.BucketCounts.GetValueOrDefault(tab.Key).ToString("N0")
                    </span>
                </a>
            </li>
        }
    </ul>

    <form method="post" asp-action="SaveInsights" asp-route-lab="@Model.CurrentLab">
        @Html.AntiForgeryToken()

        <div class="card border-0 shadow-sm rounded-top-0">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <span class="text-muted" style="font-size:.82rem;">
                        @activeHint
                        @Model.Rows.Count.ToString("N0") row(s) &mdash;
                        the Denial Code and Ins. Balance are clickable and open the claims behind them.
                        @if (!editable && Model.Rows.Count > 0)
                        {
                            <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle ms-1">
                                Read-only
                            </span>
                        }
                    </span>
                    @if (editable && Model.Rows.Count > 0)
                    {
                        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-save"></i> Save All</button>
                    }
                </div>

                @if (!editable && Model.Rows.Count > 0)
                {
                    <div class="alert alert-secondary py-2" style="font-size:.82rem;">
                        <i class="bi bi-lock"></i>
                        This tab is the record of what was said at the time, so it is not editable.
                        Edits are made on <strong>Current Week</strong>.
                    </div>
                }

                <div class="table-responsive" style="max-height:62vh;overflow:auto;">
                    <table class="table table-sm table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Week</th>
                                <th>Denial Codes</th>
                                <th>Descriptions</th>
                                <th class="text-end"># of Denial</th>
                                <th class="text-end">Total Balance ($)</th>
                                <th>Highest $ Impact - Insurance</th>
                                <th class="text-end">Ins. Balance ($)</th>
                                <th class="text-end">$ Impact (%)</th>
                                <th style="min-width:240px;">Observation</th>
                                <th>Category</th>
                                <th style="min-width:220px;">Action</th>
                                <th style="min-width:180px;">Feedback / Response</th>
                                <th>Responsibility</th>
                                <th>Discussion Date</th>
                                <th>ETA</th>
                                <th>Closed Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Rows.Count == 0)
                            {
                                <tr>
                                    <td colspan="17" class="text-center text-muted py-4">
                                        @if (Model.Bucket == DenialInsightBuckets.Current)
                                        {
                                            <span>
                                                No denial insights have been imported for this lab yet.
                                                Use <strong>Download Template</strong> for the expected format, then <strong>Import Denial Insight</strong>.
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                Nothing here yet. Rows arrive on this tab when
                                                <strong>Copy Data to Previous Week</strong> is used on Current Week.
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @for (var i = 0; i < Model.Rows.Count; i++)
                                {
                                    var row = Model.Rows[i];
                                    <tr>
                                        <td class="text-muted">@(i + 1)</td>
                                        <td style="white-space:nowrap;font-size:.78rem;">@row.WeekStart.ToString("dd MMM yyyy")</td>
                                        <td class="fw-semibold">
                                            <a asp-action="ClaimData" asp-route-lab="@Model.CurrentLab"
                                               asp-route-denialCode="@row.DenialCode" asp-route-from="insights"
                                               asp-route-bucket="@Model.Bucket"
                                               title="View the claims for this denial code">@row.DenialCode</a>
                                            @if (editable)
                                            {
                                                <input type="hidden" name="denialCodes" value="@row.DenialCode" />
                                                <input type="hidden" name="payerNames" value="@row.PayerName" />
                                            }
                                        </td>
                                        <td class="text-wrap" style="max-width:260px;">@row.DenialDescription</td>
                                        <td class="text-end">@row.NoOfDenials.ToString("N0")</td>
                                        <td class="text-end">@Money(row.TotalBalance)</td>
                                        <td>@row.PayerName</td>
                                        <td class="text-end">
                                            @if (string.IsNullOrWhiteSpace(row.PayerName))
                                            {
                                                <a asp-action="ClaimData" asp-route-lab="@Model.CurrentLab"
                                                   asp-route-denialCode="@row.DenialCode" asp-route-from="insights"
                                                   asp-route-bucket="@Model.Bucket"
                                                   title="View the claims behind this balance">@Money(row.InsuranceBalance)</a>
                                            }
                                            else
                                            {
                                                <a asp-action="ClaimData" asp-route-lab="@Model.CurrentLab"
                                                   asp-route-denialCode="@row.DenialCode" asp-route-payerName="@row.PayerName"
                                                   asp-route-from="insights" asp-route-bucket="@Model.Bucket"
                                                   title="View the claims behind this balance, for this payer">@Money(row.InsuranceBalance)</a>
                                            }
                                        </td>
                                        <td class="text-end">@row.ImpactPercentage.ToString("0.##")%</td>
                                        <td>
                                            @if (editable)
                                            {
                                                <div class="insight-html-editor form-control form-control-sm" contenteditable="true"
                                                     data-target="observations">@Html.Raw(row.ObservationHtml)</div>
                                                <input type="hidden" name="observations" value="@row.ObservationHtml" />
                                            }
                                            else if (string.IsNullOrWhiteSpace(row.ObservationHtml))
                                            {
                                                <span>-</span>
                                            }
                                            else
                                            {
                                                @Html.Raw(row.ObservationHtml)
                                            }
                                        </td>
                                        <td>
                                            @if (editable)
                                            {
                                                <input type="text" name="actionCategories" class="form-control form-control-sm" value="@row.ActionCategory" />
                                            }
                                            else
                                            {
                                                @(string.IsNullOrWhiteSpace(row.ActionCategory) ? "-" : row.ActionCategory)
                                            }
                                        </td>
                                        <td>
                                            @if (editable)
                                            {
                                                <div class="insight-html-editor form-control form-control-sm" contenteditable="true"
                                                     data-target="actions">@Html.Raw(row.ActionHtml)</div>
                                                <input type="hidden" name="actions" value="@row.ActionHtml" />
                                            }
                                            else if (string.IsNullOrWhiteSpace(row.ActionHtml))
                                            {
                                                <span>-</span>
                                            }
                                            else
                                            {
                                                @Html.Raw(row.ActionHtml)
                                            }
                                        </td>
                                        <td>
                                            @if (editable)
                                            {
                                                <textarea name="feedbackResponses" class="form-control form-control-sm" rows="2">@row.FeedbackResponse</textarea>
                                            }
                                            else
                                            {
                                                @(string.IsNullOrWhiteSpace(row.FeedbackResponse) ? "-" : row.FeedbackResponse)
                                            }
                                        </td>
                                        <td>
                                            @if (editable)
                                            {
                                                <input type="text" name="responsibilities" class="form-control form-control-sm" value="@row.Responsibility" maxlength="255" />
                                            }
                                            else
                                            {
                                                @(string.IsNullOrWhiteSpace(row.Responsibility) ? "-" : row.Responsibility)
                                            }
                                        </td>
                                        <td>
                                            @if (editable)
                                            {
                                                <input type="date" name="discussionDates" class="form-control form-control-sm" value="@(row.DiscussionDate?.ToString("yyyy-MM-dd"))" />
                                            }
                                            else
                                            {
                                                @(row.DiscussionDate?.ToString("dd MMM yyyy") ?? "-")
                                            }
                                        </td>
                                        <td>
                                            @if (editable)
                                            {
                                                <input type="date" name="etas" class="form-control form-control-sm" value="@(row.Eta?.ToString("yyyy-MM-dd"))" />
                                            }
                                            else
                                            {
                                                @(row.Eta?.ToString("dd MMM yyyy") ?? "-")
                                            }
                                        </td>
                                        <td>
                                            @if (editable)
                                            {
                                                <input type="date" name="closedDates" class="form-control form-control-sm" value="@(row.ClosedDate?.ToString("yyyy-MM-dd"))" />
                                            }
                                            else
                                            {
                                                @(row.ClosedDate?.ToString("dd MMM yyyy") ?? "-")
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </form>
</div>

@* Requirement 6g: confirm BEFORE the data moves. *@
<div class="modal fade" id="confirmCopyModal" tabindex="-1" aria-labelledby="confirmCopyLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmCopyLabel">Copy Data to Previous Week?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="font-size:.9rem;">
                <p class="mb-2">
                    This copies all
                    <strong>@Model.BucketCounts.GetValueOrDefault(DenialInsightBuckets.Current).ToString("N0")</strong>
                    Current Week insight row(s) for <strong>@Model.CurrentLab</strong> into
                    <strong>Previous Week</strong>.
                </p>
                <ul class="mb-2">
                    <li>Current Week is <strong>not</strong> emptied &mdash; the rows stay where they are.</li>
                    <li>A row already in Previous Week for the same week and denial code is refreshed from Current.</li>
                    <li>Anything in Previous Week older than @DenialInsightBuckets.PreviousWeeksRetained weeks moves to <strong>Archive</strong>.</li>
                </ul>
                <p class="mb-0 text-muted">You can run this again safely &mdash; it does not create duplicates.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-warning" id="confirmCopyBtn">
                    <i class="bi bi-arrow-right-circle"></i> Yes, copy to Previous Week
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script nonce="@Context.Items["CspNonce"]">
        // The Observation / Action cells are contenteditable so the workbook's bold and bullets stay
        // visible while editing. They are not form fields, so their HTML is copied into the hidden
        // input beside them just before the form serializes.
        (function () {
            document.querySelectorAll('form').forEach(function (form) {
                form.addEventListener('submit', function () {
                    form.querySelectorAll('.insight-html-editor').forEach(function (editor) {
                        var hidden = editor.parentElement
                            ? editor.parentElement.querySelector('input[type="hidden"][name="' + editor.dataset.target + '"]')
                            : null;
                        if (hidden) hidden.value = editor.innerHTML;
                    });
                });
            });

            // The Copy button only opens the modal; the POST fires from the confirm button, so the
            // data cannot move without the user having said yes.
            var confirmBtn = document.getElementById('confirmCopyBtn');
            if (confirmBtn) {
                confirmBtn.addEventListener('click', function () {
                    confirmBtn.disabled = true;
                    document.getElementById('copyPreviousForm').submit();
                });
            }
        })();
    </script>
}
