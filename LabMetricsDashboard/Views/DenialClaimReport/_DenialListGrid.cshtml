@model IReadOnlyList<LabMetricsDashboard.Models.DenialListRow>
@* Denial List - rows, ranking and totals come from dbo.usp_Get{prefix}_DenialList. *@
@if (Model.Count == 0)
{
    <div class="text-center text-muted py-4">
        @(ViewData["DenialListSearch"] is string search
            ? $"No denial code \"{search}\" has an outstanding insurance balance."
            : "No denial list rows were found for the selected lab.")
    </div>
}
else
{
    <div class="dcr-pr-caption">
        Denial codes by Total Insurance Balance &middot; click a denial code to open its insurances
    </div>
    <div class="pr-wrap" style="max-width:900px">
        <div class="pr-scroll dcr-pr-scroll">
            <table class="pr-table" style="width:100%">
                <colgroup><col style="width:480px" /><col style="width:150px" /><col style="width:200px" /></colgroup>
                <thead>
                    <tr>
                        <th>Denial Code &amp; Insurance</th>
                        <th>No. of Claims</th>
                        <th class="pr-grand-total">Total Insurance Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Where(r => r.RowType != "T"))
                    {
                        var gid = $"dcl-{r.CodeRank}";
                        if (r.RowType == "D")
                        {
                            <tr class="pr-panel-row pr-hp-toggle" data-hp-group="@gid" role="button" aria-expanded="false" title="Open / close insurances">
                                <td title="@r.DenialCode"><i class="bi bi-chevron-right pr-hp-chevron" aria-hidden="true"></i>@r.DenialCode</td>
                                <td>@r.ClaimCount.N0OrDash()</td>
                                <td class="pr-grand-total">@Acct2(r.TotalInsuranceBalance)</td>
                            </tr>
                        }
                        else
                        {
                            <tr class="pr-payer-row pr-hp-child" data-hp-parent="@gid">
                                <td title="@r.PayerName">@r.PayerName</td>
                                <td>@r.ClaimCount.N0OrDash()</td>
                                <td class="pr-grand-total">@Acct2(r.TotalInsuranceBalance)</td>
                            </tr>
                        }
                    }
                </tbody>
                @if (Model.FirstOrDefault(r => r.RowType == "T") is { } total)
                {
                    <tfoot>
                        <tr class="pr-total-row">
                            <td>Grand Total</td>
                            <td>@total.ClaimCount.N0OrDash()</td>
                            <td>@Acct2(total.TotalInsuranceBalance)</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
}
<div class="dcr-pr-note">
    <strong>Source:</strong> Claim Level &nbsp;|&nbsp; <strong>Filter:</strong> Total Insurance Balance &gt; 0 and Denial Code is not blank
    &nbsp;|&nbsp; <strong>Rows:</strong> Denial Code
    &nbsp;|&nbsp; <strong>Drill down:</strong> Insurance by Total Insurance Balance
    &nbsp;|&nbsp; <strong>Sorted by:</strong> Total Insurance Balance DESC
</div>
