@using System.Globalization
@using LabMetricsDashboard.Models
@using LabMetricsDashboard.Services
@model LabMetricsDashboard.ViewModels.DenialClaimLevelTabViewModel

@* The Claim Level tab. Columns come from LabClaimLineColumnCatalog and rows from the same
   repository the Dashboard's Claim Level page uses, so this is that page's data - not a second,
   differently-shaped claim list that could disagree with it. *@

@{
    // The filters are lists now, so the panel and page URLs cannot be built from a single
    // Url.Action anonymous object - it has no way to repeat a key. Appended by hand instead.
    string FilterQuery()
    {
        var parts = new List<string>();

        void Add(string key, IEnumerable<string> values)
        {
            foreach (var value in values)
            {
                parts.Add($"{key}={Uri.EscapeDataString(value)}");
            }
        }

        Add("denialCode", Model.DenialCodes);
        Add("payerName", Model.PayerNames);
        Add("panelName", Model.PanelNames);
        Add("clinicName", Model.ClinicNames);

        return parts.Count == 0 ? string.Empty : "&" + string.Join("&", parts);
    }

    var filterQuery = FilterQuery();

    // The chip names the first value and counts the rest, the same way the closed dropdown does -
    // a row of twenty payer names would push the grid off the screen.
    void Chip(string label, IReadOnlyList<string> values, string? extraCss = null)
    {
        if (values.Count == 0) return;

        <span class="claims-chip @extraCss" title="@string.Join(", ", values)">
            @label: <strong>@values[0]</strong>@if (values.Count > 1)
            {
                <span class="claims-chip-more">+@(values.Count - 1)</span>
            }
        </span>
    }
}

<div class="card border-0 shadow-sm" data-has-filter="@(Model.HasFilter ? "true" : "false")">
    <div class="card-body">

        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
            <div>
                <div class="claims-title">Claim Level</div>
                <div class="text-muted" style="font-size:.82rem;">
                    Denied claims with an insurance balance still outstanding, for
                    <strong>@Model.CurrentLab</strong>.
                    @if (!Model.HasFilter)
                    {
                        <span>Open a denial code or balance on the Denial Insight tab to filter this list.</span>
                    }
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="claims-count">
                    <strong>@Model.TotalFiltered.ToString("N0")</strong>
                    <span class="text-muted">of @Model.TotalAll.ToString("N0") claims</span>
                </span>

                @* Rows per page. Sorting orders what is loaded, so a larger page is also how you
                   sort across the whole set rather than one page of it. *@
                <label class="claims-size">
                    <span>Rows</span>
                    <select class="form-select form-select-sm" data-panel="claims" id="claimsPageSize"
                            data-panel-url-template="@(Url.Action("ClaimsPanel", new { lab = Model.CurrentLab, claimPage = 1 }) + filterQuery)"
                            data-page-url-template="@(Url.Action("Index", new { lab = Model.CurrentLab, tab = "claims", claimPage = 1 }) + filterQuery)">
                        @foreach (var size in LabMetricsDashboard.ViewModels.DenialClaimLevelTabViewModel.PageSizes)
                        {
                            <option value="@size" selected="@(size == Model.PageSize)">@size.ToString("N0")</option>
                        }
                    </select>
                </label>
                @if (Model.HasFilter)
                {
                    @* href is the full page so this still works without JavaScript; the page script
                       prefers data-panel-url and swaps just this panel. *@
                    <a class="btn btn-sm btn-outline-secondary" data-panel="claims"
                       data-panel-url="@Url.Action("ClaimsPanel", new { lab = Model.CurrentLab })"
                       href="@Url.Action("Index", new { lab = Model.CurrentLab, tab = "claims" })">
                        <i class="bi bi-x-lg"></i> Clear filters
                    </a>
                }
            </div>
        </div>

        @* The four filters. A list comes back empty when this lab's claim table has no column for
           it, and that filter is then left out rather than offered as a control that does nothing.
           Submitting as GET keeps every filtered view a shareable URL. *@
        <form method="get" asp-action="Index" class="claims-filter-bar">
            <input type="hidden" name="lab" value="@Model.CurrentLab" />
            <input type="hidden" name="tab" value="claims" />
            <input type="hidden" name="claimPageSize" value="@Model.PageSize" />

            @{
                // One filter. The checkboxes carry the field name, so the browser posts the key once
                // per selected value and the controller binds them as an array.
                void Filter(string label, string field, IReadOnlyList<string> options, IReadOnlyList<string> selected)
                {
                    var selectedSet = new HashSet<string>(selected, StringComparer.OrdinalIgnoreCase);
                    var summary = selected.Count == 0
                        ? "All"
                        : selected.Count == 1 ? selected[0] : $"{selected[0]}  +{selected.Count - 1}";

                    <div class="claims-filter" data-ms>
                        <span class="claims-filter-label">@label</span>

                        <button type="button" class="claims-ms-toggle @(selected.Count > 0 ? "is-set" : null)"
                                data-ms-toggle aria-expanded="false" aria-haspopup="listbox"
                                title="@(selected.Count == 0 ? "All" : string.Join(", ", selected))">
                            <span class="claims-ms-text" data-ms-text>@summary</span>
                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                        </button>

                        <div class="claims-ms-panel" data-ms-panel hidden>
                            <div class="claims-ms-search">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <input type="search" data-ms-search autocomplete="off" spellcheck="false"
                                       placeholder="Search @label.ToLowerInvariant()" aria-label="Search @label" />
                            </div>

                            <div class="claims-ms-tools">
                                <button type="button" data-ms-all>Select all</button>
                                <button type="button" data-ms-none>Clear</button>
                                <span class="claims-ms-count" data-ms-counter></span>
                            </div>

                            <div class="claims-ms-list" data-ms-list role="listbox" aria-multiselectable="true">
                                @foreach (var option in options)
                                {
                                    <label class="claims-ms-option" data-ms-option>
                                        <input type="checkbox" name="@field" value="@option"
                                               checked="@selectedSet.Contains(option)" />
                                        <span data-ms-label>@option</span>
                                    </label>
                                }
                            </div>

                            <div class="claims-ms-empty" data-ms-empty hidden>No match</div>
                        </div>
                    </div>
                }
            }

            @{ Filter("Denial Code", "denialCode", Model.FilterOptions.DenialCodes, Model.DenialCodes); }
            @{ Filter("Payer", "payerName", Model.FilterOptions.Payers, Model.PayerNames); }

            @if (Model.FilterOptions.Panels.Count > 0)
            {
                Filter("Panel", "panelName", Model.FilterOptions.Panels, Model.PanelNames);
            }

            @if (Model.FilterOptions.Clinics.Count > 0)
            {
                Filter("Clinic", "clinicName", Model.FilterOptions.Clinics, Model.ClinicNames);
            }

            <button type="submit" class="btn btn-sm btn-primary">
                <i class="bi bi-funnel"></i> Apply
            </button>
        </form>

        @if (Model.HasFilter)
        {
            <div class="claims-filters">
                <span class="claims-filters-label">Filtered by</span>
                @{ Chip("Denial Code", Model.DenialCodes); }
                @{ Chip("Insurance", Model.PayerNames, "claims-chip-payer"); }
                @{ Chip("Panel", Model.PanelNames); }
                @{ Chip("Clinic", Model.ClinicNames); }

                @* What the filter is actually worth. Both cover the whole filtered set, not the
                   page on screen, and claims are DISTINCT - a claim denied on three lines is three
                   rows in the grid but one claim to work. *@
                <span class="claims-filter-totals">
                    <span class="claims-filter-total">
                        <span class="claims-filter-total-value">@Model.FilteredClaims.ToString("N0")</span>
                        <span class="claims-filter-total-label">claims</span>
                    </span>
                    <span class="claims-filter-total">
                        <span class="claims-filter-total-value">@Acct2(Model.FilteredInsuranceBalance)</span>
                        <span class="claims-filter-total-label">insurance balance</span>
                    </span>
                </span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="alert alert-warning py-2">@Model.Error</div>
        }

        <div class="fs-host" id="claimsFsHost">
            <div class="fs-bar">
                <button type="button" class="fs-btn" data-fs-target="#claimsFsHost">
                    <i class="bi bi-arrows-fullscreen"></i><span class="fs-label">Fullscreen</span>
                </button>
            </div>

            <div class="claims-scroll">
                <table class="table table-sm table-bordered align-middle claims-table mb-0" id="claimsTable">
                    <thead>
                        <tr>
                            @foreach (var col in Model.DisplayColumns)
                            {
                                var money = LabClaimLineColumnCatalog.IsMoneyColumn(col);
                                <th class="sortable @(money ? "num" : null)"
                                    data-sort-type="@(money ? "number" : "auto")"
                                    scope="col" role="button" tabindex="0"
                                    title="Sort by @col">
                                    <span class="th-text">@col</span><span class="sort-arrow" aria-hidden="true"></span>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DisplayColumns.Count == 0)
                        {
                            <tr>
                                <td class="claims-empty">
                                    No claim-level columns are configured for this lab.
                                </td>
                            </tr>
                        }
                        else if (Model.Rows.Count == 0)
                        {
                            <tr>
                                <td colspan="@Model.DisplayColumns.Count" class="claims-empty">
                                    <i class="bi bi-search d-block mb-2" style="font-size:1.5rem;opacity:.45;"></i>
                                    <div class="fw-semibold mb-1">No claims match these filters</div>
                                    <div class="text-muted claims-diagnosis">
                                        @if (Model.Diagnosis is { } d)
                                        {
                                            <ul class="diag-list">
                                                <li>
                                                    <strong>@Model.TotalAll.ToString("N0")</strong> denied claim(s) with an
                                                    outstanding insurance balance in this lab.
                                                </li>
                                                @if (!string.IsNullOrWhiteSpace(Model.DenialCode))
                                                {
                                                    <li class="@(d.MatchingCode == 0 ? "diag-bad" : "diag-ok")">
                                                        <strong>@d.MatchingCode.ToString("N0")</strong> match denial code
                                                        <strong>@Model.DenialCode</strong> on its own.
                                                    </li>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(Model.PayerName))
                                                {
                                                    <li class="@(d.MatchingPayer == 0 ? "diag-bad" : "diag-ok")">
                                                        <strong>@d.MatchingPayer.ToString("N0")</strong> match insurance
                                                        <strong>@Model.PayerName</strong> on its own.
                                                    </li>
                                                }
                                            </ul>

                                            @if (d.NormalizedPopulated == 0)
                                            {
                                                <div class="diag-hint">
                                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                                    No claim carries a <code>DenialCodeNormalized</code> value yet. The column
                                                    exists but the <strong>claim-level import has not run since it was added</strong>,
                                                    so codes are being matched against the raw column only. Run the Master File
                                                    Processor for this lab to populate it.
                                                </div>
                                            }
                                            else if (d.MatchingCode > 0 && d.MatchingPayer == 0 && d.SamplePayers.Count > 0)
                                            {
                                                <div class="diag-hint">
                                                    <i class="bi bi-info-circle-fill"></i>
                                                    The denial code matches, but the insurance does not. Claims for
                                                    <strong>@Model.DenialCode</strong> are billed to:
                                                    <strong>@string.Join(", ", d.SamplePayers)</strong> &mdash; the insight
                                                    workbook spells it <strong>@Model.PayerName</strong>.
                                                </div>
                                            }
                                            else if (d.MatchingCode == 0)
                                            {
                                                <div class="diag-hint">
                                                    <i class="bi bi-info-circle-fill"></i>
                                                    No claim carries this denial code. It may exist only in the insight
                                                    workbook, or be spelled differently in the claim data.
                                                </div>
                                            }
                                        }
                                        else if (Model.HasFilter)
                                        {
                                            <span>
                                                The denial code or insurance may be spelled differently in the
                                                claim data. Clear the filters to see every denied claim.
                                            </span>
                                        }
                                        else
                                        {
                                            <span>This lab has no denied claims with an outstanding insurance balance.</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var record in Model.Rows)
                            {
                                <tr>
                                    @foreach (var col in Model.DisplayColumns)
                                    {
                                        var value = record.TryGetValue(col, out var v) ? v : string.Empty;
                                        if (LabClaimLineColumnCatalog.IsMoneyColumn(col)
                                            && decimal.TryParse(value, NumberStyles.Any, CultureInfo.InvariantCulture, out var amount))
                                        {
                                            <td class="num">@Acct2(amount)</td>
                                        }
                                        else if (LabClaimLineColumnCatalog.IsMoneyColumn(col))
                                        {
                                            <td class="num">@value</td>
                                        }
                                        else
                                        {
                                            <td>@value</td>
                                        }
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="claims-sort-note">
                <i class="bi bi-info-circle"></i>
                Sorting orders the @Model.Rows.Count.ToString("N0") row(s) on this page. Filter to a
                denial code to bring the whole set onto one page.
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <div class="claims-pager">
                <a class="btn btn-sm btn-outline-secondary @(Model.HasPrevious ? "" : "disabled")"
                   data-panel="claims"
                   data-panel-url="@(Url.Action("ClaimsPanel", new { lab = Model.CurrentLab, claimPage = Model.Page - 1, claimPageSize = Model.PageSize }) + filterQuery)"
                   href="@(Url.Action("Index", new { lab = Model.CurrentLab, tab = "claims", claimPage = Model.Page - 1, claimPageSize = Model.PageSize }) + filterQuery)">
                    <i class="bi bi-chevron-left"></i> Previous
                </a>
                <span class="claims-pager-label">
                    Page <strong>@Model.Page.ToString("N0")</strong> of @Model.TotalPages.ToString("N0")
                </span>
                <a class="btn btn-sm btn-outline-secondary @(Model.HasNext ? "" : "disabled")"
                   data-panel="claims"
                   data-panel-url="@(Url.Action("ClaimsPanel", new { lab = Model.CurrentLab, claimPage = Model.Page + 1, claimPageSize = Model.PageSize }) + filterQuery)"
                   href="@(Url.Action("Index", new { lab = Model.CurrentLab, tab = "claims", claimPage = Model.Page + 1, claimPageSize = Model.PageSize }) + filterQuery)">
                    Next <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        }
    </div>
</div>
