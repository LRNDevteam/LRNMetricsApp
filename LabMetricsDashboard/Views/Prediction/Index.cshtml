@model LabMetricsDashboard.Models.PredictionAnalysisViewModel
@{
    ViewData["Title"]       = $"Prediction Analysis - {Model.SelectedLab}";
    ViewData["SelectedLab"] = Model.SelectedLab;
    ViewData["PageLabel"]   = "Prediction Analysis";

    bool hasFilters = new[]
    {
        Model.FilterPayerName, Model.FilterPayerType, Model.FilterPanelName,
        Model.FilterCPTCode, Model.FilterForecastingPayability, Model.FilterPayStatus,
        Model.FilterForecastingPayabilitySubstatus, Model.FilterPredictionStatus
    }.Any(v => !string.IsNullOrWhiteSpace(v));

    var routeValues = new Dictionary<string, string?>
    {
        ["lab"]                       = Model.SelectedLab,
        ["filterPayerName"]           = Model.FilterPayerName,
        ["filterPayerType"]           = Model.FilterPayerType,
        ["filterPanelName"]           = Model.FilterPanelName,
        ["filterCPTCode"]             = Model.FilterCPTCode,
        ["filterForecastingPayability"]         = Model.FilterForecastingPayability,
        ["filterPayStatus"]                     = Model.FilterPayStatus,
        ["filterForecastingPayabilitySubstatus"] = Model.FilterForecastingPayabilitySubstatus,
        ["filterPredictionStatus"]              = Model.FilterPredictionStatus,
    };

    static string PayabilityBadgeClass(string v) => v switch
    {
        "Payable"             => "bg-success",
        "Potentially Payable" => "bg-warning text-dark",
        "Unknown"             => "bg-secondary",
        _                     => "bg-danger"
    };

    static string CoverageBadgeClass(string v) => v switch
    {
        "Covered"                             => "bg-success",
        "No Policy Found - Payment Expected"  => "bg-info text-dark",
        "No Policy Found - Payment Uncertain" => "bg-warning text-dark",
        _                                     => "bg-secondary"
    };

    // Bucket row styling: top-level rows bold, sub-rows indented
    static bool IsSummaryBucket(string name) =>
        name is "Predicted To Pay" or "Predicted – Paid" or "Predicted – Unpaid";

    static string DisplayGroupName(string groupName) =>
        groupName == "Not Predicted" ? "Not Predicted to Pay" : groupName;

    static string VarianceClass(decimal? v) =>
        v is null ? "" : v >= 0 ? "text-success" : "text-danger";

    static string FmtPct(decimal? v) => v.HasValue ? $"{v.Value:N2}%" : "—";
    static string FmtAmt(decimal? v) => v.HasValue ? Text(v.Value, 2) : "—";

    static string VariancePillClass(decimal? v) =>
        v is null ? "pn-var-neutral" : v >= 0 ? "pn-var-pos" : "pn-var-neg";

    static string VarianceArrowIcon(decimal? v) =>
        v is null ? "" : v >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short";

    static decimal SortVarInsurance(decimal? v) => v ?? decimal.MinValue;

    var summaryGroups = Model.Buckets
        .Where(b => b.IsGroupTotal)
        .Select(g => new
        {
            Total = g,
            Children = Model.Buckets
                .Where(c => !c.IsGroupTotal && c.GroupName == g.GroupName)
                .OrderByDescending(c => SortVarInsurance(c.VariancePaid))
                .ToList()
        })
        .OrderBy(g => g.Total.GroupName == "Predicted To Pay" ? 0 : 1)
        .ToList();

    var sm = Model.SummaryMetrics;
    var db = Model.DenialBreakdown;
    var nr = Model.NoResponseBreakdown;
    var payStatusGroups = Model.PayerPayStatusBreakdown
        .GroupBy(r => r.PayerName, StringComparer.OrdinalIgnoreCase)
        .OrderByDescending(g => g.Sum(x => x.VarianceAllowed))
        .ToList();
    var adjRows = Model.AdjustedByPayer;
    var adjTotal = new
    {
        PredAllow = adjRows.Sum(r => r.PredictedAllowed),
        PredIns   = adjRows.Sum(r => r.PredictedInsurance),
        ActAllow  = adjRows.Sum(r => r.ActualAllowed),
        ActIns    = adjRows.Sum(r => r.ActualInsurance),
        VarAllow  = adjRows.Sum(r => r.VarianceAllowed),
        VarPaid   = adjRows.Sum(r => r.VariancePaid),
    };

    static string PriBadgeClass(string b) => b switch
    {
        AgeBuckets.B0_30   => "pri-0-30",
        AgeBuckets.B31_60  => "pri-31-60",
        AgeBuckets.B61_90  => "pri-61-90",
        AgeBuckets.B91_120 => "pri-91-120",
        _                  => "pri-120p"
    };
    static string PriLabel(string b) => b switch
    {
        AgeBuckets.B0_30   => "Critical (0\u201330d)",
        AgeBuckets.B31_60  => "High (31\u201360d)",
        AgeBuckets.B61_90  => "Medium (61\u201390d)",
        AgeBuckets.B91_120 => "Low (91\u2013120d)",
        _                  => "Review (>120d)"
    };

    // Hardcoded fallback insight shown only for PCRLabsofAmerica when no JSON file is found on disk
    LabMetricsDashboard.Models.PredictionInsight? insight = Model.Insight;
    if (insight is null && Model.SelectedLab == "PCRLabsofAmerica")
    {
        insight = new LabMetricsDashboard.Models.PredictionInsight
        {
            ReportTitle    = "Prediction vs Non-Payment Analysis - Executive Insights",
            ReportPeriod   = "March 12, 2026 - March 18, 2026",
            GeneratedAt    = "2024-02-29T16:35:00Z",
            ModelUsed      = "gemma3:4b",
            SourceFileName = "(hardcoded fallback)",
            Sections       =
            [
                new LabMetricsDashboard.Models.InsightSection
                {
                    SectionNumber = 1,
                    Title         = "Payment vs Prediction Performance",
                    Subsections   =
                    [
                        new LabMetricsDashboard.Models.InsightSubsection
                        {
                            Title   = "Overview",
                            Bullets =
                            [
                                "Total predicted claims amount: $40,157.43",
                                "Predicted allowed amount: $21,497.43",
                                "Predicted insurance payment: $18,949.97",
                                "Overall, the predicted total closely matches the actual financial exposure, representing a core strength of the prediction model.",
                            ],
                        },
                        new LabMetricsDashboard.Models.InsightSubsection
                        {
                            Title   = "Actual vs Predicted",
                            Bullets =
                            [
                                "Actual allowed amount was $7,298.72, representing a variance of $8,258.73 compared to the predicted allowed amount.",
                                "Actual insurance payment was $0, representing a variance of $13,374.99 compared to the predicted insurance payment.",
                                "The largest variance is observed within the 'Predicted To Pay' category, indicating a significant overestimation of expected payment amounts.",
                            ],
                        },
                        new LabMetricsDashboard.Models.InsightSubsection
                        {
                            Title   = "Payment Rate",
                            Bullets =
                            [
                                "The overall payment rate for claims is 12.4%, suggesting that a small percentage of predicted claims are successfully paid.",
                                "Predicted allowed amount represents 27.6% of the total predicted claims, indicating a relatively high level of confidence in expected allowed amounts.",
                                "Predicted insurance payment represents 29.4% of the total predicted claims, aligning closely with the allowed amount and reinforcing the model's predictive capabilities.",
                            ],
                        },
                    ],
                },
                new LabMetricsDashboard.Models.InsightSection
                {
                    SectionNumber = 2,
                    Title         = "Non-Payment Breakdown",
                    Subsections   =
                    [
                        new LabMetricsDashboard.Models.InsightSubsection
                        {
                            Title   = "Denied Claims",
                            Bullets =
                            [
                                "39 claims were denied, accounting for 56.5% of the total unpaid claims.",
                                "The predicted allowed amount at risk for denied claims is $4,636.27, while the predicted insurance payment at risk is $3,419.21.",
                                "Denial rates are significantly higher than predicted, highlighting a need for improved pre-service authorization processes.",
                            ],
                        },
                        new LabMetricsDashboard.Models.InsightSubsection
                        {
                            Title   = "No Response Claims",
                            Bullets =
                            [
                                "29 claims are marked as 'No Response', representing 42.0% of the total unpaid claims.",
                                "The financial exposure associated with these claims is substantial, with a predicted allowed amount of $9,949.48 and a predicted insurance payment of $8,984.08.",
                                "'No Response' claims constitute the largest dollar risk within the unpaid claims category, demanding immediate attention.",
                            ],
                        },
                        new LabMetricsDashboard.Models.InsightSubsection
                        {
                            Title   = "Adjusted Claims",
                            Bullets =
                            [
                                "2 claims were marked as 'Adjusted', representing 2.9% of the total unpaid claims.",
                                "The predicted allowed amount and insurance payment amounts for adjusted claims are $971.70 each, reflecting a relatively small financial impact.",
                                "These claims likely involve complex coding or billing issues requiring targeted remediation efforts.",
                            ],
                        },
                    ],
                },
                new LabMetricsDashboard.Models.InsightSection
                {
                    SectionNumber = 3,
                    Title         = "Prediction Model Accuracy",
                    Subsections   =
                    [
                        new LabMetricsDashboard.Models.InsightSubsection
                        {
                            Title   = "Accuracy Summary",
                            Bullets =
                            [
                                "Overall prediction accuracy for the allowed amount is 99.2%, indicating a highly reliable model when predicting allowed amounts.",
                                "Overall prediction accuracy for insurance payment is 99.1%, mirroring the high reliability for allowed amount predictions.",
                                "The exceptionally high accuracy rates suggest the model is performing well and warrants continued monitoring for potential drift.",
                            ],
                        },
                    ],
                },
                new LabMetricsDashboard.Models.InsightSection
                {
                    SectionNumber = 4,
                    Title         = "Risks & Recommended Actions",
                    Subsections   =
                    [
                        new LabMetricsDashboard.Models.InsightSubsection
                        {
                            Title   = "Key Risks",
                            Bullets =
                            [
                                "High 'No Response' claim volume and associated financial exposure represents the most significant risk.",
                                "Large variances between predicted and actual allowed amounts, particularly in the 'Predicted To Pay' category, indicate potential overestimation of payment rates.",
                                "Denial of claims at a rate significantly higher than predicted suggests underlying authorization issues.",
                            ],
                        },
                        new LabMetricsDashboard.Models.InsightSubsection
                        {
                            Title   = "Recommended Actions",
                            Bullets =
                            [
                                "Prioritize investigation and resolution of all 'No Response' claims immediately, implementing enhanced follow-up procedures.",
                                "Conduct a root cause analysis of the overestimation in the 'Predicted To Pay' category to identify and correct model biases.",
                                "Review and refine pre-service authorization processes to reduce the rate of denied claims, focusing on proactive communication and accurate coding.",
                                "Implement automated claim review workflows to proactively identify and address potential payment issues prior to submission.",
                            ],
                        },
                    ],
                },
            ],
        };
    }
    // Per-section accent colours for the insight card (border, bg, icon, emoji)
    string[] insSecBorder = ["#1565c0","#c0392b","#1565c0","#f57c00"];
    string[] insSecBg     = ["#eff6ff","#fff5f5","#eff6ff","#fff8f0"];
    string[] insSecIcon   = ["#1565c0","#e53935","#1565c0","#f57c00"];
    string[] insSecEmoji  = ["&#128200;","&#128683;","&#127919;","&#9888;"];
}

<style>
    .pred-kpi-card   { border:none; border-radius:12px; box-shadow:0 2px 14px rgba(0,0,0,.08); }
    .insight-card    { border:none; border-radius:12px; box-shadow:0 2px 14px rgba(0,0,0,.08); }
    .insight-card .card-header { font-weight:700; font-size:.85rem; letter-spacing:.04em; border-radius:12px 12px 0 0; }
    .insight-table th, .insight-table td { font-size:.78rem; padding:.35rem .6rem; }
    .bar-wrap  { background:#e9ecef; border-radius:4px; height:6px; overflow:hidden; }
    .bar-fill  { height:6px; border-radius:4px; }
    .filter-panel { background:#fff; border-radius:12px; box-shadow:0 2px 10px rgba(0,0,0,.07); }
    /* Bucket table */
    .bucket-table th  { font-size:.76rem; white-space:nowrap; }
    .bucket-table td  { font-size:.82rem; }
    .bucket-summary   { background:#f0f4f8 !important; font-weight:700; }
    .bucket-sub td    { padding-left:2rem !important; color:#444; }
    .na-cell          { color:#bbb; font-style:italic; }
    /* Summary metrics table */
    .metrics-sheet { border-collapse:collapse; width:100%; font-size:.78rem; }
    .metrics-sheet th { border:1px solid #d0d7de; padding:.42rem .7rem; vertical-align:middle; white-space:nowrap; }
    .metrics-sheet td { border:1px solid #d0d7de; padding:.42rem .7rem; vertical-align:middle; white-space:nowrap; }
    .metrics-sheet thead th { background:#0d1b2a; color:#fff; font-weight:700; }
    .metrics-sheet .section-header td { background:#1565c0; color:#fff; font-weight:700; font-size:.8rem; letter-spacing:.03em; }
    .metrics-sheet .row-summary td:first-child { font-weight:700; }
    .metrics-sheet .row-summary-predicted td { background:#e8f2fc; }
    .metrics-sheet .row-summary-not-predicted td { background:#fff4e6; }
    .metrics-sheet .row-sub td:first-child { color:#1565c0; font-weight:600; padding-left:1rem; }
    .metrics-sheet .row-sub-not-predicted td:first-child { color:#c05621; font-weight:600; padding-left:1rem; }
    .metrics-sheet .row-ratio td:first-child { color:#2c3e50; }
    .metrics-sheet .val-cell { font-weight:700; white-space:nowrap; }

    /* Prediction vs Non-Payment Summary — reference UI style */
    .pn-summary-wrap {
        margin: 0;
        background: #fff;
        border-top: 1px solid #e8edf3;
        min-width: 0;
        overflow: hidden;
    }
    .pn-summary-toolbar {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: .5rem;
        padding: .65rem 1rem;
        background: #fff;
    }
    .pn-btn-outline {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .35rem .85rem;
        font-size: .78rem;
        font-weight: 600;
        color: #1565c0;
        background: #fff;
        border: 1px solid #bfdbfe;
        border-radius: 8px;
        cursor: pointer;
        transition: background .15s ease, box-shadow .15s ease;
    }
    .pn-btn-outline:hover {
        background: #eff6ff;
        box-shadow: 0 1px 4px rgba(21, 101, 192, .12);
    }
    .pn-btn-outline i { font-size: .85rem; }
    .pn-summary-scroll {
        overflow: auto;
        max-height: 500px;
        margin: 0 1rem 1rem;
        width: calc(100% - 2rem);
        max-width: calc(100% - 2rem);
        box-sizing: border-box;
        padding: 0;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        -webkit-overflow-scrolling: touch;
        position: relative;
        isolation: isolate;
    }
    .pn-summary-scroll::-webkit-scrollbar { width: 8px; height: 8px; }
    .pn-summary-scroll::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 8px;
    }
    .pn-summary-table {
        width: 100%;
        min-width: 1100px;
        border-collapse: separate;
        border-spacing: 0;
        font-size: .8rem;
        border: none;
        border-radius: 0;
        box-shadow: none;
    }
    .pn-summary-table thead th {
        background: #0f172a;
        color: #fff;
        font-weight: 700;
        font-size: .74rem;
        padding: .65rem .75rem;
        border: none;
        border-right: 1px solid rgba(255, 255, 255, .08);
        white-space: nowrap;
        vertical-align: middle;
    }
    .pn-summary-table thead th:last-child { border-right: none; }
    .pn-summary-table thead th.text-end { text-align: right; }
    .pn-summary-table thead th.text-end .pn-th-inner {
        justify-content: flex-end;
        width: 100%;
    }
    .pn-summary-table thead th:first-child { text-align: left; }
    .pn-th-inner {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
    }
    .pn-th-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.35rem;
        height: 1.35rem;
        border-radius: 6px;
        font-size: .72rem;
        flex-shrink: 0;
    }
    .pn-th-icon.ic-metrics { background: rgba(99, 102, 241, .25); color: #a5b4fc; }
    .pn-th-icon.ic-count   { background: rgba(168, 85, 247, .25); color: #d8b4fe; }
    .pn-th-icon.ic-pred-a  { background: rgba(34, 197, 94, .25); color: #86efac; }
    .pn-th-icon.ic-pred-i  { background: rgba(59, 130, 246, .25); color: #93c5fd; }
    .pn-th-icon.ic-act-a   { background: rgba(251, 146, 60, .25); color: #fdba74; }
    .pn-th-icon.ic-act-i   { background: rgba(139, 92, 246, .25); color: #c4b5fd; }
    .pn-th-icon.ic-var     { background: rgba(52, 211, 153, .2); color: #6ee7b7; }
    .pn-summary-table td {
        padding: .7rem .75rem;
        border-top: 1px solid #eef2f7;
        border-right: 1px solid #eef2f7;
        vertical-align: middle;
        white-space: nowrap;
        color: #1e293b;
    }
    .pn-summary-table td:last-child { border-right: none; }
    .pn-summary-table td.text-end { text-align: right; }
    .pn-summary-table .pn-val { font-weight: 600; font-variant-numeric: tabular-nums; }
    .pn-parent.pn-group-predicted td { background: #f0f7ff; }
    .pn-parent.pn-group-not-predicted td { background: #fff8f0; }
    .pn-parent td:first-child { font-weight: 700; }
    .pn-parent.pn-group-predicted .pn-group-label { color: #1d4ed8; }
    .pn-parent.pn-group-not-predicted .pn-group-label { color: #1e293b; }
    .pn-parent .pn-toggle-box {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.65rem;
        height: 1.65rem;
        margin-right: .55rem;
        padding: 0;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        background: #fff;
        box-shadow: 0 1px 3px rgba(15, 23, 42, .08);
        cursor: pointer;
        vertical-align: middle;
        flex-shrink: 0;
        transition: box-shadow .15s ease;
    }
    .pn-parent .pn-toggle-box:hover { box-shadow: 0 2px 6px rgba(15, 23, 42, .12); }
    .pn-parent.pn-group-predicted .pn-toggle-box { color: #2563eb; }
    .pn-parent.pn-group-not-predicted .pn-toggle-box { color: #ea580c; }
    .pn-parent .pn-toggle-box i {
        font-size: .95rem;
        line-height: 1;
        transition: transform .2s ease;
    }
    .pn-parent.pn-collapsed .pn-toggle-box i { transform: rotate(-90deg); }
    .pn-parent:not(.pn-collapsed) .pn-toggle-box i { transform: rotate(0deg); }
    .pn-parent .pn-metric-cell {
        display: flex;
        align-items: center;
        min-width: 200px;
    }
    .pn-child td { background: #fff; font-size: .78rem; }
    .pn-child.pn-group-predicted-child td { background: #fafcff; }
    .pn-child.pn-group-not-predicted-child td { background: #fffdfb; }
    .pn-child td:first-child {
        padding-left: 2.75rem !important;
        font-weight: 600;
        color: #475569;
    }
    .pn-child.pn-hidden { display: none; }
    .pn-child:hover td { background: #f8fafc !important; }
    .pn-var-pill {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }
    .pn-var-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.35rem;
        height: 1.35rem;
        border-radius: 50%;
        font-size: .85rem;
        line-height: 1;
    }
    .pn-var-pos { color: #15803d; }
    .pn-var-pos .pn-var-icon { background: #dcfce7; color: #16a34a; }
    .pn-var-neg { color: #b91c1c; }
    .pn-var-neg .pn-var-icon { background: #fee2e2; color: #dc2626; }
    .pn-var-neutral { color: #64748b; }
    .pn-var-neutral .pn-var-icon { display: none; }
    a.pn-var-link {
        text-decoration: none; cursor: pointer;
        border-bottom: none;
        gap: .4rem;
    }
    a.pn-var-link:hover { opacity: .95; }
    /* High-contrast eye affordance — was too faint on light row backgrounds */
    a.pn-var-link .pn-var-eye {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.35rem;
        height: 1.35rem;
        border-radius: 5px;
        background: #1d4ed8;
        color: #ffffff;
        font-size: .8rem;
        flex-shrink: 0;
        box-shadow: 0 1px 2px rgba(29, 78, 216, .35);
        border: 1px solid #1e3a8a;
    }
    a.pn-var-link:hover .pn-var-eye {
        background: #1e40af;
        color: #fff;
        border-color: #172554;
    }
    a.pn-var-link.pn-var-pos .pn-var-eye,
    a.pn-var-link.pn-var-neg .pn-var-eye,
    a.pn-var-link.pn-var-neutral .pn-var-eye {
        background: #1d4ed8;
        color: #fff;
    }

    /* Denied tab: denial code/description only inside expand panel */
    .denial-detail-panel {
        margin: .35rem .75rem .75rem 1.75rem;
        border: 1px solid #fecaca;
        border-radius: 8px;
        background: #fffafa;
        overflow: visible;
    }
    .denial-detail-panel .denial-panel-title {
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: #991b1b;
        padding: .45rem .75rem;
        background: #fef2f2;
        border-bottom: 1px solid #fecaca;
    }
    .denial-detail-panel table {
        margin: 0;
        font-size: .78rem;
        table-layout: auto;
        width: 100%;
    }
    .denial-detail-panel thead th {
        background: #fee2e2 !important;
        color: #7f1d1d !important;
        font-weight: 600;
        white-space: nowrap;
        padding: .4rem .65rem;
        border-bottom: 1px solid #fecaca;
    }
    .denial-detail-panel tbody td {
        padding: .4rem .65rem;
        vertical-align: top;
    }
    .denial-detail-panel .denial-code-cell {
        color: #b91c1c;
        font-weight: 700;
        white-space: normal;
        word-break: break-word;
        min-width: 140px;
        max-width: 280px;
    }
    .denial-detail-panel .denial-desc-cell {
        white-space: normal;
        word-break: break-word;
        max-width: 420px;
        color: #334155;
    }
    .prediction-accuracy-tile {
        cursor: help;
        transition: transform .15s ease, box-shadow .15s ease;
    }
    .prediction-accuracy-tile:hover,
    .prediction-accuracy-tile:focus {
        transform: translateY(-1px);
        outline: none;
    }
    .calc-tooltip-trigger { position: relative; }
    .calc-tooltip {
        display: none;
        position: absolute;
        left: 50%;
        bottom: calc(100% + 12px);
        transform: translateX(-50%);
        width: 390px;
        max-width: min(390px, calc(100vw - 32px));
        padding: 1rem 1.1rem;
        border: 1px solid #334155;
        border-radius: 16px;
        background: linear-gradient(145deg, #172033, #1e293b);
        color: #e2e8f0;
        box-shadow: 0 18px 42px rgba(15, 23, 42, .32);
        text-align: left;
        z-index: 50;
        pointer-events: none;
    }
    .calc-tooltip::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: -8px;
        width: 16px;
        height: 16px;
        transform: translateX(-50%) rotate(45deg);
        background: #1e293b;
        border-right: 1px solid #334155;
        border-bottom: 1px solid #334155;
    }
    .ratio-card .calc-tooltip {
        left: 0;
        transform: none;
    }
    .ratio-card .calc-tooltip::after {
        left: 28px;
        transform: rotate(45deg);
    }
    .calc-tooltip-trigger:hover .calc-tooltip,
    .calc-tooltip-trigger:focus .calc-tooltip,
    .calc-tooltip-trigger:focus-within .calc-tooltip {
        display: block;
    }
    .calc-tooltip-title {
        display: flex;
        align-items: center;
        gap: .55rem;
        margin-bottom: .7rem;
        color: #f8fafc;
        font-size: .9rem;
        font-weight: 800;
    }
    .calc-tooltip-title i {
        display: inline-grid;
        place-items: center;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #3730a3;
        color: #c7d2fe;
    }
    .calc-tooltip-formula {
        margin-bottom: .65rem;
        color: #cbd5e1;
        font-size: .76rem;
        line-height: 1.4;
    }
    .calc-tooltip-row {
        display: grid;
        grid-template-columns: 72px 1fr;
        gap: .6rem;
        padding: .36rem 0;
        border-top: 1px solid rgba(148, 163, 184, .16);
        font-size: .72rem;
    }
    .calc-tooltip-row:first-of-type { border-top: 0; }
    .calc-tooltip-key { color: #94a3b8; font-weight: 700; }
    .calc-tooltip-value {
        color: #f8fafc;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }
    .pn-summary-table td.pa-calc-highlight {
        background: #fef3c7 !important;
        box-shadow: inset 0 0 0 2px #f59e0b;
        color: #92400e !important;
        position: relative;
        z-index: 8;
    }

    /* Summary grid — frozen header + first 2 columns */
    .pn-summary-scroll.pred-grid-scroll .pn-summary-table.pred-freeze-table {
        width: max-content;
        min-width: 100%;
    }
    .pn-summary-table.pred-freeze-table thead th.pred-freeze-1,
    .pn-summary-table.pred-freeze-table thead th.pred-freeze-2 {
        background: #0f172a;
        color: #fff;
        z-index: 7;
    }
    .pn-summary-table.pred-freeze-table .pn-parent.pn-group-predicted .pred-freeze-1,
    .pn-summary-table.pred-freeze-table .pn-parent.pn-group-predicted .pred-freeze-2 {
        background: #f0f7ff;
    }
    .pn-summary-table.pred-freeze-table .pn-parent.pn-group-not-predicted .pred-freeze-1,
    .pn-summary-table.pred-freeze-table .pn-parent.pn-group-not-predicted .pred-freeze-2 {
        background: #fff8f0;
    }
    .pn-summary-table.pred-freeze-table .pn-child.pn-group-predicted-child .pred-freeze-1,
    .pn-summary-table.pred-freeze-table .pn-child.pn-group-predicted-child .pred-freeze-2 {
        background: #fafcff;
    }
    .pn-summary-table.pred-freeze-table .pn-child.pn-group-not-predicted-child .pred-freeze-1,
    .pn-summary-table.pred-freeze-table .pn-child.pn-group-not-predicted-child .pred-freeze-2 {
        background: #fffdfb;
    }
    .pn-summary-table.pred-freeze-table .pn-child:hover .pred-freeze-1,
    .pn-summary-table.pred-freeze-table .pn-child:hover .pred-freeze-2 {
        background: #f8fafc !important;
    }
    .pn-summary-table.pred-freeze-table .pred-freeze-1 {
        min-width: 200px;
        max-width: 320px;
    }
    .pn-summary-table.pred-freeze-table .pred-freeze-2 {
        min-width: 90px;
    }

    /* Ratio cards strip */
    .ratio-strip { background:#f0f4f8; border-top:1px solid #d0d7de; padding:.75rem 1rem; }
    .ratio-card  { background:#fff; border-radius:8px; border-left:3px solid #1565c0;
                   padding:.45rem .85rem; min-width:160px; box-shadow:0 1px 4px rgba(0,0,0,.06); }
    .ratio-card .rc-label { font-size:.68rem; font-weight:600; color:#555; letter-spacing:.03em; text-transform:uppercase; }
    .ratio-card .rc-vals  { display:flex; gap:.6rem; align-items:baseline; flex-wrap:wrap; margin-top:.15rem; }
    .ratio-card .rc-val   { font-size:.92rem; font-weight:700; color:#0d1b2a; }
    .ratio-card .rc-sub   { font-size:.66rem; color:#888; }
    .disclaimer-bar { background:#f8f9fa; border:1px solid #dee2e6; border-radius:8px; padding:.5rem 1rem; font-size:.78rem; color:#555; }
    /* Validation table (Payer / Panel) */
    .vt-table { border-collapse:collapse; width:100%; font-size:.76rem; }
    .vt-table th, .vt-table td { border:1px solid #dde3ea; padding:.38rem .6rem; white-space:nowrap; vertical-align:middle; }
    .vt-table thead th { background:#253858; color:#fff; font-weight:600; text-align:center; }
    .vt-table thead th:first-child { text-align:left; }
    .vt-table tbody tr:nth-child(odd)  { background:#fafbfc; }
    .vt-table tbody tr:nth-child(even) { background:#fff; }
    .vt-table tbody tr:hover { background:#eef4ff; }
    .vt-table tfoot tr.vt-total td { background:#1a2744; color:#fff; font-weight:700; border-top:2px solid #0d1b2a; }
    .vt-type-badge  { background:#e3f2fd; color:#1565c0; border-radius:4px; padding:.1rem .45rem; font-size:.66rem; font-weight:600; }
    .vt-paid   { color:#1565c0; font-weight:600; }
    .vt-denied { color:#c62828; font-weight:600; }
    .vt-noresp { color:#e65100; font-weight:600; }
    .vt-adj    { color:#6a1b9a; font-weight:600; }
    .vt-unpaid { color:#b71c1c; }
    .vt-var-pos { color:#1565c0; }
    .vt-var-neg { color:#c62828; }
    .vt-header  { border-bottom:1px solid #253858; }
    .vt-table .payer-drill-link {
        font-size:inherit; font-weight:600; color:#1565c0; text-decoration:none;
        padding:0; border:none; background:transparent; cursor:pointer; line-height:inherit;
    }
    .vt-table .payer-drill-link:hover { text-decoration:underline; color:#0d47a1; }
    /* Small expand/collapse toggle for validation grids (denied, pay status modal) */
    .pred-grid-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.15rem;
        height: 1.15rem;
        margin-right: .35rem;
        padding: 0;
        border: 1px solid #dbeafe;
        border-radius: 4px;
        background: #fff;
        color: #2563eb;
        box-shadow: 0 1px 2px rgba(15, 23, 42, .06);
        cursor: pointer;
        vertical-align: middle;
        flex-shrink: 0;
        line-height: 1;
        transition: box-shadow .15s ease, background .15s ease;
    }
    .pred-grid-toggle i {
        font-size: .68rem;
        line-height: 1;
        transition: transform .2s ease;
    }
    .pred-grid-toggle[aria-expanded="false"] i { transform: rotate(-90deg); }
    .pred-grid-toggle[aria-expanded="true"] i  { transform: rotate(0deg); }
    .pred-grid-toggle:hover {
        background: #f8fafc;
        box-shadow: 0 1px 4px rgba(37, 99, 235, .14);
    }
    .denial-row-payer .pred-grid-toggle {
        border-color: #bfdbfe;
        color: #1d4ed8;
    }
    .payer-group-row .pred-grid-toggle {
        border-color: #cbd5e1;
        color: #334155;
    }
    /* Denial breakdown table */
    .denial-table { border-collapse:collapse; width:100%; font-size:.76rem; }
    .denial-table th, .denial-table td { border:1px solid #d0d7de; padding:.38rem .55rem; white-space:nowrap; }
    .denial-table thead tr:first-child th { background:#0d1b2a; color:#fff; font-weight:700; text-align:center; }
    .denial-table thead tr:last-child th  { background:#1565c0; color:#fff; font-weight:600; text-align:center; }
    .denial-row-payer td  { background:#e8f0fe; font-weight:600; font-size:inherit; }
    .denial-row-code  td  { background:#fff; padding-left:1.5rem !important; color:#333; }
    .denial-row-code td:first-child { color:#c0392b; font-weight:600; }
    .denial-row-total td  { background:#f0f4f8; font-weight:700; }
    .denial-table td.amt  { text-align:right; font-variant-numeric:tabular-nums; }
    .denial-table td.cnt  { text-align:right; }
    .denial-month-group   { border-left:2px solid #90caf9 !important; }
    /* No Response breakdown table */
    .nr-table { border-collapse:collapse; width:100%; font-size:.76rem; }
    .nr-table th, .nr-table td { border:1px solid #d0d7de; padding:.38rem .55rem; white-space:nowrap; }
    .nr-table thead tr:first-child th { background:#4a148c; color:#fff; font-weight:700; text-align:center; }
    .nr-table thead tr:last-child th  { background:#7b1fa2; color:#fff; font-weight:600; text-align:center; }
    .nr-row-payer td { background:#f3e5f5; font-weight:600; font-size:inherit; }
    .nr-row-total td { background:#f0f4f8; font-weight:700; }
    .nr-table td.amt { text-align:right; font-variant-numeric:tabular-nums; }
    .nr-table td.cnt { text-align:right; }
    .nr-bucket-group { border-left:2px solid #ce93d8 !important; }
    /* Priority badge colours */
    .pri-0-30   { background:#d32f2f; color:#fff; }
    .pri-31-60  { background:#f57c00; color:#fff; }
    .pri-61-90  { background:#fbc02d; color:#212121; }
    .pri-91-120 { background:#1565c0; color:#fff; }
    .pri-120p   { background:#1565c0; color:#fff; }
    .pri-badge  { border-radius:12px; padding:.15rem .55rem; font-size:.68rem; font-weight:700; white-space:nowrap; }
    /* Pro tabs */
    .pro-tabs       { display:flex; gap:0; border-bottom:2px solid #dde3ea; background:#f8fafc; border-radius:12px 12px 0 0; overflow-x:auto; }
    .pro-tab        { border:none; background:transparent; padding:.65rem 1.25rem; font-size:.8rem;
                      font-weight:600; color:#64748b; cursor:pointer; border-bottom:3px solid transparent;
                      margin-bottom:-2px; white-space:nowrap; letter-spacing:.01em;
                      transition:color .15s,border-color .15s,background .15s; display:flex; align-items:center; gap:.4rem; }
    .pro-tab:hover  { color:#1565c0; background:#eef4ff; }
    .pro-tab.active { color:#1565c0; border-bottom-color:#1565c0; background:#fff; }
    .pro-tab.tab-denial.active   { color:#b71c1c; border-bottom-color:#b71c1c; }
    .pro-tab.tab-denial:hover    { color:#b71c1c; background:#fff5f5; }
    .pro-tab.tab-noresp.active   { color:#6a1b9a; border-bottom-color:#6a1b9a; }
    .pro-tab.tab-noresp:hover    { color:#6a1b9a; background:#fdf4ff; }
    .pro-tab.tab-panel.active    { color:#00695c; border-bottom-color:#00695c; }
    .pro-tab.tab-panel:hover     { color:#00695c; background:#f0fdf9; }
    .pro-tab.tab-cpt.active      { color:#00838f; border-bottom-color:#00838f; }
    .pro-tab.tab-cpt:hover       { color:#00838f; background:#e0f7fa; }
    .pro-tab-badge  { background:#e2e8f0; color:#475569; border-radius:20px; padding:.05rem .45rem;
                      font-size:.65rem; font-weight:700; line-height:1.5; }
    .pro-tab.active .pro-tab-badge { background:#1565c0; color:#fff; }
    .pro-tab.tab-denial.active .pro-tab-badge  { background:#b71c1c; }
    .pro-tab.tab-noresp.active .pro-tab-badge  { background:#6a1b9a; }
    .pro-tab.tab-panel.active  .pro-tab-badge  { background:#00695c; }
    .pro-tab.tab-cpt.active    .pro-tab-badge  { background:#00838f; }
    .pro-tab.tab-insight.active { color:#7c3aed; border-bottom-color:#7c3aed; }
    .pro-tab.tab-insight:hover  { color:#7c3aed; background:#faf5ff; }
    .pro-tab.tab-insight.active .pro-tab-badge { background:#7c3aed; }
    /* Prediction Accuracy tiles (no bg) */
    .pa-strip { padding:.85rem 1rem .6rem; border-bottom:1px solid #e9eef4; }
    .pa-tile  { border-radius:10px; padding:.65rem 1rem; min-width:180px; flex:1;
                border:1px solid #dde3ea; display:flex; flex-direction:column; gap:.18rem; }
    .pa-tile .pa-label { font-size:.65rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
    .pa-tile .pa-value { font-size:1.5rem; font-weight:800; line-height:1; }
    .pa-tile .pa-sub   { font-size:.65rem; color:#64748b; }

    /* Prediction Validation grids — 500px scroll + frozen header / first 2 columns */
    .pred-grid-scroll {
        max-height: 500px;
        overflow: auto;
        width: 100%;
        -webkit-overflow-scrolling: touch;
        position: relative;
        isolation: isolate;
    }
    .pred-grid-scroll .pred-freeze-table.vt-table,
    .pred-grid-scroll .pred-freeze-table.nr-table {
        border-collapse: separate;
        border-spacing: 0;
        width: max-content;
        min-width: 100%;
        table-layout: auto;
    }
    .pred-freeze-table {
        border-collapse: separate;
        border-spacing: 0;
        width: max-content;
        min-width: 100%;
    }
    .pred-freeze-table thead th {
        position: sticky;
        top: var(--pred-sticky-top, 0);
        z-index: 4;
        background-clip: padding-box;
    }
    .pred-freeze-table th.pred-freeze-1,
    .pred-freeze-table td.pred-freeze-1,
    .pred-freeze-table th.pred-freeze-2,
    .pred-freeze-table td.pred-freeze-2 {
        position: sticky;
        background-clip: padding-box;
        z-index: 2;
    }
    .pred-freeze-table thead th.pred-freeze-1,
    .pred-freeze-table thead th.pred-freeze-2 {
        z-index: 6;
    }
    .pred-freeze-table th.pred-freeze-1,
    .pred-freeze-table td.pred-freeze-1 {
        left: 0;
        min-width: 160px;
        max-width: 280px;
        box-shadow: 1px 0 0 #dde3ea;
    }
    .pred-freeze-table th.pred-freeze-2,
    .pred-freeze-table td.pred-freeze-2 {
        left: var(--pred-freeze-col1-width, 200px);
        min-width: 130px;
        box-shadow: 2px 0 5px rgba(15, 23, 42, .08);
    }
    .pred-freeze-table thead th.pred-freeze-2 {
        box-shadow: 2px 0 6px rgba(15, 23, 42, .12);
    }
    .pred-freeze-table tbody tr:nth-child(odd) .pred-freeze-1,
    .pred-freeze-table tbody tr:nth-child(odd) .pred-freeze-2 { background: #fafbfc; }
    .pred-freeze-table tbody tr:nth-child(even) .pred-freeze-1,
    .pred-freeze-table tbody tr:nth-child(even) .pred-freeze-2 { background: #fff; }
    .pred-freeze-table tbody tr:hover .pred-freeze-1,
    .pred-freeze-table tbody tr:hover .pred-freeze-2 { background: #eef4ff; }
    .pred-freeze-table .denial-row-payer .pred-freeze-1,
    .pred-freeze-table .denial-row-payer .pred-freeze-2 { background: #e8f0fe !important; }
    .pred-freeze-table .nr-row-payer .pred-freeze-1,
    .pred-freeze-table .nr-row-payer .pred-freeze-2 { background: #f3e5f5 !important; }
    .pred-freeze-table tfoot .pred-freeze-1,
    .pred-freeze-table tfoot .pred-freeze-2 { background: #1a2744 !important; color: #fff; }
    .pred-freeze-table.nr-table tfoot .pred-freeze-1,
    .pred-freeze-table.nr-table tfoot .pred-freeze-2 { background: #f0f4f8 !important; color: inherit; }
    .pred-freeze-table.nr-table thead tr:first-child th { background: #4a148c; color: #fff; }
    .pred-freeze-table.nr-table thead tr:last-child th  { background: #7b1fa2; color: #fff; }
    .pred-freeze-table.nr-table thead th.pred-freeze-1 { background: #4a148c; color: #fff; }
    .pred-freeze-table.nr-table thead th.pred-freeze-2 { background: #7b1fa2; color: #fff; }
    .pred-freeze-table.vt-table thead th.pred-freeze-1,
    .pred-freeze-table.vt-table thead th.pred-freeze-2 { background: #253858; color: #fff; }
</style>

<!-- Header -->
<h2 class="mb-1 fw-bold">&#128202; Prediction Analysis <span class="badge bg-primary bg-gradient fw-semibold" style="font-size:.45em;vertical-align:middle;border-radius:20px;padding:.35em .85em">@Model.SelectedLab</span></h2>

@if (Model.RunId is not null || Model.WeekFolder is not null || Model.DataInsertedAt is not null)
{
    <div class="mb-3 d-flex flex-wrap align-items-center gap-2" style="font-size:.78rem;color:#475569;">
        @if (Model.RunId is not null)
        {
            <span class="badge" style="background:#eef2ff;color:#3730a3;font-weight:600;border-radius:12px;padding:.35em .8em;">
                &#127991;&#65039; Run ID: @Model.RunId
            </span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.WeekFolder))
        {
            <span class="badge" style="background:#ecfdf5;color:#065f46;font-weight:600;border-radius:12px;padding:.35em .8em;">
                &#128197; Week: @Model.WeekFolder
            </span>
        }
        @if (Model.DataInsertedAt is not null)
        {
            <span class="badge" style="background:#fff7ed;color:#9a3412;font-weight:600;border-radius:12px;padding:.35em .8em;">
                &#128337; Data loaded: @Model.DataInsertedAt.Value.ToString("MMM dd, yyyy hh:mm tt")
            </span>
        }
    </div>
}

@if (!string.IsNullOrEmpty(Model.SelectedLab))
{
    @if (!Model.PredictionAvailable)
    {
        var errMsg    = Model.ErrorMessage ?? string.Empty;
        bool isMissing  = errMsg.Contains("does not exist", StringComparison.OrdinalIgnoreCase)
                       || errMsg.Contains("missing",        StringComparison.OrdinalIgnoreCase)
                       || errMsg.Contains("could not find", StringComparison.OrdinalIgnoreCase)
                       || errMsg.Contains("empty",          StringComparison.OrdinalIgnoreCase);
        bool isConnErr  = errMsg.Contains("A network-related", StringComparison.OrdinalIgnoreCase)
                       || errMsg.Contains("Login failed",       StringComparison.OrdinalIgnoreCase)
                       || errMsg.Contains("connection",         StringComparison.OrdinalIgnoreCase);
        bool isNoData   = errMsg.Contains("is empty",         StringComparison.OrdinalIgnoreCase)
                       || errMsg.Contains("not yet available", StringComparison.OrdinalIgnoreCase);

        string icon  = isConnErr ? "??" : isNoData ? "??" : isMissing ? "???" : "??";
        string title = isConnErr ? "Database Connection Error"
                     : isNoData  ? "No Data Yet"
                     : isMissing ? "Database Setup Required"
                     :             "Prediction Not Available";

        var steps = new List<(string Step, string Body)>();
        if (isMissing)
        {
            steps.Add(("1", "Connect to this lab's SQL Server database."));
            steps.Add(("2", "Run <code>01_CreateTables.sql</code> to create the base tables."));
            steps.Add(("3", "Run <code>02_CreateStoredProcedures.sql</code> to create the core SPs."));
            steps.Add(("4", "Run <code>03_PredictionAggregatedSPs.sql</code> to create the analysis SPs."));
            steps.Add(("5", "Run <code>04_PredictionAggregateTables.sql</code> &amp; <code>05_PredictionAggregateRefreshSPs.sql</code> for snapshot tables."));
            steps.Add(("6", "Run <code>06_PredictionReadSPs.sql</code> to create the read SPs."));
            steps.Add(("7", "Run PredictionAnalysisApp to load source data into the database."));
        }
        else if (isNoData)
        {
            steps.Add(("1", "Ensure PredictionAnalysisApp is configured for <strong>@Model.SelectedLab</strong>."));
            steps.Add(("2", "Set <code>\"EnableDatabaseInsert\": true</code> in the lab JSON config."));
            steps.Add(("3", "Place the latest source Excel file in the lab's Input folder."));
            steps.Add(("4", "Run PredictionAnalysisApp to load data, then reload this page."));
        }
        else if (isConnErr)
        {
            steps.Add(("1", "Verify the <code>DbConnectionString</code> in the lab's dashboard config."));
            steps.Add(("2", "Check that the SQL Server instance is reachable from the web server."));
            steps.Add(("3", "Confirm firewall rules and SQL Server login credentials."));
        }

        <div class="card border-0 shadow-sm my-4" style="border-radius:16px;overflow:hidden">
            <!-- Header bar -->
            <div class="card-header text-white py-3 px-4"
                 style="background:linear-gradient(135deg,#0d1b2a,#1565c0)">
                <div class="d-flex align-items-center gap-3">
                    <span style="font-size:2rem;line-height:1">@Html.Raw(icon)</span>
                    <div>
                        <div class="fw-bold" style="font-size:1.05rem">@title</div>
                        <div style="font-size:.75rem;opacity:.8">
                            Prediction Analysis &mdash; @Model.SelectedLab
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body px-4 py-4">

                @* Error detail message *@
                @if (!string.IsNullOrWhiteSpace(errMsg))
                {
                    <div class="alert alert-warning d-flex gap-2 align-items-start mb-4"
                         style="font-size:.85rem;border-left:4px solid #f59e0b;border-radius:8px">
                        <span style="font-size:1.1rem;margin-top:.05rem">&#9888;&#65039;</span>
                        <div>
                            <div class="fw-semibold mb-1">Details</div>
                            <div>@errMsg</div>
                        </div>
                    </div>
                }

                @* Resolution steps *@
                @if (steps.Count > 0)
                {
                    <div class="fw-semibold mb-3" style="font-size:.85rem;color:#0d1b2a;letter-spacing:.04em">
                        &#9989; RESOLUTION STEPS
                    </div>
                    <ol class="mb-4 ps-3" style="font-size:.87rem;color:#374151;line-height:1.9">
                        @foreach (var (_, body) in steps)
                        {
                            <li>@Html.Raw(body)</li>
                        }
                    </ol>
                }

                @* Script file reference strip *@
                @if (isMissing)
                {
                    <div class="rounded p-3 mb-4"
                         style="background:#f0f9ff;border:1px solid #bae6fd;font-size:.78rem">
                        <div class="fw-semibold mb-2" style="color:#0369a1">
                            &#128196; SQL Scripts (PredictionAnalysisApp\Database\)
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var script in new[]
                            {
                                "01_CreateTables.sql",
                                "02_CreateStoredProcedures.sql",
                                "03_PredictionAggregatedSPs.sql",
                                "04_PredictionAggregateTables.sql",
                                "05_PredictionAggregateRefreshSPs.sql",
                                "06_PredictionReadSPs.sql"
                            })
                            {
                                <span class="badge"
                                      style="background:#e0f2fe;color:#0369a1;
                                             font-weight:600;font-size:.74rem;
                                             border:1px solid #bae6fd;padding:.3em .65em">
                                    @script
                                </span>
                            }
                        </div>
                    </div>
                }

                @* Action buttons *@
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="Prediction" asp-action="Index"
                       asp-route-lab="@Model.SelectedLab"
                       class="btn btn-primary btn-sm">
                        &#8635; Retry
                    </a>
                    <a asp-controller="Home" asp-action="Index"
                       class="btn btn-outline-secondary btn-sm">
                        &#8592; Back to Home
                    </a>
                </div>

            </div>
        </div>
        return;
    }


    <!-- ?? Filter panel ????????????????????????????????????????????????????? -->
    <div class="filter-panel p-3 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="fw-semibold" style="font-size:.9rem">
                &#128269; Filters
                @if (hasFilters)
                {
                    <span class="badge bg-primary ms-1" style="font-size:.7rem">Active</span>
                }
            </span>
            <button class="btn btn-sm btn-link text-muted p-0" type="button"
                    data-bs-toggle="collapse" data-bs-target="#predFilterBody"
                    aria-expanded="@(hasFilters ? "true" : "false")">
                @if (hasFilters)
                {
                    <i class="bi bi-chevron-up me-1"></i><span>Hide</span>
                }
                else
                {
                    <i class="bi bi-chevron-down me-1"></i><span>Show</span>
                }
            </button>
        </div>
        <div id="predFilterBody" class="collapse @(hasFilters ? "show" : "")">
            <form method="get" asp-controller="Prediction" asp-action="Index" data-lab-form>
                <input type="hidden" name="lab" value="@Model.SelectedLab" />
                <div class="row g-2 align-items-end">
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label fw-semibold mb-1" style="font-size:.75rem">PAYER NAME</label>
                        <select name="filterPayerName" class="form-select form-select-sm">
                            <option value="">All</option>
                            @foreach (var v in Model.PayerNames)
                            {
                                if (v == Model.FilterPayerName) { <option value="@v" selected="selected">@v</option> }
                                else { <option value="@v">@v</option> }
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label fw-semibold mb-1" style="font-size:.75rem">PAYER TYPE</label>
                        <select name="filterPayerType" class="form-select form-select-sm">
                            <option value="">All</option>
                            @foreach (var v in Model.PayerTypes)
                            {
                                if (v == Model.FilterPayerType) { <option value="@v" selected="selected">@v</option> }
                                else { <option value="@v">@v</option> }
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label fw-semibold mb-1" style="font-size:.75rem">PANEL NAME</label>
                        <select name="filterPanelName" class="form-select form-select-sm">
                            <option value="">All</option>
                            @foreach (var v in Model.PanelNames)
                            {
                                if (v == Model.FilterPanelName) { <option value="@v" selected="selected">@v</option> }
                                else { <option value="@v">@v</option> }
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label fw-semibold mb-1" style="font-size:.75rem">CPT CODE</label>
                        <select name="filterCPTCode" class="form-select form-select-sm">
                            <option value="">All</option>
                            @foreach (var v in Model.CPTCodes)
                            {
                                if (v == Model.FilterCPTCode) { <option value="@v" selected="selected">@v</option> }
                                else { <option value="@v">@v</option> }
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label fw-semibold mb-1" style="font-size:.75rem">FORECASTING PAYABILITY</label>
                        <select name="filterForecastingPayability" class="form-select form-select-sm">
                            <option value="">All</option>
                            @foreach (var v in Model.ForecastingPayabilities)
                            {
                                if (v == Model.FilterForecastingPayability) { <option value="@v" selected="selected">@v</option> }
                                else { <option value="@v">@v</option> }
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label fw-semibold mb-1" style="font-size:.75rem">PAY STATUS</label>
                        <select name="filterPayStatus" class="form-select form-select-sm">
                            <option value="">All</option>
                            @foreach (var v in Model.PayStatuses)
                            {
                                if (v == Model.FilterPayStatus) { <option value="@v" selected="selected">@v</option> }
                                else { <option value="@v">@v</option> }
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label fw-semibold mb-1" style="font-size:.75rem">FORECAST SUBSTATUS</label>
                        <select name="filterForecastingPayabilitySubstatus" class="form-select form-select-sm">
                            <option value="">All</option>
                            @foreach (var v in Model.ForecastingPayabilitySubstatuses)
                            {
                                if (v == Model.FilterForecastingPayabilitySubstatus) { <option value="@v" selected="selected">@v</option> }
                                else { <option value="@v">@v</option> }
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label fw-semibold mb-1" style="font-size:.75rem">PREDICTION STATUS</label>
                        <select name="filterPredictionStatus" class="form-select form-select-sm">
                            <option value="">All</option>
                            @foreach (var v in Model.PredictionStatuses)
                            {
                                if (v == Model.FilterPredictionStatus) { <option value="@v" selected="selected">@v</option> }
                                else { <option value="@v">@v</option> }
                            }
                        </select>
                    </div>
                </div>
                <div class="mt-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm">Apply Filters</button>
                    <a asp-controller="Prediction" asp-action="Index" asp-route-lab="@Model.SelectedLab"
                       class="btn btn-outline-secondary btn-sm">Clear</a>
                    <button type="button" id="exportPredictionExcelBtn" class="btn btn-sm btn-outline-success ms-auto">
                        <i class="bi bi-file-earmark-excel me-1"></i>Download Excel
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["ExportError"] is string exportError)
    {
        <div class="alert alert-warning alert-dismissible fade show mt-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> @exportError
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.FileFound)
    {
        return;
    }

    <!-- ?? Prediction vs Non-Payment Summary ??????????????????????????????? -->
    <div class="card insight-card mb-4">
        <div class="card-header text-white d-flex align-items-center justify-content-between"
             style="background:linear-gradient(135deg,#0d1b2a,#1565c0)">
            <div>
                <div class="fw-bold">&#128203; Prediction vs Non-Payment Summary</div>
                <div style="font-size:.72rem;opacity:.8;font-weight:400">
                    Claims = COUNT(line items) &nbsp;|&nbsp;
                    Predicted = SUM(Mode Allowed / Mode Ins. Paid)
                </div>
            </div>
        </div>

        <!-- Tab bar -->
        <div class="pro-tabs" role="tablist" style="border-radius:0">
            <button class="pro-tab active" id="pt-summary" data-bs-toggle="tab"
                    data-bs-target="#pane-summary" type="button" role="tab">
                &#128203; Summary
            </button>
            @if (insight is not null)
            {
                <button class="pro-tab tab-insight" id="pt-aiinsight" data-bs-toggle="tab"
                        data-bs-target="#pane-aiinsight" type="button" role="tab">
                    &#129504; Insights
                    <span class="pro-tab-badge">@insight.Sections.Count</span>
                </button>
            }
        </div>

        <div class="tab-content">

            <!-- Summary tab (existing content) -->
            <div class="tab-pane fade show active" id="pane-summary" role="tabpanel">
                <div class="card-body p-0">

                <div class="pn-summary-wrap">
                    <div class="pn-summary-toolbar">
                        <button type="button" class="pn-btn-outline" id="pnExpandAllBtn">
                            <i class="bi bi-chevron-double-down"></i> Expand all
                        </button>
                        <button type="button" class="pn-btn-outline" id="pnCollapseAllBtn">
                            <i class="bi bi-chevron-double-up"></i> Collapse all
                        </button>
                    </div>

                    <div class="pn-summary-scroll pred-grid-scroll">
                    <table class="pn-summary-table pred-freeze-table" id="pnSummaryTable">
                        <thead>
                            <tr>
                                <th class="pred-freeze-1" style="width:18%">
                                    <span class="pn-th-inner"><span class="pn-th-icon ic-metrics"><i class="bi bi-bar-chart-fill"></i></span>Metrics</span>
                                </th>
                                <th class="text-end pred-freeze-2" style="width:9%">
                                    <span class="pn-th-inner"><span class="pn-th-icon ic-count"><i class="bi bi-people-fill"></i></span>Claim Count (#)</span>
                                </th>
                                <th class="text-end" style="width:12%">
                                    <span class="pn-th-inner"><span class="pn-th-icon ic-pred-a"><i class="bi bi-currency-dollar"></i></span>Predicted Allowed ($)</span>
                                </th>
                                <th class="text-end" style="width:12%">
                                    <span class="pn-th-inner"><span class="pn-th-icon ic-pred-i"><i class="bi bi-shield-check"></i></span>Predicted Insurance Payment ($)</span>
                                </th>
                                <th class="text-end" style="width:12%">
                                    <span class="pn-th-inner"><span class="pn-th-icon ic-act-a"><i class="bi bi-pie-chart-fill"></i></span>Actual Allowed Amount ($)</span>
                                </th>
                                <th class="text-end" style="width:12%">
                                    <span class="pn-th-inner"><span class="pn-th-icon ic-act-i"><i class="bi bi-wallet2"></i></span>Actual Insurance Payment ($)</span>
                                </th>
                                <th class="text-end" style="width:12%">
                                    <span class="pn-th-inner"><span class="pn-th-icon ic-var"><i class="bi bi-graph-up-arrow"></i></span>Variance &ndash; Allowed Amount ($)</span>
                                </th>
                                <th class="text-end" style="width:13%">
                                    <span class="pn-th-inner"><span class="pn-th-icon ic-var"><i class="bi bi-graph-up-arrow"></i></span>Variance &ndash; Insurance Payment ($)</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var pnGroupIdx = 0; }
                            @foreach (var grp in summaryGroups)
                            {
                                var g = grp.Total;
                                var isPredicted = g.GroupName == "Predicted To Pay";
                                var groupSkin = isPredicted ? "pn-group-predicted" : "pn-group-not-predicted";
                                var childSkin = isPredicted ? "pn-group-predicted-child" : "pn-group-not-predicted-child";
                                var groupKey = $"pn-g{pnGroupIdx}";
                                var hasChildren = grp.Children.Count > 0;
                                var label = DisplayGroupName(g.GroupName);
                                var startCollapsed = pnGroupIdx > 0;

                                <tr class="pn-parent @groupSkin @(hasChildren && startCollapsed ? "pn-collapsed" : "")"
                                    data-summary-group="@g.GroupName"
                                    @(hasChildren ? Html.Raw($"data-pn-group=\"{groupKey}\"") : null)>
                                    <td class="pred-freeze-1">
                                        <div class="pn-metric-cell">
                                            @if (hasChildren)
                                            {
                                                <button type="button" class="pn-toggle-box pn-chev" aria-expanded="@(startCollapsed ? "false" : "true")" title="Show / hide breakdown">
                                                    <i class="bi bi-chevron-down"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="pn-toggle-box" style="visibility:hidden" aria-hidden="true"></span>
                                            }
                                            <span class="pn-group-label">@label</span>
                                        </div>
                                    </td>
                                    <td class="text-end pn-val pred-freeze-2" data-pa-ref="@(isPredicted ? "claim denominator" : null)">@g.ClaimCount.ToString("N0")</td>
                                    <td class="text-end pn-val" data-pa-ref="@(isPredicted ? "allowed denominator" : null)">@FmtAmt(g.PredictedAllowed)</td>
                                    <td class="text-end pn-val" data-pa-ref="@(isPredicted ? "insurance denominator" : null)">@FmtAmt(g.PredictedInsurance)</td>
                                    <td class="text-end pn-val" data-pa-ref="@(isPredicted ? "allowed numerator" : null)">@FmtAmt(g.ActualAllowed)</td>
                                    <td class="text-end pn-val" data-pa-ref="@(isPredicted ? "insurance numerator" : null)">@FmtAmt(g.ActualInsurance)</td>
                                    <td class="text-end">
                                        <span class="pn-var-pill @VariancePillClass(g.VarianceAllowed)">
                                            @if (g.VarianceAllowed.HasValue)
                                            {
                                                <span class="pn-var-icon"><i class="bi @VarianceArrowIcon(g.VarianceAllowed)"></i></span>
                                            }
                                            @FmtAmt(g.VarianceAllowed)
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <span class="pn-var-pill @VariancePillClass(g.VariancePaid)">
                                            @if (g.VariancePaid.HasValue)
                                            {
                                                <span class="pn-var-icon"><i class="bi @VarianceArrowIcon(g.VariancePaid)"></i></span>
                                            }
                                            @FmtAmt(g.VariancePaid)
                                        </span>
                                    </td>
                                </tr>

                                @foreach (var child in grp.Children)
                                {
                                    var isAccuracyPaidStatus = isPredicted
                                        && (string.Equals(child.PayStatus, "Paid", StringComparison.OrdinalIgnoreCase)
                                            || string.Equals(child.PayStatus, "Patient Responsibility", StringComparison.OrdinalIgnoreCase));
                                    var statusKey = !string.IsNullOrWhiteSpace(child.PayStatus)
                                        ? child.PayStatus
                                        : child.BucketName;
                                    var tabTarget = isPredicted
                                        ? statusKey switch
                                        {
                                            var s when string.Equals(s, "Denied", StringComparison.OrdinalIgnoreCase) => "pt-denial",
                                            var s when string.Equals(s, "No Response", StringComparison.OrdinalIgnoreCase) => "pt-noresp",
                                            var s when string.Equals(s, "Adjusted", StringComparison.OrdinalIgnoreCase) => "pt-adjusted",
                                            _ => null
                                        }
                                        : null;
                                    <tr class="pn-child @childSkin @groupKey @(hasChildren && startCollapsed ? "pn-hidden" : "")">
                                        <td class="pred-freeze-1">@child.BucketName</td>
                                        <td class="text-end pn-val pred-freeze-2" data-pa-ref="@(isAccuracyPaidStatus ? "claim numerator" : null)">@child.ClaimCount.ToString("N0")</td>
                                        <td class="text-end pn-val">@FmtAmt(child.PredictedAllowed)</td>
                                        <td class="text-end pn-val">@FmtAmt(child.PredictedInsurance)</td>
                                        <td class="text-end pn-val">@FmtAmt(child.ActualAllowed)</td>
                                        <td class="text-end pn-val">@FmtAmt(child.ActualInsurance)</td>
                                        <td class="text-end">
                                            @if (tabTarget is not null)
                                            {
                                                <a href="#@tabTarget" class="pn-var-link pn-var-pill @VariancePillClass(child.VarianceAllowed)"
                                                   data-pred-tab="@tabTarget"
                                                   title="Open Predicted to Pay – @child.BucketName">
                                                    @if (child.VarianceAllowed.HasValue)
                                                    {
                                                        <span class="pn-var-icon"><i class="bi @VarianceArrowIcon(child.VarianceAllowed)"></i></span>
                                                    }
                                                    @FmtAmt(child.VarianceAllowed)
                                                    <span class="pn-var-eye" title="View breakdown" aria-label="View @child.BucketName tab"><i class="bi bi-eye-fill"></i></span>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="pn-var-pill @VariancePillClass(child.VarianceAllowed)">
                                                    @if (child.VarianceAllowed.HasValue)
                                                    {
                                                        <span class="pn-var-icon"><i class="bi @VarianceArrowIcon(child.VarianceAllowed)"></i></span>
                                                    }
                                                    @FmtAmt(child.VarianceAllowed)
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (tabTarget is not null)
                                            {
                                                <a href="#@tabTarget" class="pn-var-link pn-var-pill @VariancePillClass(child.VariancePaid)"
                                                   data-pred-tab="@tabTarget"
                                                   title="Open Predicted to Pay – @child.BucketName">
                                                    @if (child.VariancePaid.HasValue)
                                                    {
                                                        <span class="pn-var-icon"><i class="bi @VarianceArrowIcon(child.VariancePaid)"></i></span>
                                                    }
                                                    @FmtAmt(child.VariancePaid)
                                                    <span class="pn-var-eye" title="View breakdown" aria-label="View @child.BucketName tab"><i class="bi bi-eye-fill"></i></span>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="pn-var-pill @VariancePillClass(child.VariancePaid)">
                                                    @if (child.VariancePaid.HasValue)
                                                    {
                                                        <span class="pn-var-icon"><i class="bi @VarianceArrowIcon(child.VariancePaid)"></i></span>
                                                    }
                                                    @FmtAmt(child.VariancePaid)
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }

                                pnGroupIdx++;
                            }
                        </tbody>
                    </table>
                    </div>
                </div>

            <!-- ?? Ratios card strip ???????????????????????????????????? -->
            <div class="ratio-strip">
                <div class="fw-bold mb-2" style="font-size:.75rem;color:#0d1b2a;letter-spacing:.04em">&#128200; RATIOS</div>
                <div class="d-flex flex-wrap gap-2">
                    <div class="ratio-card calc-tooltip-trigger" tabindex="0">
                        <div class="rc-label">Payment Ratio</div>
                        <div class="rc-vals">
                            <span class="rc-val">@FmtPct(sm.PaymentRatioClaim)</span><span class="rc-sub">Claim</span>
                            <span class="rc-val">@FmtPct(sm.PaymentRatioAllowed)</span><span class="rc-sub">Allowed</span>
                            <span class="rc-val">@FmtPct(sm.PaymentRatioInsurance)</span><span class="rc-sub">Ins. Pmt</span>
                        </div>
                        <div class="calc-tooltip" role="tooltip">
                            <div class="calc-tooltip-title"><i class="bi bi-info"></i>Payment Ratio</div>
                            <div class="calc-tooltip-formula">Predicted paid, including Patient Responsibility, ÷ total Predicted To Pay.</div>
                            <div class="calc-tooltip-row"><span class="calc-tooltip-key">Claims</span><span class="calc-tooltip-value">@sm.PaidBasis.ClaimCount.ToString("N0") ÷ @sm.ToPayBasis.ClaimCount.ToString("N0") = @FmtPct(sm.PaymentRatioClaim)</span></div>
                            <div class="calc-tooltip-row"><span class="calc-tooltip-key">Allowed</span><span class="calc-tooltip-value">@FmtAmt(sm.PaidBasis.AllowedAmount) ÷ @FmtAmt(sm.ToPayBasis.AllowedAmount) = @FmtPct(sm.PaymentRatioAllowed)</span></div>
                            <div class="calc-tooltip-row"><span class="calc-tooltip-key">Insurance</span><span class="calc-tooltip-value">@FmtAmt(sm.PaidBasis.InsuranceAmount) ÷ @FmtAmt(sm.ToPayBasis.InsuranceAmount) = @FmtPct(sm.PaymentRatioInsurance)</span></div>
                        </div>
                    </div>
                    <div class="ratio-card calc-tooltip-trigger" tabindex="0" style="border-left-color:#c0392b">
                        <div class="rc-label">Non-Payment Rate</div>
                        <div class="rc-vals">
                            <span class="rc-val" style="color:#c0392b">@FmtPct(sm.NonPaymentRateClaim)</span><span class="rc-sub">Claim</span>
                            <span class="rc-val" style="color:#c0392b">@FmtPct(sm.NonPaymentRateAllowed)</span><span class="rc-sub">Allowed</span>
                            <span class="rc-val" style="color:#c0392b">@FmtPct(sm.NonPaymentRateInsurance)</span><span class="rc-sub">Ins. Pmt</span>
                        </div>
                        <div class="calc-tooltip" role="tooltip">
                            <div class="calc-tooltip-title"><i class="bi bi-info"></i>Non-Payment Rate</div>
                            <div class="calc-tooltip-formula">Predicted unpaid ÷ total Predicted To Pay.</div>
                            <div class="calc-tooltip-row"><span class="calc-tooltip-key">Claims</span><span class="calc-tooltip-value">@sm.UnpaidBasis.ClaimCount.ToString("N0") ÷ @sm.ToPayBasis.ClaimCount.ToString("N0") = @FmtPct(sm.NonPaymentRateClaim)</span></div>
                            <div class="calc-tooltip-row"><span class="calc-tooltip-key">Allowed</span><span class="calc-tooltip-value">@FmtAmt(sm.UnpaidBasis.AllowedAmount) ÷ @FmtAmt(sm.ToPayBasis.AllowedAmount) = @FmtPct(sm.NonPaymentRateAllowed)</span></div>
                            <div class="calc-tooltip-row"><span class="calc-tooltip-key">Insurance</span><span class="calc-tooltip-value">@FmtAmt(sm.UnpaidBasis.InsuranceAmount) ÷ @FmtAmt(sm.ToPayBasis.InsuranceAmount) = @FmtPct(sm.NonPaymentRateInsurance)</span></div>
                        </div>
                    </div>
                    <div class="ratio-card calc-tooltip-trigger" tabindex="0" style="border-left-color:#e53935">
                        <div class="rc-label">Denied</div>
                        <div class="rc-vals">
                            <span class="rc-val">@FmtPct(sm.DeniedPctClaim)</span><span class="rc-sub">Claim</span>
                            <span class="rc-val">@FmtPct(sm.DeniedPctAllowed)</span><span class="rc-sub">Allowed</span>
                            <span class="rc-val">@FmtPct(sm.DeniedPctInsurance)</span><span class="rc-sub">Ins. Pmt</span>
                        </div>
                        <div class="calc-tooltip" role="tooltip">
                            <div class="calc-tooltip-title"><i class="bi bi-info"></i>Denied Ratio</div>
                            <div class="calc-tooltip-formula">Denied ÷ total predicted unpaid.</div>
                            <div class="calc-tooltip-row"><span class="calc-tooltip-key">Claims</span><span class="calc-tooltip-value">@sm.DeniedBasis.ClaimCount.ToString("N0") ÷ @sm.UnpaidBasis.ClaimCount.ToString("N0") = @FmtPct(sm.DeniedPctClaim)</span></div>
                            <div class="calc-tooltip-row"><span class="calc-tooltip-key">Allowed</span><span class="calc-tooltip-value">@FmtAmt(sm.DeniedBasis.AllowedAmount) ÷ @FmtAmt(sm.UnpaidBasis.AllowedAmount) = @FmtPct(sm.DeniedPctAllowed)</span></div>
                            <div class="calc-tooltip-row"><span class="calc-tooltip-key">Insurance</span><span class="calc-tooltip-value">@FmtAmt(sm.DeniedBasis.InsuranceAmount) ÷ @FmtAmt(sm.UnpaidBasis.InsuranceAmount) = @FmtPct(sm.DeniedPctInsurance)</span></div>
                        </div>
                    </div>
                    <div class="ratio-card calc-tooltip-trigger" tabindex="0" style="border-left-color:#f57c00">
                        <div class="rc-label">No Response</div>
                        <div class="rc-vals">
                            <span class="rc-val">@FmtPct(sm.NoResponsePctClaim)</span><span class="rc-sub">Claim</span>
                            <span class="rc-val">@FmtPct(sm.NoResponsePctAllowed)</span><span class="rc-sub">Allowed</span>
                            <span class="rc-val">@FmtPct(sm.NoResponsePctInsurance)</span><span class="rc-sub">Ins. Pmt</span>
                        </div>
                        <div class="calc-tooltip" role="tooltip">
                            <div class="calc-tooltip-title"><i class="bi bi-info"></i>No Response Ratio</div>
                            <div class="calc-tooltip-formula">No Response ÷ total predicted unpaid.</div>
                            <div class="calc-tooltip-row"><span class="calc-tooltip-key">Claims</span><span class="calc-tooltip-value">@sm.NoResponseBasis.ClaimCount.ToString("N0") ÷ @sm.UnpaidBasis.ClaimCount.ToString("N0") = @FmtPct(sm.NoResponsePctClaim)</span></div>
                            <div class="calc-tooltip-row"><span class="calc-tooltip-key">Allowed</span><span class="calc-tooltip-value">@FmtAmt(sm.NoResponseBasis.AllowedAmount) ÷ @FmtAmt(sm.UnpaidBasis.AllowedAmount) = @FmtPct(sm.NoResponsePctAllowed)</span></div>
                            <div class="calc-tooltip-row"><span class="calc-tooltip-key">Insurance</span><span class="calc-tooltip-value">@FmtAmt(sm.NoResponseBasis.InsuranceAmount) ÷ @FmtAmt(sm.UnpaidBasis.InsuranceAmount) = @FmtPct(sm.NoResponsePctInsurance)</span></div>
                        </div>
                    </div>
                    <div class="ratio-card calc-tooltip-trigger" tabindex="0" style="border-left-color:#6a1b9a">
                        <div class="rc-label">Adjusted</div>
                        <div class="rc-vals">
                            <span class="rc-val">@FmtPct(sm.AdjustedPctClaim)</span><span class="rc-sub">Claim</span>
                            <span class="rc-val">@FmtPct(sm.AdjustedPctAllowed)</span><span class="rc-sub">Allowed</span>
                            <span class="rc-val">@FmtPct(sm.AdjustedPctInsurance)</span><span class="rc-sub">Ins. Pmt</span>
                        </div>
                        <div class="calc-tooltip" role="tooltip">
                            <div class="calc-tooltip-title"><i class="bi bi-info"></i>Adjusted Ratio</div>
                            <div class="calc-tooltip-formula">Adjusted ÷ total predicted unpaid.</div>
                            <div class="calc-tooltip-row"><span class="calc-tooltip-key">Claims</span><span class="calc-tooltip-value">@sm.AdjustedBasis.ClaimCount.ToString("N0") ÷ @sm.UnpaidBasis.ClaimCount.ToString("N0") = @FmtPct(sm.AdjustedPctClaim)</span></div>
                            <div class="calc-tooltip-row"><span class="calc-tooltip-key">Allowed</span><span class="calc-tooltip-value">@FmtAmt(sm.AdjustedBasis.AllowedAmount) ÷ @FmtAmt(sm.UnpaidBasis.AllowedAmount) = @FmtPct(sm.AdjustedPctAllowed)</span></div>
                            <div class="calc-tooltip-row"><span class="calc-tooltip-key">Insurance</span><span class="calc-tooltip-value">@FmtAmt(sm.AdjustedBasis.InsuranceAmount) ÷ @FmtAmt(sm.UnpaidBasis.InsuranceAmount) = @FmtPct(sm.AdjustedPctInsurance)</span></div>
                        </div>
                    </div>
                </div>
            </div>


            <!-- ?? Prediction Accuracy KPI tiles ???????????????????????? -->
            <div class="px-3 py-3" style="background:#f8fafc;border-top:1px solid #e2e8f0">
                <div class="fw-bold mb-3" style="font-size:.78rem;letter-spacing:.08em;color:#0d1b2a">
                    &#127919; PREDICTION ACCURACY
                </div>
                <div class="d-flex flex-wrap gap-3">

                    <!-- Claim % tile -->
                    <div class="prediction-accuracy-tile calc-tooltip-trigger" data-pa-metric="claim" tabindex="0"
                         style="background:#fff;border:1px solid #bfdbfe;border-left:4px solid #1565c0;
                                border-radius:10px;padding:.9rem 1.2rem;min-width:190px;
                                box-shadow:0 2px 8px rgba(21,101,192,.10);flex:1">
                        <div style="font-size:.65rem;font-weight:700;letter-spacing:.1em;
                                    color:#1565c0;text-transform:uppercase;margin-bottom:.3rem">
                            Claim (%)
                        </div>
                        <div style="font-size:2rem;font-weight:800;color:#1565c0;line-height:1;margin-bottom:.2rem">
                            @FmtPct(sm.PredVsActualRatioClaim)
                        </div>
                        <div style="font-size:.68rem;color:#64748b">Predicted vs Actuals Ratio</div>
                        <div class="calc-tooltip" role="tooltip">
                            <div class="calc-tooltip-title"><i class="bi bi-info"></i>Claim Accuracy</div>
                            <div class="calc-tooltip-formula">Distinct Paid + Patient Responsibility claims ÷ distinct total Predicted To Pay claims.</div>
                            <div class="calc-tooltip-row"><span class="calc-tooltip-key">Used values</span><span class="calc-tooltip-value">@(sm.PredAccuracyClaimNumerator?.ToString("N0") ?? "—") ÷ @(sm.PredAccuracyClaimDenominator?.ToString("N0") ?? "—") = @FmtPct(sm.PredVsActualRatioClaim)</span></div>
                        </div>
                    </div>

                    <!-- Allowed Amount % tile -->
                    <div class="prediction-accuracy-tile calc-tooltip-trigger" data-pa-metric="allowed" tabindex="0"
                         style="background:#fff;border:1px solid #bbf7d0;border-left:4px solid #2e7d32;
                                border-radius:10px;padding:.9rem 1.2rem;min-width:220px;
                                box-shadow:0 2px 8px rgba(46,125,50,.10);flex:1">
                        <div style="font-size:.65rem;font-weight:700;letter-spacing:.1em;
                                    color:#2e7d32;text-transform:uppercase;margin-bottom:.3rem">
                            Allowed Amount (%)
                        </div>
                        <div style="font-size:2rem;font-weight:800;color:#2e7d32;line-height:1;margin-bottom:.2rem">
                            @FmtPct(sm.PredVsActualAllowedAmount)
                        </div>
                        <div style="font-size:.68rem;color:#64748b">Predicted vs Actuals &ndash; Allowed Amount</div>
                        <div class="calc-tooltip" role="tooltip">
                            <div class="calc-tooltip-title"><i class="bi bi-info"></i>Allowed Amount Accuracy</div>
                            <div class="calc-tooltip-formula">Predicted To Pay actual Allowed Amount ÷ Mode Allowed Amount - Same Lab.</div>
                            <div class="calc-tooltip-row"><span class="calc-tooltip-key">Used values</span><span class="calc-tooltip-value">@FmtAmt(sm.PredAccuracyAllowedNumerator) ÷ @FmtAmt(sm.PredAccuracyAllowedDenominator) = @FmtPct(sm.PredVsActualAllowedAmount)</span></div>
                        </div>
                    </div>

                    <!-- Insurance Payment % tile -->
                    <div class="prediction-accuracy-tile calc-tooltip-trigger" data-pa-metric="insurance" tabindex="0"
                         style="background:#fff;border:1px solid #e9d5ff;border-left:4px solid #6a1b9a;
                                border-radius:10px;padding:.9rem 1.2rem;min-width:220px;
                                box-shadow:0 2px 8px rgba(106,27,154,.10);flex:1">
                        <div style="font-size:.65rem;font-weight:700;letter-spacing:.1em;
                                    color:#6a1b9a;text-transform:uppercase;margin-bottom:.3rem">
                            Insurance Payment (%)
                        </div>
                        <div style="font-size:2rem;font-weight:800;color:#6a1b9a;line-height:1;margin-bottom:.2rem">
                            @FmtPct(sm.PredVsActualInsPayment)
                        </div>
                        <div style="font-size:.68rem;color:#64748b">Predicted vs Actuals &ndash; Insurance Payment</div>
                        <div class="calc-tooltip" role="tooltip">
                            <div class="calc-tooltip-title"><i class="bi bi-info"></i>Insurance Payment Accuracy</div>
                            <div class="calc-tooltip-formula">Predicted To Pay actual Insurance Payment ÷ Mode Insurance Paid - Same Lab.</div>
                            <div class="calc-tooltip-row"><span class="calc-tooltip-key">Used values</span><span class="calc-tooltip-value">@FmtAmt(sm.PredAccuracyInsuranceNumerator) ÷ @FmtAmt(sm.PredAccuracyInsuranceDenominator) = @FmtPct(sm.PredVsActualInsPayment)</span></div>
                        </div>
                    </div>

                </div>
            </div>
            </div>
            </div>
            <!-- /Summary tab pane -->

            @if (insight is not null)
            {
            <div class="tab-pane fade" id="pane-aiinsight" role="tabpanel">
                <div class="p-3" style="background:#f1f5f9">
                    <div class="row g-3">
                        @for (int si = 0; si < insight.Sections.Count; si++)
                        {
                            var sec   = insight.Sections[si];
                            var ci    = si % 4;
                            var bdr   = insSecBorder[ci];
                            var bg    = insSecBg[ci];
                            var icol  = insSecIcon[ci];
                            var emoji = insSecEmoji[ci];
                            <div class="col-12 col-xl-6">
                                <div class="h-100 rounded-3 overflow-hidden"
                                     style="background:#fff;border:1px solid #e2e8f0;box-shadow:0 2px 8px rgba(0,0,0,.05)">
                                    <!-- Section header bar -->
                                    <div class="d-flex align-items-center gap-2 px-3 py-2"
                                         style="background:@bg;border-bottom:2px solid @bdr">
                                        <span>@(new Microsoft.AspNetCore.Html.HtmlString(emoji))</span>
                                        <span class="fw-bold" style="font-size:.78rem;color:@icol;letter-spacing:.05em;text-transform:uppercase">
                                            @sec.SectionNumber. @sec.Title
                                        </span>
                                    </div>
                                    <!-- Subsections -->
                                    <div class="px-3 py-2">
                                        @foreach (var sub in sec.Subsections)
                                        {
                                            <div class="d-inline-block mb-2 mt-2 px-2 py-1 rounded-pill"
                                                 style="background:@bg;border:1px solid @bdr;font-size:.68rem;font-weight:700;color:@icol;letter-spacing:.04em;text-transform:uppercase">
                                                @sub.Title
                                            </div>
                                            <ul class="mb-2" style="list-style:none;padding-left:.25rem">
                                                @foreach (var bullet in sub.Bullets)
                                                {
                                                    <li class="d-flex gap-2 mb-1" style="font-size:.78rem;color:#374151;line-height:1.5">
                                                        <span style="color:@icol;font-weight:700;flex-shrink:0">&#8250;</span>
                                                        <span>@bullet</span>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <!-- Footer -->
                <div class="d-flex align-items-center justify-content-between px-4 py-2"
                     style="background:#f8fafc;border-top:1px solid #e2e8f0">
                    <span style="font-size:.68rem;color:#94a3b8">&#128196; Source: @insight.SourceFileName</span>
                    @if (Model.Insight is null)
                    {
                        <span class="badge bg-warning text-dark" style="font-size:.62rem">fallback data</span>
                    }
                </div>
            </div>
            }
            <!-- /AI Insights tab pane -->

        </div>
    </div>

    <!-- ?? Unified Analysis Tabs: Payers | CPT | Panels | Denial | No Response ?? -->
    <div class="card insight-card mb-4">
        <div class="card-header text-white d-flex align-items-center gap-2 px-3 py-2"
             style="background:linear-gradient(135deg,#0d1b2a,#1a2744)">
            <span>&#128202; Prediction Validation &amp; Breakdown Analysis</span>
        </div>
        <div class="card-body p-0">

            <!-- Pro Tab Bar -->
            <div class="pro-tabs" role="tablist">
                <button class="pro-tab active" id="pt-payers" data-bs-toggle="tab"
                        data-bs-target="#pp-payers" type="button" role="tab">
                    Prediction vs Actual By Payer
                    <span class="pro-tab-badge">@Model.TopPayerInsights.Count</span>
                </button>
                <button class="pro-tab tab-denial" id="pt-denial" data-bs-toggle="tab"
                        data-bs-target="#pp-denial" type="button" role="tab">
                    Predicted to Pay &ndash; Denied
                    <span class="pro-tab-badge">@db.TotalClaims.ToString("N0")</span>
                </button>
                <button class="pro-tab tab-noresp" id="pt-noresp" data-bs-toggle="tab"
                        data-bs-target="#pp-noresp" type="button" role="tab">
                    Predicted to Pay &ndash; No Response
                    <span class="pro-tab-badge">@nr.TotalLineItems.ToString("N0")</span>
                </button>
                <button class="pro-tab tab-panel" id="pt-adjusted" data-bs-toggle="tab"
                        data-bs-target="#pp-adjusted" type="button" role="tab">
                    Predicted to Pay &ndash; Adjusted
                    <span class="pro-tab-badge">@adjRows.Count</span>
                </button>
            </div>

            <div class="tab-content">

                <!-- Section B: Prediction vs Actual By Payer -->
                <div class="tab-pane fade show active" id="pp-payers" role="tabpanel">
                    @{
                        var pTotal = new
                        {
                            PredAllow = Model.TopPayerInsights.Sum(r => r.PredictedAllowed),
                            PredIns   = Model.TopPayerInsights.Sum(r => r.PredictedInsurance),
                            ActAllow  = Model.TopPayerInsights.Sum(r => r.ActualAllowed),
                            ActIns    = Model.TopPayerInsights.Sum(r => r.ActualInsurance),
                            VarAllow  = Model.TopPayerInsights.Sum(r => r.VarianceAllowed),
                            VarPaid   = Model.TopPayerInsights.Sum(r => r.VariancePaid),
                        };
                    }
                    <div class="px-3 py-2 d-flex align-items-center justify-content-between flex-wrap gap-2"
                         style="background:#f8fafc;border-bottom:1px solid #e2e8f0">
                        <div>
                            <span class="fw-semibold" style="font-size:.8rem;color:#1a2744">Prediction vs Actual By Payer</span>
                            <span class="text-muted ms-2" style="font-size:.72rem">Forecasting Payability: Payable, Potentially Payable, Payable - Need Action</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" style="font-size:.72rem"
                                data-bs-toggle="modal" data-bs-target="#payerPayStatusModal" data-payer="">
                            View PayStatus Breakdown By Payer
                        </button>
                    </div>
                    <div class="pred-grid-scroll">
                        <table class="vt-table pred-freeze-table">
                            <thead>
                                <tr>
                                    <th class="pred-freeze-1">Payer Name</th>
                                    <th class="text-end pred-freeze-2">Predicted &ndash; Allowed Amount</th>
                                    <th class="text-end">Predicted &ndash; Insurance Payment</th>
                                    <th class="text-end">Actual Allowed Amount</th>
                                    <th class="text-end">Actual Insurance Payment</th>
                                    <th class="text-end">Variance &ndash; Allowed Amount</th>
                                    <th class="text-end">Variance &ndash; Insurance Payment</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.TopPayerInsights)
                                {
                                    <tr>
                                        <td class="pred-freeze-1">
                                            <button type="button" class="payer-drill-link"
                                                    data-bs-toggle="modal" data-bs-target="#payerPayStatusModal"
                                                    data-payer="@r.PayerName" title="View PayStatus breakdown">@r.PayerName</button>
                                        </td>
                                        <td class="text-end pred-freeze-2">@FmtAmt(r.PredictedAllowed)</td>
                                        <td class="text-end">@FmtAmt(r.PredictedInsurance)</td>
                                        <td class="text-end">@FmtAmt(r.ActualAllowed)</td>
                                        <td class="text-end">@FmtAmt(r.ActualInsurance)</td>
                                        <td class="text-end fw-semibold @VarianceClass(r.VarianceAllowed)">@FmtAmt(r.VarianceAllowed)</td>
                                        <td class="text-end fw-semibold @VarianceClass(r.VariancePaid)">@FmtAmt(r.VariancePaid)</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="vt-total">
                                    <td class="pred-freeze-1">Grand Total</td>
                                    <td class="text-end pred-freeze-2">@FmtAmt(pTotal.PredAllow)</td>
                                    <td class="text-end">@FmtAmt(pTotal.PredIns)</td>
                                    <td class="text-end">@FmtAmt(pTotal.ActAllow)</td>
                                    <td class="text-end">@FmtAmt(pTotal.ActIns)</td>
                                    <td class="text-end @VarianceClass(pTotal.VarAllow)">@FmtAmt(pTotal.VarAllow)</td>
                                    <td class="text-end @VarianceClass(pTotal.VarPaid)">@FmtAmt(pTotal.VarPaid)</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Section C: Predicted to Pay - Denied -->
                <div class="tab-pane fade" id="pp-denial" role="tabpanel">
                    <div class="px-3 py-2 d-flex align-items-center justify-content-between"
                         style="background:#fff5f5;border-bottom:1px solid #fecaca">
                        <span class="fw-semibold" style="font-size:.8rem;color:#b71c1c">
                            Predicted to Pay &ndash; Denied
                        </span>
                        <span class="badge" style="background:#b71c1c;font-size:.7rem">
                            @db.TotalClaims.ToString("N0") line items
                        </span>
                    </div>
                    @if (db.PayerRows.Count == 0)
                    {
                        <div class="p-3 text-muted" style="font-size:.85rem">No denied records match the current filter criteria.</div>
                    }
                    else
                    {
                        <div class="pred-grid-scroll">
                            <table class="vt-table pred-freeze-table">
                                <thead>
                                    <tr>
                                        <th class="pred-freeze-1" style="min-width:200px">Payer Name</th>
                                        <th class="text-end pred-freeze-2">Predicted &ndash; Allowed Amount</th>
                                        <th class="text-end">Predicted &ndash; Insurance Payment</th>
                                        <th class="text-end">Actual &ndash; Allowed Amount</th>
                                        <th class="text-end">Actual &ndash; Insurance Payment</th>
                                        <th class="text-end">Variance &ndash; Allowed Amount</th>
                                        <th class="text-end">Variance &ndash; Paid Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var denialIdx = 0; }
                                    @foreach (var payer in db.PayerRows)
                                    {
                                        var collapseId = $"denial-collapse-{denialIdx++}";
                                        <tr class="denial-row-payer">
                                            <td class="pred-freeze-1">
                                                @if (payer.TopDenialCodes.Count > 0)
                                                {
                                                    <button type="button" class="pred-grid-toggle"
                                                            data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                                            aria-expanded="false" aria-controls="@collapseId"
                                                            title="Show denial codes &amp; descriptions">
                                                        <i class="bi bi-chevron-down"></i>
                                                    </button>
                                                }
                                                <span class="fw-semibold">@payer.PayerName</span>
                                                @if (payer.TopDenialCodes.Count > 0)
                                                {
                                                    <span class="badge ms-1" style="background:#fecaca;color:#991b1b;font-size:.65rem">
                                                        @payer.TopDenialCodes.Count codes
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end pred-freeze-2">@FmtAmt(payer.TotalPredictedAllowed)</td>
                                            <td class="text-end">@FmtAmt(payer.TotalPredictedInsurance)</td>
                                            <td class="text-end">@FmtAmt(payer.ActualAllowed)</td>
                                            <td class="text-end">@FmtAmt(payer.ActualInsurance)</td>
                                            <td class="text-end fw-semibold @VarianceClass(payer.VarianceAllowed)">@FmtAmt(payer.VarianceAllowed)</td>
                                            <td class="text-end fw-semibold @VarianceClass(payer.VariancePaid)">@FmtAmt(payer.VariancePaid)</td>
                                        </tr>
                                        @if (payer.TopDenialCodes.Count > 0)
                                        {
                                            <tr class="p-0 border-0">
                                                <td colspan="7" class="p-0 border-0">
                                                    <div class="collapse" id="@collapseId">
                                                        <div class="denial-detail-panel">
                                                            <div class="denial-panel-title">
                                                                Denial codes &amp; descriptions — @payer.PayerName
                                                            </div>
                                                            <table class="table table-sm mb-0">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Denial Code</th>
                                                                        <th>Denial Description</th>
                                                                        <th class="text-end">Predicted &ndash; Allowed</th>
                                                                        <th class="text-end">Predicted &ndash; Ins. Pmt</th>
                                                                        <th class="text-end">Actual &ndash; Allowed</th>
                                                                        <th class="text-end">Actual &ndash; Ins. Pmt</th>
                                                                        <th class="text-end">Var &ndash; Allowed</th>
                                                                        <th class="text-end">Var &ndash; Paid</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var dc in payer.TopDenialCodes)
                                                                    {
                                                                        <tr class="denial-row-code">
                                                                            <td class="denial-code-cell" title="@dc.DenialCode">@dc.DenialCode</td>
                                                                            <td class="denial-desc-cell" title="@(string.IsNullOrWhiteSpace(dc.DenialDescription) ? null : dc.DenialDescription)">
                                                                                @(string.IsNullOrWhiteSpace(dc.DenialDescription) ? "—" : dc.DenialDescription)
                                                                            </td>
                                                                            <td class="text-end">@FmtAmt(dc.TotalPredictedAllowed)</td>
                                                                            <td class="text-end">@FmtAmt(dc.TotalPredictedInsurance)</td>
                                                                            <td class="text-end">@FmtAmt(dc.ActualAllowed)</td>
                                                                            <td class="text-end">@FmtAmt(dc.ActualInsurance)</td>
                                                                            <td class="text-end @VarianceClass(dc.VarianceAllowed)">@FmtAmt(dc.VarianceAllowed)</td>
                                                                            <td class="text-end @VarianceClass(dc.VariancePaid)">@FmtAmt(dc.VariancePaid)</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="vt-total">
                                        <td class="pred-freeze-1">Grand Total</td>
                                        <td class="text-end pred-freeze-2">@FmtAmt(db.TotalPredictedAllowed)</td>
                                        <td class="text-end">@FmtAmt(db.TotalPredictedInsurance)</td>
                                        <td class="text-end">@FmtAmt(db.TotalActualAllowed)</td>
                                        <td class="text-end">@FmtAmt(db.TotalActualInsurance)</td>
                                        <td class="text-end @VarianceClass(db.TotalVarianceAllowed)">@FmtAmt(db.TotalVarianceAllowed)</td>
                                        <td class="text-end @VarianceClass(db.TotalVariancePaid)">@FmtAmt(db.TotalVariancePaid)</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>

                <!-- Section D: Predicted to Pay - No Response -->
                <div class="tab-pane fade" id="pp-noresp" role="tabpanel">
                    <div class="px-3 py-2 d-flex align-items-center justify-content-between"
                         style="background:#fdf4ff;border-bottom:1px solid #e9d5ff">
                        <span class="fw-semibold" style="font-size:.8rem;color:#6a1b9a">
                            Predicted to Pay &ndash; No Response (Aging by Days To DOS)
                        </span>
                        <span class="badge" style="background:#6a1b9a;font-size:.7rem">
                            @nr.TotalLineItems.ToString("N0") line items
                        </span>
                    </div>
                    @if (nr.PayerRows.Count == 0)
                    {
                        <div class="p-3 text-muted" style="font-size:.85rem">No no-response records match the current filter criteria.</div>
                    }
                    else
                    {
                        <div class="pred-grid-scroll">
                            <table class="nr-table pred-freeze-table">
                                <thead>
                                    <tr>
                                        <th rowspan="2" class="pred-freeze-1" style="min-width:160px;text-align:left">Payer</th>
                                        @foreach (var bkt in AgeBuckets.All)
                                        {
                                            <th colspan="4" class="nr-bucket-group">@AgeBuckets.DisplayLabel(bkt)</th>
                                        }
                                        <th colspan="2" style="background:#1b5e20">Total</th>
                                    </tr>
                                    <tr>
                                        @{ var nrHdrBktIdx = 0; }
                                        @foreach (var bkt in AgeBuckets.All)
                                        {
                                            <th class="nr-bucket-group text-end@(nrHdrBktIdx == 0 ? " pred-freeze-2" : "")" style="font-size:.68rem">Sum Var &ndash; Allowed</th>
                                            <th class="text-end" style="font-size:.68rem">Sum Var &ndash; Paid</th>
                                            <th class="text-end" style="font-size:.68rem">% Var &ndash; Allowed</th>
                                            <th class="text-end" style="font-size:.68rem">% Var &ndash; Ins. Pmt</th>
                                            nrHdrBktIdx++;
                                        }
                                        <th class="text-end" style="background:#2e7d32;font-size:.68rem">Total Var &ndash; Allowed</th>
                                        <th class="text-end" style="background:#2e7d32;font-size:.68rem">Total Var &ndash; Paid</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payer in nr.PayerRows)
                                    {
                                        <tr class="nr-row-payer">
                                            <td class="pred-freeze-1" title="@payer.PayerName" style="font-size:inherit">@payer.PayerName</td>
                                            @{ var nrBodyBktIdx = 0; }
                                            @foreach (var bkt in AgeBuckets.All)
                                            {
                                                var ba = payer.ByBucket.GetValueOrDefault(bkt);
                                                <td class="amt nr-bucket-group text-end@(nrBodyBktIdx == 0 ? " pred-freeze-2" : "")">@FmtAmt(ba?.VarianceAllowed)</td>
                                                <td class="amt text-end">@FmtAmt(ba?.VariancePaid)</td>
                                                <td class="text-end">@FmtPct(ba?.PctVarianceAllowed)</td>
                                                <td class="text-end">@FmtPct(ba?.PctVariancePaid)</td>
                                                nrBodyBktIdx++;
                                            }
                                            <td class="amt text-end fw-semibold">@FmtAmt(payer.TotalVarianceAllowed)</td>
                                            <td class="amt text-end fw-semibold">@FmtAmt(payer.TotalVariancePaid)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="nr-row-total">
                                        <td class="pred-freeze-1">Grand Total</td>
                                        @{ var nrFootBktIdx = 0; }
                                        @foreach (var bkt in AgeBuckets.All)
                                        {
                                            var tba = nr.TotalByBucket.GetValueOrDefault(bkt);
                                            <td class="amt nr-bucket-group text-end@(nrFootBktIdx == 0 ? " pred-freeze-2" : "")">@FmtAmt(tba?.VarianceAllowed)</td>
                                            <td class="amt text-end">@FmtAmt(tba?.VariancePaid)</td>
                                            <td class="text-end">@FmtPct(tba?.PctVarianceAllowed)</td>
                                            <td class="text-end">@FmtPct(tba?.PctVariancePaid)</td>
                                            nrFootBktIdx++;
                                        }
                                        <td class="amt text-end">@FmtAmt(nr.TotalVarianceAllowed)</td>
                                        <td class="amt text-end">@FmtAmt(nr.TotalVariancePaid)</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>

                <!-- Section E: Predicted to Pay - Adjusted -->
                <div class="tab-pane fade" id="pp-adjusted" role="tabpanel">
                    <div class="px-3 py-2" style="background:#f8fafc;border-bottom:1px solid #e2e8f0">
                        <span class="fw-semibold" style="font-size:.8rem;color:#00695c">Predicted to Pay &ndash; Adjusted</span>
                    </div>
                    @if (adjRows.Count == 0)
                    {
                        <div class="p-3 text-muted" style="font-size:.85rem">No adjusted records match the current filter criteria.</div>
                    }
                    else
                    {
                        <div class="pred-grid-scroll">
                            <table class="vt-table pred-freeze-table">
                                <thead>
                                    <tr>
                                        <th class="pred-freeze-1">Payer Name</th>
                                        <th class="text-end pred-freeze-2">Predicted &ndash; Allowed Amount</th>
                                        <th class="text-end">Predicted &ndash; Insurance Payment</th>
                                        <th class="text-end">Actual &ndash; Allowed Amount</th>
                                        <th class="text-end">Actual &ndash; Insurance Payment</th>
                                        <th class="text-end">Variance &ndash; Allowed Amount</th>
                                        <th class="text-end">Variance &ndash; Paid Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in adjRows)
                                    {
                                        <tr>
                                            <td class="fw-semibold pred-freeze-1" style="font-size:inherit">@r.PayerName</td>
                                            <td class="text-end pred-freeze-2">@FmtAmt(r.PredictedAllowed)</td>
                                            <td class="text-end">@FmtAmt(r.PredictedInsurance)</td>
                                            <td class="text-end">@FmtAmt(r.ActualAllowed)</td>
                                            <td class="text-end">@FmtAmt(r.ActualInsurance)</td>
                                            <td class="text-end fw-semibold @VarianceClass(r.VarianceAllowed)">@FmtAmt(r.VarianceAllowed)</td>
                                            <td class="text-end fw-semibold @VarianceClass(r.VariancePaid)">@FmtAmt(r.VariancePaid)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="vt-total">
                                        <td class="pred-freeze-1">Grand Total</td>
                                        <td class="text-end pred-freeze-2">@FmtAmt(adjTotal.PredAllow)</td>
                                        <td class="text-end">@FmtAmt(adjTotal.PredIns)</td>
                                        <td class="text-end">@FmtAmt(adjTotal.ActAllow)</td>
                                        <td class="text-end">@FmtAmt(adjTotal.ActIns)</td>
                                        <td class="text-end @VarianceClass(adjTotal.VarAllow)">@FmtAmt(adjTotal.VarAllow)</td>
                                        <td class="text-end @VarianceClass(adjTotal.VarPaid)">@FmtAmt(adjTotal.VarPaid)</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>

    <!-- Section B modal: PayStatus breakdown by payer -->
    <div class="modal fade" id="payerPayStatusModal" tabindex="-1" aria-labelledby="payerPayStatusModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header" style="background:linear-gradient(135deg,#0d1b2a,#1a2744);color:#fff">
                    <h5 class="modal-title" id="payerPayStatusModalLabel">Predicted To Pay Vs Unpaid Variance Breakdown By Payer</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="pred-grid-scroll">
                        <table class="vt-table pred-freeze-table mb-0" id="payerPayStatusTable">
                            <thead>
                                <tr>
                                    <th class="pred-freeze-1">Payer Name / PayStatus</th>
                                    <th class="text-end pred-freeze-2">Predicted &ndash; Allowed</th>
                                    <th class="text-end">Predicted &ndash; Ins. Payment</th>
                                    <th class="text-end">Actual Allowed</th>
                                    <th class="text-end">Actual Ins. Payment</th>
                                    <th class="text-end">Variance &ndash; Allowed</th>
                                    <th class="text-end">Variance &ndash; Ins. Payment</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pg in payStatusGroups)
                                {
                                    var pgCollapse = $"ps-collapse-{pg.Key.GetHashCode():X}";
                                    var pgRows = pg.ToList();
                                    var pgTotals = new
                                    {
                                        PredAllow = pgRows.Sum(x => x.PredictedAllowed),
                                        PredIns   = pgRows.Sum(x => x.PredictedInsurance),
                                        ActAllow  = pgRows.Sum(x => x.ActualAllowed),
                                        ActIns    = pgRows.Sum(x => x.ActualInsurance),
                                        VarAllow  = pgRows.Sum(x => x.VarianceAllowed),
                                        VarPaid   = pgRows.Sum(x => x.VariancePaid),
                                    };
                                    <tr class="payer-group-row" data-payer="@pg.Key">
                                        <td class="pred-freeze-1">
                                            <button type="button" class="pred-grid-toggle"
                                                    data-bs-toggle="collapse" data-bs-target="#@pgCollapse"
                                                    aria-expanded="false" aria-controls="@pgCollapse"
                                                    title="Show / hide pay status breakdown">
                                                <i class="bi bi-chevron-down"></i>
                                            </button>
                                            <span class="fw-semibold">@pg.Key</span>
                                        </td>
                                        <td class="text-end pred-freeze-2">@FmtAmt(pgTotals.PredAllow)</td>
                                        <td class="text-end">@FmtAmt(pgTotals.PredIns)</td>
                                        <td class="text-end">@FmtAmt(pgTotals.ActAllow)</td>
                                        <td class="text-end">@FmtAmt(pgTotals.ActIns)</td>
                                        <td class="text-end @VarianceClass(pgTotals.VarAllow)">@FmtAmt(pgTotals.VarAllow)</td>
                                        <td class="text-end @VarianceClass(pgTotals.VarPaid)">@FmtAmt(pgTotals.VarPaid)</td>
                                    </tr>
                                    <tr class="p-0 border-0 payer-group-row" data-payer="@pg.Key">
                                        <td colspan="7" class="p-0 border-0">
                                            <div class="collapse" id="@pgCollapse">
                                                <table class="table table-sm mb-0">
                                                    <tbody>
                                                        @foreach (var ps in pgRows.OrderByDescending(x => x.VarianceAllowed))
                                                        {
                                                            <tr>
                                                                <td style="padding-left:2.5rem">@ps.PayStatus</td>
                                                                <td class="text-end">@FmtAmt(ps.PredictedAllowed)</td>
                                                                <td class="text-end">@FmtAmt(ps.PredictedInsurance)</td>
                                                                <td class="text-end">@FmtAmt(ps.ActualAllowed)</td>
                                                                <td class="text-end">@FmtAmt(ps.ActualInsurance)</td>
                                                                <td class="text-end @VarianceClass(ps.VarianceAllowed)">@FmtAmt(ps.VarianceAllowed)</td>
                                                                <td class="text-end @VarianceClass(ps.VariancePaid)">@FmtAmt(ps.VariancePaid)</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ?? Line Item Detail (separate page) ????????????????????????? -->
    <div class="card insight-card mb-4" style="border:1px solid #dee2e6">
        <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3 py-3 px-4">
            <div>
                <div class="fw-bold" style="font-size:.95rem">&#128196; Line Item Detail</div>
                <div class="text-muted" style="font-size:.8rem">
                    @Model.Paging.TotalFiltered.ToString("N0") records (after global filter) &mdash; view on a dedicated page with filters and paging.
                </div>
            </div>
            <a asp-controller="Prediction" asp-action="LineDetail"
               asp-route-lab="@Model.SelectedLab"
               asp-route-filterPayerName="@Model.FilterPayerName"
               asp-route-filterPayerType="@Model.FilterPayerType"
               asp-route-filterPanelName="@Model.FilterPanelName"
               asp-route-filterCPTCode="@Model.FilterCPTCode"
               class="btn btn-primary">
                &#128196; Open Line Detail &rarr;
            </a>
        </div>
    </div>

    <!-- ?? Forecasting Summary (separate page) ???????????????????????????? -->
    <div class="card insight-card mb-4" style="border:1px solid #dee2e6">
        <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3 py-3 px-4">
            <div>
                <div class="fw-bold" style="font-size:.95rem">&#128197; Forecasting Summary</div>
                <div class="text-muted" style="font-size:.8rem">
                    Last 4 weeks Median &amp; Mode weekly breakdown by payer &mdash; view on a dedicated page.
                </div>
            </div>
            <a asp-controller="Prediction" asp-action="ForecastingSummary"
               asp-route-lab="@Model.SelectedLab"
               asp-route-filterPayerName="@Model.FilterPayerName"
               asp-route-filterPayerType="@Model.FilterPayerType"
               asp-route-filterPanelName="@Model.FilterPanelName"
               asp-route-filterCPTCode="@Model.FilterCPTCode"
               class="btn btn-success">
                &#128197; Open Forecasting Summary &rarr;
            </a>
        </div>
    </div>
}

<script nonce='@Context.Items["CspNonce"]'>
    document.addEventListener('DOMContentLoaded', function () {
        var exportBtn = document.getElementById('exportPredictionExcelBtn');
        if (exportBtn) {
            // Async export (preferred): queue → LRN.ReportWorker generates → 📄 Reports
            // badge notifies. Falls back to the legacy synchronous download when the
            // lab has no queue table (not database-enabled).
            exportBtn.addEventListener('click', function () {
                var form = exportBtn.closest('form');
                if (!form) return;
                var fd = new FormData(form);
                var val = function (n) { return (fd.get(n) || '').toString().trim() || null; };

                function legacyDownload() {
                    var params = new URLSearchParams(fd);
                    var url = '@Url.Action("ExportPredictionExcel", "Prediction")' + '?' + params.toString();
                    lmdExcelDownload(url);
                }

                var filters = {
                    PayerName:                      val('filterPayerName'),
                    PayerType:                      val('filterPayerType'),
                    PanelName:                      val('filterPanelName'),
                    FinalCoverageStatus:            val('filterFinalCoverageStatus'),
                    Payability:                     val('filterPayability'),
                    CPTCode:                        val('filterCPTCode'),
                    ForecastingPayability:          val('filterForecastingPayability'),
                    PayStatus:                      val('filterPayStatus'),
                    ForecastingPayabilitySubstatus: val('filterForecastingPayabilitySubstatus'),
                    PredictionStatus:               val('filterPredictionStatus')
                };

                var body = new FormData();
                body.append('lab', '@Model.SelectedLab');
                body.append('reportType', 'PredictionAnalysis');
                body.append('filterDetails', JSON.stringify(filters));
                var af = document.querySelector('#lrnReportsAf input[name="__RequestVerificationToken"]');
                if (af) body.append('__RequestVerificationToken', af.value);

                var original = exportBtn.innerHTML;
                exportBtn.disabled = true;
                exportBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Queuing…';

                fetch('@Url.Action("Queue", "UserReports")', { method: 'POST', body: body })
                    .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, status: r.status, j: j }; }); })
                    .then(function (res) {
                        if (res.ok) {
                            exportBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Generating — watch Reports 📄';
                            if (window.lrnShowReportAlert) window.lrnShowReportAlert('success');
                            if (window.lrnReportsBadgeRefresh) window.lrnReportsBadgeRefresh();
                            setTimeout(function () { exportBtn.disabled = false; exportBtn.innerHTML = original; }, 8000);
                        } else if (res.status === 400) {
                            exportBtn.disabled = false; exportBtn.innerHTML = original;
                            legacyDownload();
                        } else {
                            exportBtn.disabled = false; exportBtn.innerHTML = original;
                            var qMsg = res.j && res.j.message ? res.j.message : '';
                            if (window.lrnShowReportAlert) {
                                if (res.status === 409 || /already/i.test(qMsg)) {
                                    window.lrnShowReportAlert('info');
                                } else {
                                    window.lrnShowReportAlert('error', { message: qMsg || 'Could not queue the report.' });
                                }
                            }
                        }
                    })
                    .catch(function () {
                        exportBtn.disabled = false; exportBtn.innerHTML = original;
                        legacyDownload();
                    });
            });
        }

        var payerModal = document.getElementById('payerPayStatusModal');
        if (payerModal) {
            payerModal.addEventListener('shown.bs.modal', function (event) {
                var trigger = event.relatedTarget;
                var payer = trigger ? (trigger.getAttribute('data-payer') || '') : '';
                var rows = payerModal.querySelectorAll('.payer-group-row');
                rows.forEach(function (row) {
                    var rowPayer = row.getAttribute('data-payer') || '';
                    var show = !payer || rowPayer === payer;
                    row.style.display = show ? '' : 'none';
                });
                var title = payerModal.querySelector('#payerPayStatusModalLabel');
                if (title) {
                    title.textContent = payer
                        ? 'Predicted To Pay Vs Unpaid Variance Breakdown — ' + payer
                        : 'Predicted To Pay Vs Unpaid Variance Breakdown By Payer';
                }
                initPredFreezeGrids(payerModal);
            });
        }

        initPredFreezeGrids(document);
        initPnSummaryGrid();
    });

    function initPnSummaryGrid() {
        var table = document.getElementById('pnSummaryTable');
        if (!table) return;

        function setGroupExpanded(parentRow, expanded) {
            var key = parentRow.getAttribute('data-pn-group');
            if (!key) return;
            parentRow.classList.toggle('pn-collapsed', !expanded);
            var chev = parentRow.querySelector('.pn-chev');
            if (chev) chev.setAttribute('aria-expanded', expanded ? 'true' : 'false');
            table.querySelectorAll('.pn-child.' + key).forEach(function (row) {
                row.classList.toggle('pn-hidden', !expanded);
            });
            requestAnimationFrame(function () {
                if (typeof measurePredFreezeTable === 'function') measurePredFreezeTable(table);
            });
        }

        function toggleGroup(parentRow) {
            setGroupExpanded(parentRow, parentRow.classList.contains('pn-collapsed'));
        }

        table.querySelectorAll('.pn-parent[data-pn-group]').forEach(function (row) {
            var chev = row.querySelector('.pn-chev');
            if (chev) {
                chev.addEventListener('click', function (e) {
                    e.stopPropagation();
                    toggleGroup(row);
                });
            }
            row.addEventListener('click', function (e) {
                if (e.target.closest('.pn-chev')) return;
                if (!row.getAttribute('data-pn-group')) return;
                toggleGroup(row);
            });
            if (row.getAttribute('data-pn-group')) row.style.cursor = 'pointer';
        });

        var expandBtn = document.getElementById('pnExpandAllBtn');
        var collapseBtn = document.getElementById('pnCollapseAllBtn');

        if (expandBtn) {
            expandBtn.addEventListener('click', function () {
                table.querySelectorAll('.pn-parent[data-pn-group]').forEach(function (row) {
                    setGroupExpanded(row, true);
                });
            });
        }
        if (collapseBtn) {
            collapseBtn.addEventListener('click', function () {
                table.querySelectorAll('.pn-parent[data-pn-group]').forEach(function (row) {
                    setGroupExpanded(row, false);
                });
            });
        }

        function highlightAccuracyInputs(metric, highlighted) {
            if (highlighted && metric === 'claim') {
                var predictedParent = table.querySelector('.pn-parent[data-summary-group="Predicted To Pay"]');
                if (predictedParent) setGroupExpanded(predictedParent, true);
            }
            table.querySelectorAll('[data-pa-ref~="' + metric + '"]').forEach(function (cell) {
                cell.classList.toggle('pa-calc-highlight', highlighted);
            });
        }

        document.querySelectorAll('.prediction-accuracy-tile[data-pa-metric]').forEach(function (tile) {
            var metric = tile.getAttribute('data-pa-metric');
            tile.addEventListener('mouseenter', function () { highlightAccuracyInputs(metric, true); });
            tile.addEventListener('mouseleave', function () { highlightAccuracyInputs(metric, false); });
            tile.addEventListener('focus', function () { highlightAccuracyInputs(metric, true); });
            tile.addEventListener('blur', function () { highlightAccuracyInputs(metric, false); });
        });
    }

    function measurePredFreezeTable(table) {
        if (!table) return;
        if (table.tHead) {
            var offset = 0;
            Array.from(table.tHead.rows).forEach(function (row) {
                Array.from(row.cells).forEach(function (th) {
                    th.style.setProperty('--pred-sticky-top', offset + 'px');
                });
                offset += row.offsetHeight;
            });
        }

        var col1 = table.querySelector('thead .pred-freeze-1, tbody .pred-freeze-1, tfoot .pred-freeze-1');
        if (col1) {
            table.style.setProperty('--pred-freeze-col1-width', col1.offsetWidth + 'px');
        }
    }

    function initPredFreezeGrids(root) {
        (root || document).querySelectorAll('.pred-grid-scroll .pred-freeze-table').forEach(function (table) {
            if (table.dataset.freezeBound !== '1') {
                table.dataset.freezeBound = '1';
                var scroll = table.closest('.pred-grid-scroll');
                if (scroll && typeof ResizeObserver !== 'undefined') {
                    var ro = new ResizeObserver(function () {
                        requestAnimationFrame(function () { measurePredFreezeTable(table); });
                    });
                    ro.observe(scroll);
                    ro.observe(table);
                }
            }
            requestAnimationFrame(function () { measurePredFreezeTable(table); });
        });
    }

    document.querySelectorAll('[data-bs-toggle="tab"]').forEach(function (tab) {
        tab.addEventListener('shown.bs.tab', function () {
            var target = tab.getAttribute('data-bs-target');
            if (!target) return;
            requestAnimationFrame(function () {
                initPredFreezeGrids(document.querySelector(target));
            });
        });
    });

    // Prediction vs Non-Payment Summary variance links → open Denied / No Response / Adjusted tabs
    document.querySelectorAll('a.pn-var-link[data-pred-tab]').forEach(function (link) {
        link.addEventListener('click', function (e) {
            e.preventDefault();
            var tabId = link.getAttribute('data-pred-tab');
            if (!tabId) return;
            var tabEl = document.getElementById(tabId);
            if (!tabEl) return;
            var card = tabEl.closest('.insight-card') || tabEl.closest('.card');
            if (card) card.scrollIntoView({ behavior: 'smooth', block: 'start' });
            bootstrap.Tab.getOrCreateInstance(tabEl).show();
            // Keep the tab button visually focused after scroll
            setTimeout(function () { tabEl.focus({ preventScroll: true }); }, 350);
        });
    });
</script>
