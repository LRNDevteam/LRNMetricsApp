<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- WebDAVModule intercepts PUT/PATCH/DELETE ahead of the ASP.NET Core handler on IIS servers
           that have the WebDAV Publishing role installed, returning 405 Method Not Allowed even
           though the app's routes support these verbs. Remove it defensively; this is a no-op if
           WebDAV isn't installed. -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- stdoutLogEnabled is OFF: it wrote .\logs\stdout_*.log inside the app's
           content root, which the ASP.NET Core file watcher monitors — every write
           restarted the host (repeated "Application is shutting down..."). The app
           has its own file logging (Logging:File:LogDirectory). Turn this on only
           to troubleshoot startup failures, and point it outside the content root. -->
      <aspNetCore processPath="dotnet"
                  arguments=".\LabMetricsDashboard.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="InProcess"
                  startupTimeLimit="180"
                  requestTimeout="00:15:00">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
