<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the unit tests reach internal helpers (status parsing, feature-flag gating,
         lab name squashing) without widening their accessibility for the whole app. -->
    <InternalsVisibleTo Include="LabMetricsDashboard.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same reasoning as the lab configs below: appsettings.Local.json holds this machine's
         secrets, and the Web SDK's default content glob was publishing it. That shipped a
         developer's copy of the production connection strings AND that machine's blank
         KeyVault:Uri, which silently switches Key Vault off on the server it lands on.
         Keep it in the build output for local debugging; never ship it. -->
    <Content Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lab configs are loaded at runtime from LabConfigFolder (appsettings.json).
         Do NOT bake a per-lab config into the build output: it ships a stale copy
         (and a plaintext DB password) into the web root and, when LabConfigFolder
         resolves to the app directory, overrides the live config — which caused the
         "Coding Summary not available for PCRLabsofAmerica" banner. -->
    <None Include="RcmWatcherService\RcmWatcherService.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep Azure SDK / SqlClient on Microsoft.Extensions 9.x. Identity 1.21, Secrets 1.5.2,
         and SqlClient 7 compile against Extensions 10.x; IIS in-process then loads the net9
         shared framework (9.0.0.0) and crashes: FileNotFoundException
         Microsoft.Extensions.Configuration.Abstractions 10.0.0.0 (HTTP 500.30 / 500.37). -->
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.4.0" />
    <PackageReference Include="Azure.Identity" Version="1.13.2" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LRN.ProductionReports\LRN.ProductionReports.csproj" SetTargetFramework="TargetFramework=net9.0">
      <Private>True</Private>
      <CopyLocalSatelliteAssemblies>true</CopyLocalSatelliteAssemblies>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\LRN.ReportQueue.Shared\LRN.ReportQueue.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Models\ProductionReportViewModel.cs" />
    <Compile Remove="Services\IProductionReportRepository.cs" />
    <Compile Remove="Services\ProductionReportExcelExportBuilder.cs" />
    <Compile Remove="Services\SqlProductionReportRepository.cs" />
    <Compile Remove="Services\WeekRangeHelper.cs" />
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties /></VisualStudio></ProjectExtensions>

  <ItemGroup>
    <ProjectReference Include="..\LRN.ProductionReports\LRN.ProductionReports.csproj" SetTargetFramework="TargetFramework=net9.0">
      <Private>True</Private>
      <CopyLocalSatelliteAssemblies>true</CopyLocalSatelliteAssemblies>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Models\ProductionReportViewModel.cs" />
    <Compile Remove="Services\IProductionReportRepository.cs" />
    <Compile Remove="Services\ProductionReportExcelExportBuilder.cs" />
    <Compile Remove="Services\SqlProductionReportRepository.cs" />
    <Compile Remove="Services\WeekRangeHelper.cs" />
  </ItemGroup>

    <ItemGroup>
      <None Include="Templates\CodingSummary_CalculationLogic.xlsx" Condition="Exists('Templates\CodingSummary_CalculationLogic.xlsx')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
