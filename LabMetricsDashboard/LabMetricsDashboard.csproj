<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the unit tests reach internal helpers (status parsing, feature-flag gating,
         lab name squashing) without widening their accessibility for the whole app. -->
    <InternalsVisibleTo Include="LabMetricsDashboard.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lab configs are loaded at runtime from LabConfigFolder (appsettings.json).
         Do NOT bake a per-lab config into the build output: it ships a stale copy
         (and a plaintext DB password) into the web root and, when LabConfigFolder
         resolves to the app directory, overrides the live config — which caused the
         "Coding Summary not available for PCRLabsofAmerica" banner. -->
    <None Include="RcmWatcherService\RcmWatcherService.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LRN.ProductionReports\LRN.ProductionReports.csproj"
                      SetTargetFramework="TargetFramework=net9.0">
      <Private>True</Private>
      <CopyLocalSatelliteAssemblies>true</CopyLocalSatelliteAssemblies>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\LRN.ReportQueue.Shared\LRN.ReportQueue.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Models\ProductionReportViewModel.cs" />
    <Compile Remove="Services\IProductionReportRepository.cs" />
    <Compile Remove="Services\ProductionReportExcelExportBuilder.cs" />
    <Compile Remove="Services\SqlProductionReportRepository.cs" />
    <Compile Remove="Services\WeekRangeHelper.cs" />
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties /></VisualStudio></ProjectExtensions>

  <ItemGroup>
    <ProjectReference Include="..\LRN.ProductionReports\LRN.ProductionReports.csproj"
                      SetTargetFramework="TargetFramework=net9.0">
      <Private>True</Private>
      <CopyLocalSatelliteAssemblies>true</CopyLocalSatelliteAssemblies>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Models\ProductionReportViewModel.cs" />
    <Compile Remove="Services\IProductionReportRepository.cs" />
    <Compile Remove="Services\ProductionReportExcelExportBuilder.cs" />
    <Compile Remove="Services\SqlProductionReportRepository.cs" />
    <Compile Remove="Services\WeekRangeHelper.cs" />
  </ItemGroup>

    <ItemGroup>
      <None Include="Templates\CodingSummary_CalculationLogic.xlsx" Condition="Exists('Templates\CodingSummary_CalculationLogic.xlsx')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
