<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LRN.ReportWorker</RootNamespace>
    <UserSecretsId>lrn-report-worker</UserSecretsId>
    <!-- Worker references LabMetricsDashboard (Web SDK). Prefer this project's
         appsettings / content when both would publish to the same relative path. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LRN.ReportQueue.Shared\LRN.ReportQueue.Shared.csproj" />
    <!-- Web project referenced so Prediction/Forecasting exports reuse the SAME
         view-model builders, Excel builders and stored procedures as the pages. -->
    <ProjectReference Include="..\LabMetricsDashboard\LabMetricsDashboard.csproj" />
    <!-- API project referenced so the CPT / Panel Lookup export runs the SAME
         SqlCptLookupRepository queries and column set as the page's own grid.
         net8.0 assets consumed by a net9.0 host, which is supported. -->
    <ProjectReference Include="..\LRN.ReportsApi\LRN.ReportsApi.csproj" />
  </ItemGroup>

  <!-- Drop referenced web/API project content that collides with this worker's publish folder
       (NETSDK1152: appsettings.json, appsettings.Development.json, web.config, etc.).
       The worker's OWN appsettings must win — LRN.ReportsApi's carries the master
       connection strings this service is deliberately not configured with. -->
  <Target Name="ExcludeDashboardContentFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="( $([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').Contains('LabMetricsDashboard'))
                                          OR $([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').Contains('LRN.ReportsApi')) )
                                        AND (
                                          '%(Filename)%(Extension)' == 'appsettings.json'
                                          OR '%(Filename)%(Extension)' == 'appsettings.Development.json'
                                          OR '%(Filename)%(Extension)' == 'web.config'
                                          OR '%(Filename)%(Extension)' == 'PCRLabsofAmerica.json'
                                        )" />
    </ItemGroup>
  </Target>

</Project>
