		{ "Name": "Total Charges", "Aliases": [ "ChargeAmount" ], "Required": true, "DataType": "decimal" },
		{ "Name": "Insurance Paid", "Aliases": [ "InsurancePayment" ], "Required": true, "DataType": "decimal" },
		{ "Name": "Patient Paid", "Aliases": [ "PatientPayment" ], "Required": true, "DataType": "decimal" },
		{ "Name": "Write Off", "Aliases": [ "InsuranceAdjustments" ], "Required": false, "DataType": "decimal" },
		{ "Name": "Balance Due", "Required": false, "DataType": "decimal" },
		{ "Name": "Carrier Balance", "Aliases": [ "InsuranceBalance" ], "Required": false, "DataType": "decimal" },
		{ "Name": "Patient Responsibility", "Aliases": [ "PatientBalance" ], "Required": false, "DataType": "decimal" },
		{ "Name": "Allowed Amount", "Aliases": [ "AllowedAmount" ], "Required": false, "DataType": "decimal" },
