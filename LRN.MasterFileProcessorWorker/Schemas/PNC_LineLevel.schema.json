		{ "Name": "Policy ID", "Required": false, "DataType": "string" },
		{ "Name": "Payer ID", "Required": false, "DataType": "string" },
		{ "Name": "Insurance Type", "Aliases": [ "PayerType" ], "Required": false, "DataType": "string" },
		{ "Name": "Rendering Provider", "Required": false, "DataType": "string" },
		{ "Name": "Billing Provider", "Aliases": [ "BillingProvider" ], "Required": false, "DataType": "string" },
		{ "Name": "Service Facility", "Required": false, "DataType": "string" },
		{ "Name": "Referring Provider", "Aliases": [ "ReferringProvider" ], "Required": false, "DataType": "string" },
		{ "Name": "Referring Provider NPI", "Required": false, "DataType": "string" },
		{ "Name": "Billing Provider NPI", "Required": false, "DataType": "string" },
