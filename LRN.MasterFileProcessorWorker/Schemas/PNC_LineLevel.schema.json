		{ "Name": "Accession Number", "Aliases": [ "AccessionNumber" ], "Required": true, "DataType": "string" },
		{ "Name": "Date of Service", "Aliases": [ "DateofService" ], "Required": true, "DataType": "date" },
		{ "Name": "Aging", "Required": false, "DataType": "string" },
		{ "Name": "Created Date", "Aliases": [ "ChargeEnteredDate" ], "Required": false, "DataType": "date" },
		{ "Name": "DOE Week", "Required": false, "DataType": "string" },
		{ "Name": "Billed Date", "Aliases": [ "FirstBilledDate" ], "Required": true, "DataType": "date" },
		{ "Name": "Billed Week", "Required": false, "DataType": "string" },
		{ "Name": "CPT / Procedure", "Aliases": [ "CPTCode" ], "Required": true, "DataType": "string" },
		{ "Name": "Modifiers", "Aliases": [ "Modifier" ], "Required": true, "DataType": "string" },
