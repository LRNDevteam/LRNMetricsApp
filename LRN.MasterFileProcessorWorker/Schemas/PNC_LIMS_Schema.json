{
	"SchemaName": "LIMSMaster",
	"SheetName": "LIMS Data",
	"HeaderRow": 1,
	"//": [
		"PNC LIMS sheet ('LIMS Data' in the sample; the importer picks the sheet by header match).",
		"SQL column names follow the other labs' LIMS schemas where the field is the same, so the LIS",
		"Summary columns (PanelName, ClinicName, DoctorFullName, SalesRepName, NewStatus, BillCategory,",
		"SubStatus, RequestCollectDate, ReqReceivedDate, ResultedDate) line up with Texas Diagnostic.",
		"'AccessionNo' is the accession (same number as the billing 'Accession Number', e.g. A250070001);",
		"'RecordId' (PNAP-...) is the LIMS order id.",
		"'Panel type' is the panel group (PanelName); 'Ordered Panels' lists the ordered tests (Tests).",
		"'FacilityName' is the client (ClinicName). 'Validated_Date' is the resulted date.",
		"'New Status ' carries a trailing space; the importer normalizes headers.",
		"Unmapped columns (address, zip, city, email, notes, secondary insurance, facility address,",
		"medications) go to AdditionalFields, subject to the sensitive-column policy."
	],
	"Columns": [
		{ "ExcelColName": "AccessionNo", "Required": true, "DataType": "string", "SQLColName": "Accession" },
		{ "ExcelColName": "RecordId", "Required": false, "DataType": "string", "SQLColName": "OrderID" },
		{ "ExcelColName": "T/F", "Required": false, "DataType": "string", "SQLColName": "TrueFalse" },
		{ "ExcelColName": "FirstName", "Required": false, "DataType": "string", "SQLColName": "PatientFirstName" },
		{ "ExcelColName": "LastName", "Required": false, "DataType": "string", "SQLColName": "PatientLastName" },
		{ "ExcelColName": "Patient Name", "Required": false, "DataType": "string", "SQLColName": "PatientFullName" },
		{ "ExcelColName": "Gender", "Required": false, "DataType": "string", "SQLColName": "Gender" },
		{ "ExcelColName": "State", "Required": false, "DataType": "string", "SQLColName": "State" },
		{ "ExcelColName": "DOB", "Required": false, "DataType": "date", "SQLColName": "PatientDateOfBirth" },
		{ "ExcelColName": "PatientId", "Required": false, "DataType": "string", "SQLColName": "PatientCode" },
		{ "ExcelColName": "Accessioned_Date", "Required": false, "DataType": "date", "SQLColName": "AccessionedDate" },
		{ "ExcelColName": "Received_Date", "Required": false, "DataType": "date", "SQLColName": "ReqReceivedDate" },
		{ "ExcelColName": "ICDCodes", "Required": false, "DataType": "string", "SQLColName": "ICD10Codes" },
		{ "ExcelColName": "Is Direct Bill Order", "Required": false, "DataType": "string", "SQLColName": "IsDirectBillOrder" },
