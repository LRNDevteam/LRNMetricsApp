{
	"SchemaName": "CoreBio_LineLevel",
	"HeaderRow": 1,
	"//": [
		"CoreBio 'Line Level File' sheet. Mapping per AveragesTable_AllAccounts_Field Mapping_V1.20.xlsx,",
		"LineLevelFactTable, column 'CoreBio'.",
		"Each column is a source header; where it is not already a COMMON alias, Aliases names the COMMON",
		"column it feeds - a lab-only alias group, so LineLevel.schema.json is unchanged for other labs.",
		"DenialCode is the ORIGINAL denial code here (V1.20), while the sheet's 'Denial Code' is the updated",
		"one. 'Denial Code' is a COMMON DenialCode alias, so DenialCode is pinned to 'Original Denial Code'",
		"with a composite (only the referenced header is read, with no fallback), and 'Denial Code' is",
		"kept raw as 'Updated Denial' - it cannot keep its own name, because the bulk loader binds CSV",
		"headers by normalized name and 'Denial Code' would bind to the DenialCode column.",
		"'Claim Level ICD' and 'Claim Level Denial Code' fill the COMMON columns of the same name; they are",
		"deliberately NOT declared here, because declaring them would put them ahead of 'Claim ICD List' /",
		"'Original Denial Code' as the source of ICDCode / DenialCode.",
		"'Facility Name' is a COMMON ClinicName alias, so it fills ClinicName and is kept raw for Facility.",
		"'Charge Last Bill Date' reaches 'Last Billed Date' through the COMMON alias; it deliberately has NO",
		"alias here (the COMMON FirstBilledDate aliases include 'Last billed date').",
		"'Total Balance' is not read: the COMMON column is calculated (Insurance + Patient Balance).",
		"The sheet has no Claim Status; it is copied from the claim sheet (ShouldCopyClaimStatusToLineLevel)."
	],
	"Columns": [
		{ "Name": "Charge Claim ID", "Aliases": [ "ClaimID" ], "Required": true, "DataType": "string" },
		{ "Name": "T/F", "Required": false, "DataType": "string" },
		{ "Name": "UID", "Required": false, "DataType": "string" },
		{ "Name": "Claim Reference #", "Aliases": [ "AccessionNumber" ], "Required": true, "DataType": "string" },
		{ "Name": "Panel Name", "Aliases": [ "Panelname" ], "Required": true, "DataType": "string" },
		{ "Name": "LIS Panel", "Required": false, "DataType": "string" },
		{ "Name": "Charge From Date", "Aliases": [ "DateofService" ], "Required": true, "DataType": "date" },
		{ "Name": "Charge To Date", "Required": false, "DataType": "date" },
		{ "Name": "Aging DOS", "Required": false, "DataType": "string" },
		{ "Name": "Charge Entered Date", "Aliases": [ "ChargeEnteredDate" ], "Required": false, "DataType": "date" },
		{ "Name": "Charge First Bill Date", "Aliases": [ "FirstBilledDate" ], "Required": true, "DataType": "date" },
		{ "Name": "Charge Last Bill Date", "Required": false, "DataType": "date" },
		{ "Name": "Claim Ordering Provider ID", "Required": false, "DataType": "string" },
		{ "Name": "Facility Name", "KeepRaw": true, "Required": false, "DataType": "string" },
		{ "Name": "LIS Facility Name", "Required": false, "DataType": "string" },
		{ "Name": "Referring Full Name", "Aliases": [ "ReferringProvider" ], "Required": false, "DataType": "string" },
		{ "Name": "Charge Panel Name", "Required": false, "DataType": "string" },
		{ "Name": "Charge Patient ID", "Aliases": [ "PatientID" ], "Required": false, "DataType": "string" },
		{ "Name": "Patient Full Name", "Required": false, "DataType": "string" },
		{ "Name": "Patient Birthday", "Aliases": [ "Patient DOB" ], "Required": true, "DataType": "date" },
		{ "Name": "Claim Primary Payer Name", "Aliases": [ "PayerName_Raw" ], "Required": true, "DataType": "string" },
		{ "Name": "Claim Primary Payer Type", "Aliases": [ "PayerType" ], "Required": false, "DataType": "string" },
		{ "Name": "Claim Primary Member ID", "Required": false, "DataType": "string" },
		{ "Name": "Charge CPT Description", "Required": false, "DataType": "string" },
		{ "Name": "Charge CPT Code", "Aliases": [ "CPTCode" ], "Required": true, "DataType": "string" },
		{ "Name": "Charge Units", "Aliases": [ "Units" ], "Required": true, "DataType": "int" },
		{ "Name": "Charge Modifier List", "Aliases": [ "Modifier" ], "Required": true, "DataType": "string" },
		{ "Name": "CPT X MOD X UNITS", "Required": false, "DataType": "string" },
		{ "Name": "Line Level Combination", "Required": false, "DataType": "string" },
		{ "Name": "Claim Level Combination", "Required": false, "DataType": "string" },
		{ "Name": "Charge Diagnosis Pointer List", "Aliases": [ "ICD Pointer" ], "Required": true, "DataType": "string" },
		{ "Name": "Claim ICD List", "Aliases": [ "ICDCode" ], "Required": true, "DataType": "string" },
		{ "Name": "Deposit Date", "Aliases": [ "CheckDate" ], "Required": false, "DataType": "date" },
		{ "Name": "Denial Date", "Required": false, "DataType": "date" },
		{ "Name": "[Original Denial Code] {DenialCode}", "Required": false, "DataType": "string" },
		{ "Name": "Original Denial Code", "Required": true, "DataType": "string" },
		{ "Name": "Updated Denial", "Aliases": [ "Denial Code" ], "KeepRaw": true, "Required": false, "DataType": "string" },
		{ "Name": "Line Level Denial Code", "Required": false, "DataType": "string" },
		{ "Name": "Charge Amount", "Aliases": [ "ChargeAmount" ], "Required": true, "DataType": "decimal" },
		{ "Name": "Charge Insurance Payments", "Aliases": [ "InsurancePayment" ], "Required": true, "DataType": "decimal" },
		{ "Name": "Charge Patient Payments", "Aliases": [ "PatientPayment" ], "Required": true, "DataType": "decimal" },
		{ "Name": "Charge Total Adjustments", "Required": false, "DataType": "decimal" },
		{ "Name": "Total Ins Balance", "Required": false, "DataType": "decimal" },
		{ "Name": "Pat Balance", "Aliases": [ "PatientBalance" ], "Required": false, "DataType": "decimal" },
		{ "Name": "Charge Balance Due Ins", "Aliases": [ "InsuranceBalance" ], "Required": false, "DataType": "decimal" },
		{ "Name": "Charge Balance At Collections", "Required": false, "DataType": "decimal" },
		{ "Name": "Charge Balance Due Other", "Required": false, "DataType": "decimal" },
		{ "Name": "Charge Insurance Adjustments", "Aliases": [ "InsuranceAdjustments" ], "Required": false, "DataType": "decimal" },
		{ "Name": "Charge Patient Adjustments", "Aliases": [ "PatientAdjustments" ], "Required": false, "DataType": "decimal" },
		{ "Name": "Charge Total Payments", "Required": false, "DataType": "decimal" },
		{ "Name": "Claim Deleted?", "Required": false, "DataType": "string" },
		{ "Name": "Payment %", "Required": false, "DataType": "decimal" }
	]
}
