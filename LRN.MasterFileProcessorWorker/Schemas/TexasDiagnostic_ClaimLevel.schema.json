		{ "Name": "DOE", "Aliases": [ "ChargeEnteredDate" ], "Required": false, "DataType": "date" },
		{ "Name": "Aging DOE", "Required": false, "DataType": "string" },
		{ "Name": "Entry Week", "Required": false, "DataType": "string" },
		{ "Name": "LastBillDate", "Aliases": [ "FirstBilledDate" ], "Required": true, "DataType": "date" },
		{ "Name": "Billed Week", "Required": false, "DataType": "string" },
