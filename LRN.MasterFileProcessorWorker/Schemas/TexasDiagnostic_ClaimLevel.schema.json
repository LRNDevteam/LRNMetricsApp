{
	"SchemaName": "TexasDiagnostic_ClaimLevel",
	"HeaderRow": 1,
	"//": [
		"Texas Diagnostic 'Claim Level' sheet. Mapping per AveragesTable_AllAccounts_Field Mapping_V1.20.xlsx,",
		"ClaimLevelFactTable, column 'TexasDx'.",
		"DenialCode <- 'Claim Level Denial Code' and ICDCode <- 'Claim Level ICD' are pinned with composites, so",
		"nothing falls back to another column when they are blank. 'Denial Code' is the original code (V1.20",
		"'Original Denial code'); it normalizes to DenialCode, so it is kept raw as 'Original Denial Code'.",
		"'Claim Level CPT' feeds 'CPT Code X Units X Modifier Orginal'; the COMMON 'CPT Code X Units X",
		"Modifier' is rebuilt from the line level after export. 'CPT' is a COMMON alias of the same column",
		"and is deliberately NOT declared, so it never stands in for a blank 'Claim Level CPT'.",
		"'Deposit Date' is CheckDate and 'Posted Date' is Payment Posted Date (both COMMON aliases).",
		"'Posted Date' is deliberately NOT declared: it is also a COMMON CheckDate alias, and declaring it",
		"would let a blank Deposit Date fall back to the posted date.",
		"'TotalPayment' / 'TotalWO' are loaded raw; the COMMON TotalPayments / TotalAdjustments are calculated.",
		"'TotalBalance' is not read: the COMMON 'Total Balance' is calculated (Carrier + Patient Balance)."
	],
	"Columns": [
		{ "Name": "VisitNum", "Aliases": [ "ClaimID" ], "Required": true, "DataType": "string" },
		{ "Name": "T/F", "Required": false, "DataType": "string" },
		{ "Name": "ENC/CPT/TC", "Required": false, "DataType": "string" },
		{ "Name": "UID", "Required": false, "DataType": "string" },
		{ "Name": "Payer Name", "Aliases": [ "PayerName_Raw" ], "Required": true, "DataType": "string" },
		{ "Name": "FinancialClass", "Aliases": [ "PayerType" ], "Required": false, "DataType": "string" },
		{ "Name": "Panel", "Aliases": [ "Panelname" ], "Required": true, "DataType": "string" },
		{ "Name": "Clinic Name", "Aliases": [ "ClinicName" ], "Required": false, "DataType": "string" },
		{ "Name": "Provider", "Aliases": [ "BillingProvider" ], "Required": false, "DataType": "string" },
		{ "Name": "ReferringProvider", "Required": false, "DataType": "string" },
		{ "Name": "Facility", "Required": false, "DataType": "string" },
		{ "Name": "ChartNum", "Aliases": [ "PatientID" ], "Required": false, "DataType": "string" },
		{ "Name": "PatientName", "Required": false, "DataType": "string" },
		{ "Name": "DOB", "Aliases": [ "Patient DOB" ], "Required": false, "DataType": "date" },
		{ "Name": "SubscriberID", "Required": false, "DataType": "string" },
