{
	"SchemaName": "WellHealth_LineLevel",
	"HeaderRow": 1,
	"//": [
		"Well Health 'Line Level' sheet. Mapping per AveragesTable_AllAccounts_Field Mapping_V1.19.xlsx,",
		"LineLevelFactTable, column 'Well Health'.",
		"Each column is a source header; where it is not already a COMMON alias, Aliases names the COMMON",
		"column it feeds. That pairing is a lab-only alias group, so no shared alias in LineLevel.schema.json",
		"changes for any other lab.",
		"'Denial Deposit Date' feeds the COMMON 'Denial Date'; 'Payment Entered' feeds 'Payment Posted Date'.",
		"The sheet has no 'Posted Date', so the COMMON 'Denial Date' alias of that name cannot fall back onto",
		"the posting date.",
		"The sheet has no Claim Status; it is copied from the claim sheet (ShouldCopyClaimStatusToLineLevel).",
		"'Charge Last Bill Date' deliberately has NO 'Last Billed Date' alias: the COMMON FirstBilledDate",
		"aliases include 'Last billed date', so that alias made FirstBilledDate read the LAST bill date.",
		"It reaches 'Last Billed Date' through the COMMON alias instead.",
		"'Claim Reference #' carries a 'D-' prefix on this sheet but not on the claim sheet; it is loaded as-is."
	],
	"Columns": [
		{ "Name": "Claim ID", "Aliases": [ "ClaimID" ], "Required": true, "DataType": "string" },
		{ "Name": "UNID", "Required": false, "DataType": "string" },
		{ "Name": "Claim Reference #", "Aliases": [ "AccessionNumber" ], "Required": true, "DataType": "string" },
		{ "Name": "Patient Full Name", "Required": false, "DataType": "string" },
		{ "Name": "Office Name", "Required": false, "DataType": "string" },
		{ "Name": "Claim Patient ID", "Aliases": [ "PatientID" ], "Required": false, "DataType": "string" },
		{ "Name": "Patient Birthday", "Aliases": [ "Patient DOB" ], "Required": true, "DataType": "date" },
		{ "Name": "Charge From Date", "Aliases": [ "DateofService" ], "Required": true, "DataType": "date" },
		{ "Name": "Charge To Date", "Required": false, "DataType": "date" },
		{ "Name": "Charge Entered Date", "Aliases": [ "ChargeEnteredDate" ], "Required": false, "DataType": "date" },
		{ "Name": "Charge First Bill Date", "Aliases": [ "FirstBilledDate" ], "Required": true, "DataType": "date" },
		{ "Name": "Charge Last Bill Date", "Required": false, "DataType": "date" },
		{ "Name": "Charge CPT Code", "Aliases": [ "CPTCode" ], "Required": true, "DataType": "string" },
		{ "Name": "CPT Short Description", "Required": false, "DataType": "string" },
		{ "Name": "Charge Units", "Aliases": [ "Units" ], "Required": true, "DataType": "int" },
		{ "Name": "CPTunits", "Required": false, "DataType": "string" },
		{ "Name": "CPTMOD", "Required": false, "DataType": "string" },
		{ "Name": "Concatenate CPTs", "Required": false, "DataType": "string" },
		{ "Name": "Charge POS Code", "Aliases": [ "POS" ], "Required": false, "DataType": "string" },
		{ "Name": "ChargeModifierList", "Aliases": [ "Modifier" ], "Required": true, "DataType": "string" },
		{ "Name": "Charge Rev Code", "Required": false, "DataType": "string" },
		{ "Name": "Charge Diagnosis Pointer List", "Aliases": [ "ICD Pointer" ], "Required": true, "DataType": "string" },
		{ "Name": "Claim ICD List", "Aliases": [ "ICDCode" ], "Required": true, "DataType": "string" },
		{ "Name": "Claim Primary Payer Name", "Aliases": [ "PayerName_Raw" ], "Required": true, "DataType": "string" },
		{ "Name": "Claim Primary Payer Type", "Aliases": [ "PayerType" ], "Required": false, "DataType": "string" },
		{ "Name": "Referring Full Name", "Aliases": [ "ReferringProvider" ], "Required": false, "DataType": "string" },
		{ "Name": "Facility Name", "Aliases": [ "ClinicName" ], "Required": false, "DataType": "string" },
		{ "Name": "Claim Billing Provider ID", "Required": false, "DataType": "string" },
		{ "Name": "Charge Panel ID", "Required": false, "DataType": "string" },
		{ "Name": "Denial Code", "Aliases": [ "DenialCode" ], "Required": true, "DataType": "string" },
		{ "Name": "Denial Deposit Date", "Aliases": [ "Denial Date" ], "Required": false, "DataType": "date" },
		{ "Name": "Deposit Date", "Aliases": [ "CheckDate" ], "Required": false, "DataType": "date" },
		{ "Name": "Payment Entered", "Aliases": [ "Payment Posted Date" ], "Required": false, "DataType": "date" },
		{ "Name": "Charge Amount", "Aliases": [ "ChargeAmount" ], "Required": true, "DataType": "decimal" },
		{ "Name": "Charge Total Payments", "Required": false, "DataType": "decimal" },
		{ "Name": "Payment %", "Required": false, "DataType": "decimal" },
		{ "Name": "Charge Insurance Payments", "Aliases": [ "InsurancePayment" ], "Required": true, "DataType": "decimal" },
		{ "Name": "Charge Patient Payments", "Aliases": [ "PatientPayment" ], "Required": true, "DataType": "decimal" },
		{ "Name": "Charge Total Adjustments", "Required": false, "DataType": "decimal" },
		{ "Name": "Charge Insurance Adjustments", "Aliases": [ "InsuranceAdjustments" ], "Required": false, "DataType": "decimal" },
