		{ "Name": "Charge Balance Due Pat", "Aliases": [ "PatientBalance" ], "Required": false, "DataType": "decimal" },
		{ "Name": "Charge Balance Due Ins", "Aliases": [ "InsuranceBalance" ], "Required": false, "DataType": "decimal" },
