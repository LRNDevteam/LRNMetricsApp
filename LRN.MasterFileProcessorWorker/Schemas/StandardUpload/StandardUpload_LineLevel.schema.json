{
  "SchemaName": "StandardUpload_LineLevel",
  "TemplateVersion": "1.0",
  "SheetName": "Line Level",
  "HeaderRow": 1,
  "Columns": [
    { "Name": "ClaimID", "Required": true, "DataType": "string", "Description": "Claim / visit / encounter number. Must match a ClaimID on the Claim Level sheet." },
    { "Name": "AccessionNumber", "Required": false, "DataType": "string", "Description": "Accession / specimen number." },
    { "Name": "PatientID", "Required": false, "DataType": "string", "Description": "Patient account / chart number." },
    { "Name": "Patient DOB", "Required": false, "DataType": "date", "Description": "Patient date of birth (MM/DD/YYYY)." },
    { "Name": "PayerName_Raw", "Required": true, "DataType": "string", "Description": "Payer / insurance name as it appears in the billing system." },
    { "Name": "PayerType", "Required": false, "DataType": "string", "Description": "Financial class." },
    { "Name": "BillingProvider", "Required": false, "DataType": "string", "Description": "Billing / rendering provider." },
    { "Name": "ReferringProvider", "Required": false, "DataType": "string", "Description": "Referring / ordering provider." },
    { "Name": "ClinicName", "Required": false, "DataType": "string", "Description": "Clinic / facility / account name." },
    { "Name": "SalesRepname", "Required": false, "DataType": "string", "Description": "Sales representative." },
    { "Name": "DateofService", "Required": true, "DataType": "date", "Description": "Date of service (MM/DD/YYYY)." },
    { "Name": "ChargeEnteredDate", "Required": false, "DataType": "date", "Description": "Charge entry date (MM/DD/YYYY)." },
    { "Name": "FirstBilledDate", "Required": false, "DataType": "date", "Description": "First billed date (MM/DD/YYYY)." },
    { "Name": "Last Billed Date", "Required": false, "DataType": "date", "Description": "Most recent billed date (MM/DD/YYYY)." },
    { "Name": "Panelname", "Required": false, "DataType": "string", "Description": "Panel / test name." },
    { "Name": "CPTCode", "Required": true, "DataType": "string", "Description": "CPT / HCPCS code of the line." },
    { "Name": "Units", "Required": false, "DataType": "integer", "Description": "Billed units. Per-unit amounts are calculated from it." },
    { "Name": "Modifier", "Required": false, "DataType": "string", "Description": "Modifier(s)." },
    { "Name": "POS", "Required": false, "DataType": "string", "Description": "Place of service." },
    { "Name": "TOS", "Required": false, "DataType": "string", "Description": "Type of service." },
    { "Name": "ChargeAmount", "Required": true, "DataType": "decimal", "Description": "Billed (charge) amount of the line." },
    { "Name": "AllowedAmount", "Required": false, "DataType": "decimal", "Description": "Allowed amount." },
    { "Name": "InsurancePayment", "Required": false, "DataType": "decimal", "Description": "Insurance payment." },
    { "Name": "PatientPayment", "Required": false, "DataType": "decimal", "Description": "Patient payment." },
    { "Name": "InsuranceAdjustments", "Required": false, "DataType": "decimal", "Description": "Insurance adjustment / write-off." },
    { "Name": "PatientAdjustments", "Required": false, "DataType": "decimal", "Description": "Patient adjustment." },
    { "Name": "InsuranceBalance", "Required": false, "DataType": "decimal", "Description": "Open insurance balance of the line." },
    { "Name": "PatientBalance", "Required": false, "DataType": "decimal", "Description": "Open patient balance of the line." },
    { "Name": "CheckDate", "Required": false, "DataType": "date", "Description": "Check / deposit date (MM/DD/YYYY)." },
    { "Name": "Payment Posted Date", "Required": false, "DataType": "date", "Description": "Payment posted date (MM/DD/YYYY)." },
    { "Name": "ClaimStatus", "Required": false, "DataType": "string", "Description": "Line status (Paid, Denied, ...). Leave blank to use the claim's status." },
    { "Name": "DenialCode", "Required": false, "DataType": "string", "Description": "Line-level denial code(s), e.g. CO-16, CO-50. Separate several with a comma." },
    { "Name": "Denial Date", "Required": false, "DataType": "date", "Description": "Date the denial was posted (MM/DD/YYYY)." },
    { "Name": "ICDCode", "Required": false, "DataType": "string", "Description": "ICD-10 diagnosis code(s) of the line, comma separated." },
    { "Name": "ICD Pointer", "Required": false, "DataType": "string", "Description": "Diagnosis pointer." }
  ]
}
