		{ "ExcelColName": "SARS-CoV-2 PCR", "Required": false, "DataType": "string", "SQLColName": "SarsCov2PCR" },
		{ "ExcelColName": "Final Report Type", "Required": false, "DataType": "string", "SQLColName": "FinalReportType" },
		{ "ExcelColName": "Billed", "Required": false, "DataType": "string", "SQLColName": "BilledorNot" },
