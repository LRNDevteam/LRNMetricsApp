{
	"SchemaName": "TexasDiagnostic_LineLevel",
	"HeaderRow": 1,
	"//": [
		"Texas Diagnostic 'Line Level' sheet. Mapping per AveragesTable_AllAccounts_Field Mapping_V1.20.xlsx,",
		"LineLevelFactTable, column 'Texas Dx'. Most headers (VisitNum, ChartNum, BeginDOS, DOE, LastBillDate,",
		"TotalCharge, CarrierPayment, CarrierWO, ...) are already COMMON aliases; they are declared here so the",
		"lab's source wins when a file carries several candidates.",
		"V1.20 lists no line-level source for Panel, ClinicName, CheckDate, DenialCode or ICDCode; the COMMON",
		"aliases fill Panel / Clinic Name / Deposit Date / Posted Date. DenialCode and ICDCode are pinned to the",
		"LINE-level columns with composites ('Claim Level ...' are listed first in the COMMON aliases):",
		"  DenialCode <- 'Line Level Denial Code', ICDCode <- 'Line Level ICD'.",
		"'Claim Level Denial Code', 'Claim Level ICD' and 'Claim Level CPT' fill the COMMON columns of the same",
		"name. 'Denial Code' (the original code) normalizes to DenialCode, so it is kept raw as",
		"'Original Denial Code' (the bulk loader binds headers by normalized name).",
		"'TotalBalance' is not read: the COMMON 'Total Balance' is calculated (Carrier + Patient Balance).",
		"The sheet has no Claim Status; it is copied from the claim sheet (ShouldCopyClaimStatusToLineLevel)."
	],
	"Columns": [
		{ "Name": "VisitNum", "Aliases": [ "ClaimID" ], "Required": true, "DataType": "string" },
		{ "Name": "T/F", "Required": false, "DataType": "string" },
		{ "Name": "ENC/CPT/TC", "Required": false, "DataType": "string" },
		{ "Name": "UID", "Required": false, "DataType": "string" },
		{ "Name": "Payer Name", "Aliases": [ "PayerName_Raw" ], "Required": true, "DataType": "string" },
		{ "Name": "FinancialClass", "Aliases": [ "PayerType" ], "Required": false, "DataType": "string" },
		{ "Name": "Panel", "Aliases": [ "Panelname" ], "Required": false, "DataType": "string" },
		{ "Name": "Clinic Name", "Aliases": [ "ClinicName" ], "Required": false, "DataType": "string" },
		{ "Name": "Provider", "Aliases": [ "BillingProvider" ], "Required": false, "DataType": "string" },
		{ "Name": "ReferringProvider", "Required": false, "DataType": "string" },
		{ "Name": "Facility", "Required": false, "DataType": "string" },
		{ "Name": "ChartNum", "Aliases": [ "PatientID" ], "Required": false, "DataType": "string" },
		{ "Name": "PatientName", "Required": false, "DataType": "string" },
		{ "Name": "DOB", "Aliases": [ "Patient DOB" ], "Required": true, "DataType": "date" },
		{ "Name": "SubscriberID", "Required": false, "DataType": "string" },
		{ "Name": "Accession", "Aliases": [ "AccessionNumber" ], "Required": true, "DataType": "string" },
		{ "Name": "BeginDOS", "Aliases": [ "DateofService" ], "Required": true, "DataType": "date" },
		{ "Name": "Aging DOS", "Required": false, "DataType": "string" },
		{ "Name": "EndDOS", "Required": false, "DataType": "date" },
		{ "Name": "DOE", "Aliases": [ "ChargeEnteredDate" ], "Required": false, "DataType": "date" },
		{ "Name": "Aging DOE", "Required": false, "DataType": "string" },
		{ "Name": "Entry Week", "Required": false, "DataType": "string" },
		{ "Name": "LastBillDate", "Aliases": [ "FirstBilledDate" ], "Required": true, "DataType": "date" },
		{ "Name": "Billed Week", "Required": false, "DataType": "string" },
		{ "Name": "CPT", "Aliases": [ "CPTCode" ], "Required": true, "DataType": "string" },
		{ "Name": "Units", "Required": true, "DataType": "int" },
		{ "Name": "Line Level CPT", "Required": false, "DataType": "string" },
		{ "Name": "Deposit Date", "Aliases": [ "CheckDate" ], "Required": false, "DataType": "date" },
		{ "Name": "DOD Week", "Required": false, "DataType": "string" },
		{ "Name": "Cheque No", "Required": false, "DataType": "string" },
		{ "Name": "Denied Week", "Required": false, "DataType": "string" },
		{ "Name": "[Line Level Denial Code] {DenialCode}", "Required": false, "DataType": "string" },
		{ "Name": "Line Level Denial Code", "Required": true, "DataType": "string" },
		{ "Name": "Original Denial Code", "Aliases": [ "Denial Code" ], "KeepRaw": true, "Required": false, "DataType": "string" },
		{ "Name": "[Line Level ICD] {ICDCode}", "Required": false, "DataType": "string" },
		{ "Name": "Line Level ICD", "Required": true, "DataType": "string" },
		{ "Name": "POS", "Required": false, "DataType": "string" },
		{ "Name": "TOS", "Required": false, "DataType": "string" },
		{ "Name": "Modifier", "Required": true, "DataType": "string" },
		{ "Name": "Medicare Fee Schedule", "Required": false, "DataType": "decimal" },
		{ "Name": "Expected Payment", "Required": false, "DataType": "decimal" },
		{ "Name": "TotalCharge", "Aliases": [ "ChargeAmount" ], "Required": true, "DataType": "decimal" },
		{ "Name": "CarrierPayment", "Aliases": [ "InsurancePayment" ], "Required": true, "DataType": "decimal" },
		{ "Name": "PatientPayment", "Required": true, "DataType": "decimal" },
		{ "Name": "CarrierWO", "Aliases": [ "InsuranceAdjustments" ], "Required": false, "DataType": "decimal" },
		{ "Name": "CarrierBalance", "Aliases": [ "InsuranceBalance" ], "Required": false, "DataType": "decimal" },
		{ "Name": "PatientBalance", "Required": false, "DataType": "decimal" },
		{ "Name": "TotalAllowed", "Aliases": [ "AllowedAmount" ], "Required": false, "DataType": "decimal" },
		{ "Name": "PatientWO", "Aliases": [ "PatientAdjustments" ], "Required": false, "DataType": "decimal" },
		{ "Name": "Payment %", "Required": false, "DataType": "decimal" }
	]
}
