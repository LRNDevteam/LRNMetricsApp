{
	"SchemaName": "LIMSMaster",
	"SheetName": "LIMS Data",
	"HeaderRow": 1,
	"//": [
		"Texas Diagnostic LIMS sheet ('LIMS Data' in the sample; the importer picks the sheet by header match).",
		"SQL column names follow the other labs' LIMS schemas where the field is the same.",
		"'Sample IDs' is the accession: it carries the same number as the billing 'Accession'",
		"(prefix + requisition + sample no., e.g. TD00116620-1), and 'Requisition ID' is the requisition.",
		"'Billed Date ' and 'Time to Bill ' carry a trailing space; the importer normalizes headers.",
		"Unmapped columns (address, zip, city, email, medications) go to AdditionalFields."
	],
	"Columns": [
		{ "ExcelColName": "Sample IDs", "Required": true, "DataType": "string", "SQLColName": "Accession" },
		{ "ExcelColName": "Requisition ID", "Required": false, "DataType": "string", "SQLColName": "Requisition" },
