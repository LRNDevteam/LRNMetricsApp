{
  // Every secret comes from this vault: ConnectionStrings--DefaultConnection (LRNMaster),
  // ConnectionStrings--<LabDbConnectionKey> for each lab below, MasterFileProcessor--SharePoint--ClientSecret,
  // Notifications--Teams--WebhookUrl and MasterDataSnapshot--BlobServiceUri / --ContainerName.
  // The test server runs with DOTNET_ENVIRONMENT=Test, which loads appsettings.Test.json (lrn-testapp-kv).
  "KeyVault": {
    "VaultUri": "https://kv-lrnmetrics-prod.vault.azure.net/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "None",
      "System": "None"
    }
  },
  "LineClaimImport": {
    "Enabled": true,
    "LabMappingsFolder": "Schemas/LabMappings",
    "FailFastOnInvalidMapping": true,
      // Reports built FROM the line-level and claim-level data rather than run separately. Each is
    // marked Success on the workflow dashboard, against the same RunId, once BOTH levels have
    // actually loaded for that lab.
    //   LabIds empty  = every lab (so a new lab is covered without editing this)
    //   LabIds listed = only those labs
    "DerivedReports": [
      {
        "ReportName": "Clinic Summary",
        "Enabled": true,
        "LabIds": []
      },
      {
        // Only these labs have the sales rep data.  4 = Cove, 16 = Elixir
        "ReportName": "Sales Rep Summary",
        "Enabled": true,
        "LabIds": [ 4, 16 ]
      }
    ]
  },
  // After a lab's line-level and claim-level data load, runs dbo.ARWB_usp_LoadClaimsFromSource in
  // that lab's database (AR Workbench / Denial Workbench): claims and lines are refreshed from the
  // latest master file, and an assigned claim that is not completed or closed whose claim status
  // changed (e.g. No Response -> Paid) moves to Status Change Verification under one of the lab's
  // "AR Workbench - RCM Manager" users, who is notified in the AR Workbench.
  // A lab without the AR Workbench scripts installed is skipped.
  // Per lab it also needs "ArWorkbenchEnabled": true in its MasterFileProcessor:Labs entry; labs
  // without it are never synced (only labs that have the AR Workbench should set it).
  // Before each sync the fee schedule (LRN Metrics > Master Values > Fees Schedule Import,
  // LRNMaster.dbo.FeeSchedule) is copied into the lab, so Revenue Expectation / Recovery Status
  // use the latest rates.
  //   LabIds empty = every lab (that has ArWorkbenchEnabled)
  "ArWorkbenchSync": {
    "Enabled": true,
    "LabIds": [],
    "CommandTimeoutSeconds": 3600,
    "RunBy": "MasterFileProcessor"
  },
  // Step 88: once a lab's weekly run has loaded its Line Level, Claim Level and LIMS tables, each
  // table is written to one Parquet file in the container:
  //   <container>/<LabName>/<RunId>_<WeekRange>_<LINELEVEL|CLAIMLEVEL|LIMS>.parquet
  //   e.g. report-snapshots/Beech_Tree/R20260213BTL0001_02.06.2026-02.12.2026_LINELEVEL.parquet
  // and indexed in LRNMaster.dbo.ReportSnapshotRun / dbo.ReportSnapshotFile
  // (Database/LRN.MasterFileProcessorWorker/Create_ReportSnapshots.sql - run it before enabling).
  // Then only the latest run of each of the last KeepWeeks week folders is kept (plus the last run
  // of each of the last KeepMonthEnd months, if set); older runs' files and rows are deleted.
  // A table that did not load in this run is not snapshotted. A failure is a WARNING on the run.
  //   Enabled      : worker-wide switch. Each lab ALSO needs "MasterDataSnapshotEnabled": true in its
  //                  MasterFileProcessor:Labs entry; labs with false (or no key) are never snapshotted.
  //   Storage account and container: NOT set here - only from Key Vault, secrets
  //                  MasterDataSnapshot--BlobServiceUri  (https://stlrnwebappfiles.blob.core.windows.net)
  //                  MasterDataSnapshot--ContainerName   (lrn-report-snapshots / lrn-report-snapshots-test)
  //                  The service's managed identity needs Storage Blob Data Contributor on the container.
  //   Storage      : "Blob", or "LocalFolder" (LocalFolder; relative to the service folder) for dev.
  "MasterDataSnapshot": {
    "Enabled": false,
    "IncludeLineLevel": true,
    "IncludeClaimLevel": true,
    "IncludeLims": true,
    "Storage": "Blob",
    "LocalFolder": "Snapshots",
    "WorkFolder": "",
    "KeepWeeks": 5,
    "KeepMonthEnd": 0,
    "RowGroupSize": 100000,
    "Compression": "Snappy",
    "CommandTimeoutSeconds": 3600,
    "SchemaVersion": 1
  },
  "//ProcessLog": [
    "Process logs are written as CSV next to the service and are NOT sent to SharePoint.",
    "  CsvEnabled      : Run/Step/Error CSVs, one set per day, in CsvLocalFolder.",
    "  CsvLocalFolder  : relative paths resolve against the service directory, so \"Logs\" is",
    "                    <install folder>\\Logs. The service account needs write access there,",
    "                    and a redeploy that wipes the folder takes the logs with it.",
    "  WorkbookEnabled : the daily LRN_Process_Logs*.xlsx. Off - CSV is the file log now.",
    "SQL logging (RunLogTable / StepLogTable / ErrorLogTable) is unaffected by all of these and",
    "still runs on every step; these switches only control the FILE copy."
  ],
