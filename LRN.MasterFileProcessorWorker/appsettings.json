{
  // Azure Key Vault holds every secret this service needs: all ConnectionStrings:* entries and
  // MasterFileProcessor:SharePoint TenantId / ClientId / ClientSecret. Vault secret names use "--"
  // in place of ":", e.g. the secret "ConnectionStrings--DefaultConnection" supplies
  // ConnectionStrings:DefaultConnection. Nothing below this line is a secret.
  //
  // Access is via DefaultAzureCredential (managed identity on the server, az-cli / Visual Studio
  // sign-in locally); that identity needs the "Key Vault Secrets User" role on the vault.
  // Set VaultUri to "" to run without the vault - see README.md.
  "KeyVault": {
    "VaultUri": "https://kv-lrnmetrics-prod.vault.azure.net/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "None",
      "System": "None"
    }
  },
  "LineClaimImport": {
    "Enabled": true,
    "LabMappingsFolder": "Schemas/LabMappings",
    "FailFastOnInvalidMapping": true,
    // Reports built FROM the line-level and claim-level data rather than run separately. Each is
    // marked Success on the workflow dashboard, against the same RunId, once BOTH levels have
    // actually loaded for that lab.
    //   LabIds empty  = every lab (so a new lab is covered without editing this)
    //   LabIds listed = only those labs
    "DerivedReports": [
      {
        "ReportName": "Clinic Summary",
        "Enabled": true,
        "LabIds": []
      },
      {
        // Only these labs have the sales rep data.  4 = Cove, 16 = Elixir
        "ReportName": "Sales Rep Summary",
        "Enabled": true,
        "LabIds": [ 4, 16 ]
      }
    ]
  },
