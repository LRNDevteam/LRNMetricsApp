<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Must track LabMetricsDashboard's TFM; a net8.0 test project cannot reference the net9.0 app. -->
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LabMetricsDashboard\LabMetricsDashboard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stale: SqlProductionReportRepository moved to the LRN.ProductionReports project and is
         Compile Remove'd from LabMetricsDashboard, so this file no longer compiles. Excluded so the
         rest of the suite can run; re-point it at LRN.ProductionReports (which needs its own
         InternalsVisibleTo) to bring it back. -->
    <Compile Remove="ExportFilterBuilderTests.cs" />
  </ItemGroup>
</Project>
