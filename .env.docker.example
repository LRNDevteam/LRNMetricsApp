# Copy to .env (same folder as docker-compose.yml) and fill in.
# .env is already gitignored. NEVER commit real connection strings.

# ── Required ─────────────────────────────────────────────────────────────────
# LRNMaster. A SQL Server running on the Docker host is host.docker.internal from
# inside a container - "localhost" would be the container itself.
#
# TrustServerCertificate=True is needed for a self-signed dev certificate;
# Microsoft.Data.SqlClient 4+ encrypts by default and otherwise refuses to connect.
LRN_DEFAULT_CONNECTION=Server=host.docker.internal,1433;Database=LRNMaster;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=True

# ── Optional ─────────────────────────────────────────────────────────────────
# Second connection used by the ReportsApi's Denial Mapper and Workflow master
# values. Leave blank if those pages are not needed.
LRN_LABMETRICS_CONNECTION=

# Host folder holding the per-lab <LabName>.json configs, mounted read-only at
# /var/lrn/labconfigs. The dashboard's lab picker stays empty without it.
# Default: ./.docker/labconfigs
LRN_LAB_CONFIG_DIR=

# Backend URLs compiled into the SPA bundle. These are what the BROWSER calls, so
# they are host-visible URLs, not compose service names. Rebuild the webui image
# after changing them (`docker compose build webui`).
VITE_LRN_METRICS_BASE_URL=http://localhost:8080
VITE_REPORTS_API_BASE_URL=http://localhost:8082/api/denialworkflow
