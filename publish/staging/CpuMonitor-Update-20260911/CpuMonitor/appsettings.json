{
  "CpuMonitorSettings": {
    "Enabled": true,

    // Log any single process using more than this share of the whole machine,
    // the same number Task Manager's CPU column shows.
    "CpuThresholdPercent": 40,
    "NormalizeByCoreCount": true,

    // Also log when the machine total goes over this, even if no single process
    // is over CpuThresholdPercent. Catches load spread across many processes.
    "MachineCpuThresholdPercent": 85,
    "MachineTopConsumers": 5,

    "SampleWindowSeconds": 5,
    "PollIntervalSeconds": 10,

    // 1 = log the first window that goes over. 0 cooldown = log every window it
    // stays over, so the log shows how long it lasted.
    "ConsecutiveSamplesBeforeAlert": 1,
    "AlertCooldownMinutes": 0,

    // Proof-of-life line every 10 minutes, so "no alerts" never looks like "dead".
    "HeartbeatMinutes": 10,

    "IgnoreProcessNames": [ "Idle", "System", "Memory Compression" ],
    "BreachLogPath": "Logs\\cpu-breaches.jsonl",
    "SqlProcessNames": [ "sqlservr" ],
    "SqlConnectionString": "",
    "SqlTopSessions": 5,
    "OfficeProcessNames": [ "EXCEL", "WINWORD", "POWERPNT", "MSACCESS", "OUTLOOK" ]
  }
}
