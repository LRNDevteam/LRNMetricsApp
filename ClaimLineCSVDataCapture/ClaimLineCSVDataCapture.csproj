<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LRN.ProductionReports\LRN.ProductionReports.csproj" />
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Models\ProductionReportViewModel.cs" />
    <Compile Remove="Services\IProductionReportRepository.cs" />
    <Compile Remove="Services\ProductionReportExcelExportBuilder.cs" />
    <Compile Remove="Services\SqlProductionReportRepository.cs" />
    <Compile Remove="Services\WeekRangeHelper.cs" />
  </ItemGroup>

  <!-- LIS Summary aggregate refresh reuses the dashboard's LIS repository as-is. -->
  <ItemGroup>
    <Compile Include="..\LabMetricsDashboard\Services\SqlLisSummaryRepository.cs" Link="Shared\LisSummary\SqlLisSummaryRepository.cs" />
    <Compile Include="..\LabMetricsDashboard\Services\ILisSummaryRepository.cs" Link="Shared\LisSummary\ILisSummaryRepository.cs" />
    <Compile Include="..\LabMetricsDashboard\Services\LisSummaryAggregateLabs.cs" Link="Shared\LisSummary\LisSummaryAggregateLabs.cs" />
    <Compile Include="..\LabMetricsDashboard\Services\FirstPaintLog.cs" Link="Shared\LisSummary\FirstPaintLog.cs" />
    <Compile Include="..\LabMetricsDashboard\Models\LisSummaryViewModel.cs" Link="Shared\LisSummary\LisSummaryViewModel.cs" />
    <Compile Include="..\LabMetricsDashboard\Models\LabOption.cs" Link="Shared\LisSummary\LabOption.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Settings\" />
    <Folder Include="Sql\NewFolder\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="FieldMappings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="BeechTreeFieldMappings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="PhiLifeFieldMappings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
