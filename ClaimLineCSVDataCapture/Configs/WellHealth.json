{
  // ─────────────────────────────────────────────────────────────────────────────
  // WellHealth lab configuration
  //
  // DEPLOY INSTRUCTIONS:
  //   Copy this file to  C:\CodingMastConfigs\Labs\WellHealth.json
  //   Copy Sql\WellHealth\WellHealthFieldMappings.json to  C:\CodingMastConfigs\Mappings\WellHealthFieldMappings.json
  //   IMPORTANT: LabFieldMappingsPath below MUST point to the deployed copy.
  //   Without it the app falls back to the global FieldMappings.json (wrong field set).
  //
  // DATABASE (run before the first load):
  //   LRN.MasterFileProcessorWorker\sql\WellHealth\01_WellHealth_CreateTables.sql   (lab database)
  //   LRN.MasterFileProcessorWorker\sql\WellHealth\02_LRNMaster_Register_WellHealth.sql (LRNMaster)
  //   The mapping names dbo.ClaimLevelDataTVP_WellHealth / dbo.LineLevelDataTVP_WellHealth and
  //   dbo.usp_BulkInsertClaimLevelData / dbo.usp_BulkInsertLineLevelData - these must exist too.
  //
  // FIRST RUN:
  //   Set ClaimLineRefresh = true for the first run so existing data is purged
  //   and the file is re-processed cleanly.  The app auto-resets it to false
  //   after a successful run.
  // ─────────────────────────────────────────────────────────────────────────────

  "DBEnabled": true,

  // ── Connection string for the WellHealth SQL Server database ───────────────
  // FILL IN: replace with the actual WellHealth DB connection string
  "DbConnectionString": "Server=YOUR_SERVER;Database=YOUR_WELLHEALTH_DB;Integrated Security=True;TrustServerCertificate=True;",

  // ── CSV ingestion flags ───────────────────────────────────────────────────
  // ClaimLineInsert MUST be true to enable file processing.
  "ClaimLineInsert": true,

  // Set true on first run (or any time you want to force a full re-load).
  // The app resets this to false automatically after a successful run.
  "ClaimLineRefresh": true,

  // ── RunId change detection ────────────────────────────────────────────────
  // The RunId this app last processed. Managed automatically: the app writes the
  // value here at the end of a successful run. Leave as "" for a new lab so the
  // first execution is always treated as changed.
  "LastProcessedRunId": "",

  // Lab name passed to sp_GetRecentSuccessRunByLab (LRNMaster) to fetch the
  // latest successfully completed RunId. Matches the LabName the Master File
  // Processor runs WellHealth under (appsettings.json / dbo.Labs).
  "FetchLatestCompletedRunIDParameter": "WellHealth",

  // ── Paths ─────────────────────────────────────────────────────────────────
  "Paths": {
    // FILL IN: base folder where WellHealth weekly CSV drops are stored
    // Example: "E:\\LRN-Data\\ServerMasters\\WellHealth\\"
    "ServerMastersBasePath": "FILL_IN_BASE_PATH",

    // FILL IN: sub-folder inside ServerMastersBasePath that contains the CSVs
    // The app searches this folder recursively for files whose name contains
    // "Claim Level" / "ClaimLevel"  or  "Line Level" / "LineLevel".
    "ServerMasterFolderName": "FILL_IN_SUBFOLDER",

    // Lab-specific FieldMappings override.
    // Point to the deployed copy of WellHealthFieldMappings.json.
    "LabFieldMappingsPath": "C:\\CodingMastConfigs\\Mappings\\WellHealthFieldMappings.json",

    // Leave blank unless you have dedicated processing/output folders for WellHealth.
    "LabProcessingBasePath": "",
    "RecentlyProcessedLineLevelStandardizedFile": "",
    "RecentlyProcessedClaimLevelStandardizedFile": "",
    "LineLevelStandardizedCsv": "",
    "ClaimLevelStandardizedCsv": "",
    "PayerMaster": "",
    "CodingMaster": "",
    "CptFeeSchedule": ""
  },

  // ── Production report output folder (optional) ────────────────────────────
  "Output": {
    "Reports": "",
    "Avgs": "",
    "Archive": "",
    "ConslidatedAvgs": "",
    "PayerCptAverageBase": "",
    "CodingValidationBase": ""
  },

  // ── Production Summary rule settings ─────────────────────────────────────
  // CONFIRM: WellHealth's billing week is not agreed yet. Rule1 (Thu-to-Wed) is the
  // default most labs use; change it once the client logic sheet says otherwise.
  "ProductionSummary": {
    "Rule": "Rule1",
    "WeekRule": "Rule1",
    "WeekRange": "Thu to Wed"
  }
}
