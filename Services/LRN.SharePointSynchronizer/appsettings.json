{
	// Azure Key Vault holds every secret this service needs: the SharePoint app registration
	// (MasterFileProcessor:SharePoint TenantId / ClientId / ClientSecret) and any ConnectionStrings:*
	// entry. Vault secret names use "--" in place of ":", e.g. the secret
	// "MasterFileProcessor--SharePoint--ClientSecret" supplies MasterFileProcessor:SharePoint:ClientSecret.
	// Nothing below this line is a secret.
	//
	// This service shares the app registration - and therefore the vault secrets - with
	// LRN.MasterFileProcessorWorker. Rotating the secret in the vault covers both.
	//
	// Access is via DefaultAzureCredential (managed identity on the server, az-cli / Visual Studio
	// sign-in locally); that identity needs the "Key Vault Secrets User" role on the vault.
	// Set VaultUri to "" to run without the vault - see README.md.
	"KeyVault": {
		"VaultUri": "https://kv-lrnmetrics-prod.vault.azure.net/"
	},
	"SharePointSynchronizer": {
		"Enabled": true,
		"PollSeconds": 1200
	},
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft": "None",
			"System": "None"
		}
	},
	"TeamsNotification": {
		"Enabled": true
		// WebhookUrl lives in appsettings.Secrets.json, NOT in Key Vault: the URL is 296 characters,
		// past the 256-character limit on the vault tags these settings are managed through.
	},
	"MasterFileProcessor": {
		"SharePoint": {
			"Enabled": true,
			// TenantId, ClientId and ClientSecret come from Key Vault. Never add them here.
			"Hostname": "3eclaimsprocessingllc.sharepoint.com",
			"SitePath": "/sites/3EClaimsProcessingLLC",
			"DriveName": "Documents"
		}
	},
	"UploadPaths": [
		{
			"IsSharePointUpload": false,
			"SyncronizeFileType": "Master",
			"ServerOutputFolder": "D:\\LRN\\Automation\\LRN-Masters",
			"SharePointFolder": "https://3eclaimsprocessingllc.sharepoint.com/sites/3EClaimsProcessingLLC/Shared%20Documents/Forms/AllItems.aspx?id=%2Fsites%2F3EClaimsProcessingLLC%2FShared%20Documents%2F10%2E%20Automation%2FLRN%2DMasters&viewid=bd69a721%2D4a9a%2D46d2%2D88e1%2D3072d4dca1ab&newTargetListUrl=%2Fsites%2F3EClaimsProcessingLLC%2FShared%20Documents&viewpath=%2Fsites%2F3EClaimsProcessingLLC%2FShared%20Documents%2FForms%2FAllItems%2Easpx"
		},
		{
			"IsSharePointUpload": false,
			"SyncronizeFileType": "RawFile",
			"ServerOutputFolder": "D:\\LRN\\Automation\\LRN-Input\\Certus",
			"SharePointFolder": "https://3eclaimsprocessingllc.sharepoint.com/sites/3EClaimsProcessingLLC/Shared%20Documents/Forms/AllItems.aspx?id=%2Fsites%2F3EClaimsProcessingLLC%2FShared%20Documents%2F2%2E%20Internal%20LRN%20Client%20Folders%2FCertus%20Laboratories%2FReporting%2F01%2ERaw%20Reports&viewid=bd69a721%2D4a9a%2D46d2%2D88e1%2D3072d4dca1ab&newTargetListUrl=%2Fsites%2F3EClaimsProcessingLLC%2FShared%20Documents&viewpath=%2Fsites%2F3EClaimsProcessingLLC%2FShared%20Documents%2FForms%2FAllItems%2Easpx",
			"PreserveSharePointFolderStructure": true,
			"SyncLatestWeekOnly": false,
			"SyncLatestWeekRawOnly": true,
			"OverwriteExisting": false
		},
		{
			"IsSharePointUpload": false,
			"SyncronizeFileType": "RawFile",
			"ServerOutputFolder": "D:\\LRN\\Automation\\LRN-Input\\Beech_Tree",
			"SharePointFolder": "https://3eclaimsprocessingllc.sharepoint.com/sites/3EClaimsProcessingLLC/Shared%20Documents/Forms/AllItems.aspx?id=%2Fsites%2F3EClaimsProcessingLLC%2FShared%20Documents%2F2%2E%20Internal%20LRN%20Client%20Folders%2FBeachTree%2FReporting%2F01%2ERaw%20Reports&viewid=bd69a721%2D4a9a%2D46d2%2D88e1%2D3072d4dca1ab&newTargetListUrl=%2Fsites%2F3EClaimsProcessingLLC%2FShared%20Documents&viewpath=%2Fsites%2F3EClaimsProcessingLLC%2FShared%20Documents%2FForms%2FAllItems%2Easpx",
			"PreserveSharePointFolderStructure": true,
			"SyncLatestWeekOnly": false,
			"SyncLatestWeekRawOnly": true,
			"OverwriteExisting": false
		}
	]
}
