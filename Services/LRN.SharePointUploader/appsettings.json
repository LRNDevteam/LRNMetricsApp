{
	// Azure Key Vault holds every secret this service needs: the SharePoint app registration
	// (BillingFrequency:SharePoint TenantId / ClientId / ClientSecret) and all ConnectionStrings:*
	// entries. Vault secret names use "--" in place of ":", e.g. the secret
	// "ConnectionStrings--LrnLogDb" supplies ConnectionStrings:LrnLogDb. Nothing below this line is
	// a secret.
	//
	// Access is via DefaultAzureCredential (managed identity on the server, az-cli / Visual Studio
	// sign-in locally); that identity needs the "Key Vault Secrets User" role on the vault.
	// Set VaultUri to "" to run without the vault - see README.md.
	"KeyVault": {
		"VaultUri": "https://kv-lrnmetrics-prod.vault.azure.net/"
	},
	"SharePointUploader": {
		"Enabled": true,
		"PollSeconds": 1200
	},
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft": "None",
			"System": "None"
		}
	},
	"TeamsNotification": {
		"Enabled": true
		// WebhookUrl lives in appsettings.Secrets.json, NOT in Key Vault: the URL is 265 characters,
		// past the 256-character limit on the vault tags these settings are managed through.
	},
	"LrnStepLog": {
		// The database this writes to is ConnectionStrings:LrnLogDb, from the vault.
		"Enabled": false,
		"SourceSystem": "SharePointUploader",
		"StepName": "SharePointSync",
		"StepSeq": 900
	},
	"BillingFrequency": {
		"ReportOutputsRoot": "D:\\LRN\\BillingImport",
		"SharePoint": {
			"Enabled": true,
			// TenantId, ClientId and ClientSecret come from Key Vault. Never add them here.
			"Hostname": "3eclaimsprocessingllc.sharepoint.com",
			"SitePath": "/sites/3EClaimsProcessingLLC",
			"DriveName": "Documents",
			"UploadOutputs": true,
			"OutputUploadFolderPath": "10. Automation/LRN-Output/Payer Policy Validation Report/Lab",
			"UploadMasterProcessorLog": true,
			"MasterProcessorLogUploadFolderPath": "10. Automation/LRN-Logs/Master File Processor"
		}
	},
	"UploadPaths": [
		{
			"IsSharePointUpload": true,
			"SyncronizeFileType": "PayerPolicy_Validation_Report",
			"ServerOutputFolder": "D:\\LRN\\Automation\\LRN-Output\\PayerPolicy_Validation_Report",
			"SharePointFolder": "https://3eclaimsprocessingllc.sharepoint.com/sites/3EClaimsProcessingLLC/Shared%20Documents/Forms/AllItems.aspx?id=%2Fsites%2F3EClaimsProcessingLLC%2FShared%20Documents%2F10%2E%20Automation%2FLRN%2DOutput%2FPayerPolicy%5FValidation%5FReport&viewid=bd69a721%2D4a9a%2D46d2%2D88e1%2D3072d4dca1ab&newTargetListUrl=%2Fsites%2F3EClaimsProcessingLLC%2FShared%20Documents&viewpath=%2Fsites%2F3EClaimsProcessingLLC%2FShared%20Documents%2FForms%2FAllItems%2Easpx"
		}
	]
}
