<?xml version="1.0" encoding="utf-8"?>
<!--
  AR Workbench on IIS. config.js holds this environment's URLs (Test vs Production) and index.html names the
  current bundle, so browsers must re-check both on every load: a cached copy keeps calling the old API after
  config.js is edited or a new build is published. The hashed files under assets/ stay cacheable.
-->
<configuration>
  <location path="config.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
