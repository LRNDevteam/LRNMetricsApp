{
  // Secrets come only from this vault: ConnectionStrings--DefaultConnection (LRNMaster) and
  // MasterDataSnapshot--BlobServiceUri / --ContainerName (the same snapshot container as the master data).
  // The test service runs with DOTNET_ENVIRONMENT=Test (on the service, not the machine), which loads
  // appsettings.Test.json (lrn-testapp-kv).
  "KeyVault": {
    "VaultUri": "https://kv-lrnmetrics-prod.vault.azure.net/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "File": {
      "LogDirectory": "Logs",
      "LogLevel": "Information",
      "RetainDays": 30
    }
  },
  // Weekly snapshots of the LRN Metrics page reports. For every lab file in LabsFolder with
  // "Enabled": true, each report that shows Success for a RunId in LRNMaster.dbo.ReportsWorkflowTracker
  // is captured once: the page's data with no filters, one Parquet file per grid / tab, at
  //   <container>/<Lab>/<RunId>_<WeekRange>_<EXECSUMMARY|LISSUMMARY|PRODSUMMARY|COLLSUMMARY|DENIALSUMMARY>_<Section>.parquet
  // plus the page's view model as a display copy, <...>_<REPORTCODE>_PageModel.json.gz, next to that run's
  // LINELEVEL / CLAIMLEVEL / LIMS files, and indexed in dbo.ReportSnapshotRun / File.
  // Only while the RunId is still the run loaded in the lab database (older runs are skipped as superseded).
  // The Denial Insight tab (DENIALINSIGHT) is the client's upload: LabMetricsDashboard requests it in
  // dbo.ReportSnapshotRequest after each import or edit.
  //   PollMinutes          : how often the tracker is checked.
  //   SettleMinutes        : wait this long after a report turns Success before capturing it.
  //   LookbackDays         : tracker rows older than this are ignored.
  //   RequestPollSeconds   : how often upload requests are checked.
  //   RequestSettleSeconds : capture an upload once it has been quiet this long (a burst of edits = one snapshot).
  //   RequestMaxAttempts   : a request that keeps failing is closed as Failed after this many tries.
  //   TrackerReportName    : the ReportsWorkflowTracker row written per lab + RunId ("" = none). Must be an
  //                          active dbo.ReportTypeMaster name (ReportTypeMaster_ReportSnapshot.sql).
  // Log: <service folder>\Logs\snapshotgenerator-YYYY-MM-DD.log
  "ReportSnapshot": {
    "Enabled": false,
    "PollMinutes": 15,
    "LabsFolder": "Labs",
    "LookbackDays": 14,
    "SettleMinutes": 5,
    "RequestPollSeconds": 60,
    "RequestSettleSeconds": 120,
    "RequestMaxAttempts": 5,
    "TrackerReportName": "Report Snapshot"
  },
  // The Denial Summary page's per-lab week, date and balance columns. COPY of LabMetricsDashboard's
  // appsettings.json LabConfig:DenialSummaryWeekRange / DenialSummaryDateColumn / DenialSummaryBalanceColumn:
  // keep them equal, or the Denial snapshots of those labs use a different week / column than the page.
  "LabConfig": {
    "DenialSummaryWeekRange": {
      "Rising_Tides": "Fri to Thu",
      "Beech_Tree": "Fri to Thu",
      "NorthWest": "Thu to Wed",
      "NW": "Thu to Wed"
    },
    "DenialSummaryDateColumn": {
      "Beech_Tree": "CheckDate",
      "Rising_Tides": "CheckDate",
      "NorthWest": "CheckDate",
      "NW": "CheckDate"
    },
    "DenialSummaryBalanceColumn": {
      "AnalyzePathology": "TotalInsuranceBalance",
      "WellHealth": "TotalInsuranceBalance",
      "NorthWest": "InsuranceBalance",
      "NW": "InsuranceBalance"
    }
  },
  // Storage, retention and Parquet settings - the same keys and meaning as the master file processor's
  // MasterDataSnapshot section. BlobServiceUri / ContainerName are NOT set here: Key Vault only.
  // KeepWeeks applies to the whole run (master data + reports): keep the two services' values equal.
  "MasterDataSnapshot": {
    "Storage": "Blob",
    "LocalFolder": "Snapshots",
    "WorkFolder": "",
    "KeepWeeks": 5,
    "KeepMonthEnd": 0,
    "RowGroupSize": 100000,
    "Compression": "Snappy",
    "SchemaVersion": 1
  },
  // The LRN Metrics per-lab configs (database connection, report rules) - the same folder and lab keys
  // LRN.ReportWorker uses. Each Labs\*.json LabKey must be one of these.
  "ReportWorker": {
    "LabConfigFolder": "E:\\LRN-Data\\PayerPolicy_v2\\2026\\ReportsDashboard\\Application\\Configs\\",
    "Labs": [
      "PCRLabsofAmerica",
      "Cove",
      "Inhealth_DTR",
      "Elixir",
      "VariantX",
      "AnalyzePathology",
      "WellHealth",
      "CoreBio",
      "TexasDiagnostic",
      "Certus",
      "Beech_Tree",
      "Augustus_Labs",
      "NorthWest",
      "PCR_Dx_AL",
      "PCR_Dx_CO",
      "Phi_Life",
      "Rising_Tides"
    ],
    "QueryTimeoutSeconds": 1800
  }
}
