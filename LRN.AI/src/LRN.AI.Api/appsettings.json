{
  "AI": {
    "DefaultProvider": "Ollama",
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "TimeoutSeconds": 180,
      "ListTimeoutSeconds": 10,
      "KeepAlive": "5m"
    },
    "Comparison": {
      "MaxModelsPerRequest": 3,
      "MaxConcurrency": 3,
      "MaxPromptCharacters": 12000,
      "MaxSystemPromptCharacters": 4000,
      "DefaultSystemPrompt": "You are an assistant evaluating medical billing denial concepts. Do not invent facts.",
      "DefaultTemperature": 0.2,
      "MaxTemperature": 1.0,
      "DefaultMaxTokens": 1200,
      "MaxOutputTokens": 4096,
      "RequireInstalledModels": true,
      "RejectLikelyPhi": true
    },
    "Security": {
      "DevelopmentBypass": false,
      "ModelEvaluationRoles": [ "Admin" ],
      "ComparePermitsPerMinute": 10,
      "MaxRequestBodyBytes": 131072,
      "AllowedCorsOrigins": []
    }
  },
  "DenialWorkflowAuth": {
    "Issuer": "LRNMetrics",
    "Audience": "LRNReportsApi"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "LRN.AI.Audit": "Information"
    }
  },
  "AllowedHosts": "*"
}
