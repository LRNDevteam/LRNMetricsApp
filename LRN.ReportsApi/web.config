<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- WebDAVModule intercepts PUT/DELETE ahead of the ASP.NET Core handler on IIS servers that
           have the WebDAV Publishing role installed, returning 405 Method Not Allowed even though
           the app's own routes fully support these verbs. Remove it defensively; this is a no-op
           if WebDAV isn't installed. -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="104857600" />
        </requestFiltering>
      </security>
      <aspNetCore processPath="dotnet"
                  arguments=".\LRN.ReportsApi.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\LRN-Files\ApplicationFolder\DenialWorkFlow\Logs\stdout"
                  hostingModel="InProcess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
