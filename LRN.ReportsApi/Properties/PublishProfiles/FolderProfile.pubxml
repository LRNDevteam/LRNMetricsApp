<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishProvider>FileSystem</PublishProvider>
    <!--
      Both properties name the SAME folder on purpose. Visual Studio's web publish pipeline
      reads PublishUrl; `dotnet publish -p:PublishProfile=FolderProfile` reads PublishDir and
      ignores PublishUrl entirely — with only PublishUrl set, a command-line publish silently
      succeeded into bin\Release\net8.0\publish\ instead of the deployment folder.
      Keep them in step if the target ever moves.
    -->
    <PublishUrl>C:\LRN-Files\Deployments\DotNet\Release Patch\04Sep2026\ToServer\V2\LRNApi</PublishUrl>
    <PublishDir>E:\VM-Deployments\LrnMetrics\LRNReportsAPI\</PublishDir>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <_TargetId>Folder</_TargetId>
    <SiteUrlToLaunchAfterPublish />
    <TargetFramework>net8.0</TargetFramework>
    <ProjectGuid>0afdfc9b-aa9b-08cf-431b-765b8a1f4680</ProjectGuid>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>